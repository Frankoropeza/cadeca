---
// LeadCapture.astro — Bloque de solicitud de cotización.
// El envío lo gestiona src/scripts/lead-form.ts (POST a /api/lead; WhatsApp como respaldo si está configurado).
import { CONTACTO, HAS_WA, contactoHref } from "@/data/contacto";

export interface Props {
 title?: string;
 producto?: string;
}

const {
 title = "Cotiza tus cajas de cartón",
 producto = "",
} = Astro.props;
---

<section class="lead-capture" id="cotizar" aria-labelledby="cotizar-title">
 <div class="container">

 <h2 id="cotizar-title" class="lead-capture__title">{title}</h2>

 <div class="lead-capture__bullets">
 <span class="lead-capture__bullet">Cotización sin compromiso</span>
 <span class="lead-capture__bullet">Asesoría para elegir la caja correcta</span>
 <span class="lead-capture__bullet">Pedidos para empresas y negocios</span>
 <span class="lead-capture__bullet">Entrega en CDMX y área metropolitana</span>
 </div>

 <form class="lead-capture__form" data-lead-form data-wa={CONTACTO.whatsapp || undefined} aria-label="Formulario de cotización">
 <input type="text" class="lead-capture__input" name="nombre" placeholder="Nombre completo" required aria-label="Nombre completo" autocomplete="name" />
 <input type="text" class="lead-capture__input" name="contacto" placeholder="Teléfono o correo" required aria-label="Teléfono o correo electrónico" autocomplete="email" />
 <select class="lead-capture__select" name="tipo" required aria-label="Tipo de caja">
 <option value="" disabled selected>Tipo de caja</option>
 <option value="Cajas corrugado estándar">Cajas corrugado estándar</option>
 <option value="Cajas a la medida">Cajas a la medida</option>
 <option value="Cajas personalizadas con logo">Cajas personalizadas con logo</option>
 <option value="Cajas para e-commerce">Cajas para e-commerce</option>
 <option value="Cajas para alimentos">Cajas para alimentos</option>
 <option value="Láminas de cartón corrugado">Láminas de cartón corrugado</option>
 <option value="Varios tipos">Varios tipos</option>
 </select>
 <select class="lead-capture__select" name="cantidad" required aria-label="Cantidad aproximada">
 <option value="" disabled selected>Cantidad aproximada</option>
 <option value="Menos de 50 piezas">Menos de 50 piezas</option>
 <option value="50 - 200 piezas">50 – 200 piezas</option>
 <option value="200 - 1,000 piezas">200 – 1,000 piezas</option>
 <option value="1,000 - 5,000 piezas">1,000 – 5,000 piezas</option>
 <option value="Más de 5,000 piezas">Más de 5,000 piezas</option>
 </select>
 <input type="hidden" name="producto" value={producto} />
 <input type="text" name="sitio_web" tabindex="-1" autocomplete="off" aria-hidden="true" class="lead-capture__hp" />
 <button type="submit" class="lead-capture__submit">Solicitar cotización</button>
 <p class="lead-capture__status" data-lead-status role="status" aria-live="polite" hidden></p>
 </form>

 <p class="lead-capture__trust">Sin compromiso · Te respondemos en horario hábil</p>
 <p class="lead-capture__alt">
 {HAS_WA && (<><a href={contactoHref()} target="_blank" rel="noopener">WhatsApp</a> · </>)}
 <a href="/cotizar/">Formulario detallado</a> · <a href="/contacto/">Contacto</a>
 </p>

 </div>
</section>
