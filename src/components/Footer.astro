---
// Footer.astro — Pie de página rediseñado
import { CONTACTO, HAS_TEL, HAS_WA, HAS_EMAIL, contactoHref } from "@/data/contacto";
---

<footer class="footer" role="contentinfo">

 <!-- CTA Band -->
 <div class="footer__cta-band">
 <div class="container">
 <div class="footer__cta-inner">
 <div class="footer__cta-content">
 <p class="footer__cta-eyebrow">Proveedor y distribuidor · CDMX y Estado de México</p>
 <p class="footer__cta-text">¿Necesitas cajas de cartón en CDMX?</p>
 <p class="footer__cta-sub">Cotización sin compromiso. Entrega programada según pedido y zona.</p>
 </div>
 <div class="footer__cta-actions">
 <a href="/cotizar/" class="footer__cta-btn footer__cta-btn--primary">
 Solicitar cotización
 </a>
 {HAS_WA && (<a href={contactoHref()}
 class="footer__cta-btn footer__cta-btn--ghost"
 target="_blank" rel="noopener">
 Escribir por WhatsApp
 </a>)}
 </div>
 </div>
 </div>
 </div>

 <!-- Main -->
 <div class="footer__main">
 <div class="container">
 <div class="footer__grid">

 <!-- Marca -->
 <div class="footer__brand">
 <a href="/" class="footer__logo-link" aria-label="CADECA — Inicio">
 <img src="/img/cadeca.png" alt="CADECA — Cajas de Cartón CDMX" class="footer__logo-img" width="140" height="36" loading="lazy" />
 </a>
 <p class="footer__brand-desc">
 Proveedor de cajas de cartón corrugado en CDMX y Estado de México. Entrega programada,
 asesoría técnica sin costo y precios de mayoreo desde pedidos pequeños.
 </p>

 <ul class="footer__contact-list">
 {HAS_TEL && (<li>
 <a href={`tel:+${CONTACTO.telefono}`} class="footer__contact-item">
 <span>{CONTACTO.telefonoVisible}</span>
 </a>
 </li>)}
 {HAS_EMAIL && (<li>
 <a href={`mailto:${CONTACTO.email}`} class="footer__contact-item">
 <span>{CONTACTO.email}</span>
 </a>
 </li>)}
 {CONTACTO.horario && (<li class="footer__schedule-item">
 <span>{CONTACTO.horario}</span>
 </li>)}
 </ul>
 </div>

 <!-- Productos -->
 <div class="footer__col">
 <h3 class="footer__col-title">Productos</h3>
 <ul class="footer__list">
 <li><a href="/catalogo/cajas-corrugado-estandar/"  class="footer__link">Corrugado Estándar</a></li>
 <li><a href="/catalogo/cajas-a-la-medida/"  class="footer__link">Cajas a la Medida</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/"  class="footer__link">Personalizadas con Logo</a></li>
 <li><a href="/catalogo/cajas-para-ecommerce/"  class="footer__link">Para E-commerce</a></li>
 <li><a href="/catalogo/cajas-para-alimentos/"  class="footer__link">Para Alimentos</a></li>
 <li><a href="/catalogo/laminas-carton-corrugado/"  class="footer__link">Láminas Corrugado</a></li>
 <li><a href="/catalogo/cajas-textil-moda-retail/"  class="footer__link">Textil y Retail</a></li>
 <li><a href="/catalogo/cajas-farmaceutica-cosmetica/" class="footer__link">Farmacéutica</a></li>
 <li><a href="/catalogo/cajas-archivo-almacenaje/"  class="footer__link">Archivo y Almacenaje</a></li>
 <li><a href="/catalogo/" class="footer__link footer__link--cta">Ver catálogo completo</a></li>
 </ul>
 </div>

 <!-- Empresa -->
 <div class="footer__col">
 <h3 class="footer__col-title">Empresa</h3>
 <ul class="footer__list">
 <li><a href="/nosotros/"   class="footer__link">Nosotros</a></li>
 <li><a href="/servicios/"  class="footer__link">Servicios</a></li>
 <li><a href="/servicios/fabricacion-cajas-medida/" class="footer__link">· Cajas a la Medida</a></li>
 <li><a href="/servicios/impresion-cajas-personalizadas/" class="footer__link">· Impresión y Logo</a></li>
 <li><a href="/servicios/entrega-domicilio-cdmx/" class="footer__link">· Entrega a Domicilio</a></li>
 <li><a href="/cotizar/"   class="footer__link">Cotizador Online</a></li>
 <li><a href="/blog/"    class="footer__link">Blog y Guías</a></li>
 <li><a href="/directorio/" class="footer__link">Directorio de Empresas</a></li>
 <li><a href="/contacto/"  class="footer__link">Contacto</a></li>
 </ul>

 <h3 class="footer__col-title footer__col-title--spaced">Guías de compra</h3>
 <ul class="footer__list">
 <li><a href="/catalogo/cajas-de-carton-grandes/" class="footer__link">Cajas grandes</a></li>
 <li><a href="/catalogo/cajas-de-carton-pequenas/" class="footer__link">Cajas pequeñas</a></li>
 <li><a href="/catalogo/cajas-de-carton-para-regalo/" class="footer__link">Cajas para regalo</a></li>
 <li><a href="/medidas-de-cajas-de-carton/" class="footer__link">Medidas de cajas</a></li>
 <li><a href="/donde-comprar-cajas-de-carton/" class="footer__link">Dónde comprar cajas</a></li>
 </ul>
 </div>

 <!-- Cobertura -->
 <div class="footer__col">
 <h3 class="footer__col-title">Zonas de Entrega</h3>
 <ul class="footer__list footer__list--zonas">
 <li><a href="/zonas-de-servicio/#azcapotzalco" class="footer__link">Vallejo / Azcapotzalco</a></li>
 <li><a href="/zonas-de-servicio/#naucalpan" class="footer__link">Naucalpan / Tlalnepantla</a></li>
 <li><a href="/zonas-de-servicio/#ecatepec" class="footer__link">Ecatepec</a></li>
 <li><a href="/zonas-de-servicio/#toluca-lerma" class="footer__link">Toluca / Lerma</a></li>
 <li><a href="/zonas-de-servicio/#coyoacan" class="footer__link">Coyoacán / Benito Juárez</a></li>
 <li><a href="/zonas-de-servicio/" class="footer__link footer__link--cta">Ver todas las zonas</a></li>
 </ul>
 </div>

 </div>
 </div>
 </div>

 <!-- Bottom -->
 <div class="footer__bottom">
 <div class="container">
 <div class="footer__bottom-inner">
 <p class="footer__copy">&copy; {new Date().getFullYear()} CADECA &mdash; Cajas de Cartón CDMX. Todos los derechos reservados.</p>
 <nav class="footer__legal" aria-label="Legal">
 <a href="/aviso-de-privacidad/">Aviso de Privacidad</a>
 <span class="footer__legal-sep" aria-hidden="true">&middot;</span>
 <a href="/contacto/">Contacto</a>
 </nav>
 </div>
 </div>
 </div>

</footer>
