---
// Footer.astro — Pie de página rediseñado
export interface Props {
 phone?:  string;
 whatsapp?: string;
 email?:  string;
 address?:  string;
 schedule?: string;
}

const {
 phone  = "55 XXXX-XXXX",
 whatsapp = "5255XXXXXXXX",
 email  = "ventas@cadeca.com.mx",
 address  = "[Dirección completa], CDMX",
 schedule = "Lun–Vie: 8:00 – 18:00 · Sáb: 9:00 – 14:00",
} = Astro.props;
---

<footer class="footer" role="contentinfo">

 <!-- CTA Band -->
 <div class="footer__cta-band">
 <div class="container">
 <div class="footer__cta-inner">
 <div class="footer__cta-content">
 <p class="footer__cta-eyebrow">Fabricante directo · Sin intermediarios</p>
 <p class="footer__cta-text">¿Necesitas cajas de cartón en CDMX?</p>
 <p class="footer__cta-sub">Cotización sin compromiso en menos de 2 horas. Entrega desde 24 hrs.</p>
 </div>
 <div class="footer__cta-actions">
 <a href="/cotizar" class="footer__cta-btn footer__cta-btn--primary">
 <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 4.97-4.03 9-9 9s-9-4.03-9-9 4.03-9 9-9 9 4.03 9 9z"/></svg>
 Solicitar cotización
 </a>
 <a href={`https://wa.me/${whatsapp}`}
 class="footer__cta-btn footer__cta-btn--ghost"
 target="_blank" rel="noopener">
 <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
 <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
 </svg>
 Escribir por WhatsApp
 </a>
 </div>
 </div>
 </div>
 </div>

 <!-- Main -->
 <div class="footer__main">
 <div class="container">
 <div class="footer__grid">

 <!-- Marca -->
 <div class="footer__brand">
 <a href="/" class="footer__logo-link" aria-label="CADECA — Inicio">
 <img src="/img/cadeca.png" alt="CADECA — Cajas de Cartón CDMX" class="footer__logo-img" width="140" height="36" loading="lazy" />
 </a>
 <p class="footer__brand-desc">
 Fabricante directo de cajas de cartón corrugado en CDMX. Entrega en 24 hrs,
 asesoría técnica sin costo y precios de mayoreo desde pedidos pequeños.
 </p>

 <ul class="footer__contact-list">
 <li>
 <a href={`tel:+${whatsapp}`} class="footer__contact-item">
 <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
 <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
 </svg>
 <span>{phone}</span>
 </a>
 </li>
 <li>
 <a href={`mailto:${email}`} class="footer__contact-item">
 <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
 <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
 <polyline points="22,6 12,13 2,6"/>
 </svg>
 <span>{email}</span>
 </a>
 </li>
 <li class="footer__schedule-item">
 <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
 <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
 </svg>
 <span>{schedule}</span>
 </li>
 </ul>

 <div class="footer__badges">
 <span class="footer__badge">FSC</span>
 <span class="footer__badge">ISO 9001</span>
 <span class="footer__badge">Hecho en CDMX</span>
 </div>
 </div>

 <!-- Productos -->
 <div class="footer__col">
 <h3 class="footer__col-title">Productos</h3>
 <ul class="footer__list">
 <li><a href="/productos/cajas-corrugado-estandar"  class="footer__link">Corrugado Estándar</a></li>
 <li><a href="/productos/cajas-a-la-medida"  class="footer__link">Cajas a la Medida</a></li>
 <li><a href="/productos/cajas-personalizadas-logo"  class="footer__link">Personalizadas con Logo</a></li>
 <li><a href="/productos/cajas-para-ecommerce"  class="footer__link">Para E-commerce</a></li>
 <li><a href="/productos/cajas-para-alimentos"  class="footer__link">Para Alimentos</a></li>
 <li><a href="/productos/laminas-carton-corrugado"  class="footer__link">Láminas Corrugado</a></li>
 <li><a href="/productos/cajas-textil-moda-retail"  class="footer__link">Textil y Retail</a></li>
 <li><a href="/productos/cajas-farmaceutica-cosmetica" class="footer__link">Farmacéutica</a></li>
 <li><a href="/productos/cajas-archivo-almacenaje"  class="footer__link">Archivo y Almacenaje</a></li>
 <li><a href="/catalogo" class="footer__link footer__link--cta">Ver catálogo completo &rarr;</a></li>
 </ul>
 </div>

 <!-- Empresa -->
 <div class="footer__col">
 <h3 class="footer__col-title">Empresa</h3>
 <ul class="footer__list">
 <li><a href="/nosotros"  class="footer__link">Nosotros</a></li>
 <li><a href="/servicios" class="footer__link">Servicios</a></li>
 <li><a href="/cotizar"  class="footer__link">Cotizador Online</a></li>
 <li><a href="/blog"  class="footer__link">Blog y Guías</a></li>
 <li><a href="/contacto"  class="footer__link">Contacto</a></li>
 </ul>

 <h3 class="footer__col-title footer__col-title--spaced">Industrias</h3>
 <ul class="footer__list">
 <li><a href="/productos/cajas-para-ecommerce"  class="footer__link">E-commerce</a></li>
 <li><a href="/productos/cajas-a-la-medida"  class="footer__link">Industrial</a></li>
 <li><a href="/productos/cajas-para-alimentos"  class="footer__link">Alimentos</a></li>
 <li><a href="/productos/cajas-personalizadas-logo" class="footer__link">Retail y Marcas</a></li>
 </ul>
 </div>

 <!-- Cobertura -->
 <div class="footer__col">
 <h3 class="footer__col-title">Zonas de Entrega</h3>
 <address class="footer__address-block">
 <p class="footer__address-line">{address}</p>
 </address>
 <ul class="footer__list footer__list--zonas">
 <li><a href="/zonas-de-servicio" class="footer__link">CDMX · Todas las alcaldías</a></li>
 <li><a href="/zonas-de-servicio" class="footer__link">Naucalpan</a></li>
 <li><a href="/zonas-de-servicio" class="footer__link">Tlalnepantla</a></li>
 <li><a href="/zonas-de-servicio" class="footer__link">Ecatepec</a></li>
 <li><a href="/zonas-de-servicio" class="footer__link">Nezahualcóyotl</a></li>
 <li><a href="/zonas-de-servicio" class="footer__link footer__link--cta">Ver todas las zonas &rarr;</a></li>
 </ul>
 </div>

 </div>
 </div>
 </div>

 <!-- Bottom -->
 <div class="footer__bottom">
 <div class="container">
 <div class="footer__bottom-inner">
 <p class="footer__copy">&copy; {new Date().getFullYear()} CADECA &mdash; Cajas de Cartón CDMX. Todos los derechos reservados.</p>
 <nav class="footer__legal" aria-label="Legal">
 <a href="/aviso-de-privacidad">Aviso de Privacidad</a>
 <span class="footer__legal-sep" aria-hidden="true">&middot;</span>
 <a href="/contacto">Contacto</a>
 </nav>
 </div>
 </div>
 </div>

</footer>
