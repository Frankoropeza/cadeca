---
// Header.astro — Navegación principal con mega-menu
export interface Props {
  whatsapp?: string;
  currentPath?: string;
}

const {
  whatsapp    = "5255XXXXXXXX",
  currentPath = Astro.url.pathname,
} = Astro.props;

const isActive = (path: string) =>
  currentPath === path ? "nav-desktop__link--active" : "";
const isSection = (prefix: string) =>
  currentPath.startsWith(prefix) ? "nav-desktop__link--active" : "";
---

<a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

<header class="header" id="header" role="banner">
  <div class="container">

    <!-- Logo -->
    <a href="/" class="header__logo" aria-label="CADECA — Cajas de Cartón CDMX — Inicio">
      <img src="/img/cadeca.png" alt="CADECA — Cajas de Cartón" class="header__logo-img" width="160" height="40" loading="eager" />
    </a>

    <!-- Nav Desktop -->
    <nav class="nav-desktop" role="navigation" aria-label="Navegación principal">
      <ul class="nav-desktop__list">

        <li class="nav-desktop__item">
          <a href="/" class={`nav-desktop__link ${isActive("/")}`}>Inicio</a>
        </li>

        <!-- Productos / Catálogo -->
        <li class="nav-desktop__item">
          <a href="/catalogo" class={`nav-desktop__link ${isSection("/catalogo")} ${isSection("/productos")}`} aria-haspopup="true">
            Catálogo <span class="nav-desktop__arrow" aria-hidden="true">▾</span>
          </a>
          <div class="mega-menu" role="menu" aria-label="Catálogo de productos">
            <div class="mega-menu__category">
              <h3 class="mega-menu__title">Cajas Estándar</h3>
              <ul class="mega-menu__list">
                <li><a href="/catalogo/cajas-corrugado-estandar/corrugado-simple"  class="mega-menu__link" role="menuitem">Corrugado simple</a></li>
                <li><a href="/catalogo/cajas-corrugado-estandar/doble-corrugado"   class="mega-menu__link" role="menuitem">Doble corrugado</a></li>
                <li><a href="/catalogo/cajas-corrugado-estandar/triple-corrugado"  class="mega-menu__link" role="menuitem">Triple corrugado</a></li>
                <li><a href="/catalogo/cajas-corrugado-estandar/cajas-mudanza"     class="mega-menu__link" role="menuitem">Cajas para mudanza</a></li>
                <li><a href="/catalogo/cajas-corrugado-estandar/corrugado-flauta-e" class="mega-menu__link" role="menuitem">Micro flauta E</a></li>
              </ul>
              <a href="/catalogo/cajas-corrugado-estandar" class="mega-menu__view-all">Ver todas →</a>
            </div>
            <div class="mega-menu__category">
              <h3 class="mega-menu__title">A Medida y Personalizadas</h3>
              <ul class="mega-menu__list">
                <li><a href="/catalogo/cajas-a-la-medida/industrial"             class="mega-menu__link" role="menuitem">Industrial reforzada</a></li>
                <li><a href="/catalogo/cajas-personalizadas-logo/1-color"         class="mega-menu__link" role="menuitem">Con logo 1 color</a></li>
                <li><a href="/catalogo/cajas-personalizadas-logo/full-color"      class="mega-menu__link" role="menuitem">Full color CMYK</a></li>
                <li><a href="/catalogo/laminas-carton-corrugado/laminas-ecologicas" class="mega-menu__link" role="menuitem">Ecológicas FSC</a></li>
              </ul>
              <a href="/catalogo/cajas-a-la-medida" class="mega-menu__view-all">Ver todas →</a>
            </div>
            <div class="mega-menu__category">
              <h3 class="mega-menu__title">Por Industria</h3>
              <ul class="mega-menu__list">
                <li><a href="/catalogo/cajas-para-ecommerce/mercado-envios"  class="mega-menu__link" role="menuitem">Mercado Envíos</a></li>
                <li><a href="/catalogo/cajas-para-ecommerce/amazon-fba"      class="mega-menu__link" role="menuitem">Amazon FBA / FBM</a></li>
                <li><a href="/catalogo/cajas-para-alimentos/pizza"           class="mega-menu__link" role="menuitem">Para pizza / fast food</a></li>
                <li><a href="/catalogo/cajas-textil-moda-retail"             class="mega-menu__link" role="menuitem">Textil, Moda y Retail</a></li>
                <li><a href="/catalogo/cajas-farmaceutica-cosmetica"         class="mega-menu__link" role="menuitem">Farmacéutica y Cosmética</a></li>
                <li><a href="/catalogo/cajas-archivo-almacenaje"             class="mega-menu__link" role="menuitem">Archivo y Almacenaje</a></li>
              </ul>
              <a href="/catalogo" class="mega-menu__view-all">Ver catálogo completo →</a>
            </div>
            <div class="mega-menu__category mega-menu__category--cta">
              <h3 class="mega-menu__title">¿No encuentras lo que buscas?</h3>
              <p class="mega-menu__desc">Cotiza cualquier medida personalizada. Respondemos en menos de 1 hora.</p>
              <a href="/cotizar" class="btn btn--primary btn--sm">Cotizar ahora</a>
              <a href={`https://wa.me/${whatsapp}`} class="mega-menu__whatsapp" target="_blank" rel="noopener">
                WhatsApp directo →
              </a>
            </div>
          </div>
        </li>

        <!-- Soluciones (redirige a productos mientras no existen) -->
        <li class="nav-desktop__item">
          <a href="/productos" class={`nav-desktop__link ${isSection("/productos")}`} aria-haspopup="true">
            Soluciones <span class="nav-desktop__arrow" aria-hidden="true">▾</span>
          </a>
          <div class="mega-menu" role="menu" aria-label="Soluciones por industria">
            <div class="mega-menu__category">
              <h3 class="mega-menu__title">Por Sector</h3>
              <ul class="mega-menu__list">
                <li><a href="/productos/cajas-para-ecommerce"         class="mega-menu__link">E-commerce y Marketplaces</a></li>
                <li><a href="/productos/cajas-a-la-medida"            class="mega-menu__link">Industrial y Nearshoring</a></li>
                <li><a href="/productos/cajas-para-alimentos"         class="mega-menu__link">Alimentos y Bebidas</a></li>
                <li><a href="/productos/cajas-personalizadas-logo"    class="mega-menu__link">Retail y Marcas</a></li>
                <li><a href="/productos/cajas-textil-moda-retail"     class="mega-menu__link">Textil, Moda y Retail</a></li>
                <li><a href="/productos/cajas-farmaceutica-cosmetica" class="mega-menu__link">Farmacéutica y Cosmética</a></li>
                <li><a href="/productos/cajas-archivo-almacenaje"     class="mega-menu__link">Archivo y Almacenaje</a></li>
              </ul>
            </div>
            <div class="mega-menu__category">
              <h3 class="mega-menu__title">Servicios</h3>
              <ul class="mega-menu__list">
                <li><a href="/cotizar"   class="mega-menu__link">Cotizador Online</a></li>
                <li><a href="/contacto"  class="mega-menu__link">Asesoría Gratuita</a></li>
                <li><a href="/contacto"  class="mega-menu__link">Entrega a Domicilio</a></li>
                <li><a href="/catalogo"  class="mega-menu__link">Catálogo Mayoreo</a></li>
              </ul>
            </div>
          </div>
        </li>

        <!-- Zonas -->
        <li class="nav-desktop__item">
          <a href="/zonas-de-servicio" class={`nav-desktop__link ${isSection("/zonas-de-servicio")}`} aria-haspopup="true">
            Zonas <span class="nav-desktop__arrow" aria-hidden="true">▾</span>
          </a>
          <div class="mega-menu" role="menu">
            <div class="mega-menu__category">
              <h3 class="mega-menu__title">Ciudad de México</h3>
              <ul class="mega-menu__list">
                <li><a href="/zonas-de-servicio" class="mega-menu__link">Vallejo / Azcapotzalco</a></li>
                <li><a href="/zonas-de-servicio" class="mega-menu__link">Iztapalapa</a></li>
                <li><a href="/zonas-de-servicio" class="mega-menu__link">Coyoacán / Sur CDMX</a></li>
              </ul>
              <a href="/zonas-de-servicio" class="mega-menu__view-all">Ver todas las zonas →</a>
            </div>
            <div class="mega-menu__category">
              <h3 class="mega-menu__title">Estado de México</h3>
              <ul class="mega-menu__list">
                <li><a href="/zonas-de-servicio" class="mega-menu__link">Naucalpan / Tlalnepantla</a></li>
                <li><a href="/zonas-de-servicio" class="mega-menu__link">Ecatepec</a></li>
                <li><a href="/zonas-de-servicio" class="mega-menu__link">Toluca / Lerma</a></li>
                <li><a href="/zonas-de-servicio" class="mega-menu__link">Cuautitlán Izcalli</a></li>
              </ul>
            </div>
          </div>
        </li>

        <li class="nav-desktop__item">
          <a href="/blog" class={`nav-desktop__link ${isSection("/blog")}`}>Blog</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/nosotros" class={`nav-desktop__link ${isActive("/nosotros")}`}>Nosotros</a>
        </li>
        <li class="nav-desktop__item">
          <a href="/contacto" class={`nav-desktop__link ${isActive("/contacto")}`}>Contacto</a>
        </li>

      </ul>
    </nav>

    <a href="/cotizar"
       class="btn btn--primary btn--sm header__cta"
       aria-label="Cotizar cajas de cartón">
      Cotizar ahora
    </a>

    <button class="hamburger" id="hamburger"
            aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-nav">
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
      <span class="hamburger__line"></span>
    </button>

  </div>
</header>

<!-- Mobile overlay + nav -->
<div class="mobile-overlay" id="mobile-overlay" aria-hidden="true"></div>
<nav class="mobile-nav" id="mobile-nav"
     role="navigation" aria-label="Navegación móvil" aria-hidden="true">
  <ul>
    <li class="mobile-nav__item"><a href="/" class="mobile-nav__link">Inicio</a></li>

    <li class="mobile-nav__item">
      <button class="mobile-nav__link" data-toggle
              aria-expanded="false" aria-controls="mob-catalogo" id="mob-toggle-catalogo">
        Catálogo <span class="mobile-nav__arrow">▾</span>
      </button>
      <div class="mobile-nav__submenu" id="mob-catalogo">
        <div class="mobile-nav__subcategory">
          <div class="mobile-nav__subtitle">Estándar</div>
          <a href="/catalogo/cajas-corrugado-estandar/corrugado-simple" class="mobile-nav__sublink">Corrugado simple</a>
          <a href="/catalogo/cajas-corrugado-estandar/doble-corrugado"  class="mobile-nav__sublink">Doble corrugado</a>
          <a href="/catalogo/cajas-corrugado-estandar/triple-corrugado" class="mobile-nav__sublink">Triple corrugado</a>
          <a href="/catalogo/cajas-corrugado-estandar/cajas-mudanza"    class="mobile-nav__sublink">Mudanza</a>
        </div>
        <div class="mobile-nav__subcategory">
          <div class="mobile-nav__subtitle">Personalizadas</div>
          <a href="/catalogo/cajas-a-la-medida/industrial"              class="mobile-nav__sublink">A la medida</a>
          <a href="/catalogo/cajas-personalizadas-logo/1-color"         class="mobile-nav__sublink">Con logo</a>
          <a href="/catalogo/laminas-carton-corrugado/laminas-ecologicas" class="mobile-nav__sublink">Ecológicas FSC</a>
        </div>
        <div class="mobile-nav__subcategory">
          <div class="mobile-nav__subtitle">Por Industria</div>
          <a href="/catalogo/cajas-para-ecommerce/mercado-envios" class="mobile-nav__sublink">Mercado Envíos</a>
          <a href="/catalogo/cajas-para-ecommerce/amazon-fba"     class="mobile-nav__sublink">Amazon FBA</a>
          <a href="/catalogo/cajas-para-alimentos/pizza"          class="mobile-nav__sublink">Pizza / Fast food</a>
        </div>
        <a href="/catalogo" class="mobile-nav__sublink mobile-nav__sublink--all">Ver catálogo completo →</a>
      </div>
    </li>

    <li class="mobile-nav__item">
      <button class="mobile-nav__link" data-toggle
              aria-expanded="false" aria-controls="mob-soluciones" id="mob-toggle-soluciones">
        Soluciones <span class="mobile-nav__arrow">▾</span>
      </button>
      <div class="mobile-nav__submenu" id="mob-soluciones">
        <a href="/productos/cajas-para-ecommerce"         class="mobile-nav__sublink">E-commerce</a>
        <a href="/productos/cajas-a-la-medida"            class="mobile-nav__sublink">Industrial / Nearshoring</a>
        <a href="/productos/cajas-para-alimentos"         class="mobile-nav__sublink">Alimentos y Bebidas</a>
        <a href="/productos/cajas-personalizadas-logo"    class="mobile-nav__sublink">Retail y Marcas</a>
        <a href="/productos/cajas-textil-moda-retail"     class="mobile-nav__sublink">Textil, Moda y Retail</a>
        <a href="/productos/cajas-farmaceutica-cosmetica" class="mobile-nav__sublink">Farmacéutica y Cosmética</a>
        <a href="/productos/cajas-archivo-almacenaje"     class="mobile-nav__sublink">Archivo y Almacenaje</a>
        <a href="/cotizar"                                class="mobile-nav__sublink">Cotizador Online</a>
        <a href="/productos" class="mobile-nav__sublink mobile-nav__sublink--all">Ver todas →</a>
      </div>
    </li>

    <li class="mobile-nav__item"><a href="/zonas-de-servicio" class="mobile-nav__link">Zonas de Servicio</a></li>
    <li class="mobile-nav__item"><a href="/blog" class="mobile-nav__link">Blog</a></li>
    <li class="mobile-nav__item"><a href="/nosotros"  class="mobile-nav__link">Nosotros</a></li>
    <li class="mobile-nav__item"><a href="/contacto"  class="mobile-nav__link">Contacto</a></li>
    <li class="mobile-nav__item"><a href="/cotizar"   class="mobile-nav__link">Cotizar</a></li>
  </ul>
  <div class="mobile-nav__cta">
    <a href="/cotizar" class="btn btn--primary">Cotizar ahora</a>
  </div>
</nav>
