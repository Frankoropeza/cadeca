---
// ProductCardFull.astro — Tarjeta de producto extendida con specs y badges
export interface Spec {
  label: string;
  value: string;
}
export interface Tag {
  label: string;
  href:  string;
}
export interface Props {
  title:      string;
  desc:       string;
  imgSrc:     string;
  imgAlt:     string;
  href:       string;
  tags?:      Tag[];
  specs?:     Spec[];
  badge?:     string;
  badgeColor?: "primary" | "success" | "info";
  minPiezas?: string;
  entrega?:   string;
  desde?:     string;
  featured?:  boolean;
  category?:  string;
}

const {
  title,
  desc,
  imgSrc,
  imgAlt,
  href,
  tags      = [],
  specs     = [],
  badge,
  badgeColor = "primary",
  minPiezas,
  entrega,
  desde,
  featured  = false,
  category  = "",
} = Astro.props;
---

<article
  class={`product-card-full ${featured ? "product-card-full--featured" : ""}`}
  data-category={category}
>
  <!-- Imagen -->
  <div class="product-card-full__img-wrap">
    {badge && (
      <span class={`product-card-full__badge product-card-full__badge--${badgeColor}`}>
        {badge}
      </span>
    )}
    <img
      src={imgSrc}
      alt={imgAlt}
      class="product-card-full__img"
      loading="lazy"
      decoding="async"
      width="900"
      height="560"
      fetchpriority="low"
    />
  </div>

  <!-- Body -->
  <div class="product-card-full__body">

    <div class="product-card-full__top">
      <h3 class="product-card-full__title">{title}</h3>
      <p class="product-card-full__desc">{desc}</p>
    </div>

    <!-- Specs técnicos -->
    {specs.length > 0 && (
      <div class="product-card-full__specs">
        {specs.map(s => (
          <div class="product-card-full__spec">
            <span class="product-card-full__spec-label">{s.label}</span>
            <span class="product-card-full__spec-value">{s.value}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Info rápida -->
    <div class="product-card-full__info">
      {minPiezas && (
        <div class="product-card-full__info-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <span>Mínimo: <strong>{minPiezas}</strong></span>
        </div>
      )}
      {entrega && (
        <div class="product-card-full__info-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <span>Entrega: <strong>{entrega}</strong></span>
        </div>
      )}
      {desde && (
        <div class="product-card-full__info-item product-card-full__info-item--price">
          <span>Desde</span>
          <strong>{desde}</strong>
        </div>
      )}
    </div>

    <!-- Subcategorías -->
    {tags.length > 0 && (
      <div class="product-card-full__tags">
        {tags.map(tag => (
          <a href={tag.href} class="product-card-full__tag">{tag.label}</a>
        ))}
      </div>
    )}

    <!-- CTA -->
    <div class="product-card-full__actions">
      <a href={href} class="product-card-full__btn-primary">
        Ver producto
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#cotizar" class="product-card-full__btn-secondary">Cotizar</a>
    </div>

  </div>
</article>

<style>
.product-card-full {
  background: var(--color-white);
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--shadow-sm);
  border: 1.5px solid var(--color-border);
  transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);
}
.product-card-full:hover {
  transform: translateY(-5px);
  box-shadow: var(--shadow-lg);
  border-color: var(--color-primary);
}
.product-card-full--featured {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 2px rgba(224,88,0,0.15), var(--shadow-md);
}

/* Imagen */
.product-card-full__img-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 16/10;
  overflow: hidden;
  background: var(--color-accent);
}
.product-card-full__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.product-card-full:hover .product-card-full__img { transform: scale(1.04); }

/* Badge */
.product-card-full__badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  z-index: 2;
  padding: 0.3rem 0.85rem;
  border-radius: 50px;
  font-size: var(--font-size-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.product-card-full__badge--primary { background: var(--color-primary); color: #fff; }
.product-card-full__badge--success  { background: #38A169; color: #fff; }
.product-card-full__badge--info     { background: var(--color-secondary); color: #fff; }

/* Body */
.product-card-full__body {
  padding: var(--spacing-xl);
  display: flex;
  flex-direction: column;
  flex: 1;
  gap: var(--spacing-md);
}
.product-card-full__title {
  font-size: var(--font-size-xl);
  font-weight: 800;
  color: var(--color-secondary);
  line-height: var(--line-height-tight);
  margin: 0;
}
.product-card-full__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* Specs */
.product-card-full__specs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
  padding: var(--spacing-md);
  background: var(--color-accent);
  border-radius: var(--border-radius);
}
.product-card-full__spec {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}
.product-card-full__spec-label {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-text-light);
}
.product-card-full__spec-value {
  font-size: var(--font-size-sm);
  font-weight: 700;
  color: var(--color-secondary);
}

/* Info rápida */
.product-card-full__info {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  padding-top: var(--spacing-xs);
  border-top: 1px solid var(--color-border);
}
.product-card-full__info-item {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: var(--font-size-xs);
  color: var(--color-text-light);
}
.product-card-full__info-item svg { flex-shrink: 0; opacity: 0.6; }
.product-card-full__info-item strong { color: var(--color-secondary); }
.product-card-full__info-item--price {
  margin-left: auto;
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 700;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
}
.product-card-full__info-item--price span { font-size: var(--font-size-xs); font-weight: 400; color: var(--color-text-light); }

/* Tags */
.product-card-full__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
}
.product-card-full__tag {
  font-size: var(--font-size-xs);
  color: var(--color-secondary);
  background: var(--color-accent);
  border: 1px solid var(--color-border);
  padding: 0.25rem 0.65rem;
  border-radius: 50px;
  transition: all var(--transition-fast);
  text-decoration: none;
}
.product-card-full__tag:hover {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

/* Actions */
.product-card-full__actions {
  display: flex;
  gap: 0.75rem;
  margin-top: auto;
  padding-top: var(--spacing-xs);
}
.product-card-full__btn-primary {
  flex: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.875rem 1.25rem;
  background: var(--color-primary);
  color: #fff;
  border-radius: var(--border-radius);
  font-size: var(--font-size-sm);
  font-weight: 700;
  text-decoration: none;
  transition: all var(--transition-fast);
  box-shadow: 0 2px 6px rgba(224,88,0,0.25);
}
.product-card-full__btn-primary:hover {
  background: var(--color-primary-dark);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(224,88,0,0.35);
}
.product-card-full__btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.875rem 1.25rem;
  border: 2px solid var(--color-border);
  color: var(--color-secondary);
  border-radius: var(--border-radius);
  font-size: var(--font-size-sm);
  font-weight: 700;
  text-decoration: none;
  transition: all var(--transition-fast);
  white-space: nowrap;
}
.product-card-full__btn-secondary:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: var(--color-accent);
}
</style>
