---
// FaqItem.astro — Item del acordeón FAQ
export interface Props {
  id:       string;
  question: string;
  answer:   string;
}

const { id, question, answer } = Astro.props;
---

<div class="faq__item">
  <button
    class="faq__question"
    aria-expanded="false"
    aria-controls={`faq-${id}`}
    id={`faq-q-${id}`}
  >
    {question}
    <span class="faq__icon" aria-hidden="true">+</span>
  </button>
  <div
    class="faq__answer"
    id={`faq-${id}`}
    role="region"
    aria-labelledby={`faq-q-${id}`}
  >
    <p set:html={answer} />
  </div>
</div>
