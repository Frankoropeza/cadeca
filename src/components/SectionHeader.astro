---
// SectionHeader.astro — Encabezado de sección reutilizable
export interface Props {
  title:      string;
  subtitle?:  string;
  link?:      { text: string; href: string };
  twoCol?:    boolean;
  id?:        string;
}

const {
  title,
  subtitle,
  link,
  twoCol = false,
  id,
} = Astro.props;
---

<div class={`section-header ${twoCol ? "section-header--two-col" : ""}`}>
  <div class="section-header__left">
    <h2 class="section-header__title" id={id}>{title}</h2>
    {subtitle && <p class="section-header__subtitle">{subtitle}</p>}
    {link && (
      <a href={link.href} class="section-header__link">{link.text} &rarr;</a>
    )}
  </div>

  {twoCol && (
    <div class="section-header__right">
      <slot />
    </div>
  )}
</div>
