---
// PageHero.astro — Hero 2 columnas homologado
// Izquierda: eyebrow + H1 + desc + desc2 + CTAs
// Derecha: chips (como cards) + stats + features list

export interface Chip {
  label: string;
}

export interface Cta {
  href:    string;
  label:   string;
  variant: "primary" | "outline" | "white";
}

export interface StatItem {
  value: string;
  label: string;
}

export interface Props {
  eyebrow?:   string;
  title:      string;
  titleHtml?: boolean;
  desc:       string;
  desc2?:     string;
  chips?:     Chip[];
  stats?:     StatItem[];
  ctas?:      Cta[];
  size?:      "normal" | "lg";
}

const {
  eyebrow,
  title,
  titleHtml = false,
  desc,
  desc2,
  chips,
  stats,
  ctas,
  size = "normal",
} = Astro.props;

const hasRight = (chips && chips.length > 0) || (stats && stats.length > 0);
---

<section class={`page-hero-std${size === "lg" ? " page-hero-std--lg" : ""}`}>
  <div class="container">
    <div class={`page-hero-std__grid${hasRight ? "" : " page-hero-std__grid--full"}`}>

      <!-- Columna izquierda: contenido principal -->
      <div class="page-hero-std__left">
        {eyebrow && <span class="page-hero-std__eyebrow">{eyebrow}</span>}

        {titleHtml
          ? <h1 class="page-hero-std__title" set:html={title} />
          : <h1 class="page-hero-std__title">{title}</h1>
        }

        <p class="page-hero-std__desc">{desc}</p>
        {desc2 && <p class="page-hero-std__desc page-hero-std__desc--2">{desc2}</p>}

        {ctas && ctas.length > 0 && (
          <div class="page-hero-std__ctas">
            {ctas.map(c => (
              <a href={c.href} class={`btn btn--${c.variant}`}>{c.label}</a>
            ))}
          </div>
        )}
      </div>

      <!-- Columna derecha: chips como cards + stats -->
      {hasRight && (
        <div class="page-hero-std__right">
          {chips && chips.length > 0 && (
            <div class="page-hero-std__feature-cards">
              {chips.map(c => (
                <div class="page-hero-std__feature-card">
                  <span class="page-hero-std__feature-dot"></span>
                  <span class="page-hero-std__feature-text">{c.label}</span>
                </div>
              ))}
            </div>
          )}
          {stats && stats.length > 0 && (
            <div class="page-hero-std__stats-grid">
              {stats.map(s => (
                <div class="page-hero-std__stat">
                  <span class="page-hero-std__stat-value">{s.value}</span>
                  <span class="page-hero-std__stat-label">{s.label}</span>
                </div>
              ))}
            </div>
          )}
        </div>
      )}

    </div>
  </div>
</section>
