---
// PageHero.astro — Hero único y homologado de todo el sitio (2026-09-28).
// Estructura fija: eyebrow → H1 → descripción (columna izquierda) + dos párrafos
// SEO en texto plano (columna derecha). Fondo de color sólido, sin botones,
// sin métricas y sin caja/marco en la columna derecha.
//
//   title   admite HTML si titleHtml = true (usar <span> para el acento de color).
//   desc2   párrafos de la columna derecha separados por "||" (admite <strong>).

export interface Props {
  eyebrow?: string;
  title: string;
  titleHtml?: boolean;
  desc: string;
  desc2?: string;
  id?: string;
}

const { eyebrow, title, titleHtml = false, desc, desc2, id = "hero-title" } = Astro.props;
const paras = (desc2 ?? "").split("||").map((p) => p.trim()).filter(Boolean);
---

<section class="page-hero-std" aria-labelledby={id}>
  <div class="container">
    <div class={`page-hero-std__inner${paras.length ? "" : " page-hero-std__inner--solo"}`}>
      <div class="page-hero-std__left">
        {eyebrow && <p class="page-hero-std__eyebrow">{eyebrow}</p>}
        {titleHtml
          ? <h1 id={id} class="page-hero-std__title" set:html={title} />
          : <h1 id={id} class="page-hero-std__title">{title}</h1>}
        <p class="page-hero-std__desc">{desc}</p>
      </div>
      {paras.length > 0 && (
        <div class="page-hero-std__right">
          {paras.map((p) => <p set:html={p} />)}
        </div>
      )}
    </div>
  </div>
</section>
