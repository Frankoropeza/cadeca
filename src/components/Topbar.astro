---
// Topbar.astro — Barra superior de contacto.
// Los canales salen de src/data/contacto.ts; un canal sin dato no se muestra.
import { CONTACTO, HAS_TEL, HAS_WA, contactoHref } from "@/data/contacto";

export interface Props {
 ctaText?:  string;
 ctaHref?:  string;
 tagline?:  string;
}

const {
 ctaText  = "Cotizar ahora",
 ctaHref  = "/cotizar/",
 tagline  = "Cajas de cartón para empresas · CDMX y Estado de México",
} = Astro.props;
---

<div class="topbar" role="complementary" aria-label="Información de contacto">
 <div class="container">

 {(HAS_TEL || HAS_WA) && (
 <div class="topbar__mobile-info">
 {HAS_TEL && <a href={`tel:+${CONTACTO.telefono}`}>Tel: {CONTACTO.telefonoVisible}</a>}
 {HAS_TEL && HAS_WA && <span class="topbar__separator">|</span>}
 {HAS_WA && <a href={contactoHref()} target="_blank" rel="noopener">WhatsApp</a>}
 </div>
 )}

 <div class="topbar__left">
 <span class="topbar__label">Cajas de Cartón CDMX</span>
 {HAS_TEL && (<><span class="topbar__separator">|</span><a href={`tel:+${CONTACTO.telefono}`}>Tel: {CONTACTO.telefonoVisible}</a></>)}
 {CONTACTO.horario && (<><span class="topbar__separator">|</span><span>{CONTACTO.horario}</span></>)}
 {HAS_WA && (<><span class="topbar__separator">|</span><a href={contactoHref()} target="_blank" rel="noopener">WhatsApp</a></>)}
 </div>

 <div class="topbar__right">
 <span>{tagline}</span>
 <a href={ctaHref} class="topbar__cta">{ctaText}</a>
 </div>

 </div>
</div>
