---
// IndustryCard.astro — Tarjeta de nicho / industria
export interface Props {
  img:       string;
  title:     string;
  desc:      string;
  href:      string;
  linkText?: string;
}

const {
  img,
  title,
  desc,
  href,
  linkText = "Ver soluciones",
} = Astro.props;
---

<article class="industry-card">
  <div class="industry-card__img-wrapper">
    <img src={img} alt={title} class="industry-card__img" width="400" height="260" loading="lazy" />
  </div>
  <h3 class="industry-card__title">{title}</h3>
  <p class="industry-card__desc">{desc}</p>
  <a href={href} class="industry-card__link">{linkText} &rarr;</a>
</article>
