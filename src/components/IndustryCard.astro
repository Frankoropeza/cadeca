---
// IndustryCard.astro — Tarjeta de sector/industria compacta 4 columnas
export interface Props {
  icon:      string;
  tag:       string;
  title:     string;
  desc:      string;
  href:      string;
  linkText?: string;
  accent?:   string;
}

const {
  icon,
  tag,
  title,
  desc,
  href,
  linkText = "Ver soluciones",
  accent = "#E05800",
} = Astro.props;
---

<a href={href} class="ind-card" style={`--ind-accent: ${accent}`}>
  <div class="ind-card__top">
    <span class="ind-card__icon" aria-hidden="true">{icon}</span>
    <span class="ind-card__tag">{tag}</span>
  </div>
  <h3 class="ind-card__title">{title}</h3>
  <p class="ind-card__desc">{desc}</p>
  <span class="ind-card__cta">{linkText} →</span>
</a>
