const title       = "Cajas de Archivo y Almacenaje CDMX | Archivo Muerto, Industrial, Apilable | CADECA";
const description = "Cajas de archivo y almacenaje en CDMX. Archivo muerto, almacén industrial, apilables triple pared y mudanza. Guarda documentos, inventario y expedientes. Entrega 24-48 hrs. Cotiza gratis.";
const WHATSAPP    = "5255XXXXXXXX";

