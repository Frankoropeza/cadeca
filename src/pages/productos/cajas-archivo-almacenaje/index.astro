    imgAlt:  "Cajas de mudanza y archivo con asas reforzadas en CDMX — CADECA",
    href:    "/catalogo/cajas-archivo-almacenaje/mudanza-archivo",
    tags: [
      { label: "Asas troqueladas",    href: "/catalogo/cajas-archivo-almacenaje/mudanza-archivo" },
      { label: "Doble y triple pared", href: "/catalogo/cajas-archivo-almacenaje/mudanza-archivo" },
