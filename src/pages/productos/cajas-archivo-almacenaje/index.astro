    imgAlt:  "Cajas apilables triple pared resistentes en CDMX — CADECA",
    href:    "/catalogo/cajas-archivo-almacenaje/apilable-resistente",
    tags: [
      { label: "Triple pared",         href: "/catalogo/cajas-archivo-almacenaje/apilable-resistente" },
