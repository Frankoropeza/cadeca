const subcategorias = [
  {
    title:   "Archivo Muerto Tamaño Oficio",
    desc:    "Cajas de archivo muerto tamaño oficio con tapa y agarraderas laterales. Ideales para expedientes legales, contables y administrativos. Corrugado resistente para apilamiento prolongado en bodega.",
    imgSrc:  "/img/catalogo/laminas-carton-corrugado-triple-cdmx.avif",
    imgAlt:  "Cajas de archivo muerto tamaño oficio en CDMX — CADECA",
    href:    "/catalogo/cajas-archivo-almacenaje/archivo-muerto-oficio",
    tags: [
      { label: "Tamaño oficio",       href: "/catalogo/cajas-archivo-almacenaje/archivo-muerto-oficio" },
      { label: "Con tapa y asas",     href: "/catalogo/cajas-archivo-almacenaje/archivo-muerto-oficio" },
      { label: "Apilable en bodega",  href: "/catalogo/cajas-archivo-almacenaje/archivo-muerto-oficio" },
    ],
    btnText: "Ver Archivo Muerto Oficio",
  },
  {
    title:   "Documentos Tamaño Carta",
    desc:    "Cajas para documentos tamaño carta con acceso frontal o superior. Perfectas para oficinas, consultorios y despachos que necesitan organizar papelería, facturas y correspondencia.",
