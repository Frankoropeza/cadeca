    tags: [
      { label: "Tamaño carta",        href: "/catalogo/cajas-archivo-almacenaje/documentos-carta" },
      { label: "Acceso frontal",       href: "/catalogo/cajas-archivo-almacenaje/documentos-carta" },
      { label: "Oficina y despacho",   href: "/catalogo/cajas-archivo-almacenaje/documentos-carta" },
    ],
    btnText: "Ver Documentos Carta",
  },
  {
    title:   "Almacén Industrial",
    desc:    "Cajas de almacenaje industrial para bodegas, centros de distribución y almacenes. Alta resistencia al apilamiento vertical, diseñadas para almacenamiento prolongado de inventario y mercancía.",
    imgSrc:  "/img/catalogo/laminas-carton-corrugado-simple-cdmx.avif",
    imgAlt:  "Cajas de almacén industrial para bodegas en CDMX — CADECA",
    href:    "/catalogo/cajas-archivo-almacenaje/almacen-industrial",
