    imgAlt:  "Cajas blíster farmacéutica flauta E para medicamentos en CDMX — CADECA",
    href:    "/catalogo/cajas-farmaceutica-cosmetica/blister-farmaceutica",
    tags: [
      { label: "Flauta E · Plegadiza",   href: "/catalogo/cajas-farmaceutica-cosmetica/blister-farmaceutica" },
      { label: "NOM-072 compliant",       href: "/catalogo/cajas-farmaceutica-cosmetica/blister-farmaceutica" },
