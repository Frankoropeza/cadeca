    imgAlt:  "Cajas línea producción pharma alta velocidad industrial en CDMX — CADECA",
    href:    "/catalogo/cajas-farmaceutica-cosmetica/linea-produccion-pharma",
    tags: [
      { label: "Alta velocidad",             href: "/catalogo/cajas-farmaceutica-cosmetica/linea-produccion-pharma" },
