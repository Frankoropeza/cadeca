const pasos = [
  { num: 1, title: "Cuéntanos tu producto",     desc: "Medicamento, cosmético, suplemento o dispositivo médico. Con eso definimos el tipo de caja, material y acabados necesarios para tu industria." },
  { num: 2, title: "Cotiza en 2 horas",          desc: "Enviamos precio, especificaciones técnicas y opciones de acabado por WhatsApp. Incluimos asesoría sobre cumplimiento normativo NOM sin costo." },
  { num: 3, title: "Pedido desde 200 pzas",      desc: "Mínimos accesibles para marcas en desarrollo y laboratorios pequeños. Precios de mayoreo desde 500 piezas con descuentos escalonados por volumen." },
  { num: 4, title: "Entrega en tu laboratorio",  desc: "3-5 días hábiles en CDMX y área metropolitana. Entregas coordinadas con tu calendario de producción, directo a tu laboratorio o centro de distribución." },
];

const testimonios = [
  {
    initials: "DH",
    name:     "Dr. Daniel H.",
    role:     "Director de Operaciones — Laboratorio Farmacéutico, Azcapotzalco, CDMX",
    text:     "Llevamos 2 años trabajando con CADECA para nuestras cajas blíster. La calidad de impresión cumple NOM-072, las tolerancias dimensionales son exactas para nuestras encartonadoras y nunca hemos tenido un rechazo de COFEPRIS por empaque. Altamente recomendados.",
  },
  {
    initials: "MC",
    name:     "Mariana C.",
    role:     "Fundadora — Marca de Skincare Premium, Polanco, CDMX",
    text:     "CADECA entendió que para una marca de cosmética premium el empaque ES el producto. El acabado soft touch con hot stamping dorado que nos hicieron es espectacular. Mis clientas fotografían la caja antes de abrirla — eso es branding que funciona.",
  },
  {
    initials: "JP",
    name:     "José P.",
    role:     "Gerente de Logística — Distribuidora Farmacéutica, Naucalpan, Edo. Méx.",
    text:     "Compramos 5,000 cajas mensuales de doble pared para distribución de medicamentos. CADECA cumple en tiempo, calidad y precio. Las cajas resisten el apilamiento de 6 niveles en tarima y mantienen integridad en cadena de frío. Son nuestro proveedor fijo.",
  },
];

const faqs = [
  {
    id: "fc1",
    question: "¿Qué norma NOM aplica para cajas de medicamentos en México?",
    answer: "La <strong>NOM-072-SSA1-2012</strong> establece los requisitos de etiquetado de medicamentos de venta libre y con receta. Esto incluye información obligatoria que debe aparecer en el empaque primario y secundario: denominación genérica, forma farmacéutica, cantidad, lote, caducidad, laboratorio fabricante y datos de COFEPRIS. En CADECA producimos cajas con todos estos elementos correctamente impresos y verificados antes de entrega.",
  },
  {
    id: "fc2",
    question: "¿Qué acabados especiales ofrecen para cajas de cosmética premium?",
    answer: "Para cosmética premium ofrecemos: <strong>Barniz UV selectivo</strong> (brillo en zonas específicas), <strong>hot stamping</strong> (dorado, plateado, oro rosa), <strong>laminado soft touch</strong> (textura aterciopelada), <strong>embossing/debossing</strong> (relieve y bajo relieve), <strong>ventanas de acetato</strong> y <strong>foil holográfico</strong>. Todos los acabados son combinables entre sí. El pedido mínimo para acabados especiales es de 200 piezas.",
  },
  {
    id: "fc3",
    question: "¿Cuál es el pedido mínimo para cajas farmacéuticas?",
    answer: "El pedido mínimo es de <strong>200 piezas</strong> para cajas farmacéuticas y de cosmética. Para pedidos de 500+ piezas aplican precios de mayoreo. Para 1,000+ piezas tenemos precios especiales por volumen. Laboratorios con consumo recurrente pueden acceder a contratos anuales con precios fijos y entregas programadas.",
  },
  {
    id: "fc4",
    question: "¿Las cajas son compatibles con encartonadoras automáticas?",
    answer: "Sí. Nuestras cajas para líneas de producción pharma están fabricadas con <strong>tolerancias dimensionales de +/- 0.5mm</strong>, pre-doblado preciso y corte limpio para alimentación automática en encartonadoras de alta velocidad. Trabajamos con las especificaciones técnicas de tu máquina para garantizar compatibilidad al 100%. Enviamos muestras de prueba antes de la producción completa.",
  },
  {
    id: "fc5",
    question: "¿Cumplen con los requisitos de COFEPRIS para empaque farmacéutico?",
    answer: "Sí. Nuestras cajas farmacéuticas cumplen con los requerimientos de <strong>COFEPRIS</strong> en cuanto a materiales seguros (libres de metales pesados), impresión legible e indeleble de información regulatoria, y trazabilidad de lote. Utilizamos tintas certificadas para contacto indirecto con alimentos y medicamentos. Podemos proporcionar certificados de materiales y fichas técnicas para auditorías.",
  },
  {
    id: "fc6",
    question: "¿Ofrecen cajas con cumplimiento NOM-051 para suplementos alimenticios?",
    answer: "Sí. Para suplementos alimenticios producimos cajas con <strong>etiquetado frontal NOM-051</strong> completo: sellos de advertencia (exceso de calorías, sodio, grasas, azúcares), tabla nutricional, lista de ingredientes y declaración de alérgenos. Nuestro equipo de diseño verifica que la información cumpla con la norma antes de enviar a producción, evitando rechazos y reprocesos costosos.",
  },
];

const faqItems = faqs.map(f => ({ question: f.question, answer: f.answer }));
const breadcrumbs = [
  { name: "Inicio", href: "/" },
  { name: "Productos", href: "/productos" },
  { name: "Cajas Farmacéutica y Cosmética" },
];
---

<PageLayout
  title={title}
  description={description}
  schema={productSchema}
  whatsapp={WHATSAPP}
  faqItems={faqItems}
  breadcrumbs={breadcrumbs}
>

  <!-- HERO -->
    <!-- Breadcrumb -->
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/productos">Productos</a></li>
      <li><span class="current">Cajas Farmacéutica y Cosmética</span></li>
      </ol>
    </div>
  </div>


  <!-- Banner catálogo técnico -->
  <div style="background:var(--color-secondary);padding:1rem 0;text-align:center;">
    <div class="container" style="display:flex;align-items:center;justify-content:center;gap:1rem;flex-wrap:wrap;">
      <span style="color:rgba(255,255,255,0.8);font-size:0.85rem;">¿Necesitas specs técnicas, fichas de materiales y cumplimiento NOM?</span>
      <a href="/catalogo/cajas-farmaceutica-cosmetica" style="background:var(--color-primary);color:#fff;padding:0.4rem 1rem;border-radius:0.5rem;font-size:0.8rem;font-weight:700;text-decoration:none;">Ver ficha técnica completa →</a>
    </div>
  </div>

  <section class="page-hero" aria-labelledby="prod-pharma-title">
    <div class="container">
      <div class="page-hero__inner">
        <div class="page-hero__content">
          <p class="page-hero__badge">Blíster · Cosmética Premium · Distribuidora · Suplementos · Línea Pharma</p>
          <h1 id="prod-pharma-title" class="page-hero__title">
            Cajas para Industria<br><span>Farmacéutica y Cosmética en CDMX</span>
          </h1>
          <p class="page-hero__desc">
            Empaque especializado para laboratorios farmacéuticos, marcas de cosmética premium, distribuidoras y líneas de producción automatizadas. Cumplimiento NOM-072, acabados especiales y entregas en 3-5 días hábiles en CDMX y Estado de México. Desde 200 piezas.
          </p>
          <div class="page-hero__ctas">
            <a href="#cotizar"       class="btn btn--primary">Cotizar Ahora</a>
            <a href="#subcategorias" class="btn btn--outline">Ver Categorías</a>
          </div>
        </div>
          <div class="page-hero__stat">
            <span class="page-hero__stat-value">3-5 días</span>
            <span class="page-hero__stat-label">Entrega CDMX</span>
          </div>
          <div class="page-hero__stat">
            <span class="page-hero__stat-value">NOM-072</span>
            <span class="page-hero__stat-label">Cumplimiento pharma</span>
          </div>
          <div class="page-hero__stat">
            <span class="page-hero__stat-value">Premium</span>
            <span class="page-hero__stat-label">Acabados especiales</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">

    <!-- DETALLE DEL PRODUCTO -->
    <section class="prod-detail" aria-labelledby="detalle-pharma-title">
      <div class="container">
        <div class="prod-detail__inner">
          <div class="prod-detail__img-wrap">
            <img
              src="/img/catalogo/cajas-carton-personalizadas-full-color-cmyk-cdmx.avif"
              alt="Cajas de cartón para industria farmacéutica y cosmética en CDMX — CADECA"
              class="prod-detail__img"
              width="900" height="560"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          <div class="prod-detail__content">
            <span class="prod-detail__label">El empaque que cumple la norma y eleva tu marca</span>
            <h2 id="detalle-pharma-title" class="section-header__title" style="margin:0">
              Cajas Farmacéuticas y Cosméticas: Cumplimiento Normativo y Acabados Premium
            </h2>
            <p class="prod-detail__intro">
              La industria farmacéutica y cosmética requiere empaque que combine cumplimiento regulatorio estricto con presentación impecable. En CADECA fabricamos cajas que cumplen NOM-072 para medicamentos, NOM-051 para suplementos y ofrecemos acabados premium para marcas de cosmética que necesitan que su empaque comunique calidad desde el primer contacto visual.
            </p>
            <div>
              <p class="prod-detail__specs-title">Especificaciones técnicas</p>
              <div class="prod-detail__specs-grid">
                <div class="prod-detail__spec">
                  <span class="prod-detail__spec-label">Tipo de caja</span>
                  <span class="prod-detail__spec-value">Plegadiza · Rígida · Corrugado</span>
                </div>
                <div class="prod-detail__spec">
                  <span class="prod-detail__spec-label">Flauta</span>
                  <span class="prod-detail__spec-value">E (blíster) · BC (distribución)</span>
                </div>
                <div class="prod-detail__spec">
                  <span class="prod-detail__spec-label">Normatividad</span>
                  <span class="prod-detail__spec-value">NOM-072 · NOM-051 · COFEPRIS</span>
                </div>
                <div class="prod-detail__spec">
                  <span class="prod-detail__spec-label">Acabados</span>
                  <span class="prod-detail__spec-value">UV · Hot stamping · Soft touch</span>
                </div>
                <div class="prod-detail__spec">
                  <span class="prod-detail__spec-label">Material</span>
                  <span class="prod-detail__spec-value">SBS · Kraft · Caple · Couché</span>
                </div>
                <div class="prod-detail__spec">
                  <span class="prod-detail__spec-label">Impresión</span>
                  <span class="prod-detail__spec-value">1 color a full color CMYK</span>
                </div>
                <div class="prod-detail__spec">
                  <span class="prod-detail__spec-label">Pedido mínimo</span>
                  <span class="prod-detail__spec-value">200 piezas</span>
                </div>
                <div class="prod-detail__spec">
                  <span class="prod-detail__spec-label">Entrega CDMX</span>
                  <span class="prod-detail__spec-value">3-5 días hábiles</span>
                </div>
              </div>
            </div>
            <div class="prod-detail__actions">
              <a href="#cotizar"                      class="btn btn--primary">Solicitar Cotización</a>
              <a href={`https://wa.me/${WHATSAPP}`}
                 target="_blank" rel="noopener"      class="btn btn--outline">WhatsApp Directo</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SUBCATEGORÍAS -->
    <section class="products" id="subcategorias" aria-labelledby="subcats-pharma-title">
      <div class="container">
        <SectionHeader
          id="subcats-pharma-title"
          twoCol
          title="Cajas para Cada Segmento Farmacéutico y Cosmético"
          subtitle="Blíster, cosmética premium, distribución, suplementos y líneas de producción automatizadas. Soluciones específicas para cada necesidad."
          link={{ text: "Ver catálogo completo", href: "/catalogo/cajas-farmaceutica-cosmetica" }}
        >
          <p>Cada segmento de la industria farmacéutica y cosmética tiene requerimientos únicos de empaque. Un blíster de medicamento necesita cumplir NOM-072 al pie de la letra. Una crema de skincare premium necesita un empaque que justifique su precio. Una distribuidora necesita resistencia para palletizado. En CADECA cubrimos todos estos requerimientos.</p>
          <p>Fabricamos desde 200 piezas con calidad consistente y cumplimiento normativo verificado. Para laboratorios con consumo recurrente ofrecemos contratos anuales con precios fijos y entregas programadas.</p>
        </SectionHeader>
        <div class="products__grid">
          {subcategorias.map(p => <ProductCard {...p} />)}
        </div>
      </div>
