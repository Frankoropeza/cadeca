const title       = "Cajas para Industria Farmacéutica y Cosmética CDMX | Blíster, Cosmética Premium | CADECA";
const description = "Cajas de cartón para industria farmacéutica y cosmética en CDMX. Blíster farmacéutica, cosmética premium, suplementos, líneas de producción pharma. Cumplimiento NOM-072. Desde 200 piezas, entrega 3-5 días. Cotiza gratis.";
