      { label: "NOM-051 compliant",         href: "/catalogo/cajas-farmaceutica-cosmetica/suplementos-nutricion" },
      { label: "Etiquetado frontal",         href: "/catalogo/cajas-farmaceutica-cosmetica/suplementos-nutricion" },
      { label: "Desde 200 pzas",            href: "/catalogo/cajas-farmaceutica-cosmetica/suplementos-nutricion" },
    ],
    btnText: "Ver Suplementos y Nutrición",
  },
  {
    title:   "Línea Producción Pharma — Alta Velocidad",
    desc:    "Cajas diseñadas para líneas de producción automatizadas de alta velocidad. Tolerancias dimensionales estrictas, pre-doblado y compatibilidad con encartonadoras industriales.",
