      { label: "Doble pared BC",            href: "/catalogo/cajas-farmaceutica-cosmetica/distribuidora-farmacia" },
      { label: "Cadena de frío",             href: "/catalogo/cajas-farmaceutica-cosmetica/distribuidora-farmacia" },
