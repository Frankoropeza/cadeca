---
import PageLayout from "@/layouts/PageLayout.astro";

const title  = "Página no encontrada | CADECA — Cajas de Cartón CDMX";
const description = "La página que buscas no existe o fue movida. Explora nuestro catálogo de cajas de cartón corrugado en CDMX y Estado de México.";
---

<PageLayout title={title} description={description}>
 <main id="contenido-principal">
 <section class="error-404">
 <div class="container">
 <div class="error-404__inner">
 <span class="error-404__code">404</span>
 <h1 class="error-404__title">Página no encontrada</h1>
 <p class="error-404__desc">
 Lo sentimos, la página que buscas no existe o fue movida.
 Pero seguro encontramos la caja perfecta para ti.
 </p>
 <div class="error-404__actions">
 <a href="/" class="btn btn--primary">Ir al inicio</a>
 <a href="/catalogo" class="btn btn--outline">Ver catálogo</a>
 <a href="/cotizar" class="btn btn--ghost">Cotizar ahora</a>
 </div>

 <div class="error-404__links">
 <h2 class="error-404__links-title">Páginas populares</h2>
 <ul class="error-404__links-list">
 <li><a href="/productos/cajas-corrugado-estandar">Cajas Corrugado Estándar</a></li>
 <li><a href="/productos/cajas-a-la-medida">Cajas a la Medida</a></li>
 <li><a href="/productos/cajas-personalizadas-logo">Personalizadas con Logo</a></li>
 <li><a href="/productos/cajas-para-ecommerce">Cajas para E-commerce</a></li>
 <li><a href="/productos/cajas-para-alimentos">Cajas para Alimentos</a></li>
 <li><a href="/zonas-de-servicio">Zonas de Servicio</a></li>
 <li><a href="/contacto">Contacto</a></li>
 </ul>
 </div>
 </div>
 </div>
 </section>
 </main>
</PageLayout>

