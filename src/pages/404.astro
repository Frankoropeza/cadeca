---
import PageLayout from "@/layouts/PageLayout.astro";
import { readFileSync } from "node:fs";

// Reglas con comodín de public/_redirects: GitHub Pages no las aplica, se resuelven aquí.
const dinamicas = readFileSync("public/_redirects", "utf8").split("\n")
  .map((l) => l.trim()).filter((l) => l && !l.startsWith("#"))
  .map((l) => l.split(/\s+/)).filter(([o]) => /[*:]/.test(o)).map(([o, d]) => [o, d]);

const title  = "Página no encontrada | CADECA — Cajas de Cartón CDMX";
const description = "La página que buscas no existe o fue movida. Explora nuestro catálogo de cajas de cartón corrugado en CDMX y Estado de México.";
---

<PageLayout title={title} description={description}>
 <script define:vars={{ dinamicas }}>
 (function () {
   var p = location.pathname;
   for (var i = 0; i < dinamicas.length; i++) {
     var nombres = [];
     var re = new RegExp("^" + dinamicas[i][0]
       .replace(/[.+?^${}()|[\]\\]/g, "\\$&")
       .replace(/\*/g, "(.*)")
       .replace(/:([a-z]+)/g, function (_, n) { nombres.push(n); return "([^/]+)"; }) + "$");
     var m = p.match(re);
     if (m) {
       var destino = dinamicas[i][1];
       nombres.forEach(function (n, k) { destino = destino.replace(":" + n, m[k + 1]); });
       location.replace(destino);
       return;
     }
   }
 })();
 </script>
 <main id="contenido-principal">
 <section class="error-404">
 <div class="container">
 <div class="error-404__inner">
 <span class="error-404__code">404</span>
 <h1 class="error-404__title">Página no encontrada</h1>
 <p class="error-404__desc">
 Lo sentimos, la página que buscas no existe o fue movida.
 Pero seguro encontramos la caja perfecta para ti.
 </p>
 <div class="error-404__actions">
 <a href="/" class="btn btn--primary">Ir al inicio</a>
 <a href="/catalogo/" class="btn btn--outline">Ver catálogo</a>
 <a href="/cotizar/" class="btn btn--ghost">Cotizar ahora</a>
 </div>

 <div class="error-404__links">
 <h2 class="error-404__links-title">Páginas populares</h2>
 <ul class="error-404__links-list">
 <li><a href="/catalogo/cajas-corrugado-estandar/">Cajas Corrugado Estándar</a></li>
 <li><a href="/catalogo/cajas-a-la-medida/">Cajas a la Medida</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Personalizadas con Logo</a></li>
 <li><a href="/catalogo/cajas-para-ecommerce/">Cajas para E-commerce</a></li>
 <li><a href="/catalogo/cajas-para-alimentos/">Cajas para Alimentos</a></li>
 <li><a href="/zonas-de-servicio/">Zonas de Servicio</a></li>
 <li><a href="/contacto/">Contacto</a></li>
 </ul>
 </div>
 </div>
 </div>
 </section>
 </main>
</PageLayout>

