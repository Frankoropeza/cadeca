---
import { CONTACTO, HAS_TEL, HAS_WA, HAS_EMAIL, contactoHref } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import PageHero  from "@/components/PageHero.astro";

const title  = "Contacto | Cajas de Cartón en CDMX | CADECA";
const description = "Contacta a CADECA para cotizar cajas de cartón corrugado en CDMX y Estado de México: estándar, a la medida, personalizadas con logo y láminas.";

const breadcrumbs = [
 { name: "Inicio", href: "/" },
 { name: "Contacto" },
];

// Canales activos: sólo los que tienen dato en src/data/contacto.ts
const canales = [
 {
 titulo: "Formulario de cotización",
 desc: "La vía recomendada: indícanos tipo de caja, medidas y cantidad, y te enviamos precio y tiempo de entrega.",
 cta: "Ir al formulario",
 href: "/cotizar/",
 externo: false,
 destaca: true,
 },
 ...(HAS_WA ? [{
 titulo: "WhatsApp",
 desc: "Envíanos medidas y cantidad por mensaje.",
 cta: "Escribir por WhatsApp",
 href: contactoHref("Hola, quiero cotizar cajas de cartón"),
 externo: true,
 destaca: false,
 }] : []),
 ...(HAS_TEL ? [{
 titulo: "Teléfono",
 desc: CONTACTO.horario ? `Atención: ${CONTACTO.horario}.` : "Atención en horario hábil.",
 cta: `Llamar al ${CONTACTO.telefonoVisible}`,
 href: `tel:+${CONTACTO.telefono}`,
 externo: false,
 destaca: false,
 }] : []),
 ...(HAS_EMAIL ? [{
 titulo: "Correo electrónico",
 desc: "Para cotizaciones formales y pedidos con orden de compra.",
 cta: CONTACTO.email,
 href: `mailto:${CONTACTO.email}`,
 externo: false,
 destaca: false,
 }] : []),
];
---

<PageLayout
 title={title}
 description={description}
 pageType="page"
 breadcrumbs={breadcrumbs}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><span class="current">Contacto</span></li>
 </ol>
 </div>
 </div>

 <PageHero
 eyebrow="Cotizaciones para empresas y negocios"
 titleHtml={true}
 title="Contacto y <span>Cotizaciones</span>"
 desc="Te ayudamos a elegir y cotizar la caja de cartón correcta para tu producto: medidas, tipo de corrugado, impresión y volumen."
 desc2="Atendemos a tiendas en línea, comercios, oficinas y empresas industriales de la Ciudad de México y el Estado de México. Para darte una cotización precisa necesitamos saber qué vas a empacar, sus medidas y peso, y cuántas cajas requieres al mes.||Si ya usas una caja y quieres mejorarla o bajar su costo, descríbela en el formulario: medidas exteriores, tipo de cartón y el problema que tienes (se aplasta, se rompe en el envío, sobra espacio)."
 chips={[
 { label: "Cotización sin compromiso" },
 { label: "Asesoría para elegir la caja" },
 { label: "CDMX y Estado de México" },
 ]}
 ctas={[
 { href: "/cotizar/", label: "Solicitar cotización", variant: "primary" },
 ]}
 />

 <main id="contenido-principal" role="main">

 <section class="contact-canales" aria-labelledby="canales-title">
 <div class="container">
 <h2 id="canales-title" class="sr-only">Canales de contacto</h2>
 <div class="contact-canales__grid">
 {canales.map(c => (
 <div class={`contact-canal${c.destaca ? " contact-canal--destaca" : ""}`}>
 <h3 class="contact-canal__titulo">{c.titulo}</h3>
 <p class="contact-canal__desc">{c.desc}</p>
 <a
 href={c.href}
 class={`btn ${c.destaca ? "btn--primary" : "btn--outline"}`}
 {...(c.externo ? { target:"_blank", rel:"noopener" } : {})}
 >
 {c.cta}
 </a>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="contact-ubicacion" aria-labelledby="ubic-title">
 <div class="container">
 <h2 id="ubic-title" class="contact-ubicacion__title">Zona de Cobertura</h2>
 <div class="contact-ubicacion__grid">
 <div>
 <h3>Ciudad de México</h3>
 <p>Entregas en las 16 alcaldías. Consulta el detalle en <a href="/zonas-de-servicio/">zonas de servicio</a>.</p>
 <h3 style="margin-top:var(--spacing-lg)">Estado de México</h3>
 <p>Municipios del área metropolitana: Naucalpan, Tlalnepantla, Ecatepec, Cuautitlán Izcalli, Texcoco, Chalco, Ixtapaluca y Toluca, entre otros.</p>
 <h3 style="margin-top:var(--spacing-lg)">Resto de la República</h3>
 <p>Envíos por paquetería según volumen y destino; se cotizan por separado.</p>
 </div>
 <div>
 <h3>Antes de cotizar</h3>
 <ul>
 <li>Medidas del producto o de la caja actual (largo × ancho × alto, en cm)</li>
 <li>Peso aproximado del producto</li>
 <li>Cantidad por pedido y frecuencia de compra</li>
 <li>Si la caja lleva impresión (logo, colores)</li>
 <li>Uso: envío por paquetería, almacén, exportación o punto de venta</li>
 </ul>
 </div>
 </div>
 </div>
 </section>

 </main>

 <LeadCapture title="Solicita tu cotización" />

</PageLayout>
