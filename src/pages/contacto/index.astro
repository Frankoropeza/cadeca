---
import { CONTACTO, HAS_TEL, HAS_WA, HAS_EMAIL, contactoHref } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import PageHero  from "@/components/PageHero.astro";

const title  = "Contacto | Cajas de Cartón en CDMX | CADECA";
const description = "Contacta a CADECA para cotizar cajas de cartón corrugado en CDMX y Estado de México: estándar, a la medida, personalizadas con logo y láminas.";

const breadcrumbs = [
 { name: "Inicio", href: "/" },
 { name: "Contacto" },
];

// Canales activos: sólo los que tienen dato en src/data/contacto.ts
const canales = [
 {
 titulo: "Formulario de cotización",
 desc: "La vía recomendada: indícanos tipo de caja, medidas y cantidad, y te enviamos precio y tiempo de entrega.",
 cta: "Ir al formulario",
 href: "/cotizar/",
 externo: false,
 destaca: true,
 },
 ...(HAS_WA ? [{
 titulo: "WhatsApp",
 desc: "Envíanos medidas y cantidad por mensaje.",
 cta: "Escribir por WhatsApp",
 href: contactoHref("Hola, quiero cotizar cajas de cartón"),
 externo: true,
 destaca: false,
 }] : []),
 ...(HAS_TEL ? [{
 titulo: "Teléfono",
 desc: CONTACTO.horario ? `Atención: ${CONTACTO.horario}.` : "Atención en horario hábil.",
 cta: `Llamar al ${CONTACTO.telefonoVisible}`,
 href: `tel:+${CONTACTO.telefono}`,
 externo: false,
 destaca: false,
 }] : []),
 ...(HAS_EMAIL ? [{
 titulo: "Correo electrónico",
 desc: "Para cotizaciones formales y pedidos con orden de compra.",
 cta: CONTACTO.email,
 href: `mailto:${CONTACTO.email}`,
 externo: false,
 destaca: false,
 }] : []),
];
const faqsModulo = [
 { "question": "¿Qué datos necesito para cotizar cajas de cartón?", "answer": "Indica el tipo de caja, largo, ancho y alto, cantidad aproximada y zona de entrega. Si requiere impresión, añade el número de tintas y el archivo de diseño disponible; esos datos permiten revisar la estructura y preparar una cotización pertinente." },
 { "question": "¿Cómo se revisa una solicitud de cotización de cajas?", "answer": "La solicitud se revisa en horario hábil considerando medidas, cantidad, uso y características del cartón. Cuando hay varias medidas o especificaciones técnicas, se valida la información necesaria antes de confirmar precio, disponibilidad y condiciones de entrega." },
 { "question": "¿Pueden cotizar cajas de cartón para negocios pequeños?", "answer": "Se atienden empresas, negocios y emprendedores con necesidades de cajas estándar, a la medida o personalizadas. Comparte el volumen previsto y el uso de la caja para que la cotización contemple una opción adecuada a tu operación." },
 { "question": "¿Las cajas de cartón se pueden entregar fuera de CDMX?", "answer": "La cobertura principal comprende Ciudad de México y Estado de México. Si requieres entrega en otra ciudad, incluye el destino completo en el formulario para revisar la viabilidad logística y las condiciones aplicables al pedido." },
 { "question": "¿Qué información se requiere para imprimir cajas de cartón?", "answer": "Comparte las medidas de la caja, cantidad, número de tintas y el archivo o referencia visual disponible. También conviene indicar dónde debe ir el diseño y el uso del empaque, pues la superficie imprimible depende de la estructura elegida." }
];
---

<PageLayout
 faqItems={faqsModulo}
 title={title}
 description={description}
 pageType="page"
 breadcrumbs={breadcrumbs}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><span class="current">Contacto</span></li>
 </ol>
 </div>
 </div>

 <PageHero
 eyebrow="Contacto · Cotización de cajas"
 titleHtml={true}
 title="Contacto proveedor de cajas <span>de cartón</span>"
 desc="Contacto proveedor de cajas de cartón para elegir y cotizar el empaque de tu producto. Comparte medidas, tipo de corrugado, impresión y volumen para revisar alternativas."
 desc2="El contacto permite solicitar opciones para tiendas en línea, comercios, oficinas y empresas industriales. Para cotizar se requieren producto, medidas, peso y cantidad; con esa información se revisan cartón, flauta, ECT, impresión y estructura del empaque.||Para cotizar cajas de cartón, el producto, su peso y la estructura de empaque orientan la selección de cartón y ECT. Comparte dimensiones del artículo, peso unitario, cantidad de piezas por caja y necesidad de impresión; CADECA revisa los datos para <strong>cotizar cajas de cartón</strong>."
 />

 <main id="contenido-principal" role="main">

 <section class="contact-canales" aria-labelledby="canales-title">
 <div class="container">
 <h2 id="canales-title" class="sr-only">Canales de contacto</h2>
 <div class="contact-canales__grid">
 {canales.map(c => (
 <div class={`contact-canal${c.destaca ? " contact-canal--destaca" : ""}`}>
 <h3 class="contact-canal__titulo">{c.titulo}</h3>
 <p class="contact-canal__desc">{c.desc}</p>
 <a
 href={c.href}
 class={`btn ${c.destaca ? "btn--primary" : "btn--outline"}`}
 {...(c.externo ? { target:"_blank", rel:"noopener" } : {})}
 >
 {c.cta}
 </a>
 </div>
 ))}
 </div>
 </div>
 </section>

 <section class="contact-ubicacion" aria-labelledby="ubic-title">
 <div class="container">
 <h2 id="ubic-title" class="contact-ubicacion__title">Zona de Cobertura</h2>
 <div class="contact-ubicacion__grid">
 <div>
 <h3>Ciudad de México</h3>
 <p>Entregas en las 16 alcaldías. Consulta el detalle en <a href="/zonas-de-servicio/">zonas de servicio</a>.</p>
 <h3 style="margin-top:var(--spacing-lg)">Estado de México</h3>
 <p>Municipios del área metropolitana: Naucalpan, Tlalnepantla, Ecatepec, Cuautitlán Izcalli, Texcoco, Chalco, Ixtapaluca y Toluca, entre otros.</p>
 <h3 style="margin-top:var(--spacing-lg)">Resto de la República</h3>
 <p>Envíos por paquetería según volumen y destino; se cotizan por separado.</p>
 </div>
 <div>
 <h3>Antes de cotizar</h3>
 <ul>
 <li>Medidas del producto o de la caja actual (largo × ancho × alto, en cm)</li>
 <li>Peso aproximado del producto</li>
 <li>Cantidad por pedido y frecuencia de compra</li>
 <li>Si la caja lleva impresión (logo, colores)</li>
 <li>Uso: envío por paquetería, almacén, exportación o punto de venta</li>
 </ul>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqsModulo} tema="cotizaciones y contacto" />

</PageLayout>
