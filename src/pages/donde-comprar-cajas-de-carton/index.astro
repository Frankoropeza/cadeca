---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";

const title = "Dónde Comprar Cajas de Cartón | Guía de Compra | CADECA";
const description = "Dónde comprar cajas de cartón: compara proveedor, papelería, autoservicio y marketplace; conoce qué preguntar y cómo pedir una cotización a CADECA.";

const schema = {
  "@context": "https://schema.org", "@type": "WebPage",
  "@id": "https://cajas-de-carton.com/donde-comprar-cajas-de-carton/#webpage",
  "name": title, "url": "https://cajas-de-carton.com/donde-comprar-cajas-de-carton/", "description": description,
  "about": { "@id": "https://cajas-de-carton.com/#org" }, "isPartOf": { "@id": "https://cajas-de-carton.com/#website" }
};

const productos = [
  { code: "CAD-CS-11", title: "Caja Corrugado Chica Estándar", badge: "Formato pequeño", badgeColor: "orange", desc: "Ficha con cuatro medidas pequeñas, flautas B/E, ECT-32 y pedido de 50 piezas publicado.", imgSrc: "/img/catalogo/caja-chica-estandar-hero-cdmx.avif", imgAlt: "Caja de cartón chica estándar", href: "/catalogo/cajas-corrugado-estandar/caja-chica-estandar/", specs: [["Medidas", "10×10×10 a 25×20×15 cm"], ["ECT", "ECT-32"], ["Pedido", "50 piezas"]] },
  { code: "CAD-CM-01", title: "Cajas para Mudanza con Asas", badge: "Formato grande", badgeColor: "blue", desc: "Ficha con cinco tallas publicadas, doble corrugado BC y ECT-44 para mudanza.", imgSrc: "/img/catalogo/cajas-carton-mudanza-resistentes-cdmx.avif", imgAlt: "Cajas de cartón para mudanza", href: "/catalogo/cajas-corrugado-estandar/cajas-mudanza/", specs: [["Medidas", "30×25×25 a 50×50×90 cm"], ["ECT", "ECT-44"], ["Pedido", "Sin mínimo publicado"]] },
  { code: "CAD-PL-03", title: "Cajas Personalizadas Full Color", badge: "Personalizadas", badgeColor: "green", desc: "Ficha para comparar impresión full color, opciones de pared y pedido publicado de 200 piezas.", imgSrc: "/img/catalogo/cajas-carton-personalizadas-full-color-cmyk-cdmx.avif", imgAlt: "Caja de cartón personalizada full color", href: "/catalogo/cajas-personalizadas-logo/full-color/", specs: [["Impresión", "Full color CMYK"], ["ECT", "ECT-32 / ECT-44"], ["Pedido", "200 piezas"]] },
  { code: "CAD-AH-02", title: "Caja de Almacén Industrial Doble Pared", badge: "Almacén", badgeColor: "blue", desc: "Referencia de doble pared con medidas de 40×30×30 a 120×100×60 cm y pedido de 50 piezas.", imgSrc: "/img/catalogo/caja-almacen-industrial-triple-pared-cdmx.avif", imgAlt: "Caja industrial para almacén", href: "/catalogo/cajas-archivo-almacenaje/almacen-industrial/", specs: [["Medidas", "40×30×30 a 120×100×60 cm"], ["ECT", "ECT-44 / ECT-51"], ["Pedido", "50 piezas"]] }
];

const faqs = [
  { id: "comprar-1", question: "¿Dónde venden cajas de cartón en pocas piezas?", answer: "Para una necesidad inmediata y de pocas piezas, suelen ser útiles las papelerías, tiendas de autoservicio y puntos de venta de material de empaque. Revisa la medida, el estado del cartón y si la caja corresponde al peso de tu producto." },
  { id: "comprar-2", question: "¿Dónde comprar cajas de cartón para un negocio?", answer: "Para pedidos con medida, especificación o volumen definido, un proveedor o distribuidor permite solicitar una cotización con SKU, cantidad, ECT, flauta y requisitos de entrega. CADECA atiende solicitudes de empresas y negocios mediante su catálogo y formulario de cotización." },
  { id: "comprar-3", question: "¿Qué debo preguntar antes de comprar cajas?", answer: "Pregunta por medida interior, tipo de pared, flauta, ECT, cantidad mínima, condición de entrega y si la especificación queda escrita en la cotización. También confirma cómo revisarás dimensiones y estado del pedido al recibirlo." },
  { id: "comprar-4", question: "¿Conviene comprar cajas en un marketplace?", answer: "Un marketplace puede servir para comparar disponibilidad o resolver cantidades pequeñas, pero antes de comprar verifica las dimensiones, la resistencia publicada, el número de piezas y el costo del envío. Para una medida o especificación particular, pide una cotización técnica." },
  { id: "comprar-5", question: "¿Cómo cotizo cajas de cartón con CADECA?", answer: "Comparte el producto que vas a empacar, largo por ancho por alto requeridos, peso, tipo de protección, cantidad y ficha de referencia si ya identificaste una. Puedes usar el formulario de esta página o la página de cotización." }
];
---

<PageLayout title={title} description={description} schema={schema}
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Dónde comprar cajas de cartón" }]}
  faqItems={faqs.map(({ question, answer }) => ({ question, answer }))}>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación"><div class="container"><ol><li><a href="/">Inicio</a></li><li><span class="current">Dónde comprar cajas de cartón</span></li></ol></div></div>
  <PageHero eyebrow="Guía · Compra de cajas" title="Dónde comprar cajas de <span>cartón</span>" desc="Dónde comprar cajas de cartón depende de cantidad, medidas y especificación. Para pedidos con volumen o requerimientos técnicos, compara una cotización de proveedor o distribuidor." desc2="Quien busca <strong>cajas de cartón cerca de mí</strong> debe definir primero medida interior, peso, pared, flauta, ECT y cantidad. Dos cajas con el mismo nombre pueden resolver necesidades distintas; la ficha técnica y la cotización ayudan a comparar la opción para cada uso.||CADECA surte como proveedor con talleres aliados. Indica medidas, cantidad, uso y zona de entrega para revisar la <strong>venta de cajas de cartón</strong>; te asesoramos para elegir la caja disponible." />
  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="opciones-title"><div class="container"><div class="sku-detail__content"><h2 id="opciones-title" class="sku-detail__title">Opciones para comprar según tu necesidad</h2><p>Las papelerías, tiendas de autoservicio y comercios de empaque pueden ser una opción cuando necesitas pocas cajas y puedes elegir una medida disponible en el momento. Son útiles para una prueba, una mudanza doméstica o una reposición puntual. Antes de llevarlas, mide la caja armada, revisa que no tenga humedad o golpes y confirma que el cartón soporte el peso previsto.</p><p>Los marketplaces amplían la comparación de presentaciones y cantidades. Su ventaja es la variedad visible, pero la publicación debe revisarse con cuidado: cuántas piezas incluye, qué medida está informada, si habla de dimensión interior o exterior y cuál es la resistencia. Una caja económica que no coincide con el producto puede exigir más relleno o generar una segunda compra.</p><p>Para una operación de negocio, un proveedor o distribuidor como CADECA es una opción cuando necesitas volumen, una medida determinada o una ficha técnica. El catálogo permite empezar con un SKU existente y el formulario de <a href="/cotizar/">cotización</a> sirve para compartir la necesidad. Si ninguna ficha coincide, revisa la categoría de <a href="/catalogo/cajas-a-la-medida/">cajas a la medida</a> antes de pedir una alternativa.</p></div></div></section>
    <section id="fichas" style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" aria-labelledby="fichas-title"><div class="container"><h2 id="fichas-title" class="section-header__title">Fichas para iniciar una solicitud</h2><p class="section-header__subtitle">Estas referencias existentes ayudan a comunicar el formato que buscas al momento de cotizar.</p><div class="sku-grid">{productos.map((p) => <article class="sku-card"><div class="sku-card__img-wrap"><img src={p.imgSrc} alt={p.imgAlt} class="sku-card__img" width="640" height="480" loading="lazy" decoding="async" /><span class="sku-card__code">{p.code}</span><span class={`sku-card__badge sku-card__badge--${p.badgeColor}`}>{p.badge}</span></div><div class="sku-card__body"><h3 class="sku-card__name">{p.title}</h3><p class="sku-card__desc">{p.desc}</p><div class="sku-card__specs">{p.specs.map(([label, value]) => <div><span class="sku-card__spec-label">{label}</span><span class="sku-card__spec-value">{value}</span></div>)}</div><div class="sku-card__footer"><a class="btn btn--primary" href={p.href}>Ver ficha técnica</a></div></div></article>)}</div></div></section>
    <section class="sku-detail" aria-labelledby="preguntar-title"><div class="container"><div class="sku-detail__content"><h2 id="preguntar-title" class="sku-detail__title">Qué preguntar al proveedor antes de decidir</h2><p>Pide que la cotización identifique la medida interna o externa, la pared, la flauta, el ECT y la cantidad. Agrega el peso por caja, la necesidad de apilamiento, si el producto es frágil y la zona de entrega. Así podrás comparar alternativas equivalentes y no sólo el nombre comercial de una caja.</p><p>La <a href="/blog/como-elegir-proveedor-cajas-carton-cdmx/">guía para elegir proveedor</a> desarrolla criterios como ficha técnica, cantidad mínima, personalización y condiciones comerciales. Úsala como lista de preguntas, pero verifica los datos específicos de tu pedido directamente en la cotización que recibas.</p><p>Al recibir cajas, revisa una muestra antes de incorporarla a la operación. La <a href="/blog/checklist-control-calidad-cajas-carton-proveedor/">checklist de control de calidad</a> propone confirmar dimensiones interiores, espesor, pegado, humedad, cantos y estado de la impresión cuando aplique. Guardar la ficha y la cotización junto con esa revisión facilita detectar diferencias entre lo solicitado y lo recibido.</p></div></div></section>
    <section class="sku-sizes" aria-labelledby="cotizar-title"><div class="container"><h2 id="cotizar-title" class="section-header__title">Cómo cotizar con CADECA</h2><div class="catalog-sizes-table-wrap"><table class="catalog-sizes-table"><thead><tr><th>Dato</th><th>Qué compartir</th><th>Por qué importa</th></tr></thead><tbody><tr><td>Producto</td><td>Tipo de artículo y si es frágil</td><td>Define protección y estructura</td></tr><tr><td>Medida</td><td>Largo × ancho × alto interiores requeridos</td><td>Permite comparar una ficha o calcular una alternativa</td></tr><tr><td>Peso y apilamiento</td><td>Peso por caja y forma de almacenaje</td><td>Ayuda a revisar pared, flauta y ECT</td></tr><tr><td>Cantidad</td><td>Número de piezas y recurrencia si aplica</td><td>Se contrasta con el pedido publicado por SKU</td></tr><tr><td>Referencia</td><td>SKU o enlace de una ficha existente</td><td>Evita ambigüedad sobre el formato solicitado</td></tr></tbody></table></div><p style="margin-top:var(--spacing-md);">Puedes enviar esos datos desde <a href="/cotizar/">cotizar</a> o usar el formulario al final de esta página. Para elegir una medida inicial, consulta también la guía de <a href="/medidas-de-cajas-de-carton/">medidas de cajas de cartón</a>.</p></div></section>
  </main>
  <FaqCotizacion faqs={faqs} tema="dónde comprar cajas de cartón" producto="Dónde comprar cajas de cartón" />
</PageLayout>
