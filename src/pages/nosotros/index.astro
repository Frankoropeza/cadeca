---
import PageLayout  from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import PageHero  from "@/components/PageHero.astro";

const title  = "Nosotros | Proveedor de Cajas de Cartón en CDMX | CADECA";
const description = "Conoce CADECA, proveedor y distribuidor de cajas de cartón corrugado para empresas en CDMX y Estado de México.";

const valores = [
 { titulo: "Proveedor y distribuidor", desc: "Surtimos cajas producidas por talleres y fabricantes aliados, coordinando opciones de material, volumen y entrega." },
 { titulo: "Precisión Técnica", desc: "Cada caja cumple con ECT verificado en laboratorio. No vendemos especificaciones de papel — vendemos resistencia real y demostrable." },
 { titulo: "Entrega programada", desc: "Coordinamos entregas en CDMX y Estado de México según el volumen, la zona y la disponibilidad de rutas." },
 { titulo: "Asesoría Sin Costo", desc: "Te ayudamos a elegir el corrugado correcto para tu producto, el peso volumétrico y el diseño de separadores." },
 { titulo: "Opciones sustentables", desc: "Surtimos papel reciclado y, si tu proyecto requiere certificación FSC, la confirmamos con el fabricante al cotizar." },
 { titulo: "A la Medida Real", desc: "Coordinamos cajas en las medidas que necesitas con talleres especializados y confirmamos las especificaciones al cotizar." },
];

const cifras = [
 { numero: "50+",  etiqueta: "SKUs en catálogo" },
 { numero: "CDMX + Edomex",etiqueta: "Zona de entrega" },
];

const equipo = [
 { nombre: "Cotización",  desc: "Revisamos medidas, cantidad, material y destino para preparar opciones de suministro." },
 { nombre: "Cajas a la medida", desc: "Coordinamos diseño CAD y especificaciones con talleres especializados." },
 { nombre: "Suministro",  desc: "Organizamos pedidos y entregas programadas según las necesidades de tu empresa." },
 { nombre: "Ventas y Asesoría",  desc: "Te ayudamos a elegir la caja adecuada para tu producto y operación." },
];

const breadcrumbs = [
 { name: "Inicio", href: "/" },
 { name: "Nosotros" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="page"
 breadcrumbs={breadcrumbs}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><span class="current">Nosotros</span></li>
 </ol>
 </div>
 </div>

 <PageHero
 eyebrow="Empresa · Proveedor de cajas"
 titleHtml={true}
 title="Proveedor de cajas de cartón <span>para empresas</span>"
 desc="Proveedor de cajas de cartón para empresas que requieren corrugado estándar, a la medida o personalizado. CADECA coordina opciones con talleres aliados en CDMX y Estado de México."
 desc2="Como <strong>proveedor de cajas de cartón</strong>, CADECA atiende e-commerce, manufactura, alimentos y retail con opciones estándar, a la medida o personalizadas. Se revisan especificaciones de medida, flauta, ECT e impresión según el producto y el uso.||CADECA funciona como <strong>distribuidor de cajas de cartón en CDMX</strong> mediante talleres aliados. Comparte medidas, cantidad, uso y zona de entrega para cotizar; te asesoramos para elegir la caja."
 />

 <main id="contenido-principal" role="main">

 <!-- Cifras clave -->
 <section class="about-stats" aria-label="Cifras clave CADECA">
 <div class="container">
 <div class="about-stats__grid">
 {cifras.map(c => (
 <div class="about-stats__item">
 <span class="about-stats__numero">{c.numero}</span>
 <span class="about-stats__etiqueta">{c.etiqueta}</span>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Historia -->
 <section class="about-historia" aria-labelledby="historia-title">
 <div class="container">
 <div class="about-historia__grid">
 <div class="about-historia__img-wrap">
 <img
 src="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
 alt="Cajas de cartón corrugado para empresas en CDMX y Estado de México"
 width="640" height="480" loading="lazy" decoding="async"
 />
 </div>
 <div class="about-historia__content">
 <span class="about-historia__eyebrow">Nuestra historia</span>
 <h2 id="historia-title" class="about-historia__title">Un proveedor para elegir la caja correcta</h2>
 <p>Empezamos con una pregunta simple: ¿por qué tantas empresas reciben cajas que no se ajustan a su producto, cobran por resistencia que no necesitan o, peor, les fallan en tránsito?</p>
 <p>CADECA trabaja como proveedor y distribuidor de cajas de cartón para empresas en CDMX y Estado de México. Coordinamos la producción con talleres y fabricantes aliados, de acuerdo con las medidas, el material, la resistencia y el volumen que necesitas.</p>
 <p>Atendemos desde vendedores de e-commerce hasta operaciones industriales, alimentos, retail y otras empresas que requieren suministro de cajas estándar, a la medida o personalizadas. Te ayudamos a revisar la opción adecuada y programamos la entrega según el pedido.</p>
 </div>
 </div>
 </div>
 </section>

 <!-- Valores -->
 <section class="about-valores" aria-labelledby="valores-title" style="background:var(--color-accent);padding:var(--spacing-3xl) 0;">
 <div class="container">
 <SectionHeader
 id="valores-title"
 title="Por Qué CADECA"
 subtitle="Lo que nos diferencia no es el slogan — son las decisiones de diseño y producción que tomamos cada día."
 />
 <div class="about-valores__grid">
 {valores.map(v => (
 <div class="about-valores__card">
 <h3 class="about-valores__titulo">{v.titulo}</h3>
 <p class="about-valores__desc">{v.desc}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Equipo -->
 <section class="about-equipo" aria-labelledby="equipo-title">
 <div class="container">
 <SectionHeader
 id="equipo-title"
 title="El Equipo Detrás de Cada Caja"
 subtitle="Personas con experiencia real en la industria del corrugado en México."
 />
 <div class="about-equipo__grid">
 {equipo.map(e => (
 <div class="about-equipo__item">
 <h3 class="about-equipo__nombre">{e.nombre}</h3>
 <p class="about-equipo__desc">{e.desc}</p>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Ubicación -->
 <section class="about-zona" aria-labelledby="zona-title" style="background:var(--color-secondary);padding:var(--spacing-3xl) 0;">
 <div class="container">
 <div class="about-zona__inner">
 <div>
 <h2 id="zona-title" class="about-zona__title">Surtimos en CDMX,<br>Entregamos en Toda la ZMVM</h2>
 <p class="about-zona__desc">Coordinamos entregas en la Zona Metropolitana del Valle de México — CDMX y Estado de México — según el volumen, la zona y la disponibilidad de rutas.</p>
 <ul class="about-zona__list">
 <li> Entrega programada en Ciudad de México</li>
 <li> Fecha según pedido y zona</li>
 <li>Cobertura: ZMVM — CDMX + Edomex</li>
 <li> Interior de la República: 2-5 días (paquetería)</li>
 </ul>
 <a href="/zonas-de-servicio/" class="btn btn--primary" style="margin-top:var(--spacing-lg)">Ver zonas de servicio</a>
 </div>
 </div>
 </div>
 </section>

 <!-- Certificaciones -->
 <section class="about-certs" aria-labelledby="certs-title">
 <div class="container">
 <SectionHeader
 id="certs-title"
 title="Compromisos de Calidad"
 subtitle="Revisamos las especificaciones y documentación disponibles para cada pedido."
 />
 <div class="about-certs__grid">
 <div class="about-certs__item">
 <span class="about-certs__badge">ECT</span>
 <h3>ECT Verificado</h3>
 <p>Cada lote lleva prueba de Edge Crush Test. Te entregamos la resistencia que cotizamos.</p>
 </div>
 <div class="about-certs__item">
 <span class="about-certs__badge">FSC</span>
 <h3>Opción FSC</h3>
 <p>Si necesitas fibra con certificación FSC, la indicamos al cotizar y confirmamos disponibilidad con el fabricante.</p>
 </div>
 <div class="about-certs__item">
 <span class="about-certs__badge">COFEPRIS</span>
 <h3>Food Grade</h3>
 <p>Liner food-grade y tintas base agua sin metales pesados. Carta de cumplimiento COFEPRIS disponible.</p>
 </div>
 <div class="about-certs__item">
 <span class="about-certs__badge">ISTA</span>
 <h3>ISTA / IATA</h3>
 <p>Cajas de exportación diseñadas conforme normas ISTA 2A/3A e IATA para carga aérea y marítima.</p>
 </div>
 </div>
 </div>
 </section>

 </main>

 <LeadCapture title="¿Buscas cajas para tu empresa? Solicita una cotización" />

</PageLayout>
