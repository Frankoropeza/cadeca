---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout    from "@/layouts/PageLayout.astro";
import PageHero      from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ProductCard   from "@/components/ProductCard.astro";
import { grupos, categorias, totalEmpresas } from "@/data/directorio";
const SITE     = "https://cajas-de-carton.com";

const title       = "Directorio de Empresas de Empaque en CDMX | CADECA";
const description = "Directorio de fabricantes, distribuidores, diseñadores, paqueterías y proveedores del sector de empaques y cartón corrugado en CDMX.";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Directorio de Empresas — Empaques Corrugado CDMX",
  "description": description,
  "url": `${SITE}/directorio/`,
  "publisher": { "@type": "Organization", "name": "CADECA", "url": SITE },
};

// Preparar datos con SVG placeholder y tags de categorías
const gruposConData = grupos.map((g, i) => {
  const num  = String(i + 1).padStart(2, "0");
  const cats = categorias.filter(c => c.grupoId === g.id);
  const empCount = cats.reduce((acc, c) => acc + c.empresas.length, 0);

  // SVG placeholder con el color del grupo
  const svgRaw = `<svg xmlns='http://www.w3.org/2000/svg' width='900' height='560'><rect width='900' height='560' fill='${g.color}'/><rect width='900' height='560' fill='url(%23p)' opacity='.18'/><defs><pattern id='p' width='40' height='40' patternUnits='userSpaceOnUse'><circle cx='20' cy='20' r='1' fill='white'/></pattern></defs><text x='50%' y='46%' dominant-baseline='middle' text-anchor='middle' fill='rgba(255,255,255,0.10)' font-size='200' font-family='sans-serif' font-weight='900'>${num}</text><text x='50%' y='72%' dominant-baseline='middle' text-anchor='middle' fill='rgba(255,255,255,0.55)' font-size='28' font-family='sans-serif' font-weight='700'>${g.nombre}</text></svg>`;
  const imgSrc = `data:image/svg+xml,${encodeURIComponent(svgRaw)}`;

  // Tags = primeras 4 categorías del grupo
  const tags = cats.slice(0, 4).map(c => ({
    label: c.titulo,
    href:  `/directorio/${g.id}/${c.id}/`,
  }));

  return { ...g, catCount: cats.length, empCount, imgSrc, tags };
});
---

<PageLayout
  noindex={true}
  title={title}
  description={description}
  schema={schema}
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Directorio" }]}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><span class="current">Directorio</span></li>
      </ol>
    </div>
  </div>

  <PageHero
    eyebrow="Directorio · Cartón y empaque"
    titleHtml={true}
    title="Directorio de empresas de <span>cartón y empaque</span>"
    desc={`Directorio de empresas de cartón y empaque organizado en ${grupos.length} grupos y categorías. Consulta perfiles publicados de proveedores, diseñadores, paqueterías y organismos del sector.`}
    desc2="El directorio reúne <strong>proveedores de cajas de cartón</strong>, productores de materia prima, conversores, diseñadores de packaging, paqueterías, clientes mayoristas y organismos. Los perfiles se organizan por grupo y categoría para facilitar la búsqueda dentro del ecosistema de empaque.||Selecciona el grupo de tu interés para revisar los datos publicados y localizar opciones del sector. Para una caja específica, CADECA surte como proveedor: comparte medidas, cantidad, uso y zona de entrega para recibir orientación al cotizar."
  />

  <!-- Separador visual -->
  <div class="dir-index-sep" aria-hidden="true"></div>

  <!-- Cuerpo -->
  <div class="dir-index-body">
    <div class="container">

      <SectionHeader
        title={`Directorio · ${grupos.length} grupos · ${totalEmpresas} empresas`}
        twoCol
        link={{ text: "Registrar mi empresa", href: "/contacto/" }}
      >
        <p>Este directorio reúne a los principales actores del ecosistema de empaque en México: fabricantes de materia prima, conversores, agencias de diseño, paqueterías y organismos certificadores.</p>
        <p>Selecciona un grupo para explorar sus categorías. ¿Tu empresa no aparece? <a href="/contacto/" style="color:var(--color-primary);font-weight:700;">Regístrala gratis</a></p>
      </SectionHeader>

      <div class="products__grid dir-grupos-grid">
        {gruposConData.map(g => (
          <ProductCard
            title={g.nombre}
            desc={`${g.catCount} categorías · ${g.empCount} empresas — ${g.desc.slice(0, 90)}…`}
            imgSrc={g.imgSrc}
            imgAlt={`Grupo ${g.nombre} — Directorio de empaques CADECA`}
            href={`/directorio/${g.id}/`}
            tags={g.tags}
            btnText="Ver categorías"
          />
        ))}
      </div>

      <!-- CTA registrar empresa -->
      <div class="dir-cta">
        <h2 class="dir-cta__title">¿Tu empresa no aparece en el directorio?</h2>
        <p class="dir-cta__desc">Registra tu empresa gratuitamente. Llegamos a miles de compradores de empaques cada mes en CDMX y Zona Metropolitana.</p>
        <div class="dir-cta__actions">
          <a href="/contacto/" class="btn btn--primary">Registrar empresa gratis</a>
          {HAS_WA && (
<a href={contactoHref()} class="btn btn--outline" {...contactoAttrs}>Consultar por WhatsApp</a>
)}
        </div>
      </div>

    </div>
  </div>

</PageLayout>

<style>
/* Separador entre hero y cuerpo */
.dir-index-sep {
  height: 4px;
  background: var(--color-primary);
}

.dir-index-body {
  padding: var(--spacing-4xl) 0 var(--spacing-4xl);
  background: var(--color-accent);
}

/* El grid usa products__grid de global.css — solo ajustamos el tope */
.dir-grupos-grid {
  margin-bottom: var(--spacing-4xl);
}

/* CTA final */
.dir-cta {
  background: var(--color-secondary);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-3xl) var(--spacing-2xl);
  text-align: center;
}
.dir-cta__title {
  font-size: clamp(1.3rem, 2.5vw, 1.8rem);
  font-weight: 800;
  color: #fff;
  margin-bottom: var(--spacing-md);
}
.dir-cta__desc {
  font-size: var(--font-size-base);
  color: rgba(255,255,255,0.75);
  max-width: 50ch;
  margin: 0 auto var(--spacing-xl);
  line-height: 1.6;
}
.dir-cta__actions {
  display: flex;
  gap: 1rem;
  justify-content: center;
  flex-wrap: wrap;
}
.dir-cta .btn--outline {
  border-color: rgba(255,255,255,0.4);
  color: #fff;
}
.dir-cta .btn--outline:hover {
  background: rgba(255,255,255,0.1);
  border-color: rgba(255,255,255,0.8);
}
</style>
