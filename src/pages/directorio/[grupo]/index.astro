---
import PageLayout   from "@/layouts/PageLayout.astro";
import PageHero      from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ProductCard   from "@/components/ProductCard.astro";
import { grupos, getGrupo, getCategoriasByGrupo } from "@/data/directorio";

export async function getStaticPaths() {
  return grupos.map(g => ({ params: { grupo: g.id } }));
}

const { grupo: grupoId } = Astro.params;
const grupoData = getGrupo(grupoId);
const cats      = getCategoriasByGrupo(grupoId);

if (!grupoData) return Astro.redirect("/directorio");

const WHATSAPP = "5255XXXXXXXX";

const totalEmpresas = cats.reduce((acc, c) => acc + c.empresas.length, 0);
const title         = `${grupoData.nombre} — Directorio de Empaques CDMX | CADECA`;
const description   = `${cats.length} categorías y ${totalEmpresas} empresas de ${grupoData.nombre.toLowerCase()} en el directorio de empaques y cartón corrugado de CADECA.`;

// SVG placeholder por categoría (color del grupo + número + nombre)
const catsConData = cats.map((cat, i) => {
  const num = String(i + 1).padStart(2, "0");
  const svgRaw = `<svg xmlns='http://www.w3.org/2000/svg' width='900' height='560'><rect width='900' height='560' fill='${grupoData.color}'/><rect width='900' height='560' fill='url(%23p)' opacity='.18'/><defs><pattern id='p' width='40' height='40' patternUnits='userSpaceOnUse'><circle cx='20' cy='20' r='1' fill='white'/></pattern></defs><text x='50%' y='44%' dominant-baseline='middle' text-anchor='middle' fill='rgba(255,255,255,0.10)' font-size='200' font-family='sans-serif' font-weight='900'>${num}</text><text x='50%' y='72%' dominant-baseline='middle' text-anchor='middle' fill='rgba(255,255,255,0.55)' font-size='24' font-family='sans-serif' font-weight='700'>${cat.titulo}</text></svg>`;
  const imgSrc = `data:image/svg+xml,${encodeURIComponent(svgRaw)}`;

  // Tags = primeras 4 empresas de la categoría
  const tags = cat.empresas.slice(0, 4).map(e => ({
    label: e.nombre,
    href:  `/directorio/${grupoId}/${cat.id}`,
  }));

  return { ...cat, imgSrc, tags };
});
---

<PageLayout
  title={title}
  description={description}
  breadcrumbs={[
    { name: "Inicio",     href: "/" },
    { name: "Directorio", href: "/directorio" },
    { name: grupoData.nombre },
  ]}
  whatsapp={WHATSAPP}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/directorio">Directorio</a></li>
        <li><span class="current">{grupoData.nombre}</span></li>
      </ol>
    </div>
  </div>

  <!-- Hero de grupo -->
  <PageHero
    eyebrow={`Directorio · ${grupoData.nombre}`}
    titleHtml={true}
    title={`<span>${grupoData.nombre}</span> — Empresas del Sector`}
    desc={grupoData.desc}
    desc2={`El grupo <strong>${grupoData.nombre}</strong> concentra ${cats.length} categorías especializadas con ${totalEmpresas} empresas verificadas activas en CDMX y Zona Metropolitana. Abarca desde grandes corporativos hasta talleres especializados con décadas de experiencia en el sector del empaque y el cartón corrugado.||Selecciona la categoría que mejor se ajusta a tu búsqueda para acceder al listado completo con datos de contacto, giro específico y zona de operación de cada empresa. ¿Tu empresa pertenece a este grupo y no aparece en el directorio? <a href="/contacto" style="color:var(--color-primary);font-weight:700;">Solicita tu registro gratuito →</a>`}
    stats={[
      { value: String(cats.length),    label: "Categorías" },
      { value: String(totalEmpresas),  label: "Empresas" },
    ]}
    ctas={[
      { href: "/cotizar",    label: "Solicitar cotización", variant: "primary" },
      { href: "/directorio", label: "Ver todos los grupos", variant: "outline" },
    ]}
  />

  <!-- Separador visual -->
  <div class="dir-sep" aria-hidden="true"></div>

  <!-- Categorías + Sidebar -->
  <div class="dir-grupo-body">
    <div class="container">
      <div class="dir-grupo-layout">

        <!-- Columna principal -->
        <div>
          <SectionHeader
            title={`${grupoData.nombre} · ${cats.length} categorías · ${totalEmpresas} empresas`}
            twoCol
          >
            <p>{grupoData.desc}</p>
            <p>Selecciona una categoría para ver el listado de empresas. <a href="/directorio" style="color:var(--color-primary);font-weight:700;">Ver todos los grupos →</a></p>
          </SectionHeader>

          <div class="products__grid dir-cats-grid">
            {catsConData.map(cat => (
              <ProductCard
                title={cat.titulo}
                desc={`${cat.empresas.length} empresas — ${cat.desc.slice(0, 90)}…`}
                imgSrc={cat.imgSrc}
                imgAlt={`Categoría ${cat.titulo} — Directorio CADECA`}
                href={`/directorio/${grupoId}/${cat.id}`}
                tags={cat.tags}
                btnText="Ver empresas"
              />
            ))}
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="dir-grupo-sidebar">

          <!-- CTA CADECA -->
          <div class="dir-sidebar-cta" style={`--accent:${grupoData.color}`}>
            <p class="dir-sidebar-cta__label">Fabricante directo CDMX</p>
            <h3 class="dir-sidebar-cta__title">¿Necesitas cajas de cartón?</h3>
            <p class="dir-sidebar-cta__desc">Cotización sin compromiso. Entrega en 24 hrs en CDMX y Edomex.</p>
            <a href="/cotizar" class="btn btn--primary" style="width:100%;text-align:center;display:flex;justify-content:center">Solicitar cotización</a>
            <a href={`https://wa.me/${WHATSAPP}`} class="dir-sidebar-cta__wa" target="_blank" rel="noopener">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              WhatsApp directo
            </a>
          </div>

          <!-- Otros grupos -->
          <div class="dir-sidebar-widget">
            <h3 class="dir-sidebar-widget__title">Otros grupos del directorio</h3>
            <nav class="dir-sidebar-cats">
              {grupos.filter(g => g.id !== grupoId).map(g => (
                <a href={`/directorio/${g.id}`} class="dir-sidebar-cats__link">
                  {g.nombre}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              ))}
            </nav>
          </div>

          <a href="/directorio" class="dir-sidebar-all">
            Ver directorio completo
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>

        </aside>
      </div>
    </div>
  </div>

</PageLayout>

<style>
/* Separador */
.dir-sep {
  height: 4px;
  background: linear-gradient(90deg, var(--color-primary) 0%, #C44D00 100%);
}

/* Body */
.dir-grupo-body {
  padding: var(--spacing-4xl) 0 var(--spacing-4xl);
  background: var(--color-accent);
}

/* Layout main + sidebar */
.dir-grupo-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-2xl);
}
@media (min-width: 1280px) {
  .dir-grupo-layout { grid-template-columns: 1fr 280px; align-items: start; }
}

.dir-cats-grid {
  margin-bottom: 0;
}

/* Sidebar */
.dir-grupo-sidebar {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

/* CTA sidebar */
.dir-sidebar-cta {
  border: 1px solid var(--color-border);
  border-top: 4px solid var(--accent, var(--color-primary));
  border-radius: var(--border-radius-md);
  padding: var(--spacing-xl);
  background: #fff;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}
.dir-sidebar-cta__label {
  font-size: var(--font-size-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--accent, var(--color-primary));
}
.dir-sidebar-cta__title {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--color-secondary);
}
.dir-sidebar-cta__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: 1.5;
  margin-bottom: var(--spacing-xs);
}
.dir-sidebar-cta__wa {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.55rem 1rem;
  border: 1.5px solid var(--color-border);
  border-radius: var(--border-radius-sm);
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: #25D366;
  text-decoration: none;
  transition: background var(--transition-fast), border-color var(--transition-fast);
}
.dir-sidebar-cta__wa:hover { background: #f0fdf4; border-color: #25D366; }

/* Sidebar widget */
.dir-sidebar-widget {
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-md);
  padding: var(--spacing-lg);
  background: #fff;
}
.dir-sidebar-widget__title {
  font-size: var(--font-size-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-text-light);
  margin-bottom: var(--spacing-md);
}
.dir-sidebar-cats {
  display: flex;
  flex-direction: column;
}
.dir-sidebar-cats__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 0;
  border-bottom: 1px solid var(--color-border);
  font-size: var(--font-size-sm);
  color: var(--color-text);
  text-decoration: none;
  transition: color var(--transition-fast);
}
.dir-sidebar-cats__link:last-child { border-bottom: none; }
.dir-sidebar-cats__link:hover { color: var(--color-primary); }

/* Ver todos */
.dir-sidebar-all {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  padding: 0.7rem 1rem;
  border: 1.5px solid var(--color-border);
  border-radius: var(--border-radius-sm);
  font-size: var(--font-size-xs);
  font-weight: 700;
  color: var(--color-text-light);
  text-decoration: none;
  transition: border-color var(--transition-fast), color var(--transition-fast);
}
.dir-sidebar-all:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
</style>
