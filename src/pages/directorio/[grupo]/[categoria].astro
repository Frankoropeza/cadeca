---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout    from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import PageHero from "@/components/PageHero.astro";
import EmpresaCard   from "@/components/EmpresaCard.astro";
import { categorias, getGrupo, getCategoriasByGrupo, getCategoria } from "@/data/directorio";

export async function getStaticPaths() {
  return categorias.map(c => ({
    params: { grupo: c.grupoId, categoria: c.id },
  }));
}

const { grupo: grupoId, categoria: catId } = Astro.params;
const grupoData = getGrupo(grupoId);
const catData   = getCategoria(grupoId, catId);

const otrasCAts = getCategoriasByGrupo(grupoId).filter(c => c.id !== catId);

if (!grupoData || !catData) return Astro.redirect("/directorio/");
const SITE     = "https://cajas-de-carton.com";

// Párrafos SEO por categoría (2 por categoría)
const seoParagrafos: Record<string, [string, string]> = {
  'fabricantes-papel': [
    'El directorio de <strong>fabricantes de papel y cartón en México</strong> de CADECA reúne a los principales productores de papel kraft, liner, médium y cartón corrugado de la CDMX y Zona Metropolitana. Encontrarás empresas con capacidad para abastecer proyectos industriales de gran escala, con certificaciones de calidad y materias primas responsables.',
    'Como <strong>proveedor de cajas de cartón corrugado en CDMX</strong>, CADECA trabaja de la mano con talleres y fabricantes de papel del mercado para coordinar cada pedido. Si buscas empaques a la medida, contáctanos para revisar opciones y tiempo de entrega.',
  ],
  'fabricantes-cajas': [
    'El directorio de <strong>fabricantes de cajas de cartón corrugado en CDMX y Estado de México</strong> de CADECA incluye a las empresas más reconocidas del sector empaque. Desde pequeños talleres hasta grandes plantas industriales con capacidad para millones de piezas mensuales, aquí encuentras el proveedor ideal según tu volumen y especificaciones.',
    'CADECA es <strong>proveedor de cajas de cartón corrugado</strong> en la Ciudad de México. Surtimos cajas estándar, a la medida y personalizadas con impresión de hasta 4 colores. Coordinamos la entrega en CDMX y Zona Metropolitana según el pedido. <strong>Cotización sin compromiso.</strong>',
  ],
  'distribuidores': [
    'Los <strong>distribuidores de empaques y materiales de empaque en CDMX</strong> listados en este directorio ofrecen soluciones inmediatas para empresas que requieren inventario disponible sin tiempos de producción. Cartón corrugado, papel kraft, cinta adhesiva, rellenos y materiales complementarios en un solo proveedor.',
    'CADECA opera como <strong>proveedor de empaques de cartón</strong> con entregas programadas y suministro continuo para empresas en CDMX y Estado de México. Coordinamos las opciones disponibles con talleres y fabricantes aliados. <strong>Solicita tu cotización.</strong>',
  ],
  'impresion-troquelado': [
    'Las empresas de <strong>impresión y troquelado de cajas en México</strong> listadas en este directorio son especialistas en packaging personalizado: impresión flexográfica y digital, troquelado de alta precisión, barnices y acabados especiales. Soluciones para marcas que buscan diferenciarse con su empaque.',
    'En CADECA ofrecemos <strong>impresión de cajas de cartón corrugado</strong> en 1 hasta 4 colores con tintas base agua. Diseño de prueba digital sin costo, muestras físicas antes de producción y entrega en CDMX. Personaliza tu empaque con tu logo, colores corporativos y mensajes promocionales. <strong>Cotiza ahora.</strong>',
  ],
  'diseno-packaging': [
    'El <strong>diseño de packaging y empaques</strong> es una inversión estratégica en la identidad de marca y la experiencia del cliente. Las agencias y estudios de diseño listados en este directorio son especialistas en diseño estructural, diseño gráfico de empaques y desarrollo de prototipos para la industria del cartón corrugado.',
    'CADECA ofrece <strong>servicio de diseño CAD incluido sin costo</strong> en todos los pedidos de cajas a la medida. Nuestro equipo técnico desarrolla el diseño estructural óptimo según tus medidas, producto y requerimientos de resistencia. Desde el diseño hasta la entrega, un solo proveedor. <strong>Solicita asesoría técnica gratuita.</strong>',
  ],
  'maquinaria': [
    'Las empresas de <strong>maquinaria para empaque y procesamiento de cartón en México</strong> listadas aquí ofrecen equipos para corrugado, troquelado, impresión, doblado y sellado. Desde equipos nuevos hasta maquinaria reconstruida, encuentra el equipo adecuado para tu planta o taller.',
    'Si produces empaques y buscas optimizar tu proceso, CADECA puede ser tu aliado como <strong>proveedor de cajas de cartón corrugado terminadas</strong>, eliminando la necesidad de invertir en maquinaria. Suministro programado y entregas coordinadas según pedido en CDMX.',
  ],
  'tintas-barnices': [
    'Los <strong>proveedores de tintas y barnices para impresión de cartón</strong> en este directorio suministran insumos para la industria gráfica del empaque: tintas flexográficas base agua, barnices UV, barnices de retardo, adhesivos y recubrimientos especiales para cartón corrugado y cartón sólido.',
    'CADECA utiliza exclusivamente <strong>tintas base agua y barnices ecológicos</strong> en la impresión de cajas de cartón personalizadas. Nuestros empaques son seguros para alimentos y cumplen con las normas NOM aplicables. Conoce nuestra línea de <strong>cajas personalizadas con impresión profesional</strong> y solicita tu muestra.',
  ],
  'paqueterias': [
    'Las <strong>paqueterías y servicios de mensajería en México</strong> listadas en este directorio son aliados clave para el e-commerce y la logística de distribución. Encuentras desde grandes operadores nacionales hasta mensajería local para CDMX, con soluciones para e-commerce, industria y distribución masiva.',
    'El empaque correcto hace la diferencia en la logística. CADECA produce <strong>cajas de cartón para e-commerce y paquetería</strong> optimizadas para resistir el manejo en transportadoras: calibres correctos, sellado seguro y dimensiones optimizadas para reducir costos de envío. <strong>Cotiza tus cajas para envíos ahora.</strong>',
  ],
  'almacenes-fulfillment': [
    'Los <strong>almacenes y centros de fulfillment en CDMX y Zona Metropolitana</strong> listados aquí ofrecen soluciones de almacenaje, preparación de pedidos, pick & pack y distribución para marcas de e-commerce y empresas que externalizan su logística de última milla.',
    'Para operaciones de fulfillment eficientes, el empaque correcto es fundamental. CADECA suministra <strong>cajas de cartón corrugado para e-commerce y fulfillment</strong> con entregas programadas y sin riesgo de desabasto. Dimensiones estándar o a la medida, desde 50 piezas. <strong>Solicita tu programa de suministro.</strong>',
  ],
  'ecommerce': [
    'Las <strong>plataformas de e-commerce y marketplaces en México</strong> como Mercado Libre, Amazon y Shopify han transformado la demanda de empaques para envío. Este directorio reúne a los principales actores del ecosistema digital que conectan vendedores con compradores y que tienen requerimientos específicos de packaging.',
    'CADECA es el proveedor de confianza de <strong>cajas de cartón para vendedores de Mercado Libre, Amazon y Shopify</strong> en CDMX. Cajas optimizadas para envíos, con medidas estándar o a la medida de tu producto, desde 50 piezas. Reducimos tu costo de empaque hasta un 30% vs. comprar en tienda. <strong>Cotiza ahora.</strong>',
  ],
  'alimentos': [
    'Las empresas de la <strong>industria alimentaria en México</strong> tienen requerimientos específicos de empaque: materiales food-grade, barreras de humedad y grasa, certificaciones sanitarias y normas NOM aplicables. Este directorio reúne a los proveedores especializados en empaques para alimentos en CDMX.',
    'CADECA surte <strong>cajas de cartón para alimentos</strong> con materiales food-grade, aptos para contacto indirecto con alimentos. Especiales para pizzerías, restaurantes, panaderías y procesadoras de alimentos en CDMX y Estado de México. La entrega se coordina según el pedido. <strong>Solicita muestras.</strong>',
  ],
  'farmaceutica': [
    'La <strong>industria farmacéutica y cosmética</strong> requiere empaques con estándares muy específicos: materiales certificados, impresión de alta calidad, trazabilidad y cumplimiento con normas COFEPRIS. Este directorio reúne a los proveedores especializados en packaging para el sector salud y belleza.',
    'CADECA ofrece <strong>cajas de cartón para industria farmacéutica y cosmética</strong> con los estándares de calidad que el sector requiere. Impresión de alta definición para etiquetado, materiales y entregas programadas para tu línea de producción en CDMX. <strong>Consulta para elegir la caja correcta.</strong>',
  ],
  'textil-retail': [
    'El <strong>sector textil, moda y retail en México</strong> demanda empaques que combinen funcionalidad con estética de marca. Este directorio incluye a los proveedores de cajas para zapatos, ropa, accesorios y productos de retail, con opciones de impresión full color y acabados premium.',
    'CADECA produce <strong>cajas de cartón para retail, moda y textil</strong> con diseño personalizado y acabados que elevan la percepción de marca. Cajas para zapatos, camisas, accesorios y productos de tienda con tu logo e imagen corporativa. Mínimos accesibles desde 100 piezas. <strong>Solicita tu muestra.</strong>',
  ],
  'industrial': [
    'La <strong>industria manufacturera en CDMX y Estado de México</strong> es uno de los principales consumidores de cajas de cartón corrugado industrial: doble y triple pared, alta resistencia ECT, para piezas metálicas, plásticas, electrónicas y maquinaria. Este directorio reúne a los proveedores del sector.',
    'CADECA surte <strong>cajas de cartón corrugado industrial</strong> para la industria manufacturera de CDMX y Edomex. Flautas BC y triple pared, resistencia ECT hasta 44, piezas desde 50 unidades. Asesoría gratuita para seleccionar el calibre correcto según el peso de tu producto. <strong>Cotiza ahora.</strong>',
  ],
  'asociaciones': [
    'Las <strong>asociaciones, cámaras y organismos del sector empaque en México</strong> juegan un papel clave en la normatividad, la representación empresarial y el desarrollo del sector. Este directorio incluye a los organismos más relevantes para fabricantes, distribuidores y usuarios de empaques de cartón corrugado.',
    'CADECA participa activamente en el ecosistema del <strong>sector empaque y cartón corrugado en México</strong>. Conoce nuestros productos, obtén asesoría gratuita sobre materiales, calibres y resistencias, y recibe cotización personalizada. <strong>Contáctanos hoy.</strong>',
  ],
  'certificadoras': [
    'Los <strong>organismos certificadores y entidades de normalización del sector empaque</strong> en México garantizan que los materiales y procesos cumplan con las normas aplicables: NOM, ISO, FSC, ISTA, entre otras. Este directorio incluye a las principales entidades para el sector cartón corrugado.',
    'CADECA puede coordinar materiales y documentación según los estándares de las principales <strong>certificadoras y normas del sector empaque</strong>. Si necesitas cartón reciclado con certificación FSC, lo indicamos al cotizar y confirmamos disponibilidad con el fabricante. Conoce nuestras opciones de <strong>empaques ecológicos.</strong>',
  ],
};

const [seoP1, seoP2] = seoParagrafos[catId] ?? [
  `El directorio de <strong>${catData.titulo}</strong> de CADECA reúne a los principales proveedores y empresas especializadas en CDMX y Zona Metropolitana. Encuentra proveedores verificados, contacta directamente y optimiza tu cadena de suministro de empaques de cartón corrugado.`,
  `CADECA es <strong>proveedor de cajas de cartón corrugado</strong> en la Ciudad de México. Surtimos cajas estándar, a la medida y personalizadas, con entrega coordinada según el pedido. Cotización sin compromiso. Contáctanos para asesoría técnica gratuita.`,
];

const title       = `${catData.titulo} — Directorio ${grupoData.nombre} CDMX | CADECA`;
const description = `${catData.empresas.length} empresas de ${catData.titulo.toLowerCase()} en el directorio de empaques y cartón corrugado de CADECA. Fabricantes, proveedores y servicios en CDMX y Zona Metropolitana.`;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${catData.titulo} — Directorio CADECA`,
  "description": description,
  "url": `${SITE}/directorio/${grupoId}/${catId}/`,
  "publisher": { "@type": "Organization", "name": "CADECA", "url": SITE },
};

---

<PageLayout
  noindex={true}
  title={title}
  description={description}
  schema={schema}
  breadcrumbs={[
    { name: "Inicio",         href: "/" },
    { name: "Directorio",     href: "/directorio/" },
    { name: grupoData.nombre, href: `/directorio/${grupoId}/` },
    { name: catData.titulo },
  ]}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/directorio/">Directorio</a></li>
        <li><a href={`/directorio/${grupoId}/`}>{grupoData.nombre}</a></li>
        <li><span class="current">{catData.titulo}</span></li>
      </ol>
    </div>
  </div>

  <PageHero eyebrow={`Directorio · ${grupoData.nombre}`} title={catData.titulo} desc={catData.desc} desc2={`${seoP1}||${seoP2}`} />

  <!-- Separador -->
  <div class="dir-sep" aria-hidden="true" style={`background: linear-gradient(90deg, ${grupoData.color} 0%, ${grupoData.color}99 100%)`}></div>

  <!-- Empresas + Sidebar -->
  <div class="dir-empresas-body">
    <div class="container">
      <div class="dir-empresas-layout">

        <!-- Columna principal -->
        <div>
          <SectionHeader
            title={`${catData.empresas.length} empresas en ${catData.titulo}`}
            twoCol
          >
            <p>{catData.desc}</p>
            <p>¿Tu empresa debería aparecer aquí? <a href="/contacto/" style="color:var(--color-primary);font-weight:700;">Regístrala gratis</a></p>
          </SectionHeader>

          <div class="dir-emp-grid">
            {catData.empresas.map(emp => (
              <EmpresaCard
                nombre={emp.nombre}
                giro={emp.giro}
                ciudad={emp.ciudad}
                desc={emp.desc}
                direccion={emp.direccion}
                tel={emp.tel}
                maps={emp.maps}
                rating={emp.rating}
                reviews={emp.reviews}
                web={emp.web}
                verificado={emp.verificado}
                accentColor={grupoData.color}
              />
            ))}
          </div>
        </div>

        <!-- Sidebar -->
        <aside class="dir-empresas-sidebar">

          <!-- CTA CADECA -->
          <div class="dir-sidebar-cta" style={`--accent:${grupoData.color}`}>
            <p class="dir-sidebar-cta__label">Proveedor de cajas CDMX</p>
            <h3 class="dir-sidebar-cta__title">¿Necesitas cajas de cartón?</h3>
            <p class="dir-sidebar-cta__desc">Cotización sin compromiso. Entrega programada según pedido y zona.</p>
            <a href="/cotizar/" class="btn btn--primary" style="width:100%;text-align:center;display:flex;justify-content:center">Solicitar cotización</a>
            {HAS_WA && (
<a href={contactoHref()} class="dir-sidebar-cta__wa" {...contactoAttrs}>
              WhatsApp directo
            </a>
)}
          </div>

          <!-- Otras categorías -->
          {otrasCAts.length > 0 && (
            <div class="dir-sidebar-widget">
              <h3 class="dir-sidebar-widget__title">Otras categorías en {grupoData.nombre}</h3>
              <nav class="dir-sidebar-cats">
                {otrasCAts.map(c => (
                  <a href={`/directorio/${grupoId}/${c.id}/`} class="dir-sidebar-cats__link">
                    {c.titulo}
                    <span class="dir-sidebar-cats__count">{c.empresas.length}</span>
                  </a>
                ))}
              </nav>
            </div>
          )}

          <a href="/directorio/" class="dir-sidebar-all">
            Ver todos los grupos del directorio
          </a>

        </aside>
      </div>
    </div>
  </div>

</PageLayout>

<style>
/* Hero */

/* Grid 2 columnas */

/* Col 1 */

/* Col 2: párrafos SEO */

/* Separador */
.dir-sep { height: 4px; }

/* Body */
.dir-empresas-body {
  padding: var(--spacing-4xl) 0 var(--spacing-4xl);
  background: var(--color-accent);
}
.dir-empresas-layout {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-2xl);
}
@media (min-width: 1280px) {
  .dir-empresas-layout { grid-template-columns: 1fr 280px; align-items: start; }
}

/* Grid de empresas */
.dir-emp-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--spacing-md);
  margin-bottom: 0;
}
@media (min-width: 640px)  { .dir-emp-grid { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 900px)  { .dir-emp-grid { grid-template-columns: repeat(3, 1fr); } }

/* Sidebar */
.dir-empresas-sidebar {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

/* CTA sidebar */
.dir-sidebar-cta {
  border: 1px solid var(--color-border);
  border-top: 4px solid var(--accent, var(--color-primary));
  border-radius: var(--border-radius-md);
  padding: var(--spacing-xl);
  background: #fff;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}
.dir-sidebar-cta__label {
  font-size: var(--font-size-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--accent, var(--color-primary));
}
.dir-sidebar-cta__title {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--color-secondary);
}
.dir-sidebar-cta__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: 1.5;
  margin-bottom: var(--spacing-xs);
}
.dir-sidebar-cta__wa {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.55rem 1rem;
  border: 1.5px solid var(--color-border);
  border-radius: var(--border-radius-sm);
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: #25D366;
  text-decoration: none;
  transition: var(--transition-btn);
}
.dir-sidebar-cta__wa:hover {
  background: #f0fdf4;
  border-color: #25D366;
}

/* Sidebar widget */
.dir-sidebar-widget {
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-md);
  padding: var(--spacing-lg);
  background: #fff;
}
.dir-sidebar-widget__title {
  font-size: var(--font-size-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-text-light);
  margin-bottom: var(--spacing-md);
}
.dir-sidebar-cats {
  display: flex;
  flex-direction: column;
}
.dir-sidebar-cats__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.6rem 0;
  border-bottom: 1px solid var(--color-border);
  font-size: var(--font-size-sm);
  color: var(--color-text);
  text-decoration: none;
}
.dir-sidebar-cats__link:last-child { border-bottom: none; }
.dir-sidebar-cats__link:hover { color: var(--color-primary); }
.dir-sidebar-cats__count {
  font-size: var(--font-size-xs);
  font-weight: 600;
  color: var(--color-text-light);
  background: var(--color-accent);
  padding: 0.1rem 0.45rem;
  border-radius: 999px;
}

/* Ver todos */
.dir-sidebar-all {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  padding: 0.7rem 1rem;
  border: 1.5px solid var(--color-border);
  border-radius: var(--border-radius-sm);
  font-size: var(--font-size-xs);
  font-weight: 700;
  color: var(--color-text-light);
  text-decoration: none;
}
.dir-sidebar-all:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}
</style>
