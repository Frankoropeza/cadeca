 },
 {
 id:  "2",
 question: "¿Qué tipos de cajas de cartón venden?",
 answer:  "Surtimos ocho líneas: cajas de cartón corrugado de simple, doble y triple pared; cajas personalizadas con logo; cajas para regalo; cajas para envíos y e-commerce; cajas para alimentos; cajas para archivo; láminas de cartón corrugado y cajas a la medida. Cada línea tiene fichas técnicas en el <a href=\"/catalogo/\">catálogo</a>.",
 },
 {
 id:  "3",
