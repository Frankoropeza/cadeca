---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title       = "Cajas de Cartón CDMX y Estado de México | CADECA";
const description = "La mejor empresa de cajas de cartón en CDMX y Estado de México. Corrugado estándar, a medida y personalizadas al mayoreo. Entrega en 24-48 hrs. Cotiza gratis.";

// FAQ Schema — sincronizado con el acordeón visible
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Dónde comprar cajas de cartón al mayoreo en CDMX?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "En CADECA somos tu mejor opción para comprar cajas de cartón al mayoreo en la Ciudad de México y Estado de México. Manejamos cajas corrugadas estándar, a la medida y personalizadas con logo. Contáctanos por WhatsApp para una cotización en menos de 2 horas."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué tipos de cajas de cartón venden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Manejamos 6 tipos principales: Cajas corrugado estándar (simple, doble y triple pared), Cajas a la medida, Cajas personalizadas con logo e impresión full color, Cajas para e-commerce y envíos, Cajas para alimentos y Láminas de cartón corrugado por metro."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuál es el pedido mínimo de cajas de cartón?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Para cajas estándar no tenemos mínimo requerido. Para cajas personalizadas con logo el mínimo es de 100 piezas. Para cajas a la medida el mínimo depende de las especificaciones. Contáctanos y te asesoramos según tu necesidad."
      }
    },
    {
      "@type": "Question",
      "name": "¿Hacen entregas a domicilio en CDMX y Estado de México?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, realizamos entregas a domicilio en toda la Ciudad de México y Estado de México. Para pedidos grandes coordinamos logística directa a tu negocio, almacén u obra. El tiempo de entrega es de 24 a 48 horas en pedidos estándar y de 3 a 5 días en personalizados."
      }
    },
    {
      "@type": "Question",
      "name": "¿Venden cajas de cartón para e-commerce y Mercado Libre?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Tenemos cajas estándar en medidas compatibles con Mercado Envíos, Amazon MX, DHL, FedEx y Estafeta. Pedidos desde 50 piezas, entrega en 24 hrs en CDMX. Perfectas para vendedores online que necesitan abastecerse frecuentemente."
      }
    },
    {
      "@type": "Question",
      "name": "¿Ofrecen cajas de cartón ecológicas o recicladas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí. Contamos con cajas fabricadas con material reciclado posconsumo y opciones con tintas base agua para impresión ecológica. Ideales para marcas con compromiso ambiental o que venden a mercados con regulaciones de sostenibilidad."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo cotizo cajas de cartón personalizadas con mi logo?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Es muy sencillo: contáctanos por WhatsApp o llena el formulario de cotización con las medidas deseadas, cantidad y tipo de impresión. Te enviamos una propuesta en menos de 2 horas con precio, tiempo de producción y prueba de diseño sin costo."
      }
    }
  ]
};
---

