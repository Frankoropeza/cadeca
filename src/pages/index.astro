const pasos = [
 { num: 1, title: "Solicita tu cotización",  desc: "Usa el formulario o escríbenos por WhatsApp. Te respondemos en horario hábil con precio y tiempo de entrega." },
 { num: 2, title: "Aprueba tu Diseño", desc: "Para personalizadas te enviamos prueba de diseño digital sin costo. Para estándar confirmamos medidas y cantidad." },
 { num: 3, title: "Coordinamos el suministro", desc: "Confirmamos materiales, especificaciones y fecha de entrega según el pedido con talleres aliados." },
 { num: 4, title: "Entrega a tu Puerta", desc: "Llevamos tu pedido directo a tu negocio, bodega o domicilio en CDMX y Estado de México. Factura incluida." },
];

const faqs = [
 {
 id:  "1",
 question: "¿Dónde comprar cajas de cartón al mayoreo en CDMX?",
