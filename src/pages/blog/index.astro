---
import PageLayout from "@/layouts/PageLayout.astro";
import BlogCard   from "@/components/BlogCard.astro";
import "@/styles/blog.css";
import { getCollection } from "astro:content";

const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPosts = allPosts.filter(p => p.data.featured);
const regularPosts  = allPosts;

const categories = ["Guías", "E-commerce", "Industria", "Sostenibilidad", "Consejos"] as const;

const recentPosts = allPosts.slice(0, 5);

const SITE = "https://cajas-de-carton.com";

const schemaBlog = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog CADECA — Guías y Consejos de Empaque",
  "description": "Artículos especializados sobre cajas de cartón corrugado, empaques para e-commerce, industria y sostenibilidad en CDMX.",
  "url": `${SITE}/blog`,
  "publisher": {
    "@type": "Organization",
    "name": "CADECA",
    "logo": { "@type": "ImageObject", "url": `${SITE}/img/cadeca-logo.png` },
  },
  "blogPost": allPosts.map(post => ({
    "@type": "BlogPosting",
    "headline": post.data.title,
    "description": post.data.description,
    "datePublished": post.data.pubDate.toISOString(),
    "url": `${SITE}/blog/${post.slug}`,
    "author": { "@type": "Organization", "name": post.data.author },
  })),
};
---

<PageLayout
  title="Blog CADECA — Guías y Consejos de Cajas de Cartón | CDMX"
  description="Artículos especializados sobre cajas de cartón corrugado, empaques para e-commerce, industria, sostenibilidad y consejos prácticos para tu negocio en CDMX."
  schema={schemaBlog}
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Blog" }]}
>
  <main id="contenido-principal">

    <!-- Hero -->
    <section class="blog-hero">
      <div class="container">
        <h1 class="blog-hero__title">Blog CADECA</h1>
        <p class="blog-hero__subtitle">Guías, consejos y tendencias sobre empaques de cartón corrugado para tu negocio</p>
      </div>
    </section>

    <!-- Category Filter -->
    <div class="container" style="padding-top: var(--spacing-xl);">
      <div class="blog-categories">
        <a href="/blog" class="blog-categories__link blog-categories__link--active">Todos</a>
        {categories.map(cat => {
          const catSlug = cat.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-");
          return <a href={`/blog/categoria/${catSlug}`} class="blog-categories__link">{cat}</a>;
        })}
      </div>
    </div>

    <div class="container">
      <div class="blog-layout">
        <div>
          <!-- Featured -->
          {featuredPosts.length > 0 && (
            <section>
              <h2 style="font-size: var(--font-size-2xl); font-weight: 700; color: var(--color-secondary); margin: 0 0 var(--spacing-lg);">Artículos destacados</h2>
              <div class="blog-featured">
                {featuredPosts.map(post => (
                  <BlogCard
                    title={post.data.title}
                    slug={post.slug}
                    description={post.data.description}
                    pubDate={post.data.pubDate}
                    category={post.data.category}
                    readingTime={post.data.readingTime}
                    image={post.data.image}
                    imageAlt={post.data.imageAlt}
                    featured={true}
                  />
                ))}
              </div>
            </section>
          )}

          <!-- All Posts -->
          <section style="margin-top: var(--spacing-2xl);">
            <h2 style="font-size: var(--font-size-2xl); font-weight: 700; color: var(--color-secondary); margin: 0 0 var(--spacing-lg);">Todos los artículos</h2>
            <div class="blog-grid">
              {regularPosts.map(post => (
                <BlogCard
                  title={post.data.title}
                  slug={post.slug}
                  description={post.data.description}
                  pubDate={post.data.pubDate}
                  category={post.data.category}
                  readingTime={post.data.readingTime}
                  image={post.data.image}
                  imageAlt={post.data.imageAlt}
                />
              ))}
            </div>
          </section>
        </div>

        <!-- Sidebar -->
        <aside class="blog-sidebar">
          <!-- Categories -->
          <div class="blog-sidebar__section">
            <h3 class="blog-sidebar__title">Categorías</h3>
            <ul class="blog-sidebar__list">
              {categories.map(cat => {
                const catSlug = cat.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-");
                const count = allPosts.filter(p => p.data.category === cat).length;
                return (
                  <li>
                    <a href={`/blog/categoria/${catSlug}`}>{cat} ({count})</a>
                  </li>
                );
              })}
            </ul>
          </div>

          <!-- Recent -->
          <div class="blog-sidebar__section">
            <h3 class="blog-sidebar__title">Recientes</h3>
            <ul class="blog-sidebar__list">
              {recentPosts.map(post => (
                <li>
                  <a href={`/blog/${post.slug}`}>{post.data.title}</a>
                </li>
              ))}
            </ul>
          </div>

          <!-- CTA -->
          <div class="blog-sidebar__cta">
            <h3>¿Necesitas cajas?</h3>
            <p>Cotiza sin compromiso. Entrega en 24 hrs en CDMX.</p>
            <a href="/cotizar" class="btn">Solicitar cotización</a>
          </div>
        </aside>
      </div>
    </div>

  </main>
</PageLayout>
