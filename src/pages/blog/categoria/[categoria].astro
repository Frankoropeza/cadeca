---
import PageLayout from "@/layouts/PageLayout.astro";
import BlogCard  from "@/components/BlogCard.astro";
import PageHero from "@/components/PageHero.astro";
import "@/styles/blog.css";
import { getCollection } from "astro:content";

const categoryMap: Record<string, string> = {
 "guias": "Guías",
 "e-commerce": "E-commerce",
 "industria": "Industria",
 "sostenibilidad": "Sostenibilidad",
 "consejos": "Consejos",
};

export async function getStaticPaths() {
 const slugs = ["guias", "e-commerce", "industria", "sostenibilidad", "consejos"];
 return slugs.map(slug => ({ params: { categoria: slug } }));
}

const { categoria } = Astro.params;
const categoryName = categoryMap[categoria!] || categoria;

const todos = await getCollection("blog");
const allPosts = todos
 .filter(p => p.data.category === categoryName)
 .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ["Guías", "E-commerce", "Industria", "Sostenibilidad", "Consejos"] as const;


const heroCategoria: Record<string, { title: string; desc: string; desc2: string }> = {
 "Guías": {
  title: "Guías de <span>cajas de cartón</span> y empaque",
  desc: "Guías prácticas para elegir, medir y comprar cajas de cartón corrugado: tipos de flauta, resistencia ECT, medidas y embalaje para tu negocio.",
  desc2: "Cada guía explica un tema de empaque paso a paso: cómo <strong>calcular las medidas de una caja</strong>, qué diferencia hay entre pared simple, doble y triple, y cómo leer una especificación técnica antes de cotizar.||Están pensadas para compras, logística y emprendedores de CDMX y Estado de México que necesitan decidir con datos y evitar cajas sobredimensionadas o poco resistentes.",
 },
 "E-commerce": {
  title: "Empaque para <span>e-commerce</span> y envíos",
  desc: "Artículos sobre cajas de cartón para envíos: peso volumétrico, requisitos de Amazon y Mercado Libre, protección del producto y experiencia de unboxing.",
  desc2: "Aquí reunimos lo que una tienda en línea necesita saber para elegir <strong>cajas para envíos</strong>: medidas que reducen el costo de paquetería, resistencia adecuada y reglas de los marketplaces.||También abordamos devoluciones, empaque de temporada alta y cómo escalar la operación de empaque cuando crecen los pedidos.",
 },
 "Industria": {
  title: "Cajas de cartón para la <span>industria</span>",
  desc: "Artículos técnicos sobre cartón corrugado para manufactura, alimentos, farmacéutica, automotriz y exportación: normas, especificaciones y buenas prácticas.",
  desc2: "Explicamos cómo se especifica el <strong>cartón corrugado industrial</strong>: resistencia ECT y BCT, tipos de flauta, embalaje para exportación y requisitos por sector.||El objetivo es que el área de compras y la de calidad hablen el mismo idioma con su proveedor y documenten el empaque correcto para cada producto.",
 },
 "Sostenibilidad": {
  title: "Empaque de cartón <span>sustentable</span>",
  desc: "Artículos sobre cartón reciclado, economía circular, alternativas al plástico y huella de carbono del empaque para empresas en México.",
  desc2: "Revisamos con datos cuándo conviene el <strong>cartón reciclado</strong> frente al virgen, qué alternativas existen al plástico de burbuja y cómo reportar el impacto del empaque.||Son lecturas útiles para marcas que quieren reducir material sin sacrificar la protección del producto durante el transporte.",
 },
 "Consejos": {
  title: "Consejos para comprar <span>cajas de cartón</span>",
  desc: "Consejos para comprar, almacenar y negociar cajas de cartón: control de calidad, inventario de empaques y errores comunes al elegir proveedor.",
  desc2: "Reunimos recomendaciones prácticas para <strong>comprar cajas de cartón</strong> con menos riesgo: qué revisar al recibir un pedido, cómo almacenar el cartón y cómo planear el reabasto.||Cada consejo parte de situaciones reales de compra y logística en CDMX y Estado de México, sin tecnicismos innecesarios.",
 },
};
const hero = heroCategoria[categoryName!] ?? { title: `<span>${categoryName}</span>`, desc: `Artículos sobre ${categoryName?.toLowerCase()} en el blog de CADECA.`, desc2: "" };

const SITE = "https://cajas-de-carton.com";

const schemaCollection = {
 "@context": "https://schema.org",
 "@type": "CollectionPage",
 "name": `${categoryName} — Blog CADECA`,
 "description": `Artículos sobre ${categoryName?.toLowerCase()} en el blog de CADECA.`,
 "url": `${SITE}/blog/categoria/${categoria}/`,
 "publisher": { "@type": "Organization", "name": "CADECA" },
};
---

<PageLayout
 title={`${categoryName} — Blog CADECA | Cajas de Cartón CDMX`}
 description={`Artículos sobre ${categoryName?.toLowerCase()} — guías, consejos y tendencias de empaques de cartón corrugado para tu negocio.`}
 schema={schemaCollection}
 breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Blog", href: "/blog/" }, { name: categoryName! }]}
>
 <main id="contenido-principal">

 <PageHero eyebrow={`Blog · ${categoryName}`} titleHtml={true} title={hero.title} desc={hero.desc} desc2={hero.desc2} />

 <!-- Filtro de categorías (mismo componente visual que /blog/) -->
 <div class="blog-filter-bar">
 <div class="container">
 <div class="blog-filter-bar__inner">
 <a href="/blog/" class="blog-filter-bar__link">
 Todos <span class="blog-filter-bar__count">{todos.length}</span>
 </a>
 {categories.map(cat => {
 const catSlug = cat.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-");
 const isActive = catSlug === categoria;
 const count = todos.filter(p => p.data.category === cat).length;
 return (
 <a href={`/blog/categoria/${catSlug}/`} class={`blog-filter-bar__link${isActive ? " blog-filter-bar__link--active" : ""}`} aria-current={isActive ? "page" : undefined}>
 {cat}
 {count > 0 && <span class="blog-filter-bar__count">{count}</span>}
 </a>
 );
 })}
 </div>
 </div>
 </div>

 <div class="container" style="padding-top: var(--spacing-xl); padding-bottom: var(--spacing-3xl);">
 {allPosts.length > 0 ? (
 <div class="blog-grid">
 {allPosts.map(post => (
 <BlogCard
 title={post.data.title}
 slug={post.slug}
 description={post.data.description}
 pubDate={post.data.pubDate}
 category={post.data.category}
 readingTime={post.data.readingTime}
 image={post.data.image}
 imageAlt={post.data.imageAlt}
 />
 ))}
 </div>
 ) : (
 <div style="text-align: center; padding: var(--spacing-3xl) 0;">
 <p style="font-size: var(--font-size-lg); color: var(--color-text-light);">Aún no hay artículos en esta categoría.</p>
 <a href="/blog/" class="btn btn--primary" style="margin-top: var(--spacing-lg);">Ver todos los artículos</a>
 </div>
 )}
 </div>

 </main>
</PageLayout>
