---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Cajas de Cartón Naucalpan / Tlalnepantla — Entrega 24 hrs · Fabricante Directo | CADECA";
const description = "Cajas de cartón corrugado con entrega en 24 hrs en Naucalpan / Tlalnepantla. Fabricante directo, sin intermediarios. Cajas estándar, a la medida y personalizadas. Cotiza gratis.";
const canonical   = SITE + "/zonas-de-servicio/naucalpan-tlalnepantla";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "CADECA — Cajas de Cartón Naucalpan / Tlalnepantla",
    "description": description,
    "url": canonical,
    "areaServed": ["Naucalpan de Juárez", "Tlalnepantla de Baz"],
    "address": { "@type": "PostalAddress", "addressRegion": "Estado de México", "addressCountry": "MX" },
    "priceRange": "$$"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Cuánto tarda la entrega en el Parque Industrial Naucalpan?", "acceptedAnswer": { "@type": "Answer", "text": "Para pedidos en stock la entrega es de 24 hrs hábiles. Para producción bajo pedido: 3-5 días de fabricación más entrega." } },
    { "@type": "Question", "name": "¿Tienen capacidad para abastecer líneas de producción en Tlalnepantla?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, trabajamos con empresas industriales con abasto continuo. Podemos establecer contratos de suministro mensual con precio fijo y entrega programada." } },
    { "@type": "Question", "name": "¿Hacen cajas triple pared para exportación?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, fabricamos cajas de doble y triple pared para embalaje de exportación cumpliendo normas ASTM e ISTA." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",            href: "/" },
    { name: "Zonas de Servicio", href: "/zonas-de-servicio" },
    { name: "Naucalpan / Tlalnepantla" },
  ]}
  whatsapp={WHATSAPP}
>

  {/* ════════ HERO — idéntico al index ════════ */}
  <section class="hero">
    <div class="container">
      <div class="hero__inner">

        <div class="hero__left">
          <p class="hero__badge">Municipios: Naucalpan de Juárez · Tlalnepantla de Baz</p>
          <h1 class="hero__title">
            Cajas de Cartón en<br><span>Naucalpan / Tlalnepantla</span>
          </h1>
          <p class="hero__intro">Cajas de cartón corrugado para el corredor manufacturero más importante del Estado de México. Entrega directa en 24 hrs en toda la zona industrial.</p>
          <div class="hero__ctas">
            <a href="/cotizar" class="btn btn--primary btn--lg">Cotizar cajas ahora</a>
            <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+necesito+cajas+en+Naucalpan+%2F+Tlalnepantla"}
               class="btn btn--outline btn--lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp</a>
          </div>
          <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">24 hrs</span>
            <span class="hero__metric-label">Entrega exprés</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">Ilimitado</span>
            <span class="hero__metric-label">Capacidad de prod.</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">15+</span>
            <span class="hero__metric-label">Años en la zona</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">2 hrs</span>
            <span class="hero__metric-label">Cotización</span>
          </div>
          </div>
        </div>

        <div class="hero__right">
          <p>CADECA atiende a la <strong>zona industrial de Naucalpan y Tlalnepantla</strong>, uno de los corredores manufactureros más importantes del país. Cientos de empresas industriales, laboratorios farmacéuticos, distribuidoras y plantas de manufactura reciben nuestras cajas de cartón corrugado con entregas en 24 horas.</p>
          <p>Suministramos <strong>cajas corrugadas industriales de doble y triple pared, cajas farmacéuticas y empaques a la medida</strong> para el corredor industrial Naucalpan-Tlalnepantla. Programa de suministro continuo para empresas con consumo semanal. Fabricante directo, precios competitivos y cotización en menos de 2 horas.</p>
        </div>

      </div>
    </div>
  </section>

  {/* ════════ VENTAJAS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"¿Por qué elegir CADECA en Naucalpan / Tlalnepantla?"}
        subtitle="Fabricante directo con entrega propia — sin intermediarios, sin costos ocultos"
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Mayor corredor industrial del EDOMEX</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Entrega exprés 24 hrs en parques industriales</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Cajas industriales doble y triple pared</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Suministro continuo para líneas de producción</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ INDUSTRIAS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Industrias y sectores en Naucalpan / Tlalnepantla"}
        subtitle="Atendemos todos los sectores productivos de la zona"
      />
      <ul class="tag-cloud">
          <li class="tag-item">Autopartes y manufactura OEM</li>
          <li class="tag-item">Farmacéutica y cosmética</li>
          <li class="tag-item">Electrónica y tecnología</li>
          <li class="tag-item">Alimentos y bebidas</li>
      </ul>
    </div>
  </section>

  {/* ════════ PRODUCTOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"Productos más solicitados en Naucalpan / Tlalnepantla"}
        subtitle="Cajas en stock con entrega exprés · Sin mínimos restrictivos"
      />
      <div class="products__grid">
          <ProductCard
            title="Corrugado Estándar"
            desc="24 hrs en stock"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar en CDMX — CADECA"
            href="/catalogo/cajas-corrugado-estandar"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Líneas de producción"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida en CDMX — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Industrial Triple Pared"
            desc="Exportación ASTM"
            imgSrc="/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif"
            imgAlt="Industrial Triple Pared en CDMX — CADECA"
            href="/catalogo/cajas-industriales-triple-pared"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas Personalizadas"
            desc="Con logo e impresión"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas Personalizadas en CDMX — CADECA"
            href="/catalogo/cajas-personalizadas-con-logo"
            btnText="Ver detalles"
          />
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Preguntas frecuentes — Naucalpan / Tlalnepantla"}
        subtitle="Todo sobre nuestro servicio de entrega en tu zona"
      />
      <div class="faq-list" role="list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-naucalpan-tlalnepantla-0">
              <span>¿Cuánto tarda la entrega en el Parque Industrial Naucalpan?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-naucalpan-tlalnepantla-0">
              <p>Para pedidos en stock la entrega es de 24 hrs hábiles. Para producción bajo pedido: 3-5 días de fabricación más entrega.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-naucalpan-tlalnepantla-1">
              <span>¿Tienen capacidad para abastecer líneas de producción en Tlalnepantla?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-naucalpan-tlalnepantla-1">
              <p>Sí, trabajamos con empresas industriales con abasto continuo. Podemos establecer contratos de suministro mensual con precio fijo y entrega programada.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-naucalpan-tlalnepantla-2">
              <span>¿Hacen cajas triple pared para exportación?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-naucalpan-tlalnepantla-2">
              <p>Sí, fabricamos cajas de doble y triple pared para embalaje de exportación cumpliendo normas ASTM e ISTA.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <LeadCapture
    titulo={"Cotiza cajas en Naucalpan / Tlalnepantla"}
    subtitulo="Fabricante directo · Cotización en menos de 2 horas · Entrega en 24 hrs"
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
/* ── Secciones generales ── */
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface,#f8f9fb); }

/* ── Feature grid (ventajas) ── */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* ── Tag cloud (industrias) ── */
.tag-cloud {
  list-style: none; padding: 0;
  display: flex; flex-wrap: wrap; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  justify-content: center;
}
.tag-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-primary);
  border-radius: var(--border-radius);
  padding: 0.5rem 1.25rem;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-secondary);
}


/* ── FAQ ── */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }
@media(min-width:1024px){ .products__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
