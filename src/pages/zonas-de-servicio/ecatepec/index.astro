---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Cajas de Cartón Ecatepec de Morelos — Entrega 24-48 hrs · Fabricante Directo | CADECA";
const description = "Cajas de cartón corrugado con entrega en 24-48 hrs en Ecatepec de Morelos. Fabricante directo, sin intermediarios. Cajas estándar, a la medida y personalizadas. Cotiza gratis.";
const canonical   = SITE + "/zonas-de-servicio/ecatepec";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "CADECA — Cajas de Cartón Ecatepec de Morelos",
    "description": description,
    "url": canonical,
    "areaServed": ["Ecatepec de Morelos"],
    "address": { "@type": "PostalAddress", "addressRegion": "Estado de México", "addressCountry": "MX" },
    "priceRange": "$$"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Entregan en los parques industriales de Ecatepec?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, cubrimos todos los parques industriales de Ecatepec con entregas en 24-48 hrs hábiles." } },
    { "@type": "Question", "name": "¿Hacen cotizaciones para grandes volúmenes?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, tenemos precios especiales para volúmenes de más de 1,000 piezas mensuales." } },
    { "@type": "Question", "name": "¿Ofrecen suministro programado en Ecatepec?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, establecemos contratos de suministro con entregas periódicas y precio fijo para empresas con consumo constante." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",            href: "/" },
    { name: "Zonas de Servicio", href: "/zonas-de-servicio" },
    { name: "Ecatepec de Morelos" },
  ]}
  whatsapp={WHATSAPP}
>

  {/* ════════ HERO — idéntico al index ════════ */}
  <section class="hero">
    <div class="container">
      <div class="hero__inner">

        <div class="hero__left">
          <p class="hero__badge">Municipio: Ecatepec de Morelos · EDOMEX</p>
          <h1 class="hero__title">
            Cajas de Cartón en<br><span>Ecatepec de Morelos</span>
          </h1>
          <p class="hero__intro">Cajas de cartón corrugado para la zona industrial de Ecatepec. Fabricante directo con entrega en 24-48 hrs en parques industriales y bodegas.</p>
          <div class="hero__ctas">
            <a href="/cotizar" class="btn btn--primary btn--lg">Cotizar cajas ahora</a>
            <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+necesito+cajas+en+Ecatepec"}
               class="btn btn--outline btn--lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp</a>
          </div>
          <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">24-48 hrs</span>
            <span class="hero__metric-label">Entrega en Ecatepec</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">50+</span>
            <span class="hero__metric-label">Piezas mínimo</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">Mayor</span>
            <span class="hero__metric-label">Mpio del EDOMEX</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">2 hrs</span>
            <span class="hero__metric-label">Cotización</span>
          </div>
          </div>
        </div>

        <div class="hero__right">
          <p>CADECA distribuye <strong>cajas de cartón corrugado en Ecatepec de Morelos</strong>, el municipio más poblado del Estado de México con una de las mayores concentraciones industriales del país. Entregamos en parques industriales, bodegas y comercios de Ecatepec en 24-48 horas.</p>
          <p>Para la industria de <strong>Ecatepec: cajas corrugadas estándar y a la medida, empaques para alimentos, cajas para e-commerce y empaques industriales</strong>. Pedidos desde 50 piezas con entrega directa. CADECA es el proveedor de cajas más solicitado en el oriente del Estado de México. Cotiza ahora.</p>
        </div>

      </div>
    </div>
  </section>

  {/* ════════ VENTAJAS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"¿Por qué elegir CADECA en Ecatepec de Morelos?"}
        subtitle="Fabricante directo con entrega propia — sin intermediarios, sin costos ocultos"
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Entrega en 24-48 hrs en toda la zona industrial</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Atención a comercios y distribuidoras de Ecatepec</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Cajas estándar, a la medida y personalizadas</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Suministro continuo para empresas de manufactura</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ INDUSTRIAS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Industrias y sectores en Ecatepec de Morelos"}
        subtitle="Atendemos todos los sectores productivos de la zona"
      />
      <ul class="tag-cloud">
          <li class="tag-item">Manufactura automotriz y metalmecánica</li>
          <li class="tag-item">Distribución y logística</li>
          <li class="tag-item">Comercio y retail</li>
          <li class="tag-item">Alimentos y bebidas</li>
      </ul>
    </div>
  </section>

  {/* ════════ PRODUCTOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"Productos más solicitados en Ecatepec de Morelos"}
        subtitle="Cajas en stock con entrega exprés · Sin mínimos restrictivos"
      />
      <div class="products__grid">
          <ProductCard
            title="Corrugado Estándar"
            desc="Stock permanente"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar en CDMX — CADECA"
            href="/catalogo/cajas-corrugado-estandar"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Producción 3-5 días"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida en CDMX — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas E-commerce"
            desc="Para envíos y fulfillment"
            imgSrc="/img/productos/cajas-de-carton-para-ecommerce-mercado-libre-amazon-cdmx.avif"
            imgAlt="Cajas E-commerce en CDMX — CADECA"
            href="/catalogo/cajas-ecommerce-mercado-libre"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Industrial Triple Pared"
            desc="Para manufactura pesada"
            imgSrc="/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif"
            imgAlt="Industrial Triple Pared en CDMX — CADECA"
            href="/catalogo/cajas-industriales-triple-pared"
            btnText="Ver detalles"
          />
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Preguntas frecuentes — Ecatepec de Morelos"}
        subtitle="Todo sobre nuestro servicio de entrega en tu zona"
      />
      <div class="faq-list" role="list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-ecatepec-0">
              <span>¿Entregan en los parques industriales de Ecatepec?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-ecatepec-0">
              <p>Sí, cubrimos todos los parques industriales de Ecatepec con entregas en 24-48 hrs hábiles.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-ecatepec-1">
              <span>¿Hacen cotizaciones para grandes volúmenes?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-ecatepec-1">
              <p>Sí, tenemos precios especiales para volúmenes de más de 1,000 piezas mensuales.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-ecatepec-2">
              <span>¿Ofrecen suministro programado en Ecatepec?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-ecatepec-2">
              <p>Sí, establecemos contratos de suministro con entregas periódicas y precio fijo para empresas con consumo constante.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <LeadCapture
    titulo={"Cotiza cajas en Ecatepec de Morelos"}
    subtitulo="Fabricante directo · Cotización en menos de 2 horas · Entrega en 24-48 hrs"
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
/* ── Secciones generales ── */
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface,#f8f9fb); }

/* ── Feature grid (ventajas) ── */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* ── Tag cloud (industrias) ── */
.tag-cloud {
  list-style: none; padding: 0;
  display: flex; flex-wrap: wrap; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  justify-content: center;
}
.tag-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-primary);
  border-radius: var(--border-radius);
  padding: 0.5rem 1.25rem;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-secondary);
}


/* ── FAQ ── */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }
@media(min-width:1024px){ .products__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
