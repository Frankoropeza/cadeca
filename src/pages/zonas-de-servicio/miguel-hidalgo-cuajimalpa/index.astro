---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Cajas de Cartón Miguel Hidalgo / Cuajimalpa — Entrega 24-48 hrs · Fabricante Directo | CADECA";
const description = "Cajas de cartón corrugado con entrega en 24-48 hrs en Miguel Hidalgo / Cuajimalpa. Fabricante directo, sin intermediarios. Cajas estándar, a la medida y personalizadas. Cotiza gratis.";
const canonical   = SITE + "/zonas-de-servicio/miguel-hidalgo-cuajimalpa";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "CADECA — Cajas de Cartón Miguel Hidalgo / Cuajimalpa",
    "description": description,
    "url": canonical,
    "areaServed": ["Miguel Hidalgo", "Cuajimalpa"],
    "address": { "@type": "PostalAddress", "addressRegion": "Ciudad de México", "addressCountry": "MX" },
    "priceRange": "$$"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Hacen packaging premium con acabados especiales?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, ofrecemos barniz UV, laminado mate y brillante para cajas de alta presentación en Polanco y zonas corporativas." } },
    { "@type": "Question", "name": "¿Entregan en Santa Fe y Lomas?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, tenemos rutas de entrega en todo el corredor corporativo: Polanco, Santa Fe, Lomas, Tecamachalco y Cuajimalpa." } },
    { "@type": "Question", "name": "¿Pueden hacer cajas para gift boxes o presentación?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, fabricamos cajas especiales para presentación de productos premium con diseño personalizado." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",            href: "/" },
    { name: "Zonas de Servicio", href: "/zonas-de-servicio" },
    { name: "Miguel Hidalgo / Cuajimalpa" },
  ]}
  whatsapp={WHATSAPP}
>

  {/* ════════ HERO — idéntico al index ════════ */}
  <section class="hero">
    <div class="container">
      <div class="hero__inner">

        <div class="hero__left">
          <p class="hero__badge">Polanco · Lomas · Santa Fe · Cuajimalpa</p>
          <h1 class="hero__title">
            Cajas de Cartón en<br><span>Miguel Hidalgo / Cuajimalpa</span>
          </h1>
          <p class="hero__intro">Packaging premium y cajas personalizadas para empresas del corredor corporativo de CDMX: Polanco, Santa Fe, Lomas y Cuajimalpa.</p>
          <div class="hero__ctas">
            <a href="/cotizar" class="btn btn--primary btn--lg">Cotizar cajas ahora</a>
            <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+necesito+cajas+en+Miguel+Hidalgo+%2F+Polanco"}
               class="btn btn--outline btn--lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp</a>
          </div>
          <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">24-48 hrs</span>
            <span class="hero__metric-label">Entrega en la zona</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">4 colores</span>
            <span class="hero__metric-label">Impresión full color</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">100+</span>
            <span class="hero__metric-label">Piezas con logo</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">2 hrs</span>
            <span class="hero__metric-label">Cotización</span>
          </div>
          </div>
        </div>

        <div class="hero__right">
          <p>CADECA provee <strong>cajas de cartón corrugado a empresas en Miguel Hidalgo y Cuajimalpa</strong>, alcaldías con alta concentración corporativa, hotelería y negocios de gama alta en CDMX. Polanco, Lomas, Santa Fe y Las Lomas son zonas donde la calidad del empaque refleja la imagen de la marca.</p>
          <p>Empaques personalizados con impresión full color, cajas de lujo para retail y packaging premium para empresas en Miguel Hidalgo y Cuajimalpa. Entregas discretas en <strong>24-48 horas</strong>, facturas fiscales y atención comercial de primer nivel. CADECA: el proveedor de empaques del corredor empresarial de CDMX.</p>
        </div>

      </div>
    </div>
  </section>

  {/* ════════ VENTAJAS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"¿Por qué elegir CADECA en Miguel Hidalgo / Cuajimalpa?"}
        subtitle="Fabricante directo con entrega propia — sin intermediarios, sin costos ocultos"
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Packaging premium para marcas corporativas</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Entregas discretas en Polanco, Santa Fe y Lomas</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Cajas con logo de alta calidad de impresión</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Atención a hotelería, restaurantes y retail</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ INDUSTRIAS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Industrias y sectores en Miguel Hidalgo / Cuajimalpa"}
        subtitle="Atendemos todos los sectores productivos de la zona"
      />
      <ul class="tag-cloud">
          <li class="tag-item">Corporativos y servicios financieros</li>
          <li class="tag-item">Hotelería y hospitalidad</li>
          <li class="tag-item">Retail de lujo y moda</li>
          <li class="tag-item">Gastronomía y eventos corporativos</li>
      </ul>
    </div>
  </section>

  {/* ════════ PRODUCTOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"Productos más solicitados en Miguel Hidalgo / Cuajimalpa"}
        subtitle="Cajas en stock con entrega exprés · Sin mínimos restrictivos"
      />
      <div class="products__grid">
          <ProductCard
            title="Cajas con Logo"
            desc="Impresión premium 4 colores"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas con Logo en CDMX — CADECA"
            href="/catalogo/cajas-personalizadas-con-logo"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Diseño CAD incluido"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida en CDMX — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Packaging Sustentable"
            desc="FSC certificado"
            imgSrc="/img/productos/laminas-carton-corrugado-ecologico-reciclado-fsc-cdmx.avif"
            imgAlt="Packaging Sustentable en CDMX — CADECA"
            href="/catalogo/packaging-ecologico"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas para Alimentos"
            desc="Para restaurantes y catering"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Cajas para Alimentos en CDMX — CADECA"
            href="/catalogo/cajas-para-alimentos"
            btnText="Ver detalles"
          />
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Preguntas frecuentes — Miguel Hidalgo / Cuajimalpa"}
        subtitle="Todo sobre nuestro servicio de entrega en tu zona"
      />
      <div class="faq-list" role="list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-miguel-hidalgo-cuajimalpa-0">
              <span>¿Hacen packaging premium con acabados especiales?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-miguel-hidalgo-cuajimalpa-0">
              <p>Sí, ofrecemos barniz UV, laminado mate y brillante para cajas de alta presentación en Polanco y zonas corporativas.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-miguel-hidalgo-cuajimalpa-1">
              <span>¿Entregan en Santa Fe y Lomas?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-miguel-hidalgo-cuajimalpa-1">
              <p>Sí, tenemos rutas de entrega en todo el corredor corporativo: Polanco, Santa Fe, Lomas, Tecamachalco y Cuajimalpa.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-miguel-hidalgo-cuajimalpa-2">
              <span>¿Pueden hacer cajas para gift boxes o presentación?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-miguel-hidalgo-cuajimalpa-2">
              <p>Sí, fabricamos cajas especiales para presentación de productos premium con diseño personalizado.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <LeadCapture
    titulo={"Cotiza cajas en Miguel Hidalgo / Cuajimalpa"}
    subtitulo="Fabricante directo · Cotización en menos de 2 horas · Entrega en 24-48 hrs"
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
/* ── Secciones generales ── */
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface,#f8f9fb); }

/* ── Feature grid (ventajas) ── */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* ── Tag cloud (industrias) ── */
.tag-cloud {
  list-style: none; padding: 0;
  display: flex; flex-wrap: wrap; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  justify-content: center;
}
.tag-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-primary);
  border-radius: var(--border-radius);
  padding: 0.5rem 1.25rem;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-secondary);
}


/* ── FAQ ── */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }
@media(min-width:1024px){ .products__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
