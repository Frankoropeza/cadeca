<style>
/* ── Hero → reemplazado por PageHero.astro ── */

/* ── Chips ── */
.zona-chip { display: inline-flex; align-items: center; gap: 0.3rem; font-size: var(--font-size-xs); font-weight: 700; padding: 0.3rem 0.7rem; border-radius: 100px; }
.zona-chip--green { background: rgba(34,197,94,0.15); color: #16a34a; border: 1px solid rgba(34,197,94,0.3); }
.zona-chip--blue  { background: rgba(59,130,246,0.15); color: #2563eb; border: 1px solid rgba(59,130,246,0.3); }

/* ── Zonas grid ── */
.zonas-section { padding: var(--spacing-3xl) 0; }
.zonas-section--alt { background: var(--color-accent); }
