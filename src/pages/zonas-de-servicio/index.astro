---
import PageLayout    from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FaqItem       from "@/components/FaqItem.astro";
import LeadCapture   from "@/components/LeadCapture.astro";
import PageHero      from "@/components/PageHero.astro";

const WHATSAPP = "5255XXXXXXXX";

const title       = "Zonas de Servicio Cajas de Cartón CDMX y Estado de México | CADECA";
const description = "CADECA entrega cajas de cartón corrugado en toda la ZMVM. CDMX, Naucalpan, Tlalnepantla, Ecatepec, Toluca, Cuautitlán y más. Entrega express 24 hrs. Fabricante directo.";

const breadcrumbs = [
  { name: "Inicio", href: "/" },
  { name: "Zonas de Servicio" },
];

const faqs = [
  {
    question: "¿Cuánto tiempo tarda la entrega en CDMX?",
    answer: "Para productos en stock (cajas estándar, Mercado Envíos, Amazon FBA) la entrega en CDMX es en 24 horas hábiles desde la confirmación del pedido. Para pedidos de producción bajo pedido, el tiempo es de 3 a 5 días hábiles más el tiempo de entrega según zona.",
  },
  {
    question: "¿Tienen costo de envío o entrega a domicilio?",
    answer: "Para pedidos mayores a cierto volumen (consultar con asesor) la entrega en CDMX y zona metropolitana es sin costo adicional. Para pedidos pequeños o zonas alejadas se aplica costo de flete según cotización. En todos los casos informamos el costo antes de confirmar el pedido.",
  },
  {
    question: "¿Pueden entregar en el interior de la República?",
    answer: "Sí. Para clientes fuera de la ZMVM enviamos vía paquetería (DHL, FedEx, Estafeta, J&T) con el costo a cargo del cliente. El tiempo de entrega varía de 2 a 5 días hábiles según el destino. Consulta disponibilidad para tu ciudad.",
  },
  {
    question: "¿Puedo recoger directamente en planta?",
    answer: "Sí. Nuestras instalaciones están en CDMX y puedes coordinar la recolección directa para ahorrar el costo de flete. Comunícate con tu asesor para agendar la fecha y hora de recolección.",
  },
];

const zonasCDMX = [
  { nombre: "Vallejo / Azcapotzalco",     alcaldias: ["Azcapotzalco","Gustavo A. Madero"],          entrega: "24 hrs",  clase: "zona--destacada" },
  { nombre: "Iztapalapa",                  alcaldias: ["Iztapalapa","Iztacalco"],                      entrega: "24 hrs",  clase: "" },
  { nombre: "Venustiano Carranza / Centro",alcaldias: ["Venustiano Carranza","Cuauhtémoc"],            entrega: "24 hrs",  clase: "" },
  { nombre: "Coyoacán / Benito Juárez",    alcaldias: ["Coyoacán","Benito Juárez","Álvaro Obregón"],   entrega: "24 hrs",  clase: "" },
  { nombre: "Tlalpan / Xochimilco",        alcaldias: ["Tlalpan","Xochimilco","Milpa Alta"],           entrega: "24-48 hrs",clase:"" },
  { nombre: "Miguel Hidalgo / Cuajimalpa", alcaldias: ["Miguel Hidalgo","Cuajimalpa"],                entrega: "24 hrs",  clase: "" },
  { nombre: "Tláhuac / Milpa Alta",        alcaldias: ["Tláhuac","Milpa Alta"],                       entrega: "48 hrs",  clase: "" },
];

const zonasEdomex = [
  { nombre: "Naucalpan / Tlalnepantla",    municipios: ["Naucalpan de Juárez","Tlalnepantla de Baz"], entrega: "24 hrs",  clase: "zona--destacada" },
  { nombre: "Ecatepec",                    municipios: ["Ecatepec de Morelos"],                        entrega: "24-48 hrs",clase:"zona--destacada" },
  { nombre: "Toluca / Lerma / Zinacantepec",municipios:["Toluca","Lerma","Zinacantepec","Metepec"],    entrega: "48 hrs",  clase: "" },
  { nombre: "Cuautitlán Izcalli / Tultitlán",municipios:["Cuautitlán Izcalli","Tultitlán"],           entrega: "24-48 hrs",clase:"" },
  { nombre: "Texcoco / Chimalhuacán",      municipios: ["Texcoco","Chimalhuacán","Los Reyes La Paz"],  entrega: "48 hrs",  clase: "" },
  { nombre: "Chalco / Ixtapaluca",         municipios: ["Chalco","Ixtapaluca","Valle de Chalco"],     entrega: "48 hrs",  clase: "" },
  { nombre: "Atizapán / Nicolás Romero",   municipios: ["Atizapán de Zaragoza","Nicolás Romero"],     entrega: "48 hrs",  clase: "" },
];

const schemaServiceArea = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Entrega de Cajas de Cartón Corrugado en ZMVM",
  "provider": { "@type": "LocalBusiness", "@id": "https://cajas-de-carton.com/#negocio" },
  "areaServed": [
    { "@type": "City", "name": "Ciudad de México", "containedInPlace": { "@type": "Country", "name": "México" } },
    { "@type": "State", "name": "Estado de México", "containedInPlace": { "@type": "Country", "name": "México" } },
  ],
  "hasOfferCatalog": { "@type": "OfferCatalog", "name": "Cajas de Cartón Corrugado", "url": "https://cajas-de-carton.com/catalogo" },
};
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="page"
  breadcrumbs={breadcrumbs}
  faqItems={faqs}
  schema={schemaServiceArea}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><span class="current">Zonas de Servicio</span></li>
      </ol>
    </div>
  </div>

  <PageHero
    eyebrow="CDMX · Estado de México · ZMVM completa"
    titleHtml={true}
    title="Entrega de Cajas de Cartón en <span>Toda la ZMVM</span>"
    desc="Cobertura completa en las 16 alcaldías de CDMX y los principales municipios del Estado de México. Entrega express en 24 horas para productos en stock."
    desc2="Flota propia de reparto en zona metropolitana. Sin costos de envío en pedidos superiores al mínimo. Coordina la recolección directa en planta o recibe en tu negocio, bodega o planta industrial."
    chips={[
      { label: "16 alcaldías CDMX" },
      { label: "6 municipios EDOMEX" },
      { label: "Entrega 24–48 hrs" },
      { label: "Recolección en planta disponible" },
    ]}
    ctas={[
      { href: "/cotizar", label: "Cotizar con entrega", variant: "primary" },
      { href: "/catalogo/", label: "Ver catálogo", variant: "outline" },
    ]}
  />

  <main id="contenido-principal" role="main">

    <!-- CDMX -->
    <section class="zonas-section" aria-labelledby="cdmx-title">
      <div class="container">
        <SectionHeader
          id="cdmx-title"
          title="Ciudad de México — 16 Alcaldías"
          subtitle="Cobertura completa en toda la CDMX. Entrega en 24 hrs para pedidos en stock. Para pedidos de producción: 3-5 días hábiles de fabricación + entrega."
        />
        <div class="zonas-grid">
          {zonasCDMX.map(z => (
            <div class={`zona-card ${z.clase}`}>
              <div class="zona-card__header">
                <h3 class="zona-card__nombre">{z.nombre}</h3>
                <span class={`zona-chip zona-chip--${z.entrega === "24 hrs" ? "green" : "blue"}`}>
                  ⚡ {z.entrega}
                </span>
              </div>
              <p class="zona-card__alcaldias">{z.alcaldias.join(" · ")}</p>
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar cajas de cartón para entregas en ${z.nombre}`} target="_blank" rel="noopener" class="zona-card__cta">
                Cotizar para {z.nombre.split("/")[0].trim()} →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Estado de México -->
    <section class="zonas-section zonas-section--alt" aria-labelledby="edomex-title">
      <div class="container">
        <SectionHeader
          id="edomex-title"
          title="Estado de México — Zona Metropolitana"
          subtitle="Los principales municipios industriales y comerciales del Estado de México. Entrega en 24 a 48 horas según distancia desde nuestra planta en CDMX."
        />
        <div class="zonas-grid">
          {zonasEdomex.map(z => (
            <div class={`zona-card ${z.clase}`}>
              <div class="zona-card__header">
                <h3 class="zona-card__nombre">{z.nombre}</h3>
                <span class={`zona-chip zona-chip--${z.entrega === "24 hrs" ? "green" : "blue"}`}>
                  ⚡ {z.entrega}
                </span>
              </div>
              <p class="zona-card__alcaldias">{z.municipios.join(" · ")}</p>
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar cajas de cartón para entregas en ${z.nombre}`} target="_blank" rel="noopener" class="zona-card__cta">
                Cotizar para {z.nombre.split("/")[0].trim()} →
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Cómo funciona -->
    <section class="zonas-proceso" aria-labelledby="proceso-title">
      <div class="container">
        <SectionHeader
          id="proceso-title"
          centered
          title="¿Cómo Funciona la Entrega?"
          subtitle="Del pedido a tu almacén sin complicaciones."
        />
        <div class="proceso-steps">
          <div class="proceso-step">
            <span class="proceso-step__num">01</span>
            <h3 class="proceso-step__titulo">Cotiza en menos de 1 hora</h3>
            <p class="proceso-step__desc">Envíanos la medida, tipo de caja y cantidad por WhatsApp o formulario. Respondemos con precio y disponibilidad en menos de 60 minutos en horario hábil.</p>
          </div>
          <div class="proceso-step">
            <span class="proceso-step__num">02</span>
            <h3 class="proceso-step__titulo">Confirma y paga</h3>
            <p class="proceso-step__desc">50% de anticipo para arrancar producción. 50% contra entrega o previo. Aceptamos transferencia, tarjeta y efectivo.</p>
          </div>
          <div class="proceso-step">
            <span class="proceso-step__num">03</span>
            <h3 class="proceso-step__titulo">Producimos en 3-5 días</h3>
            <p class="proceso-step__desc">Para cajas en stock: listas en 24 hrs. Para producción bajo pedido: 3-5 días hábiles con calidad ECT verificado en planta.</p>
          </div>
          <div class="proceso-step">
            <span class="proceso-step__num">04</span>
            <h3 class="proceso-step__titulo">Entregamos en tu almacén</h3>
            <p class="proceso-step__desc">Coordinamos la entrega a domicilio en tu zona o puedes recoger directamente en nuestra planta en CDMX. Sin sorpresas en el costo de flete.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="faq" aria-labelledby="faq-zonas-title">
      <div class="container">
        <h2 id="faq-zonas-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Frecuentes sobre Entregas</h2>
        <div class="faq__list">
          {faqs.map((f, i) => <FaqItem id={`z-faq-${i}`} question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>

  </main>

  <!-- Hub de Zonas con cards -->
