---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FaqItem from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import PageHero from "@/components/PageHero.astro";

const title = "Cajas de cartón en CDMX y Estado de México";
const description = "Cajas de cartón corrugado para negocios e industrias de CDMX y Estado de México. Cotiza medidas, cantidad y zona de entrega.";

const breadcrumbs = [
  { name: "Inicio", href: "/" },
  { name: "Zonas de Servicio" },
];

const faqs = [
  { question: "¿En qué zonas de CDMX y Estado de México entregan?", answer: "Atendemos las 16 alcaldías de Ciudad de México y municipios del Estado de México como Atizapán de Zaragoza, Nicolás Romero, Chalco, Ixtapaluca, Cuautitlán Izcalli, Ecatepec, Naucalpan, Nezahualcóyotl, Tlalnepantla, Texcoco, Chimalhuacán, Toluca y Lerma. Confirmamos la cobertura de la dirección al cotizar." },
  { question: "¿Qué información necesitan para cotizar?", answer: "Indica las medidas internas o externas, el tipo de caja, la cantidad, el uso del empaque y la alcaldía o municipio de entrega. Con esos datos podemos orientarte hacia una opción estándar o a la medida." },
  { question: "¿Manejan cajas estándar y cajas a la medida?", answer: "Sí. Puedes solicitar cajas corrugadas estándar, opciones para ecommerce, alimentos, archivo, textil, farmacia y cosmética, o una cotización a la medida según el producto y la forma de manejo." },
  { question: "¿Cómo se define el costo de la entrega?", answer: "Se revisan la cantidad, el volumen, la zona y las condiciones de entrega. El costo y las condiciones aplicables se confirman antes de autorizar el pedido." },
  { question: "¿Pueden programar entregas recurrentes?", answer: "Podemos revisar un esquema de suministro recurrente cuando compartas tu consumo y las fechas que necesitas. La programación se acuerda según el volumen, la zona y la disponibilidad confirmada." },
];

const schemaServiceArea = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Cajas de cartón en CDMX y Estado de México",
  provider: { "@id": "https://cajas-de-carton.com/#org" },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Álvaro Obregón, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Azcapotzalco, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Benito Juárez, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Coyoacán, Ciudad de México" },
    { "@type": "AdministrativeArea", name: "Cuajimalpa de Morelos, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Cuauhtémoc, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Gustavo A. Madero, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Iztacalco, Ciudad de México" },
    { "@type": "AdministrativeArea", name: "Iztapalapa, Ciudad de México" }, { "@type": "AdministrativeArea", name: "La Magdalena Contreras, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Miguel Hidalgo, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Milpa Alta, Ciudad de México" },
    { "@type": "AdministrativeArea", name: "Tláhuac, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Tlalpan, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Venustiano Carranza, Ciudad de México" }, { "@type": "AdministrativeArea", name: "Xochimilco, Ciudad de México" },
    { "@type": "AdministrativeArea", name: "Atizapán de Zaragoza, Estado de México" }, { "@type": "AdministrativeArea", name: "Nicolás Romero, Estado de México" }, { "@type": "AdministrativeArea", name: "Chalco, Estado de México" }, { "@type": "AdministrativeArea", name: "Ixtapaluca, Estado de México" },
    { "@type": "AdministrativeArea", name: "Cuautitlán Izcalli, Estado de México" }, { "@type": "AdministrativeArea", name: "Ecatepec de Morelos, Estado de México" }, { "@type": "AdministrativeArea", name: "Naucalpan de Juárez, Estado de México" }, { "@type": "AdministrativeArea", name: "Nezahualcóyotl, Estado de México" },
    { "@type": "AdministrativeArea", name: "Tlalnepantla de Baz, Estado de México" }, { "@type": "AdministrativeArea", name: "Texcoco, Estado de México" }, { "@type": "AdministrativeArea", name: "Chimalhuacán, Estado de México" }, { "@type": "AdministrativeArea", name: "Toluca, Estado de México" }, { "@type": "AdministrativeArea", name: "Lerma, Estado de México" },
  ],
};
---

<PageLayout title={title} description={description} pageType="page" breadcrumbs={breadcrumbs} faqItems={faqs} schema={schemaServiceArea}>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación"><div class="container"><ol><li><a href="/">Inicio</a></li><li><span class="current">Zonas de Servicio</span></li></ol></div></div>

  <PageHero eyebrow="CDMX · Estado de México" title="Cajas de cartón en CDMX y Estado de México" desc="Cobertura para negocios, comercios, ecommerce y operaciones industriales en las 16 alcaldías de CDMX y municipios del Estado de México." desc2="Cotizamos cajas estándar o a la medida con base en tus medidas, cantidad, uso del empaque y zona de entrega.||Confirma la disponibilidad y la programación de entrega para tu dirección." chips={[{ label: "16 alcaldías CDMX" }, { label: "Municipios del Estado de México" }, { label: "Cajas estándar y a la medida" }]} ctas={[{ href: "/cotizar/", label: "Cotizar cajas", variant: "primary" }, { href: "/catalogo/", label: "Ver catálogo", variant: "outline" }]} />

  <main id="contenido-principal" role="main">
    <section class="zonas-section" aria-labelledby="cdmx-title"><div class="container">
      <SectionHeader id="cdmx-title" title="Ciudad de México" subtitle="Una cobertura por alcaldía, con opciones de empaque relacionadas con la actividad comercial, de servicios, manufactura y distribución de cada zona." />
      <div class="zonas-grid">
        <article class="zona-card"><h3 id="alvaro-obregon" class="zona-card__nombre">Álvaro Obregón</h3><p>Santa Fe reúne corporativos y servicios profesionales; San Ángel concentra galerías, restaurantes, decoración y artesanías. También hay comercio, distribución, manufactura ligera y negocios textiles. Suelen pedir <a href="/catalogo/cajas-textil-moda-retail/">cajas para textil y moda</a>, cajas personalizadas para boutiques, opciones para ecommerce y cajas de archivo.</p></article>
        <article class="zona-card"><h3 id="azcapotzalco" class="zona-card__nombre">Azcapotzalco</h3><p>Vallejo, Ferrería y sus alrededores concentran manufactura automotriz, química, farmacéutica, metal, plástico, muebles y logística. Para estas operaciones son relevantes las <a href="/catalogo/cajas-a-la-medida/">cajas a la medida</a>, el corrugado industrial de doble o triple pared y las cajas ecommerce para centros de distribución.</p></article>
        <article class="zona-card"><h3 id="benito-juarez" class="zona-card__nombre">Benito Juárez</h3><p>Del Valle, Narvarte, Nápoles e Insurgentes Sur combinan ecommerce, marcas DTC, servicios profesionales, clínicas, moda, restaurantes y distribuidoras. Se solicitan cajas para ecommerce, alimentos, boutiques y productos de salud; consulta también las <a href="/catalogo/cajas-personalizadas-logo/">cajas personalizadas con logo</a>.</p></article>
        <article class="zona-card"><h3 id="coyoacan" class="zona-card__nombre">Coyoacán</h3><p>El Centro Histórico y el Mercado de Coyoacán reúnen diseño, artesanías, librerías, galerías, gastronomía y comercio de productos propios. Universidad y Churubusco suman ecommerce, marcas de accesorios, talleres y manufactura ligera. Son comunes las cajas para alimentos, ecommerce, librería y artículos frágiles.</p></article>
        <article class="zona-card"><h3 id="cuajimalpa" class="zona-card__nombre">Cuajimalpa</h3><p>Santa Fe concentra oficinas, servicios empresariales, retail premium y restaurantes; el centro de Cuajimalpa tiene comercio popular y los pueblos de la zona combinan artesanías y producción local. Para estas actividades funcionan cajas de archivo, ecommerce, alimentos y corrugado de presentación; revisa la categoría de <a href="/catalogo/cajas-archivo-almacenaje/">cajas de archivo y almacenaje</a>.</p></article>
        <article class="zona-card"><h3 id="cuauhtemoc" class="zona-card__nombre">Cuauhtémoc</h3><p>Tepito, La Merced y el Centro Histórico concentran comercio de ropa, calzado, electrónica, abarrotes, joyería y librería. Roma y Doctores suman restaurantes, hoteles, clínicas, laboratorios y negocios DTC. Se piden cajas estándar y de doble pared para distribución, cajas para alimentos y opciones para ecommerce.</p></article>
        <article class="zona-card"><h3 id="gustavo-a-madero" class="zona-card__nombre">Gustavo A. Madero</h3><p>El norte de la alcaldía combina comercio popular, manufactura, distribución y el corredor industrial que comparte con Azcapotzalco. La demanda se relaciona con mercancía general, ropa, calzado, electrónicos y operaciones logísticas. Para cargas distintas conviene comparar <a href="/catalogo/cajas-corrugado-estandar/">cajas de corrugado estándar</a> de una, dos o tres paredes.</p></article>
        <article class="zona-card"><h3 id="iztacalco" class="zona-card__nombre">Iztacalco</h3><p>La zona reúne manufactura, bodegas, distribución y comercio del oriente de la ciudad. Los negocios necesitan empaques para mercancía general, alimentos y productos que se mueven por canales de distribución. Son relevantes las cajas de corrugado estándar, doble pared y opciones a la medida para operaciones industriales.</p></article>
        <article class="zona-card"><h3 id="iztapalapa" class="zona-card__nombre">Iztapalapa</h3><p>La Central de Abasto y los corredores industriales concentran comercio, distribución, manufactura y negocios de alimentos. Se solicitan cajas estándar y a la medida, cajas para frutas y verduras, alimentos y envíos. Para venta en línea, consulta las <a href="/catalogo/cajas-para-ecommerce/">cajas para ecommerce</a>.</p></article>
        <article class="zona-card"><h3 id="magdalena-contreras" class="zona-card__nombre">La Magdalena Contreras</h3><p>La alcaldía combina zonas residenciales del sur con pequeño comercio, servicios y negocios locales. Para estas actividades se requieren empaques accesibles para mercancía, alimentos, regalos y envíos de menor volumen. Las categorías de cajas estándar y cajas para alimentos permiten partir de una solución según producto y manejo.</p></article>
        <article class="zona-card"><h3 id="miguel-hidalgo" class="zona-card__nombre">Miguel Hidalgo</h3><p>Polanco, Lomas y el corredor corporativo concentran oficinas, hotelería, restaurantes, retail premium y negocios de alta presentación. Suelen solicitar cajas personalizadas, ecommerce, alimentos y cajas para archivo o logística interna. Para presentación de marca, revisa las <a href="/catalogo/cajas-personalizadas-logo/">cajas personalizadas</a>.</p></article>
        <article class="zona-card"><h3 id="milpa-alta" class="zona-card__nombre">Milpa Alta</h3><p>La actividad de la zona incluye productores agrícolas, alimentos procesados, negocios artesanales y pequeños comercios del sur. Las necesidades de empaque se concentran en frutas, verduras, alimentos y productos locales. La categoría de <a href="/catalogo/cajas-para-alimentos/">cajas para alimentos</a> reúne opciones para revisar según el producto.</p></article>
        <article class="zona-card"><h3 id="tlahuac" class="zona-card__nombre">Tláhuac</h3><p>Tláhuac combina una zona rural-urbana con productores agrícolas, alimentos procesados y pequeños negocios. Se solicitan cajas para frutas, verduras, alimentos preparados, productos artesanales y distribución local. También pueden evaluarse cajas estándar o soluciones a la medida para acomodar el producto.</p></article>
        <article class="zona-card"><h3 id="tlalpan" class="zona-card__nombre">Tlalpan</h3><p>El sur de la alcaldía concentra actividad agroindustrial, productores de alimentos, viveros, catering y manufactura ligera. Son habituales las cajas para alimentos, cajas agrícolas y corrugado industrial para volumen. Para pedidos con medidas específicas, consulta las <a href="/catalogo/cajas-a-la-medida/">cajas a la medida</a>.</p></article>
        <article class="zona-card"><h3 id="venustiano-carranza" class="zona-card__nombre">Venustiano Carranza</h3><p>El Centro, La Merced, Tepito y el entorno del aeropuerto reúnen mercados, bodegas, importadores, distribuidores y pequeñas empresas. Se necesitan cajas para ropa, mercancía general, alimentos y productos que pasan por distribución. Las cajas estándar, personalizadas y de doble o triple pared cubren distintos niveles de protección.</p></article>
        <article class="zona-card"><h3 id="xochimilco" class="zona-card__nombre">Xochimilco</h3><p>La zona combina floricultura, agricultura chinampera, alimentos, artesanías, turismo, comercio local y manufactura ligera. Sus pedidos suelen incluir cajas para flores, frutas y verduras, alimentos, souvenirs y ecommerce. Revisa las opciones de <a href="/catalogo/cajas-para-alimentos/">cajas para alimentos</a> y corrugado estándar según el manejo requerido.</p></article>
      </div>
    </div></section>

    <section class="zonas-section zonas-section--alt" aria-labelledby="edomex-title"><div class="container">
      <SectionHeader id="edomex-title" title="Estado de México" subtitle="Cobertura en corredores industriales, zonas comerciales y municipios del oriente, norte y Valle de Toluca." />
      <div class="zonas-grid">
        <article class="zona-card"><h3 id="atizapan-nicolas-romero" class="zona-card__nombre">Atizapán de Zaragoza y Nicolás Romero</h3><p>Atizapán reúne manufactura de electrónica, maquinaria, plástico y autopartes, además de comercio formal, servicios y ecommerce. Nicolás Romero forma parte de este corredor del noroeste con actividad manufacturera y comercial. Se solicitan cajas industriales, empaques para manufactura y cajas personalizadas; consulta el <a href="/catalogo/cajas-corrugado-estandar/">corrugado estándar</a> disponible.</p></article>
        <article class="zona-card"><h3 id="chalco-ixtapaluca" class="zona-card__nombre">Chalco e Ixtapaluca</h3><p>El sureste del Estado de México combina crecimiento comercial y residencial con distribución, ecommerce y manufactura pequeña y mediana. Los negocios de la zona solicitan cajas para envíos, alimentos y empaques a la medida. También puedes revisar las opciones para <a href="/catalogo/cajas-para-ecommerce/mercado-envios/">envíos de ecommerce</a>.</p></article>
        <article class="zona-card"><h3 id="cuautitlan-izcalli" class="zona-card__nombre">Cuautitlán Izcalli</h3><p>El municipio combina industria automotriz, proveedores de manufactura, logística, bodegas, centros de distribución y ecommerce. Para esta actividad se piden cajas de doble o triple pared, separadores, cajas a la medida y formatos para envíos. La categoría de <a href="/catalogo/cajas-a-la-medida/">cajas a la medida</a> es un punto de partida para requerimientos industriales.</p></article>
        <article class="zona-card"><h3 id="ecatepec" class="zona-card__nombre">Ecatepec de Morelos</h3><p>Xalostoc y Santa Clara concentran manufactura de alimentos, plástico, química, textil y metal; San Cristóbal y Ciudad Azteca suman comercio y distribución. Se solicitan cajas de doble pared para operaciones industriales y abarrotes, cajas ecommerce, cajas para alimentos y corrugado estándar. Consulta también las <a href="/catalogo/cajas-corrugado-estandar/triple-corrugado/">cajas de triple corrugado</a> para cargas que requieran mayor protección.</p></article>
        <article class="zona-card"><h3 id="naucalpan" class="zona-card__nombre">Naucalpan de Juárez</h3><p>El Parque Industrial Naucalpan y Alce Blanco concentran autopartes, manufactura metalmecánica, farmacéutica, alimentos y química; Periférico Norte suma comercio y distribución. Los pedidos suelen orientarse a cajas industriales, farmacéuticas, doble o triple pared y soluciones a la medida. Para requerimientos de mayor resistencia, revisa <a href="/catalogo/laminas-carton-corrugado/">láminas de cartón corrugado</a>.</p></article>
        <article class="zona-card"><h3 id="nezahualcoyotl" class="zona-card__nombre">Nezahualcóyotl</h3><p>El corredor de Pantitlán y los mercados concentran comercio de ropa, calzado, electrónicos y abarrotes; la Zona Industrial Neza suma muebles, plástico y textil. También hay vendedores en Mercado Libre, Shopify y otras plataformas. Son comunes las cajas ecommerce, cajas para calzado, corrugado simple para comercio y doble pared para distribución.</p></article>
        <article class="zona-card"><h3 id="tlalnepantla" class="zona-card__nombre">Tlalnepantla de Baz</h3><p>El corredor municipal combina industria farmacéutica, química, automotriz, alimentos, electrónica y logística. San Juan Ixhuatepec y Barrientos tienen actividad química, metalmecánica, plástica y de materiales; el centro suma comercio y servicios. Se requieren cajas farmacéuticas, corrugado de doble o triple pared, cajas para distribución y empaques a la medida.</p></article>
        <article class="zona-card"><h3 id="texcoco-chimalhuacan" class="zona-card__nombre">Texcoco y Chimalhuacán</h3><p>El oriente del Estado de México combina comercio, distribución, manufactura y pequeñas empresas. Para estas operaciones se solicitan cajas corrugadas estándar, cajas a la medida, opciones personalizadas y empaques para envíos. La categoría de <a href="/catalogo/cajas-personalizadas-logo/">cajas personalizadas con logo</a> puede ser útil para negocios que venden directamente al consumidor.</p></article>
        <article class="zona-card"><h3 id="toluca-lerma" class="zona-card__nombre">Toluca y Lerma</h3><p>El Valle de Toluca reúne industria automotriz, farmacéutica, alimentos y manufactura diversa, con un corredor industrial que conecta Toluca y Lerma. Los pedidos se enfocan en cajas industriales de alta resistencia, empaques para autopartes y cajas para exportación. Consulta las opciones de <a href="/catalogo/cajas-corrugado-estandar/triple-corrugado/">triple corrugado</a> y cajas a la medida.</p></article>
      </div>
    </div></section>

    <section class="zonas-proceso" aria-labelledby="proceso-title"><div class="container">
      <SectionHeader id="proceso-title" title="Cómo funciona la entrega" subtitle="Coordinamos cada pedido con la información de tu producto y la zona de destino." />
      <div class="proceso-steps">
        <div class="proceso-step"><span class="proceso-step__num">01</span><h3 class="proceso-step__titulo">Cotización</h3><p class="proceso-step__desc">Comparte medidas, cantidad, tipo de caja, uso del empaque y dirección de entrega.</p></div>
        <div class="proceso-step"><span class="proceso-step__num">02</span><h3 class="proceso-step__titulo">Confirmación</h3><p class="proceso-step__desc">Revisamos medidas, cantidad y especificaciones para confirmar la opción adecuada.</p></div>
        <div class="proceso-step"><span class="proceso-step__num">03</span><h3 class="proceso-step__titulo">Programación</h3><p class="proceso-step__desc">Acordamos la programación de entrega según el volumen, la zona y la disponibilidad confirmada.</p></div>
      </div>
    </div></section>

    <section class="faq" aria-labelledby="faq-zonas-title"><div class="container">
      <h2 id="faq-zonas-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas frecuentes sobre cobertura</h2>
      <div class="faq__list">{faqs.map((f, i) => <FaqItem id={`z-faq-${i}`} question={f.question} answer={f.answer} />)}</div>
    </div></section>
  </main>

  <LeadCapture title="¿En qué alcaldía o municipio necesitas cajas?" />
</PageLayout>
