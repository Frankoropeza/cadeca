---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Cajas de Cartón Vallejo / Azcapotzalco — Entrega 24 hrs · Fabricante Directo | CADECA";
const description = "Cajas de cartón corrugado con entrega en 24 hrs en Vallejo / Azcapotzalco. Fabricante directo, sin intermediarios. Cajas estándar, a la medida y personalizadas. Cotiza gratis.";
const canonical   = SITE + "/zonas-de-servicio/vallejo-azcapotzalco";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "CADECA — Cajas de Cartón Vallejo / Azcapotzalco",
    "description": description,
    "url": canonical,
    "areaServed": ["Azcapotzalco", "Gustavo A. Madero"],
    "address": { "@type": "PostalAddress", "addressRegion": "Ciudad de México", "addressCountry": "MX" },
    "priceRange": "$$"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Entregan en el Parque Industrial Vallejo?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, hacemos entregas diarias en el Parque Industrial Vallejo y toda la alcaldía Azcapotzalco en 24 hrs hábiles para pedidos en stock." } },
    { "@type": "Question", "name": "¿Cuál es el pedido mínimo?", "acceptedAnswer": { "@type": "Answer", "text": "Desde 50 piezas para cajas estándar y desde 100 para personalizadas con logo." } },
    { "@type": "Question", "name": "¿Hacen suministro continuo para fábricas?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, establecemos programas de suministro mensual con precio fijo y entrega programada para plantas industriales." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",            href: "/" },
    { name: "Zonas de Servicio", href: "/zonas-de-servicio" },
    { name: "Vallejo / Azcapotzalco" },
  ]}
  whatsapp={WHATSAPP}
>

  {/* ════════ HERO — idéntico al index ════════ */}
  <section class="hero">
    <div class="container">
      <div class="hero__inner">

        <div class="hero__left">
          <p class="hero__badge">Alcaldías: Azcapotzalco · Gustavo A. Madero</p>
          <h1 class="hero__title">
            Cajas de Cartón en<br><span>Vallejo / Azcapotzalco</span>
          </h1>
          <p class="hero__intro">Corrugado estándar, a la medida y personalizado con logo. Entrega directa en 24 hrs en el corazón industrial del norte de CDMX.</p>
          <div class="hero__ctas">
            <a href="/cotizar" class="btn btn--primary btn--lg">Cotizar cajas ahora</a>
            <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+necesito+cajas+en+Vallejo+%2F+Azcapotzalco"}
               class="btn btn--outline btn--lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp</a>
          </div>
          <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">24 hrs</span>
            <span class="hero__metric-label">Entrega exprés</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">50+</span>
            <span class="hero__metric-label">Piezas mínimo</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">15+</span>
            <span class="hero__metric-label">Años en la zona</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">2 hrs</span>
            <span class="hero__metric-label">Respuesta cot.</span>
          </div>
          </div>
        </div>

        <div class="hero__right">
          <p>CADECA distribuye <strong>cajas de cartón corrugado en Vallejo y Azcapotzalco</strong>, la zona industrial más importante de la Ciudad de México. Fábricas, bodegas, distribuidoras y maquiladoras de la alcaldía Azcapotzalco y Gustavo A. Madero reciben pedidos en 24-48 horas directamente desde nuestra planta.</p>
          <p>Suministramos <strong>cajas corrugadas de simple, doble y triple pared</strong> para la industria manufacturera de Vallejo. Pedidos desde 50 piezas, entregas programadas para consumo industrial y cotización en menos de 2 horas. Fabricante directo — sin intermediarios — con los mejores precios de la zona norte de CDMX.</p>
        </div>

      </div>
    </div>
  </section>

  {/* ════════ VENTAJAS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"¿Por qué elegir CADECA en Vallejo / Azcapotzalco?"}
        subtitle="Fabricante directo con entrega propia — sin intermediarios, sin costos ocultos"
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Zona industrial más densa del norte CDMX</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Entrega exprés 24 hrs en stock</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Fabricante directo — precios de mayoreo</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Cajas industriales triple pared disponibles</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ INDUSTRIAS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Industrias y sectores en Vallejo / Azcapotzalco"}
        subtitle="Atendemos todos los sectores productivos de la zona"
      />
      <ul class="tag-cloud">
          <li class="tag-item">Manufactura y metalmecánica</li>
          <li class="tag-item">Química y farmacéutica</li>
          <li class="tag-item">Distribución mayorista</li>
          <li class="tag-item">Alimentos y bebidas</li>
      </ul>
    </div>
  </section>

  {/* ════════ PRODUCTOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"Productos más solicitados en Vallejo / Azcapotzalco"}
        subtitle="Cajas en stock con entrega exprés · Sin mínimos restrictivos"
      />
      <div class="products__grid">
          <ProductCard
            title="Corrugado Estándar"
            desc="Entrega 24 hrs en stock"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar en CDMX — CADECA"
            href="/catalogo/cajas-corrugado-estandar"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Producción 3-5 días"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida en CDMX — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Industrial Triple Pared"
            desc="Alta resistencia ECT"
            imgSrc="/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif"
            imgAlt="Industrial Triple Pared en CDMX — CADECA"
            href="/catalogo/cajas-industriales-triple-pared"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas Personalizadas"
            desc="Con logo e impresión"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas Personalizadas en CDMX — CADECA"
            href="/catalogo/cajas-personalizadas-con-logo"
            btnText="Ver detalles"
          />
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Preguntas frecuentes — Vallejo / Azcapotzalco"}
        subtitle="Todo sobre nuestro servicio de entrega en tu zona"
      />
      <div class="faq-list" role="list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-vallejo-azcapotzalco-0">
              <span>¿Entregan en el Parque Industrial Vallejo?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-vallejo-azcapotzalco-0">
              <p>Sí, hacemos entregas diarias en el Parque Industrial Vallejo y toda la alcaldía Azcapotzalco en 24 hrs hábiles para pedidos en stock.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-vallejo-azcapotzalco-1">
              <span>¿Cuál es el pedido mínimo?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-vallejo-azcapotzalco-1">
              <p>Desde 50 piezas para cajas estándar y desde 100 para personalizadas con logo.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-vallejo-azcapotzalco-2">
              <span>¿Hacen suministro continuo para fábricas?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-vallejo-azcapotzalco-2">
              <p>Sí, establecemos programas de suministro mensual con precio fijo y entrega programada para plantas industriales.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <LeadCapture
    titulo={"Cotiza cajas en Vallejo / Azcapotzalco"}
    subtitulo="Fabricante directo · Cotización en menos de 2 horas · Entrega en 24 hrs"
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
/* ── Secciones generales ── */
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface,#f8f9fb); }

/* ── Feature grid (ventajas) ── */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* ── Tag cloud (industrias) ── */
.tag-cloud {
  list-style: none; padding: 0;
  display: flex; flex-wrap: wrap; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  justify-content: center;
}
.tag-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-primary);
  border-radius: var(--border-radius);
  padding: 0.5rem 1.25rem;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-secondary);
}


/* ── FAQ ── */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }
@media(min-width:1024px){ .products__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
