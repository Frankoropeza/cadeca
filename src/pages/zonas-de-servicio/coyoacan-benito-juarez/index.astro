---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Cajas de Cartón Coyoacán / Benito Juárez — Entrega 48-72 hrs · Fabricante Directo | CADECA";
const description = "Cajas de cartón corrugado con entrega en 48-72 hrs en Coyoacán / Benito Juárez. Fabricante directo, sin intermediarios. Cajas estándar, a la medida y personalizadas. Cotiza gratis.";
const canonical   = SITE + "/zonas-de-servicio/coyoacan-benito-juarez";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "CADECA — Cajas de Cartón Coyoacán / Benito Juárez",
    "description": description,
    "url": canonical,
    "areaServed": ["Coyoacán", "Benito Juárez"],
    "address": { "@type": "PostalAddress", "addressRegion": "Ciudad de México", "addressCountry": "MX" },
    "priceRange": "$$"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Hacen cajas para e-commerce con logo?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, desde 100 piezas fabricamos cajas personalizadas con tu logo e impresión en 1-4 colores." } },
    { "@type": "Question", "name": "¿Tienen opciones de packaging ecológico?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, manejamos cartón kraft reciclado certificado FSC para marcas con valores sustentables." } },
    { "@type": "Question", "name": "¿Cuánto tarda la entrega en Coyoacán?", "acceptedAnswer": { "@type": "Answer", "text": "Entre 48-72 hrs hábiles desde la confirmación del pedido." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",            href: "/" },
    { name: "Zonas de Servicio", href: "/zonas-de-servicio" },
    { name: "Coyoacán / Benito Juárez" },
  ]}
  whatsapp={WHATSAPP}
>

  {/* ════════ HERO — idéntico al index ════════ */}
  <section class="hero">
    <div class="container">
      <div class="hero__inner">

        <div class="hero__left">
          <p class="hero__badge">Alcaldías: Coyoacán · Benito Juárez</p>
          <h1 class="hero__title">
            Cajas de Cartón en<br><span>Coyoacán / Benito Juárez</span>
          </h1>
          <p class="hero__intro">Cajas de cartón corrugado y packaging personalizado para e-commerce, marcas independientes y empresas del sur de CDMX. Entrega en 48-72 hrs.</p>
          <div class="hero__ctas">
            <a href="/cotizar" class="btn btn--primary btn--lg">Cotizar cajas ahora</a>
            <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+necesito+cajas+en+Coyoac%C3%A1n"}
               class="btn btn--outline btn--lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp</a>
          </div>
          <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">48-72 hrs</span>
            <span class="hero__metric-label">Entrega en la zona</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">100+</span>
            <span class="hero__metric-label">Piezas con logo</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">50+</span>
            <span class="hero__metric-label">Piezas estándar</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">2 hrs</span>
            <span class="hero__metric-label">Cotización</span>
          </div>
          </div>
        </div>

        <div class="hero__right">
          <p>CADECA entrega <strong>cajas de cartón corrugado en Coyoacán y Benito Juárez</strong>, alcaldías con alta concentración de empresas de servicios, e-commerce, startups y marcas de consumo. Empaques de calidad para negocios que valoran la presentación y la funcionalidad de su empaque.</p>
          <p>Ideal para <strong>vendedores de e-commerce, marcas independientes y startups</strong> en Coyoacán y BJ. Cajas a la medida con impresión personalizada desde 100 piezas, entrega en 48-72 horas. CADECA es el proveedor de cajas preferido de los emprendedores del sur de CDMX. Cotiza ahora sin compromiso.</p>
        </div>

      </div>
    </div>
  </section>

  {/* ════════ VENTAJAS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"¿Por qué elegir CADECA en Coyoacán / Benito Juárez?"}
        subtitle="Fabricante directo con entrega propia — sin intermediarios, sin costos ocultos"
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Packaging profesional para marcas y e-commerce</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Cajas personalizadas con logo desde 100 piezas</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Entrega en 48-72 hrs en Coyoacán y BJ</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Ideal para Mercado Libre, Amazon y Shopify</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ INDUSTRIAS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Industrias y sectores en Coyoacán / Benito Juárez"}
        subtitle="Atendemos todos los sectores productivos de la zona"
      />
      <ul class="tag-cloud">
          <li class="tag-item">E-commerce y marcas DTC</li>
          <li class="tag-item">Startups y scale-ups</li>
          <li class="tag-item">Retail y tiendas independientes</li>
          <li class="tag-item">Gastronomía y alimentos gourmet</li>
      </ul>
    </div>
  </section>

  {/* ════════ PRODUCTOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title={"Productos más solicitados en Coyoacán / Benito Juárez"}
        subtitle="Cajas en stock con entrega exprés · Sin mínimos restrictivos"
      />
      <div class="products__grid">
          <ProductCard
            title="Cajas E-commerce"
            desc="ML · Amazon · Shopify"
            imgSrc="/img/productos/cajas-de-carton-para-ecommerce-mercado-libre-amazon-cdmx.avif"
            imgAlt="Cajas E-commerce en CDMX — CADECA"
            href="/catalogo/cajas-ecommerce-mercado-libre"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas con Logo"
            desc="Impresión full color"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas con Logo en CDMX — CADECA"
            href="/catalogo/cajas-personalizadas-con-logo"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Para tu producto exacto"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida en CDMX — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver detalles"
          />
          <ProductCard
            title="Packaging Ecológico"
            desc="Certificado FSC"
            imgSrc="/img/productos/laminas-carton-corrugado-ecologico-reciclado-fsc-cdmx.avif"
            imgAlt="Packaging Ecológico en CDMX — CADECA"
            href="/catalogo/packaging-ecologico"
            btnText="Ver detalles"
          />
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title={"Preguntas frecuentes — Coyoacán / Benito Juárez"}
        subtitle="Todo sobre nuestro servicio de entrega en tu zona"
      />
      <div class="faq-list" role="list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-coyoacan-benito-juarez-0">
              <span>¿Hacen cajas para e-commerce con logo?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-coyoacan-benito-juarez-0">
              <p>Sí, desde 100 piezas fabricamos cajas personalizadas con tu logo e impresión en 1-4 colores.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-coyoacan-benito-juarez-1">
              <span>¿Tienen opciones de packaging ecológico?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-coyoacan-benito-juarez-1">
              <p>Sí, manejamos cartón kraft reciclado certificado FSC para marcas con valores sustentables.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-coyoacan-benito-juarez-2">
              <span>¿Cuánto tarda la entrega en Coyoacán?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-coyoacan-benito-juarez-2">
              <p>Entre 48-72 hrs hábiles desde la confirmación del pedido.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <LeadCapture
    titulo={"Cotiza cajas en Coyoacán / Benito Juárez"}
    subtitulo="Fabricante directo · Cotización en menos de 2 horas · Entrega en 48-72 hrs"
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
/* ── Secciones generales ── */
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface,#f8f9fb); }

/* ── Feature grid (ventajas) ── */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* ── Tag cloud (industrias) ── */
.tag-cloud {
  list-style: none; padding: 0;
  display: flex; flex-wrap: wrap; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  justify-content: center;
}
.tag-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-primary);
  border-radius: var(--border-radius);
  padding: 0.5rem 1.25rem;
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-secondary);
}


/* ── FAQ ── */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }
@media(min-width:1024px){ .products__grid { grid-template-columns: repeat(2, 1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
