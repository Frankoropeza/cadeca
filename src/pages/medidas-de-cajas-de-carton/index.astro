---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FaqItem from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";

const title = "Medidas de Cajas de Cartón | Guía y Referencias | CADECA";
const description = "Medidas de cajas de cartón en formato L×A×H. Consulta cómo medir, calcular holgura y comparar referencias publicadas del catálogo CADECA.";

const schema = {
  "@context": "https://schema.org", "@type": "WebPage",
  "@id": "https://cajas-de-carton.com/medidas-de-cajas-de-carton/#webpage",
  "name": title, "url": "https://cajas-de-carton.com/medidas-de-cajas-de-carton/", "description": description,
  "about": { "@id": "https://cajas-de-carton.com/#org" }, "isPartOf": { "@id": "https://cajas-de-carton.com/#website" }
};

const productos = [
  { code: "CAD-CS-11", title: "Caja Corrugado Chica Estándar", badge: "Pequeñas", badgeColor: "orange", desc: "Cuatro referencias de 10×10×10 a 25×20×15 cm para comparar formatos compactos.", imgSrc: "/img/catalogo/caja-chica-estandar-hero-cdmx.avif", imgAlt: "Medidas de caja chica estándar", href: "/catalogo/cajas-corrugado-estandar/caja-chica-estandar/", specs: [["Medidas", "10×10×10 a 25×20×15 cm"], ["ECT", "ECT-32"], ["Pedido", "50 piezas"]] },
  { code: "CAD-CM-01", title: "Cajas para Mudanza con Asas", badge: "Grandes", badgeColor: "blue", desc: "Cinco tallas publicadas, de 30×25×25 a 50×50×90 cm, para objetos voluminosos.", imgSrc: "/img/catalogo/cajas-carton-mudanza-resistentes-cdmx.avif", imgAlt: "Medidas de cajas de mudanza", href: "/catalogo/cajas-corrugado-estandar/cajas-mudanza/", specs: [["Medidas", "30×25×25 a 50×50×90 cm"], ["ECT", "ECT-44"], ["Pedido", "Sin mínimo publicado"]] },
  { code: "CAD-FC-04", title: "Caja para Suplementos y Nutrición", badge: "Kits", badgeColor: "green", desc: "Medidas publicadas para frasco, bote, kit y display, de 10×10×15 a 35×25×20 cm.", imgSrc: "/img/catalogo/caja-suplementos-nutricion-deportiva-cdmx.avif", imgAlt: "Medidas de cajas para suplementos", href: "/catalogo/cajas-farmaceutica-cosmetica/suplementos-nutricion/", specs: [["Medidas", "10×10×15 a 35×25×20 cm"], ["ECT", "ECT-32"], ["Pedido", "200 piezas"]] },
  { code: "CAD-AH-02", title: "Caja de Almacén Industrial Doble Pared", badge: "Pallet", badgeColor: "blue", desc: "Rango publicado de 40×30×30 cm hasta 120×100×60 cm para almacén y tarima.", imgSrc: "/img/catalogo/caja-almacen-industrial-triple-pared-cdmx.avif", imgAlt: "Medidas de caja industrial", href: "/catalogo/cajas-archivo-almacenaje/almacen-industrial/", specs: [["Medidas", "40×30×30 a 120×100×60 cm"], ["ECT", "ECT-44 / ECT-51"], ["Pedido", "50 piezas"]] }
];

const faqs = [
  { id: "medidas-1", question: "¿En qué orden se escriben las medidas de una caja?", answer: "Las medidas se expresan como largo × ancho × alto: L×A×H. El largo es la dimensión mayor de la base, el ancho la menor y el alto va de la base a la tapa." },
  { id: "medidas-2", question: "¿Debo medir el interior o el exterior?", answer: "Para calcular el espacio del producto se usan las medidas interiores. La diferencia con el exterior depende del grosor del corrugado, por lo que debes solicitar que la cotización aclare la referencia de la medida." },
  { id: "medidas-3", question: "¿Cómo calculo el tamaño de una caja para mi producto?", answer: "Mide el producto en sus tres puntos máximos y agrega holgura en cada lado según el material de protección. La guía enlazada de cálculo de medidas incluye fórmulas y ejemplos de holgura." },
  { id: "medidas-4", question: "¿Qué medida ayuda a reducir el peso volumétrico?", answer: "Una caja que deje el espacio necesario para protección, sin volumen vacío excesivo, ayuda a controlar el peso volumétrico. Revisa la fórmula y los ejemplos del artículo de peso volumétrico antes de definir una medida." },
  { id: "medidas-5", question: "¿Qué tamaños de cajas de cartón hay?", answer: "Las referencias del catálogo van de 10×10×10 cm en caja chica estándar a 120×100×60 cm en almacén industrial. Las medidas publicadas son puntos de comparación; la medida adecuada depende del producto y su protección." }
];
---

<PageLayout title={title} description={description} schema={schema}
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Medidas de cajas de cartón" }]}
  faqItems={faqs.map(({ question, answer }) => ({ question, answer }))}>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación"><div class="container"><ol><li><a href="/">Inicio</a></li><li><span class="current">Medidas de cajas de cartón</span></li></ol></div></div>
  <PageHero eyebrow="Guía · Medidas y tamaño" title="Medidas de cajas de cartón" desc="Las medidas de cajas de cartón se comparan en el orden largo × ancho × alto y deben responder al espacio interior que requiere el producto ya protegido. Esta guía reúne el método de cálculo y referencias de tamaño tomadas sólo de fichas existentes del catálogo." desc2="Una medida útil equilibra ajuste y protección: debe permitir introducir el producto y el relleno sin dejar volumen innecesario. Confirma siempre si la medida cotizada es interior o exterior." ctas={[{ href: "#referencias", label: "Ver referencias", variant: "primary" }, { href: "/cotizar/", label: "Solicitar cotización", variant: "outline" }]} />
  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="como-medir-title"><div class="container"><div class="sku-detail__content"><h2 id="como-medir-title" class="sku-detail__title">Cómo medir: interior, exterior y L×A×H</h2><p>La guía de <a href="/blog/como-calcular-medidas-caja-carton-producto/">cómo calcular medidas exactas de una caja</a> establece el orden largo × ancho × alto. El largo corresponde a la dimensión más grande de la base, el ancho a la dimensión menor y el alto a la distancia entre la base y la tapa. Usar el mismo orden permite comparar una ficha contra las dimensiones reales del producto.</p><p>Para calcular una medida funcional, toma el largo, ancho y alto del artículo en su punto más amplio. Después suma la holgura necesaria por lado: cambia si el contenido es textil, rígido, frágil, pesado o va acompañado de divisores. La medida interior es la relevante para el ajuste del producto; el espesor del cartón modifica la dimensión exterior.</p><p>Antes de pedir una caja, deja anotadas cuatro cosas: medidas internas requeridas, peso del producto ya empacado, material de relleno y forma de apilamiento. Si ninguna referencia publicada se adapta, la categoría de <a href="/catalogo/cajas-a-la-medida/">cajas a la medida</a> es el siguiente punto de consulta. En operaciones de e-commerce, también conviene registrar las dimensiones que se cargarán en la plataforma de envío.</p></div></div></section>
    <section id="referencias" style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" aria-labelledby="fichas-title"><div class="container"><h2 id="fichas-title" class="section-header__title">Fichas con medidas de referencia</h2><p class="section-header__subtitle">Los productos de esta rejilla contienen dimensiones publicadas en sus fichas técnicas.</p><div class="sku-grid">{productos.map((p) => <article class="sku-card"><div class="sku-card__img-wrap"><img src={p.imgSrc} alt={p.imgAlt} class="sku-card__img" width="640" height="480" loading="lazy" decoding="async" /><span class="sku-card__code">{p.code}</span><span class={`sku-card__badge sku-card__badge--${p.badgeColor}`}>{p.badge}</span></div><div class="sku-card__body"><h3 class="sku-card__name">{p.title}</h3><p class="sku-card__desc">{p.desc}</p><div class="sku-card__specs">{p.specs.map(([label, value]) => <div><span class="sku-card__spec-label">{label}</span><span class="sku-card__spec-value">{value}</span></div>)}</div><div class="sku-card__footer"><a class="btn btn--primary" href={p.href}>Ver ficha técnica</a></div></div></article>)}</div></div></section>
    <section class="sku-sizes" aria-labelledby="tabla-title"><div class="container"><h2 id="tabla-title" class="section-header__title">Tabla de tamaños de cajas de cartón</h2><div class="catalog-sizes-table-wrap"><table class="catalog-sizes-table"><thead><tr><th>Medida L×A×H (cm)</th><th>Uso descrito en la ficha</th><th>Fuente</th></tr></thead><tbody><tr><td>10×10×10</td><td>Joyería y accesorios</td><td><a href="/catalogo/cajas-corrugado-estandar/caja-chica-estandar/">CAD-CS-11</a></td></tr><tr><td>20×15×10</td><td>Cosméticos medianos, libros de bolsillo y artículos pequeños</td><td><a href="/catalogo/cajas-corrugado-estandar/caja-chica-estandar/">CAD-CS-11</a></td></tr><tr><td>15×15×25</td><td>Bote de proteína</td><td><a href="/catalogo/cajas-farmaceutica-cosmetica/suplementos-nutricion/">CAD-FC-04</a></td></tr><tr><td>40×30×30</td><td>Mudanza / almacenaje según ficha</td><td><a href="/catalogo/cajas-corrugado-estandar/cajas-mudanza/">CAD-CM-01</a></td></tr><tr><td>60×45×45</td><td>Mudanza</td><td><a href="/catalogo/cajas-corrugado-estandar/cajas-mudanza/">CAD-CM-01</a></td></tr><tr><td>120×100×60</td><td>Formato pallet para almacén</td><td><a href="/catalogo/cajas-archivo-almacenaje/almacen-industrial/">CAD-AH-02</a></td></tr></tbody></table></div></div></section>
    <section class="sku-detail" aria-labelledby="volumetrico-title"><div class="container"><div class="sku-detail__content"><h2 id="volumetrico-title" class="sku-detail__title">Medida y peso volumétrico</h2><p>La medida de la caja también influye en el cobro de algunos envíos. El artículo sobre <a href="/blog/peso-volumetrico-cajas-medida-ecommerce-ahorro-envios/">peso volumétrico en e-commerce</a> explica la fórmula que usa largo, ancho y alto en centímetros. Si el volumen calculado pesa más que el producto real, el envío puede cobrarse por esa referencia.</p><p>Reducir la caja sin prever el relleno no es una solución. El orden correcto es definir el producto, la protección y el ajuste interior; después se revisa si una medida estándar evita espacio vacío. Para bultos que se almacenan o se apilan, suma al criterio dimensional la pared y el ECT que aparece en la ficha técnica.</p></div></div></section>
    <section class="sku-detail" aria-labelledby="verificar-title"><div class="container"><div class="sku-detail__content"><h2 id="verificar-title" class="sku-detail__title">Verifica la medida al recibir tu pedido</h2><p>La medición no termina con la cotización. La checklist de <a href="/blog/checklist-control-calidad-cajas-carton-proveedor/">control de calidad de cajas</a> propone revisar el largo, ancho y alto internos de una muestra, además del espesor de la lámina. Comparar cinco cajas contra la especificación escrita ayuda a detectar variaciones antes de usarlas en una línea de empaque.</p><p>Guarda la medida acordada junto con el SKU, la flauta y el ECT. Si el producto cambia de presentación, vuelve a medirlo en lugar de asumir que la misma caja seguirá funcionando. Una variación pequeña en altura, tapa, inserto o relleno puede cambiar el volumen final y el comportamiento de la caja durante el traslado o el apilamiento.</p><p>Las medidas de la tabla son referencias tomadas de fichas del catálogo. Úsalas para ubicar un rango de tamaño y abre la fuente enlazada para revisar todos sus datos antes de pedir una cantidad.</p></div></div></section>
    <section class="faq" aria-labelledby="faq-title"><div class="container"><h2 id="faq-title" class="section-header__title">Preguntas frecuentes</h2><div class="faq__list">{faqs.map((f) => <FaqItem {...f} />)}</div></div></section>
  </main>
  <LeadCapture title="Comparte las medidas de tu producto para cotizar la caja adecuada" producto="Medidas de cajas de cartón" />
</PageLayout>
