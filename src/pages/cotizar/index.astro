---
import { CONTACTO, HAS_WA, contactoHref, contactoAttrs } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import PageHero  from "@/components/PageHero.astro";

const title  = "Cotizar Cajas de Cartón en CDMX | CADECA";
const description = "Solicita tu cotización de cajas de cartón corrugado en CDMX y Estado de México: estándar, a la medida, personalizadas con logo y láminas. Sin compromiso.";

const breadcrumbs = [
 { name: "Inicio", href: "/" },
 { name: "Cotizar" },
];

const faqs = [
 { question: "¿Qué datos necesito para cotizar?", answer: "Tipo de caja, medidas aproximadas (largo × ancho × alto en cm), cantidad estimada y, si aplica, si llevará impresión de logo. Con eso preparamos una cotización con precio por pieza y tiempo de entrega." },
 { question: "¿Cuánto tarda la respuesta?", answer: "Respondemos las solicitudes en horario hábil. Las cotizaciones con medidas especiales o impresión pueden requerir más tiempo porque se validan con el taller que produce la caja." },
 { question: "¿Hay pedido mínimo?", answer: "Depende del tipo de caja: las medidas estándar se surten en cantidades menores que las cajas a la medida o impresas, que tienen un mínimo de producción. En la cotización te indicamos el mínimo para tu caso." },
 { question: "¿Puedo pedir una muestra antes del pedido completo?", answer: "En cajas a la medida y personalizadas es posible solicitar una muestra para validar medidas y resistencia antes de producir el volumen completo. Indícalo en el formulario." },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="page"
 breadcrumbs={breadcrumbs}
 faqItems={faqs}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><span class="current">Cotizar</span></li>
 </ol>
 </div>
 </div>

 <PageHero
 eyebrow="Cotización sin compromiso"
 titleHtml={true}
 title="Cotiza tus Cajas de <span>Cartón en CDMX</span>"
 desc="Cuéntanos qué necesitas y te enviamos una cotización con precio por pieza, cantidad mínima y tiempo de entrega."
 desc2="Trabajamos cajas de cartón corrugado estándar, a la medida, personalizadas con logo y láminas de cartón para empresas, tiendas en línea y negocios de la Ciudad de México y el Estado de México.||Si tienes una muestra, un plano o una caja de referencia, descríbela en el formulario: con medidas, peso del producto y uso final podemos recomendarte el tipo de corrugado adecuado."
 chips={[
 { label: "Sin compromiso" },
 { label: "Precio por pieza y por volumen" },
 { label: "Asesoría para elegir la caja" },
 { label: "CDMX y Estado de México" },
 ]}
 ctas={[
 { href: "#cotizar-page-form", label: "Llenar formulario", variant: "primary" },
 ...(HAS_WA ? [{ href: contactoHref(), label: "WhatsApp", variant: "outline" as const }] : []),
 ]}
 />

 <main id="contenido-principal" role="main">

 <section class="cotizar-form-section">
 <div class="container">
 <div class="cotizar-layout">

 <div class="cotizar-form-wrap">
 <h2 class="cotizar-form-wrap__title">Formulario de Cotización</h2>
 <form id="cotizar-page-form" class="cotizar-form" data-lead-form data-wa={CONTACTO.whatsapp || undefined}>

 <div class="cotizar-form__group">
 <label for="cot-nombre" class="cotizar-form__label">Nombre completo *</label>
 <input id="cot-nombre" name="nombre" type="text" class="cotizar-form__input" placeholder="Tu nombre" required />
 </div>

 <div class="cotizar-form__group">
 <label for="cot-empresa" class="cotizar-form__label">Empresa (opcional)</label>
 <input id="cot-empresa" name="empresa" type="text" class="cotizar-form__input" placeholder="Nombre de tu empresa o negocio" />
 </div>

 <div class="cotizar-form__row">
 <div class="cotizar-form__group">
 <label for="cot-contacto" class="cotizar-form__label">Teléfono o WhatsApp *</label>
 <input id="cot-contacto" name="contacto" type="tel" class="cotizar-form__input" placeholder="55 1234-5678" required />
 </div>
 <div class="cotizar-form__group">
 <label for="cot-email" class="cotizar-form__label">Correo electrónico</label>
 <input id="cot-email" name="email" type="email" class="cotizar-form__input" placeholder="tu@correo.com" />
 </div>
 </div>

 <div class="cotizar-form__group">
 <label for="cot-tipo" class="cotizar-form__label">Tipo de caja *</label>
 <select id="cot-tipo" name="tipo" class="cotizar-form__select" required>
 <option value="">Selecciona el tipo</option>
 <optgroup label="Corrugado Estándar">
 <option>Corrugado simple (ECT-32)</option>
 <option>Doble corrugado (ECT-44)</option>
 <option>Triple corrugado (ECT-61)</option>
 <option>Cajas mudanza</option>
 </optgroup>
 <optgroup label="E-commerce">
 <option>Cajas Mercado Envíos</option>
 <option>Cajas Amazon FBA/FBM</option>
 <option>Cajas paqueterías (DHL/FedEx/Estafeta)</option>
 <option>E-commerce a la medida</option>
 </optgroup>
 <optgroup label="Personalizadas">
 <option>Caja con logo 1 color</option>
 <option>Caja con logo 2 colores</option>
 <option>Caja full color CMYK</option>
 <option>Acabados especiales (barniz UV)</option>
 </optgroup>
 <optgroup label="Especiales">
 <option>Caja a la medida industrial</option>
 <option>Caja para alimentos (food grade)</option>
 <option>Cajas para pizza</option>
 <option>Láminas de cartón corrugado</option>
 <option>Separadores y divisiones</option>
 <option>Otro — lo describo abajo</option>
 </optgroup>
 </select>
 </div>

 <div class="cotizar-form__row">
 <div class="cotizar-form__group">
 <label for="cot-medida" class="cotizar-form__label">Medida aprox. (Largo × Ancho × Alto cm)</label>
 <input id="cot-medida" name="medida" type="text" class="cotizar-form__input" placeholder="30 × 20 × 15" />
 </div>
 <div class="cotizar-form__group">
 <label for="cot-cantidad" class="cotizar-form__label">Cantidad estimada *</label>
 <select id="cot-cantidad" name="cantidad" class="cotizar-form__select" required>
 <option value="">Selecciona</option>
 <option>25 – 50 piezas</option>
 <option>51 – 100 piezas</option>
 <option>101 – 500 piezas</option>
 <option>501 – 1,000 piezas</option>
 <option>1,001 – 5,000 piezas</option>
 <option>Más de 5,000 piezas</option>
 </select>
 </div>
 </div>

 <div class="cotizar-form__group">
 <label for="cot-producto" class="cotizar-form__label">Producto de referencia (opcional)</label>
 <input id="cot-producto" name="producto" type="text" class="cotizar-form__input" placeholder="Clave o nombre del catálogo, p. ej. CAD-CS-01" />
 </div>

 <div class="cotizar-form__group">
 <label for="cot-detalles" class="cotizar-form__label">Detalles adicionales (producto, uso, urgencia)</label>
 <textarea id="cot-detalles" name="detalles" class="cotizar-form__textarea" rows="4" placeholder="Describe tu producto, si es para e-commerce, industrial, alimentos... Cualquier detalle que nos ayude a cotizar con precisión."></textarea>
 </div>

 <input type="text" name="sitio_web" tabindex="-1" autocomplete="off" aria-hidden="true" class="lead-capture__hp" />
 <button type="submit" class="btn btn--primary btn--full btn--lg">
 Solicitar cotización
 </button>
 <p class="cotizar-form__nota">Usamos tus datos sólo para responder esta solicitud. Consulta el <a href="/aviso-de-privacidad/">aviso de privacidad</a>.</p>
 <p class="cotizar-form__status" data-lead-status role="status" aria-live="polite" hidden></p>
 </form>
 </div>

 <div class="cotizar-sidebar">
 {HAS_WA && (
 <div class="cotizar-sidebar__card">
 <h3>¿Prefieres WhatsApp?</h3>
 <p>Envíanos medidas y cantidad por mensaje.</p>
 <a href={contactoHref("Hola, quiero cotizar cajas de cartón")} class="btn btn--primary btn--full" {...contactoAttrs}>Abrir WhatsApp</a>
 </div>
 )}

 <div class="cotizar-sidebar__card">
 <h3>Qué incluye tu cotización</h3>
 <ul class="cotizar-sidebar__list">
 <li>Precio por pieza y por volumen</li>
 <li>Cantidad mínima para tu tipo de caja</li>
 <li>Tiempo de entrega estimado</li>
 <li>Recomendación de corrugado (simple, doble o triple)</li>
 </ul>
 </div>

 <div class="cotizar-sidebar__card" style="margin-top:var(--spacing-md)">
 <h3> Información útil para tu cotización</h3>
 <ul class="cotizar-sidebar__list">
 <li>Medida del producto (L × A × H)</li>
 <li>Peso del producto</li>
 <li>Cantidad mensual estimada</li>
 <li>¿Necesita impresión de logo?</li>
 <li>¿Uso en e-commerce o industrial?</li>
 <li>¿Hay urgencia de entrega?</li>
 </ul>
 </div>
 </div>

 </div>
 </div>
 </section>

 <section class="faq" aria-labelledby="faq-cotizar-title">
 <div class="container">
 <h2 id="faq-cotizar-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Frecuentes sobre Cotizaciones</h2>
 <div class="faq__list">
 {faqs.map(f => <FaqItem id={`cot-${faqs.indexOf(f)}`} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>

 </main>
</PageLayout>


