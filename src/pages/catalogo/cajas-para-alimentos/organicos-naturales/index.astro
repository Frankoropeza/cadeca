---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja para Orgánicos y Productos Naturales | CADECA";
const description = "Caja de cartón reciclado para productos orgánicos y naturales: kraft food-grade, sin blanqueadores de cloro. Cotiza en CDMX y Estado de México.";

const specs = [
 ["Código SKU", "CAD-AL-11"],
 ["Certificación", "FSC por confirmar al cotizar · Food-grade NOM-051"],
 ["Material", "Kraft reciclado postconsumer"],
 ["Blanqueante", "Sin ECF/TCF"],
 ["Tintas", "Water-based sin metales"],
 ["Compatibilidad", "Certificaciones orgánicas"],
 ["Pedido mínimo", "100 piezas"],
 ["Impresión", "1 color opcional"],
 ["Entrega CDMX", "Según pedido"],
];

const faqs = [
 { id:"cad-al-11-f1", question:"¿La caja es compatible con certificaciones orgánicas como NMX-FF-068?", answer:"El material de CAD-AL-11 (kraft reciclado, sin blanqueantes de cloro, tintas water-based) puede revisarse contra los requerimientos de materiales de contacto de la certificación NMX-FF-068 de productos orgánicos. Si requieres FSC, lo indicamos al cotizar y confirmamos disponibilidad con el fabricante. La certificación del producto orgánico en sí es responsabilidad del fabricante del producto, no del proveedor de empaque." },
 { id:"cad-al-11-f2", question:"¿Tiene el mismo aspecto que el kraft virgen?", answer:"El kraft reciclado tiene un tono ligeramente más oscuro y puede mostrar pequeñas variaciones en la textura que son características de fibra reciclada. Para muchas marcas orgánicas, esta apariencia más rústica y natural es precisamente el efecto deseado. Si necesitas homogeneidad perfecta de color, podemos ofrecer kraft virgen no blanqueado como alternativa." },
 { id:"cad-al-11-f3", question:"¿Puedo mencionar en mi etiqueta que el empaque es reciclado FSC?", answer:"Si tu proyecto requiere cartón con certificación FSC, lo indicamos al cotizar y confirmamos disponibilidad con el fabricante antes de definir la comunicación de marketing o el etiquetado. Para usar el logo FSC oficial en tu producto, necesitas tramitar tu propia licencia FSC o confirmar las condiciones aplicables con el fabricante." },
];

const gallery = [
 { src: "/img/catalogo/cajas-medida-alimentos-fda-cdmx.avif", alt: "Caja orgánicos naturales FSC CDMX" },
 { src: "/img/catalogo/laminas-carton-reciclado-ecologico-cdmx.avif", alt: "Material reciclado FSC alimentos" },
 { src: "/img/catalogo/cajas-carton-corrugado-simple-pared-cdmx.avif", alt: "Kraft corrugado simple orgánico" },
 { src: "/img/catalogo/cajas-pasteleria-tartas-cdmx.avif", alt: "Empaque natural artesanal" },
 { src: "/img/catalogo/cajas-frutas-verduras-corrugado-cdmx.avif", alt: "Frutas verduras orgánicas" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas para Alimentos",href:"/catalogo/cajas-para-alimentos/"},{name:"Caja para Productos Orgánicos y Naturales"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para Productos Orgánicos y Naturales",sku:"CAD-AL-11",description:"Caja kraft reciclado para marcas de productos orgánicos y naturales. Food-grade, imagen sustentable; FSC por confirmar al cotizar. Desde 100 piezas en CDMX.",image:gallery[0].src,material:"CAD-AL-11",category:"Cajas para Alimentos",moq:"100 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-alimentos/">Cajas para Alimentos</a></li>
 <li><span class="current">Caja para Productos Orgánicos y Naturales</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-cadal11-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-AL-11 · Cajas para Alimentos</span>
 <h1 id="sku-cadal11-title" class="cat-page-hero__title">Caja para <span>Orgánicos</span> y Productos Naturales CDMX</h1>
 <p class="cat-page-hero__desc">Caja kraft reciclado para marcas de productos orgánicos y naturales. Food-grade, imagen sustentable, compatible con certificaciones orgánicas; FSC por confirmar al cotizar. Desde 100 piezas en CDMX.</p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AL-11</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>Según pedido</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>100 piezas</strong></div>
 <div class="cat-page-hero__strip-item">Proveedor: <strong>CADECA</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadal11-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AL-11 · Familia: Cajas para Alimentos</p>
 <h2 id="detalle-cadal11-title" class="sku-detail__title">Caja para Productos Orgánicos y Naturales</h2>
 <p class="sku-detail__desc">Las marcas de productos orgánicos, naturales y saludables necesitan un empaque coherente con sus valores: material reciclado o de fuente responsable, sin químicos tóxicos y con imagen que refuerce el mensaje sustentable. CAD-AL-11 usa kraft reciclado postconsumer, food-grade sin blanqueantes a base de cloro y tintas water-based si se requiere impresión. Si tu proyecto requiere FSC, lo confirmamos al cotizar con el fabricante. Desde 100 piezas para marcas pequeñas de mercados orgánicos y tiendas naturistas.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Por confirmar</span><span class="sku-detail__strip-label">FSC al cotizar</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Food-grade</span><span class="sku-detail__strip-label">NOM-051</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Eco</span><span class="sku-detail__strip-label">Sin recargo</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-AL-11 Caja para Productos Orgánicos y Naturales`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-AL-11</a>
 <a href="/catalogo/cajas-para-alimentos/" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-cadal11-title">
 <div class="container">
 <h2 id="faq-cadal11-title" class="sku-faq__title">Preguntas Frecuentes — Caja para Productos Orgánicos y Naturales</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture title="¿Tu marca es orgánica o natural? Cotiza una caja kraft reciclada coherente con tus valores" />
</PageLayout>
