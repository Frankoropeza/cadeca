---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas para Pizza de Cartón Corrugado | CADECA";
const description = "Cajas pizza en CDMX. 20-45 cm. Liner food-grade, ECT-32, desde 100 pzas, entrega programada según pedido. CADECA proveedor.";

const medidas = [
 { talla:"20 cm", ml:"21×21×4 cm", real:"21×21×4", flauta:"C",ect:"ECT-32",vacío:"0.12 kg",máx:"1.5 kg", disp:"yellow", label:"3-5 días", hl:false },
 { talla:"25 cm", ml:"26×26×4 cm", real:"26×26×4", flauta:"C",ect:"ECT-32",vacío:"0.16 kg",máx:"2 kg", disp:"yellow", label:"3-5 días", hl:true },
 { talla:"30 cm", ml:"31×31×5 cm", real:"31×31×5", flauta:"C",ect:"ECT-32",vacío:"0.21 kg",máx:"2.5 kg", disp:"yellow", label:"3-5 días", hl:true },
 { talla:"33 cm", ml:"34×34×5 cm", real:"34×34×5", flauta:"C",ect:"ECT-32",vacío:"0.24 kg",máx:"3 kg", disp:"yellow", label:"3-5 días", hl:false },
 { talla:"40 cm", ml:"41×41×6 cm", real:"41×41×6", flauta:"C",ect:"ECT-32",vacío:"0.32 kg",máx:"4 kg", disp:"yellow", label:"3-5 días", hl:false },
 { talla:"45 cm", ml:"46×46×6 cm", real:"46×46×6", flauta:"C",ect:"ECT-32",vacío:"0.40 kg",máx:"5 kg", disp:"gray", label:"5-7 días", hl:false },
];

const specs = [
 ["Código SKU", "CAD-AL-01"],
 ["Aplicación", "Pizza 20-45 cm"],
 ["Liner", "Food-grade kraft marrón o blanco"],
 ["Pared", "Simple ECT-32"],
 ["Sin tintas tóxicas", "Sí"],
 ["Impresión", "Flexo 1-2 colores"],
 ["Ventilación", "Opcional anti-vapor"],
 ["Base", "Simple o doble"],
 ["Temperatura", "Hasta 80 °C 30 min"],
 ["Apilamiento", "10 cajas vacías"],
 ["MOQ", "100 pzas"],
 ["Entrega", "3-5 días hábiles"],
 ["Stock", "Consultar disponibilidad"],
];

const faqs = [
 {
 id:"al01-f1",
 question:"¿Qué medida de caja necesito para una pizza de 33 cm?",
 answer:"Para 33 cm el interior debe ser 34×34 cm (1 cm extra por lado). Altura 5 cm estándar, 6 cm para orilla rellena, 7-8 cm para decoración alta. Confirma la altura de tu pizza en frío antes de hacer el pedido.",
 },
 {
 id:"al01-f2",
 question:"¿Es mejor liner blanco o kraft marrón para cajas de pizza?",
 answer:"Blanco: mejor presentación, colores vivos, ideal para cadenas premium. Kraft: más económico, misma higiene food-grade, ideal para pizzerías artesanales. Para impresión: kraft acepta tintas oscuras bien; colores claros requieren liner blanco.",
 },
 { id:"al01-f3", question:"¿Cómo elegir la medida de caja para pizza?", answer:"La dimensión interior debe ser mayor al diámetro de la pizza ya horneada y considerar la altura de la orilla o toppings. Así se reduce el contacto con la tapa y se facilita el acomodo." },
 { id:"al01-f4", question:"¿Qué tipo de corrugado conviene para cajas de pizza?", answer:"La elección depende del tamaño, peso, nivel de humedad y forma de despacho. El kraft y el liner blanco ofrecen opciones de presentación distintas, mientras la resistencia se ajusta a la carga." },
 { id:"al01-f5", question:"¿Qué información debo enviar para cotizar cajas para pizza?", answer:"Envía el formulario con diámetro, altura, cantidad, tipo de pizza y necesidad de impresión. También indica si la caja llevará ventilación o un formato especial para revisar la configuración disponible." },
];

const mainImg = "/img/catalogo/cajas-pizza-corrugado-doble-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/cajas-pizza-corrugado-doble-cdmx.avif", alt: "Caja pizza corrugado — principal" },
 { src: "/img/catalogo/caja-pizza-hero-cdmx.avif", alt: "Caja pizza — hero" },
 { src: "/img/catalogo/caja-pizza-topview-cdmx.avif", alt: "Caja pizza — vista superior" },
 { src: "/img/catalogo/caja-pizza-stack-cdmx.avif", alt: "Cajas pizza — apiladas" },
 { src: "/img/catalogo/caja-pizza-detalle-cdmx.avif", alt: "Material food grade — detalle" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"Alimentos", href:"/catalogo/cajas-para-alimentos/"}, {name:"Cajas para Pizza"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja para Pizza Food Grade", sku:"CAD-AL-01", description:"Caja para Pizza Food Grade en CDMX — surtido coordinado por CADECA", image:"/img/catalogo/cajas-pizza-corrugado-doble-cdmx.avif", material:"Cartón corrugado simple food-grade pizza", category:"Cajas para Alimentos", moq:"100"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-alimentos/">Alimentos</a></li>
 <li><span class="current">Cajas para Pizza</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-al01-title"
   eyebrow="Alimentos · SKU CAD-AL-01"
   titleHtml={true}
   title="Cajas para pizza <span>con ventilación</span>"
   desc="Cajas para pizza de 20 a 45 cm que ayudan a organizar la entrega y presentación del producto. Se cotizan para pizzerías según diámetro, cantidad e impresión requerida."
   desc2="La configuración usa corrugado ECT-32, liner kraft marrón o blanco y ventilación antivapor opcional para formatos de 20 a 45 cm. Las <strong>cajas para pizza personalizadas</strong> pueden llevar impresión y definirse según diámetro, tipo de cierre y presentación.||Para elegir una caja de pizza, el diámetro y la ventilación antivapor determinan el formato y el cierre. Indica diámetro de la pizza, altura, tipo de masa, cantidad y si llevará impresión; CADECA revisa kraft, ventilación y presentación para cotizar."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-al01-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AL-01 · Familia: Cajas para Alimentos</p>
 <h2 id="detalle-al01-title" class="sku-detail__title">Caja para Pizza — Food Grade</h2>
 <p class="sku-detail__desc">Liner food-grade kraft marrón o blanco, sin tintas tóxicas. Pared simple ECT-32 con ventilación anti-vapor opcional. Base simple o doble según peso. Soporta hasta 80 °C durante 30 minutos. Impresión flexo 1-2 colores disponible.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Food-grade</span><span class="sku-detail__strip-label">Liner</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3-5 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-AL-01 Caja para Pizza Food Grade`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-AL-01</a>
 <a href="/catalogo/cajas-para-alimentos/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-al01-title">
 <div class="container">
 <h2 id="sizes-al01-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-AL-01</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
 <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Surtimos cualquier medida personalizada desde 100 piezas.  Producción coordinada bajo pedido.</p>
 </div>
 </section>

 </main>
 <FaqCotizacion faqs={faqs} tema="cajas para pizza" />
</PageLayout>
