---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja Café Bebidas Productos Secos CDMX | Food-grade | CAD-AL-09 | CADECA";
const description = "Caja para café, bebidas, snacks y productos secos en CDMX. Corrugado simple/doble food-grade, compatible para distribución directa a cafeterías y tiendas. CADECA.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU", "CAD-AL-09"],
 ["Certificación", "Food-grade NOM-051"],
 ["Material", "Kraft virgen"],
 ["Uso", "Seco y semiseco"],
 ["Compatibilidad", "Distribución B2B y e-commerce"],
 ["Impresión", "Opcional 1 color"],
 ["Medidas", "4 estándar café/bebidas"],
 ["Pedido mínimo", "100 piezas"],
 ["Entrega CDMX", "24 hrs"],
];

const faqs = [
 { id:"cad-al-09-f1", question:"¿Las cajas son aptas para productos que tienen aroma intenso como el café?", answer:"Sí. El kraft virgen sin tratamientos especiales es compatible con productos de aroma intenso como café, especias y hierbas aromáticas. No absorbe ni transfiere olores hacia el producto. Si el producto es muy sensible a la absorción de aromas externos, recomendamos bolsa interior de celofán o papel kraft encerado como barrera adicional." },
 { id:"cad-al-09-f2", question:"¿Puedo usarlas para envíos por Mercado Libre o Amazon de productos alimenticios?", answer:"Sí. CAD-AL-09 cumple los requisitos de embalaje de Mercado Libre y Amazon México para alimentos secos no perecederos. El doble corrugado ECT-32 supera el mínimo exigido para peso de hasta 5 kg. Para alimentos refrigerados o congelados, verifica los requisitos específicos de temperatura de las plataformas." },
 { id:"cad-al-09-f3", question:"¿Tienen medidas específicas para cajas de café de 1 kg?", answer:"Sí, una de las 4 medidas estándar de CAD-AL-09 está dimensionada específicamente para bolsas de café de 250 g a 1 kg. Pregunta por la medida CA-09-C al solicitar tu cotización." },
];

const gallery = [
 { src: "/img/catalogo/cajas-fast-food-antigrasa-cdmx.avif", alt: "Caja café bebidas productos secos CDMX" },
 { src: "/img/catalogo/cajas-medida-alimentos-fda-cdmx.avif", alt: "Empaque food-grade café" },
 { src: "/img/catalogo/cajas-pasteleria-tartas-cdmx.avif", alt: "Cajas alimentos artesanales" },
 { src: "/img/catalogo/cajas-carton-corrugado-simple-pared-cdmx.avif", alt: "Corrugado simple alimentación" },
 { src: "/img/catalogo/corrugado-doble-pared-hero-cdmx.avif", alt: "Corrugado doble pared alimentos" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas para Alimentos",href:"/catalogo/cajas-para-alimentos"},{name:"Caja para Café, Bebidas y Productos Secos"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para Café, Bebidas y Productos Secos",sku:"CAD-AL-09",description:"Caja food-grade para café, bebidas envasadas, snacks y productos secos. Compatible con distribución directa a cafeterías, tiendas de conveniencia y e-commerce.",image:gallery[0].src,material:"CAD-AL-09",category:"Cajas para Alimentos",moq:"100 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-alimentos">Cajas para Alimentos</a></li>
 <li><span class="current">Caja para Café, Bebidas y Productos Secos</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-cadal09-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-AL-09 · Cajas para Alimentos</span>
 <h1 id="sku-cadal09-title" class="cat-page-hero__title">Caja para <span>Café</span>, Bebidas y Productos Secos CDMX</h1>
 <p class="cat-page-hero__desc">Caja food-grade para café, bebidas envasadas, snacks y productos secos. Compatible con distribución directa a cafeterías, tiendas de conveniencia y e-commerce.</p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AL-09</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>100 piezas</strong></div>
 <div class="cat-page-hero__strip-item">Fabricante: <strong>Directo</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadal09-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AL-09 · Familia: Cajas para Alimentos</p>
 <h2 id="detalle-cadal09-title" class="sku-detail__title">Caja para Café, Bebidas y Productos Secos</h2>
 <p class="sku-detail__desc">El mercado de café de especialidad, bebidas naturales y snacks artesanales en CDMX crece rápidamente y necesita un empaque que sea funcional para distribución B2B y atractivo para el cliente final. CAD-AL-09 es food-grade, disponible en kraft natural o con opción de personalización mínima, y resistente para el manejo en rutas de entrega directa a cafeterías y tiendas de conveniencia. Compatible también con envíos por e-commerce a toda la república.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Food-grade</span><span class="sku-detail__strip-label">NOM-051</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">B2B</span><span class="sku-detail__strip-label">Distribución</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AL-09 Caja para Café, Bebidas y Productos Secos`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AL-09</a>
 <a href="/catalogo/cajas-para-alimentos" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-cadal09-title">
 <div class="container">
 <h2 id="faq-cadal09-title" class="sku-faq__title">Preguntas Frecuentes — Caja para Café, Bebidas y Productos Secos</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="¿Vendes café o productos artesanales? Cotiza la caja food-grade perfecta para tu distribución" />
</PageLayout>
