---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem     from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Cajas Congelados Resistentes Humedad CDMX | WR Liner -18°C | CAD-AL-05 | CADECA";
const description = "Cajas congelados CDMX. WR liner, ECT-44 retiene 80% con humedad, -18°C. Desde 100 pzas, 5-7 días. CADECA fabricante.";
const WHATSAPP    = "5255XXXXXXXX";

const medidas = [
  { talla:"S", ml:"30×20×15 cm", real:"30×20×15", flauta:"BC",ect:"ECT-44 WR",vacío:"0.45 kg",máx:"8 kg", disp:"yellow", label:"5-7 días", hl:false },
  { talla:"M", ml:"40×30×20 cm", real:"40×30×20", flauta:"BC",ect:"ECT-44 WR",vacío:"0.70 kg",máx:"15 kg", disp:"yellow", label:"5-7 días", hl:true },
  { talla:"L", ml:"50×35×25 cm", real:"50×35×25", flauta:"BC",ect:"ECT-44 WR",vacío:"1.00 kg",máx:"22 kg", disp:"yellow", label:"5-7 días", hl:true },
  { talla:"XL", ml:"60×45×30 cm", real:"60×45×30", flauta:"BC",ect:"ECT-44 WR",vacío:"1.45 kg",máx:"30 kg", disp:"gray", label:"7-10 días", hl:false },
  { talla:"A la medida", ml:"Personalizada", real:"A definir", flauta:"BC",ect:"ECT-44 WR",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
  ["Código SKU", "CAD-AL-05"],
  ["Aplicación", "Helados · Mariscos · Carnes · Congelados"],
  ["Liner", "WR Water Resistant"],
  ["ECT humedad", "Retiene 80% a 90% HR"],
  ["Temperatura mínima", "-18 °C"],
  ["Pared", "Doble BC ECT-44"],
  ["Condensación", "Resistente a ciclos frío-temp"],
  ["Marcado", "Datos nutricionales y trazabilidad"],
  ["MOQ", "100 pzas"],
  ["Entrega", "5-7 días hábiles"],
  ["Certificación", "Apto contacto indirecto COFEPRIS"],
];

const faqs = [
  {
    id:"al05-f1",
    question:"¿Qué es el liner WR y cómo funciona?",
    answer:"Papel exterior tratado con agentes hidrofóbicos que forman barrera contra agua y vapor. A diferencia del cartón estándar que absorbe humedad y pierde resistencia, el WR mantiene 70-80% del ECT original a 90% HR por 24-48 horas. Esencial en cámaras donde los ciclos de apertura generan condensación constante.",
  },
  {
    id:"al05-f2",
    question:"¿Por qué el ECT baja con la humedad?",
    answer:"El cartón es higroscópico: absorbe humedad reduciendo la rigidez del médium y liner. Un ECT-44 puede bajar a ECT-20 efectivo a 90% HR sin WR. El liner WR ralentiza este proceso manteniendo ECT efectivo en 35-38 (80%) incluso en congelación.",
  },
];

const mainImg = "/img/catalogo/cajas-congelados-humedad-cdmx.avif";
const gallery = [
  { src: mainImg, alt: "Caja Congelados — vista frontal CDMX" },
  { src: mainImg, alt: "Caja Congelados — detalle corrugación" },
  { src: mainImg, alt: "Caja Congelados — stack apilado" },
  { src: mainImg, alt: "Caja Congelados — contexto uso industrial" },
  { src: mainImg, alt: "Caja Congelados — medidas referencia" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"Alimentos", href:"/catalogo/cajas-para-alimentos"}, {name:"Congelados"}]}
  faqItems={[{question:"¿Qué es el liner WR y cómo funciona?", answer:"Papel exterior tratado con agentes hidrofóbicos que forman barrera contra agua y vapor. A diferencia del cartón estándar que absorbe humedad y pierde resistencia, el WR mantiene 70-80% del ECT original a 90% HR por 24-48 horas. Esencial en cámaras donde los ciclos de apertura generan condensación constante."}, {question:"¿Por qué el ECT baja con la humedad?", answer:"El cartón es higroscópico: absorbe humedad reduciendo la rigidez del médium y liner. Un ECT-44 puede bajar a ECT-20 efectivo a 90% HR sin WR. El liner WR ralentiza este proceso manteniendo ECT efectivo en 35-38 (80%) incluso en congelación."}]}
  product={{name:"Caja Congelados Resistente Humedad WR Liner", sku:"CAD-AL-05", description:"Caja Congelados Resistente Humedad WR Liner en CDMX — fabricante directo CADECA", image:"/img/catalogo/cajas-congelados-humedad-cdmx.avif", material:"Cartón corrugado ECT-44 WR liner water resistant congelados -18°C", category:"Cajas para Alimentos", moq:"100"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-para-alimentos">Alimentos</a></li>
        <li><span class="current">Congelados</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-al05-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-AL-05 · Cajas para Alimentos</span>
      <h1 id="sku-al05-title" class="cat-page-hero__title">Cajas Congelados <span>WR Liner</span><br>— Resistente Humedad -18 °C CDMX</h1>
      <p class="cat-page-hero__desc">Liner WR water resistant que retiene 80% del ECT a 90% HR. Doble corrugado BC ECT-44 para helados, mariscos, carnes y congelados hasta -18 °C. Desde 100 piezas.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AL-05</strong></div>
        <div class="cat-page-hero__strip-item">Liner: <strong>WR Water Resistant</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>100 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>5-7 días</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-al05-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-AL-05 · Familia: Cajas para Alimentos</p>
            <h2 id="detalle-al05-title" class="sku-detail__title">Caja Congelados — WR Liner Resistente Humedad</h2>
            <p class="sku-detail__desc">Liner WR water resistant sobre doble corrugado BC ECT-44. Retiene 80% del ECT a 90% HR. Resistente a ciclos de condensación frío-temperatura. Apto contacto indirecto COFEPRIS. Marcado para datos nutricionales y trazabilidad.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">WR Liner</span><span class="sku-detail__strip-label">Tratamiento</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5-7 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AL-05 Caja Congelados WR Liner`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AL-05</a>
              <a href="/catalogo/cajas-para-alimentos" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-al05-title">
      <div class="container">
        <h2 id="sizes-al05-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-AL-05</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
                  <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
                  <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"✓":"⏱"} {m.label}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Fabricamos cualquier medida personalizada desde 100 piezas. ⏱ Producción bajo pedido.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-al05-title">
      <div class="container">
        <h2 id="faq-al05-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-AL-05</h2>
        <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
      </div>
    </section>
  </main>
  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-AL-05 — Cajas congelados desde 100 piezas, entrega 5-7 días" />
</PageLayout>
