---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas para Congelados Resistentes a Humedad | CADECA";
const description = "Cajas congelados CDMX. WR liner, ECT-44 retiene 80% con humedad, -18°C. Desde 100 pzas, entrega programada según pedido. CADECA proveedor.";

const medidas = [
 { talla:"S", ml:"30×20×15 cm", real:"30×20×15", flauta:"BC",ect:"ECT-44 WR",vacío:"0.45 kg",máx:"8 kg", disp:"yellow", label:"5-7 días", hl:false },
 { talla:"M", ml:"40×30×20 cm", real:"40×30×20", flauta:"BC",ect:"ECT-44 WR",vacío:"0.70 kg",máx:"15 kg", disp:"yellow", label:"5-7 días", hl:true },
 { talla:"L", ml:"50×35×25 cm", real:"50×35×25", flauta:"BC",ect:"ECT-44 WR",vacío:"1.00 kg",máx:"22 kg", disp:"yellow", label:"5-7 días", hl:true },
 { talla:"XL", ml:"60×45×30 cm", real:"60×45×30", flauta:"BC",ect:"ECT-44 WR",vacío:"1.45 kg",máx:"30 kg", disp:"gray", label:"7-10 días", hl:false },
 { talla:"A la medida", ml:"Personalizada", real:"A definir", flauta:"BC",ect:"ECT-44 WR",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
 ["Código SKU", "CAD-AL-05"],
 ["Aplicación", "Helados · Mariscos · Carnes · Congelados"],
 ["Liner", "WR Water Resistant"],
 ["ECT humedad", "Retiene 80% a 90% HR"],
 ["Temperatura mínima", "-18 °C"],
 ["Pared", "Doble BC ECT-44"],
 ["Condensación", "Resistente a ciclos frío-temp"],
 ["Marcado", "Datos nutricionales y trazabilidad"],
 ["MOQ", "100 pzas"],
 ["Entrega", "5-7 días hábiles"],
 ["Certificación", "Apto contacto indirecto COFEPRIS"],
];

const faqs = [
 {
 id:"al05-f1",
 question:"¿Qué es el liner WR y cómo funciona?",
 answer:"El liner WR es un papel exterior con tratamiento resistente a humedad que ayuda a disminuir la absorción de agua y vapor. Puede ser útil en entornos con condensación, aunque la resistencia final depende de la carga, manejo y condiciones de almacenamiento.",
 },
 {
 id:"al05-f2",
 question:"¿Por qué el ECT baja con la humedad?",
 answer:"El cartón es higroscópico: absorbe humedad reduciendo la rigidez del médium y liner. Un ECT-44 puede bajar a ECT-20 efectivo a 90% HR sin WR. El liner WR ralentiza este proceso manteniendo ECT efectivo en 35-38 (80%) incluso en congelación.",
 },
 { id:"al05-f3", question:"¿Cómo elegir cajas para alimentos congelados?", answer:"Considera el peso, las dimensiones y la humedad esperada durante el traslado o almacenamiento. El liner resistente a humedad ayuda a conservar la rigidez del corrugado, pero no sustituye el control de temperatura." },
 { id:"al05-f4", question:"¿Qué significa ECT en una caja para productos congelados?", answer:"ECT es una medida de resistencia a compresión del cartón corrugado. Un valor mayor puede ser útil cuando se requiere apilado o cuando la carga y la humedad exigen una estructura con mayor rigidez." },
 { id:"al05-f5", question:"¿Qué información debo enviar para cotizar cajas para congelados?", answer:"Envía el formulario con medidas, cantidad, peso por caja y condiciones de uso. Indica si habrá cámara fría, condensación o apilado para revisar la resistencia y el tipo de liner más convenientes." },
];

const mainImg = "/img/catalogo/cajas-congelados-humedad-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/cajas-congelados-humedad-cdmx.avif", alt: "Caja congelados — principal" },
 { src: "/img/catalogo/caja-congelados-hero-cdmx.avif", alt: "Congelados — hero" },
 { src: "/img/catalogo/caja-congelados-resistencia-cdmx.avif", alt: "Resistencia a humedad" },
 { src: "/img/catalogo/caja-congelados-stack-cdmx.avif", alt: "Cajas congelados — apiladas" },
 { src: "/img/catalogo/caja-congelados-cera-cdmx.avif", alt: "Barrera de cera — detalle" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"Alimentos", href:"/catalogo/cajas-para-alimentos/"}, {name:"Congelados"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja Congelados Resistente Humedad WR Liner", sku:"CAD-AL-05", description:"Caja Congelados Resistente Humedad WR Liner en CDMX — surtido coordinado por CADECA", image:"/img/catalogo/cajas-congelados-humedad-cdmx.avif", material:"Cartón corrugado ECT-44 WR liner water resistant congelados -18°C", category:"Cajas para Alimentos", moq:"100"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-alimentos/">Alimentos</a></li>
 <li><span class="current">Congelados</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-al05-title"
   eyebrow="Alimentos · SKU CAD-AL-05"
   titleHtml={true}
   title="Cajas para congelados <span>resistentes a humedad</span>"
   desc="Cajas para congelados, helados, mariscos y carnes que requieren cartón definido para ambiente húmedo. Se especifican para distribución, almacenamiento y el peso de cada producto."
   desc2="La configuración usa doble corrugado BC ECT-44 y liner WR para conservar la resistencia en humedad relativa alta. Las <strong>cajas resistentes a la humedad</strong> se consideran para productos congelados, con la medida, peso y forma de estiba que se requiera en cada operación.||CADECA surte por medio de talleres aliados al confirmar medidas, cantidad, uso y zona de entrega. Indica el tipo de congelado, peso y condiciones de manejo para asesorarte sobre liner, resistencia y formato de caja para la operación."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-al05-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AL-05 · Familia: Cajas para Alimentos</p>
 <h2 id="detalle-al05-title" class="sku-detail__title">Caja Congelados — WR Liner Resistente Humedad</h2>
 <p class="sku-detail__desc">Liner WR water resistant sobre doble corrugado BC ECT-44. Retiene 80% del ECT a 90% HR. Resistente a ciclos de condensación frío-temperatura. Apto contacto indirecto COFEPRIS. Marcado para datos nutricionales y trazabilidad.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">WR Liner</span><span class="sku-detail__strip-label">Tratamiento</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5-7 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-AL-05 Caja Congelados WR Liner`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-AL-05</a>
 <a href="/catalogo/cajas-para-alimentos/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-al05-title">
 <div class="container">
 <h2 id="sizes-al05-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-AL-05</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
 <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Surtimos cualquier medida personalizada desde 100 piezas.  Producción coordinada bajo pedido.</p>
 </div>
 </section>

 </main>
 <FaqCotizacion faqs={faqs} tema="cajas para congelados" />
</PageLayout>
