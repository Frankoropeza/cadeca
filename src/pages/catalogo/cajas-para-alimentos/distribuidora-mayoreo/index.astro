---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja Distribuidora Alimentos Mayoreo CDMX | ECT-44 | CAD-AL-08 | CADECA";
const description = "Caja para distribuidora de alimentos al mayoreo en CDMX. Alta resistencia al apilado ECT-44, entrega en ruta por zonas. Stock permanente. MOQ 500 pzas. CADECA.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU", "CAD-AL-08"],
 ["Tipo", "Doble corrugado BC"],
 ["Resistencia", "ECT-44"],
 ["Stock", "Permanente 6 medidas"],
 ["Ciclo", "Reorden semanal/quincenal"],
 ["Apilado", "12 hrs ruta distribución"],
 ["Material", "Kraft virgen / reciclado"],
 ["Pedido mínimo", "500 piezas"],
 ["Entrega CDMX", "24 hrs en stock"],
];

const faqs = [
 { id:"cad-al-08-f1", question:"¿Pueden manejar pedidos recurrentes con entrega programada?", answer:"Sí. Para distribuidoras con consumo predecible, manejamos blanket orders: defines el volumen mensual estimado y nosotros apartamos producción. Las entregas se programan semanalmente o quincenalmente según tu ciclo. No pagas todo de golpe — solo el lote de la semana más la reserva de producción." },
 { id:"cad-al-08-f2", question:"¿Pueden entregar directamente en mis bodegas de distribución?", answer:"Sí, entregamos en instalaciones de cliente en CDMX y área metropolitana para pedidos de 500+ piezas. Para rutas fuera del área metropolitana, manejamos flete a través de paqueterías consolidadas. Consultanos la zona específica para confirmar tiempos y costos." },
 { id:"cad-al-08-f3", question:"¿Tienen algún descuento por volumen para distribuidoras?", answer:"Sí. Los precios decrementales aplican a partir de 1,000 piezas por orden. Para contratos mensuales de 5,000+ piezas, ofrecemos precio de contrato fijo durante 6 meses independientemente de variaciones en materias primas. Consulta a tu asesor comercial para la estructura de descuentos aplicable a tu volumen." },
];

const gallery = [
 { src: "/img/catalogo/cajas-medida-alimentos-fda-cdmx.avif", alt: "Caja distribuidora alimentos mayoreo CDMX" },
 { src: "/img/catalogo/caja-almacen-industrial-rack-cdmx.avif", alt: "Almacén distribución alimentos" },
 { src: "/img/catalogo/caja-almacen-industrial-pasillos-cdmx.avif", alt: "Pasillos distribución" },
 { src: "/img/catalogo/corrugado-doble-pared-apilado-cdmx.avif", alt: "Apilado rutas distribución" },
 { src: "/img/catalogo/caja-exportacion-pallet-cdmx.avif", alt: "Pallet distribuidora alimentos" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas para Alimentos",href:"/catalogo/cajas-para-alimentos"},{name:"Caja para Distribuidora de Alimentos Mayoreo"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para Distribuidora de Alimentos Mayoreo",sku:"CAD-AL-08",description:"Caja para distribución mayorista de alimentos en CDMX. Doble corrugado ECT-44, alta resistencia al apilado en ruta, stock permanente para entrega programada semanal.",image:gallery[0].src,material:"CAD-AL-08",category:"Cajas para Alimentos",moq:"500 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-alimentos">Cajas para Alimentos</a></li>
 <li><span class="current">Caja para Distribuidora de Alimentos Mayoreo</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-cadal08-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-AL-08 · Cajas para Alimentos</span>
 <h1 id="sku-cadal08-title" class="cat-page-hero__title">Caja para <span>Distribuidora</span> de Alimentos Mayoreo CDMX</h1>
 <p class="cat-page-hero__desc">Caja para distribución mayorista de alimentos en CDMX. Doble corrugado ECT-44, alta resistencia al apilado en ruta, stock permanente para entrega programada semanal.</p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AL-08</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>500 piezas</strong></div>
 <div class="cat-page-hero__strip-item">Fabricante: <strong>Directo</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadal08-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AL-08 · Familia: Cajas para Alimentos</p>
 <h2 id="detalle-cadal08-title" class="sku-detail__title">Caja para Distribuidora de Alimentos Mayoreo</h2>
 <p class="sku-detail__desc">Las distribuidoras de alimentos manejan volúmenes altos con ciclos de pedido predecibles y exigencias de resistencia al apilado en rutas largas. CAD-AL-08 está en stock permanente para pedidos semanales o quincenales sin esperar producción. Doble corrugado ECT-44, diseñada para soportar el apilado en camiones de reparto durante 8-12 horas de ruta. Disponible en 6 medidas que cubren abarrotes, bebidas, lácteos y snacks.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">6 medidas</span><span class="sku-detail__strip-label">En stock</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">500 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Semanal</span><span class="sku-detail__strip-label">Reorden</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AL-08 Caja para Distribuidora de Alimentos Mayoreo`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AL-08</a>
 <a href="/catalogo/cajas-para-alimentos" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-cadal08-title">
 <div class="container">
 <h2 id="faq-cadal08-title" class="sku-faq__title">Preguntas Frecuentes — Caja para Distribuidora de Alimentos Mayoreo</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="¿Eres distribuidora de alimentos? Cotiza tu blanket order y asegura stock permanente en CDMX" />
</PageLayout>
