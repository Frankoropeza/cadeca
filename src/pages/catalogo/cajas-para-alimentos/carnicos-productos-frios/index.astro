---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja Cárnicos Productos Fríos CDMX | Antihumedad | CAD-AL-07 | CADECA";
const description = "Caja para cárnicos y productos fríos en CDMX. Barrera antihumedad integrada, corrugado doble pared, apta para refrigeración. MOQ 200 pzas. CADECA fabricante.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU", "CAD-AL-07"],
 ["Certificación", "Food-grade NOM-213 cárnicos"],
 ["Barrera", "Antihumedad exterior"],
 ["Resistencia", "ECT-44 húmedo"],
 ["Temperatura", "Apta 2–8°C distribución"],
 ["Material", "Kraft virgen antihumedad"],
 ["Tiempo en frío", "Hasta 6 hrs sin pérdida estructural"],
 ["Pedido mínimo", "200 piezas"],
 ["Entrega CDMX", "24–48 hrs"],
];

const faqs = [
 { id:"cad-al-07-f1", question:"¿La caja aguanta el peso de carne con líquidos?", answer:"CAD-AL-07 está diseñada para carga sólida en frío con presencia de humedad superficial, no para inmersión en líquidos. Si el producto genera jugos en volumen, recomendamos liner interior de polietileno como accesorio adicional. Para distribución normal de carne envasada al vacío o en charola, la caja es completamente adecuada." },
 { id:"cad-al-07-f2", question:"¿Cumple normativa COFEPRIS para distribución de cárnicos?", answer:"Sí. El material de CAD-AL-07 es food-grade compatible con NOM-213-SSA1 que regula productos cárnicos procesados. Para productos cárnicos frescos (no procesados) que requieren temperatura de 0-4°C, verificar que las condiciones de distribución y el tiempo en ruta sean compatibles con las 6 horas de integridad que ofrece la caja." },
 { id:"cad-al-07-f3", question:"¿Puedo reutilizar la caja en más de una ruta?", answer:"No recomendamos la reutilización para cárnicos por razones de inocuidad. La barrera antihumedad se degrada con el uso repetido y la normativa de inocuidad alimentaria requiere materiales de un solo uso en contacto con productos cárnicos. Sin embargo, para el retorno de cajas vacías (sin contacto posterior con alimentos), el cartón es totalmente reciclable." },
];

const gallery = [
 { src: "/img/catalogo/cajas-congelados-humedad-cdmx.avif", alt: "Caja cárnicos antihumedad distribución CDMX" },
 { src: "/img/catalogo/cajas-medida-alimentos-fda-cdmx.avif", alt: "Empaques alimentos certificados" },
 { src: "/img/catalogo/corrugado-doble-pared-hero-cdmx.avif", alt: "Doble corrugado resistencia" },
 { src: "/img/catalogo/corrugado-doble-pared-apilado-cdmx.avif", alt: "Apilado cajas cárnicos" },
 { src: "/img/catalogo/caja-exportacion-pallet-cdmx.avif", alt: "Distribución en pallet" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas para Alimentos",href:"/catalogo/cajas-para-alimentos"},{name:"Caja para Cárnicos y Productos Fríos"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para Cárnicos y Productos Fríos",sku:"CAD-AL-07",description:"Caja con barrera antihumedad para distribución de cárnicos, embutidos y productos refrigerados. Mantiene integridad estructural en temperaturas de 2°C a 8°C hasta 6 horas.",image:gallery[0].src,material:"CAD-AL-07",category:"Cajas para Alimentos",moq:"200 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-alimentos">Cajas para Alimentos</a></li>
 <li><span class="current">Caja para Cárnicos y Productos Fríos</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-cadal07-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-AL-07 · Cajas para Alimentos</span>
 <h1 id="sku-cadal07-title" class="cat-page-hero__title">Caja para <span>Cárnicos</span> y Productos Fríos — Antihumedad CDMX</h1>
 <p class="cat-page-hero__desc">Caja con barrera antihumedad para distribución de cárnicos, embutidos y productos refrigerados. Mantiene integridad estructural en temperaturas de 2°C a 8°C hasta 6 horas.</p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AL-07</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>200 piezas</strong></div>
 <div class="cat-page-hero__strip-item">Fabricante: <strong>Directo</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadal07-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AL-07 · Familia: Cajas para Alimentos</p>
 <h2 id="detalle-cadal07-title" class="sku-detail__title">Caja para Cárnicos y Productos Fríos</h2>
 <p class="sku-detail__desc">La distribución de cárnicos y embutidos exige un corrugado que no pierda resistencia al contacto con la humedad superficial y los ciclos de temperatura durante el reparto. CAD-AL-07 tiene barrera antihumedad en el liner exterior que mantiene la resistencia estructural en entornos refrigerados (2-8°C) durante las rutas de distribución habituales. Ideal para carnicerías, distribuidoras de embutidos, plantas TIPO y centros de distribución de supermercados.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Húmedo</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">NOM-213</span><span class="sku-detail__strip-label">Cárnicos</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">2–8°C</span><span class="sku-detail__strip-label">Temperatura</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">200 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AL-07 Caja para Cárnicos y Productos Fríos`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AL-07</a>
 <a href="/catalogo/cajas-para-alimentos" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-cadal07-title">
 <div class="container">
 <h2 id="faq-cadal07-title" class="sku-faq__title">Preguntas Frecuentes — Caja para Cárnicos y Productos Fríos</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="¿Distribuyes cárnicos en CDMX? Cotiza la caja con barrera antihumedad adecuada para tu ruta" />
</PageLayout>
