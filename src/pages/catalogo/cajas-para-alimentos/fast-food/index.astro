---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem     from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Cajas Fast Food Antigrasa CDMX | Hamburguesas Wraps | CAD-AL-02 | CADECA";
const description = "Cajas fast food antigrasa CDMX. Hamburguesas, wraps, nuggets. FDA compliant, desde 100 pzas, 3-5 días. CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const medidas = [
  { talla:"XS nuggets", ml:"12×12×6 cm", real:"12×12×6", flauta:"C",ect:"ECT-32",vacío:"0.08 kg",máx:"0.5 kg", disp:"yellow", label:"3-5 días", hl:false },
  { talla:"S hamburguesa", ml:"14×14×8 cm", real:"14×14×8", flauta:"C",ect:"ECT-32",vacío:"0.10 kg",máx:"0.8 kg", disp:"yellow", label:"3-5 días", hl:true },
  { talla:"M burger doble", ml:"16×16×10 cm", real:"16×16×10", flauta:"C",ect:"ECT-32",vacío:"0.13 kg",máx:"1.0 kg", disp:"yellow", label:"3-5 días", hl:true },
  { talla:"L wrap", ml:"22×14×8 cm", real:"22×14×8", flauta:"C",ect:"ECT-32",vacío:"0.14 kg",máx:"0.8 kg", disp:"yellow", label:"3-5 días", hl:false },
  { talla:"XL combo", ml:"26×22×12 cm", real:"26×22×12", flauta:"C",ect:"ECT-32",vacío:"0.20 kg",máx:"2.0 kg", disp:"gray", label:"5-7 días", hl:false },
  { talla:"A la medida", ml:"Personalizada", real:"A definir", flauta:"C",ect:"ECT-32",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
  ["Código SKU", "CAD-AL-02"],
  ["Aplicación", "Hamburguesas · Wraps · Nuggets"],
  ["Tratamiento", "Antigrasa tipo 3 o 5"],
  ["Liner", "Kraft marrón o blanco"],
  ["Sin tintas tóxicas", "FDA compliant"],
  ["Pared", "Simple ECT-32"],
  ["Temperatura", "90 °C 20 min"],
  ["Impresión", "Flexo 1-2 colores"],
  ["Ventilación", "Opcional"],
  ["Formato", "Almeja o tapa"],
  ["MOQ", "100 pzas"],
  ["Entrega", "3-5 días hábiles"],
];

const faqs = [
  {
    id:"al02-f1",
    question:"¿Qué es el tratamiento antigrasa?",
    answer:"Aplicación de agentes repelentes de aceite. Tipo 3 para nuggets y aros; tipo 5-6 para hamburguesas con salsas. Sin tratamiento el aceite degrada el corrugado en minutos.",
  },
  {
    id:"al02-f2",
    question:"¿Las tintas son seguras para el cliente?",
    answer:"Solo tintas base agua sin metales pesados, aprobadas FDA/COFEPRIS. Interior sin impresión. Si el producto tiene contacto directo con cartón sin envase primario, consúltanos.",
  },
];

const mainImg = "/img/catalogo/cajas-fast-food-antigrasa-cdmx.avif";
const gallery = [
  { src: "/img/catalogo/cajas-fast-food-antigrasa-cdmx.avif", alt: "Caja fast food — principal" },
  { src: "/img/catalogo/caja-fastfood-hero-cdmx.avif", alt: "Fast food — hero" },
  { src: "/img/catalogo/caja-fastfood-grasa-cdmx.avif", alt: "Tratamiento antigrasa" },
  { src: "/img/catalogo/caja-fastfood-delivery-cdmx.avif", alt: "Cajas — delivery" },
  { src: "/img/catalogo/caja-fastfood-tallas-cdmx.avif", alt: "Tallas por menú" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"Alimentos", href:"/catalogo/cajas-para-alimentos"}, {name:"Fast Food Antigrasa"}]}
  faqItems={[{question:"¿Qué es el tratamiento antigrasa?", answer:"Aplicación de agentes repelentes de aceite. Tipo 3 para nuggets y aros; tipo 5-6 para hamburguesas con salsas. Sin tratamiento el aceite degrada el corrugado en minutos."}, {question:"¿Las tintas son seguras para el cliente?", answer:"Solo tintas base agua sin metales pesados, aprobadas FDA/COFEPRIS. Interior sin impresión. Si el producto tiene contacto directo con cartón sin envase primario, consúltanos."}]}
  product={{name:"Caja Fast Food Antigrasa", sku:"CAD-AL-02", description:"Caja Fast Food Antigrasa en CDMX — fabricante directo CADECA", image:"/img/catalogo/cajas-fast-food-antigrasa-cdmx.avif", material:"Cartón corrugado antigrasa FDA compliant fast food", category:"Cajas para Alimentos", moq:"100"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-para-alimentos">Alimentos</a></li>
        <li><span class="current">Fast Food Antigrasa</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-al02-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-AL-02 · Cajas para Alimentos</span>
      <h1 id="sku-al02-title" class="cat-page-hero__title">Cajas Fast Food <span>Antigrasa</span><br>— FDA Compliant CDMX</h1>
      <p class="cat-page-hero__desc">Cajas con tratamiento antigrasa tipo 3 o 5 para hamburguesas, wraps y nuggets. Formato almeja o tapa. Tintas base agua FDA compliant. Desde 100 piezas.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AL-02</strong></div>
        <div class="cat-page-hero__strip-item">Tratamiento: <strong>Antigrasa FDA</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>100 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>3-5 días</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-al02-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-AL-02 · Familia: Cajas para Alimentos</p>
            <h2 id="detalle-al02-title" class="sku-detail__title">Caja Fast Food — Antigrasa</h2>
            <p class="sku-detail__desc">Tratamiento antigrasa tipo 3 (nuggets, aros) o tipo 5 (hamburguesas con salsas). Formato almeja o tapa según aplicación. Soporta hasta 90 °C durante 20 minutos. Solo tintas base agua sin metales pesados.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Antigrasa</span><span class="sku-detail__strip-label">Tratamiento</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3-5 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AL-02 Caja Fast Food Antigrasa`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AL-02</a>
              <a href="/catalogo/cajas-para-alimentos" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-al02-title">
      <div class="container">
        <h2 id="sizes-al02-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-AL-02</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
                  <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
                  <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"✓":"⏱"} {m.label}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Fabricamos cualquier medida personalizada desde 100 piezas. ⏱ Producción bajo pedido.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-al02-title">
      <div class="container">
        <h2 id="faq-al02-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-AL-02</h2>
        <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
      </div>
    </section>
  </main>
  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-AL-02 — Cajas fast food desde 100 piezas, entrega 3-5 días" />
</PageLayout>
