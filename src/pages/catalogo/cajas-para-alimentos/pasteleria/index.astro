---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem     from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Cajas Pastelería Tartas CDMX | Base Reforzada | Ventana Acetato | CAD-AL-03 | CADECA";
const description = "Cajas pastelería CDMX. Pay, tarta, cupcakes, gelatinas. Interior blanco, base reforzada, acetato opcional. Desde 100 pzas, 3-5 días. CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const medidas = [
  { talla:"Pay 20 cm", ml:"22×22×10 cm", real:"22×22×10", flauta:"C",ect:"ECT-32",vacío:"0.22 kg",máx:"2 kg", disp:"yellow", label:"3-5 días", hl:false },
  { talla:"Pay 25 cm", ml:"27×27×12 cm", real:"27×27×12", flauta:"C",ect:"ECT-32",vacío:"0.28 kg",máx:"3 kg", disp:"yellow", label:"3-5 días", hl:true },
  { talla:"Pay 30 cm", ml:"32×32×12 cm", real:"32×32×12", flauta:"C",ect:"ECT-32",vacío:"0.35 kg",máx:"4 kg", disp:"yellow", label:"3-5 días", hl:true },
  { talla:"Cupcakes ×6", ml:"25×17×10 cm", real:"25×17×10", flauta:"C",ect:"ECT-32",vacío:"0.20 kg",máx:"1 kg", disp:"yellow", label:"3-5 días", hl:false },
  { talla:"Cupcakes ×12", ml:"35×24×10 cm", real:"35×24×10", flauta:"C",ect:"ECT-32",vacío:"0.30 kg",máx:"1.5 kg", disp:"yellow", label:"3-5 días", hl:false },
  { talla:"Gelatina rect.", ml:"30×20×10 cm", real:"30×20×10", flauta:"C",ect:"ECT-32",vacío:"0.25 kg",máx:"2 kg", disp:"gray", label:"5-7 días", hl:false },
];

const specs = [
  ["Código SKU", "CAD-AL-03"],
  ["Aplicación", "Pay · Tarta · Cupcakes · Gelatinas"],
  ["Interior", "Kraft blanco coated"],
  ["Base", "Reforzada 2 capas"],
  ["Ventana acetato", "Opcional MOQ 200"],
  ["Cierre", "Lengüeta o cinta"],
  ["Pared", "Simple ECT-32"],
  ["Interior sin impresión", "Sí"],
  ["Impresión ext.", "Flexo 1-2 colores"],
  ["Peso máx. pastel", "4 kg"],
  ["MOQ", "100 pzas"],
  ["Entrega", "3-5 días hábiles"],
];

const faqs = [
  {
    id:"al03-f1",
    question:"¿Cuándo necesito la ventana de acetato?",
    answer:"Cuando el pastel tiene decoración visual importante y se vende en punto de venta donde el cliente escoge visualmente, o cuando es regalo. Para pasteles por pedido anticipado la ventana no agrega valor y aumenta el costo.",
  },
  {
    id:"al03-f2",
    question:"¿Por qué la base reforzada es importante?",
    answer:"Un pastel de 3-4 kg puede hundir una base simple. La base reforzada usa dos capas, duplicando la rigidez. Crítica para tartas con betún fluido, pasteles de varios pisos y gelatinas. Recomendada para pasteles mayores a 2 kg.",
  },
];

const mainImg = "/img/catalogo/cajas-pasteleria-tartas-cdmx.avif";
const gallery = [
  { src: "/img/catalogo/cajas-carton-pasteleria-pasteles-cdmx.avif", alt: "Caja pastelería — principal" },
  { src: "/img/catalogo/caja-pasteleria-hero-cdmx.avif", alt: "Caja pastelería — hero" },
  { src: "/img/catalogo/caja-pasteleria-stack-cdmx.avif", alt: "Cajas pastelería — apiladas" },
  { src: "/img/catalogo/caja-pasteleria-interior-cdmx.avif", alt: "Caja pastelería — interior" },
  { src: "/img/catalogo/caja-pasteleria-ventana-cdmx.avif", alt: "Caja pastelería — ventana PET" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"Alimentos", href:"/catalogo/cajas-para-alimentos"}, {name:"Pastelería y Tartas"}]}
  faqItems={[{question:"¿Cuándo necesito la ventana de acetato?", answer:"Cuando el pastel tiene decoración visual importante y se vende en punto de venta donde el cliente escoge visualmente, o cuando es regalo. Para pasteles por pedido anticipado la ventana no agrega valor y aumenta el costo."}, {question:"¿Por qué la base reforzada es importante?", answer:"Un pastel de 3-4 kg puede hundir una base simple. La base reforzada usa dos capas, duplicando la rigidez. Crítica para tartas con betún fluido, pasteles de varios pisos y gelatinas. Recomendada para pasteles mayores a 2 kg."}]}
  product={{name:"Caja Pastelería Tartas Base Reforzada", sku:"CAD-AL-03", description:"Caja Pastelería Tartas Base Reforzada en CDMX — fabricante directo CADECA", image:"/img/catalogo/cajas-pasteleria-tartas-cdmx.avif", material:"Cartón corrugado interior blanco base reforzada pasteles", category:"Cajas para Alimentos", moq:"100"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-para-alimentos">Alimentos</a></li>
        <li><span class="current">Pastelería y Tartas</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-al03-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-AL-03 · Cajas para Alimentos</span>
      <h1 id="sku-al03-title" class="cat-page-hero__title">Cajas Pastelería <span>Tartas Base Reforzada</span><br>— Ventana Acetato CDMX</h1>
      <p class="cat-page-hero__desc">Interior blanco coated con base reforzada 2 capas. Ventana acetato opcional (MOQ 200). Para pay, tarta, cupcakes y gelatinas hasta 4 kg. Desde 100 piezas.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AL-03</strong></div>
        <div class="cat-page-hero__strip-item">Interior: <strong>Blanco coated</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>100 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>3-5 días</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-al03-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-AL-03 · Familia: Cajas para Alimentos</p>
            <h2 id="detalle-al03-title" class="sku-detail__title">Caja Pastelería — Tartas Base Reforzada</h2>
            <p class="sku-detail__desc">Interior kraft blanco coated sin impresión. Base reforzada 2 capas para pasteles hasta 4 kg. Ventana acetato opcional desde 200 piezas. Cierre por lengüeta o cinta. Impresión exterior flexo 1-2 colores.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Blanco coated</span><span class="sku-detail__strip-label">Interior</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3-5 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AL-03 Caja Pastelería Tartas`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AL-03</a>
              <a href="/catalogo/cajas-para-alimentos" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-al03-title">
      <div class="container">
        <h2 id="sizes-al03-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-AL-03</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
                  <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
                  <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"✓":"⏱"} {m.label}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Fabricamos cualquier medida personalizada desde 100 piezas. ⏱ Producción bajo pedido.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-al03-title">
      <div class="container">
        <h2 id="faq-al03-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-AL-03</h2>
        <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
      </div>
    </section>
  </main>
  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-AL-03 — Cajas pastelería desde 100 piezas, entrega 3-5 días" />
</PageLayout>
