---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Láminas de Cartón a la Medida | CADECA";
const description = "Láminas de cartón corrugado a la medida con corte exacto en CDMX. Simple, doble o triple pared. Para fabricantes y talleres. MOQ 50 piezas.";

const specs = [
 ["Código SKU", "CAD-LA-06"],
 ["Corte", "Cizalla ±2mm precisión"],
 ["Pared", "Simple / Doble / Triple a elección"],
 ["Medidas", "Cualquier L×A personalizado"],
 ["Resistencia", "ECT-32/44/71 según pared"],
 ["Material", "Kraft virgen o reciclado"],
 ["Presentación", "Paquetes enzunchados en pallet"],
 ["Pedido mínimo", "50 láminas/medida"],
 ["Entrega CDMX", "Según pedido"],
];

const faqs = [
 {
 id: "cad-la-06-f1",
 question: "¿Cómo elijo la medida adecuada para láminas de cartón a la medida?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "cad-la-06-f2",
 question: "¿Qué resistencia de cartón conviene para láminas de cartón a la medida?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "cad-la-06-f3",
 question: "¿Se pueden personalizar láminas de cartón a la medida con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "cad-la-06-f4",
 question: "¿Cómo debo almacenar láminas de cartón a la medida antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "cad-la-06-f5",
 question: "¿Qué datos necesito para cotizar láminas de cartón a la medida?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/lamina-medida-hero-cdmx.avif", alt: "Láminas corrugado a la medida corte exacto CDMX" },
 { src: "/img/catalogo/lamina-medida-corte-cdmx.avif", alt: "Corte cizalla láminas corrugado" },
 { src: "/img/catalogo/lamina-medida-borde-cdmx.avif", alt: "Borde lámina cortada a medida" },
 { src: "/img/catalogo/lamina-medida-tallas-cdmx.avif", alt: "Tallas láminas a la medida" },
 { src: "/img/catalogo/laminas-carton-corrugado-doble-cdmx.avif", alt: "Láminas doble pared medida" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Láminas de Cartón Corrugado",href:"/catalogo/laminas-carton-corrugado/"},{name:"Láminas Corrugado a la Medida con Corte Exacto"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Láminas Corrugado a la Medida con Corte Exacto",sku:"CAD-LA-06",description:"Láminas corrugado cortadas a la dimensión exacta que necesitas: cualquier largo×ancho, simple/doble/triple pared. Para fabricantes de cajas, talleres y proyectos especiales.",image:gallery[0].src,material:"CAD-LA-06",category:"Láminas de Cartón Corrugado",moq:"50 láminas/medida"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/laminas-carton-corrugado/">Láminas de Cartón Corrugado</a></li>
 <li><span class="current">Láminas Corrugado a la Medida con Corte Exacto</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadla06-title"
   eyebrow="Láminas · SKU CAD-LA-06"
   titleHtml={true}
   title="Láminas de cartón a la medida <span>con corte</span>"
   desc="Láminas de cartón a la medida para talleres, fabricantes de cajas y proyectos que requieren largo y ancho específicos. Se cotizan en CDMX y Estado de México."
   desc2="Las láminas se cortan al largo y ancho solicitados, en cartón corrugado de pared simple, doble o triple. El <strong>corte exacto</strong> permite preparar material para empaques, separadores, protección o procesos de transformación donde el formato estándar no funciona.||Para láminas a corte, el largo, ancho y tipo de pared dependen de si funcionarán como separador, protección o empaque. Envía medida terminada, espesor o pared deseada, aplicación y piezas por pedido; CADECA revisa el <strong>corte exacto</strong> requerido."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadla06-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-LA-06 · Familia: Láminas de Cartón Corrugado</p>
 <h2 id="detalle-cadla06-title" class="sku-detail__title">Láminas Corrugado a la Medida con Corte Exacto</h2>
 <p class="sku-detail__desc">Cuando las medidas estándar no son suficientes, CADECA corta láminas a la dimensión exacta que tu proceso requiere. Cualquier largo y ancho, en simple, doble o triple pared. Ideal para fabricantes de cajas que compran planos para sus líneas de troquelado, talleres de empaque que hacen formatos especiales y proyectos de ingeniería de empaque. Corte por cizalla de alta precisión con tolerancia de ±2mm. Desde 50 láminas por medida.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">±2mm</span><span class="sku-detail__strip-label">Precisión</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 lám.</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Triple op.</span><span class="sku-detail__strip-label">Pared</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-LA-06 Láminas Corrugado a la Medida con Corte Exacto`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-LA-06</a>
 <a href="/catalogo/laminas-carton-corrugado/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="láminas de cartón a la medida" />
</PageLayout>
