---
import PageLayout    from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture   from "@/components/LeadCapture.astro";

const title       = "Catálogo Láminas Cartón Corrugado CDMX | Simple, Doble, Triple, Separadores | CADECA";
const description = "Catálogo láminas cartón corrugado CDMX. Simple flauta C, doble BC, triple BCB, separadores y ecológicas FSC. Desde 25 pzas. CADECA fabricante.";
const WHATSAPP    = "5255XXXXXXXX";

const productos = [
  {
    code:       "CAD-LC-01",
    badge:      "Más económico",
    badgeColor: "orange",
    featured:   true,
    title:      "Láminas Simples Flauta C",
    desc:       "Láminas corrugado simple flauta C ECT-26/32. Hasta 120×240 cm, corte a medida. La opción más económica para protección, relleno y layer pads. Desde 100 pzas.",
    imgSrc:     "/img/catalogo/laminas-carton-corrugado-simple-cdmx.avif",
    imgAlt:     "Láminas cartón corrugado simple flauta C CDMX — CADECA CAD-LC-01",
    href:       "/catalogo/laminas-carton-corrugado/laminas-simples",
    specs: [
      { label: "Flauta",    value: "C — 4 mm" },
      { label: "ECT",       value: "ECT-26/32" },
      { label: "MOQ",       value: "100 piezas" },
      { label: "Entrega",   value: "3-5 días" },
    ],
    moq: "100 pzas",
  },
  {
    code:       "CAD-LC-02",
    badge:      "ECT-44",
    badgeColor: "blue",
    featured:   false,
    title:      "Láminas Dobles BC",
    desc:       "Láminas doble corrugado BC ECT-44. Bases tarima, tapas y divisores. BCT >250 kg/m². Hasta 120×240 cm. Desde 50 pzas.",
    imgSrc:     "/img/catalogo/laminas-carton-corrugado-doble-cdmx.avif",
    imgAlt:     "Láminas cartón corrugado doble BC CDMX — CADECA CAD-LC-02",
    href:       "/catalogo/laminas-carton-corrugado/laminas-dobles",
    specs: [
      { label: "Flauta",    value: "BC — 7 mm" },
      { label: "ECT",       value: "ECT-44" },
      { label: "MOQ",       value: "50 piezas" },
      { label: "Entrega",   value: "3-5 días" },
    ],
    moq: "50 pzas",
  },
  {
    code:       "CAD-LC-03",
    badge:      "Sustituto madera",
    badgeColor: "blue",
    featured:   false,
    title:      "Láminas Triples BCB",
    desc:       "Láminas triple corrugado BCB ECT-61+. Sustituto de madera sin NIMF 15. BCT >500 kg/m². Ideal exportación industrial. Desde 25 pzas.",
    imgSrc:     "/img/catalogo/laminas-carton-corrugado-triple-cdmx.avif",
    imgAlt:     "Láminas cartón corrugado triple BCB CDMX — CADECA CAD-LC-03",
    href:       "/catalogo/laminas-carton-corrugado/laminas-triples",
    specs: [
      { label: "Flauta",    value: "BCB — 12 mm" },
      { label: "ECT",       value: "ECT-61+" },
      { label: "MOQ",       value: "25 piezas" },
      { label: "Entrega",   value: "5-7 días" },
    ],
    moq: "25 pzas",
  },
  {
    code:       "CAD-LC-04",
    badge:      "Menor costo",
    badgeColor: "green",
    featured:   false,
    title:      "Separadores y Divisiones",
    desc:       "Separadores ranurados a la medida. Flauta B o E, ensamblaje sin pegamento. Diseño CAD gratis en 24 hrs. El precio más bajo por unidad. Desde 200 pzas.",
    imgSrc:     "/img/catalogo/separadores-carton-corrugado-cdmx.avif",
    imgAlt:     "Separadores cartón corrugado divisiones CDMX — CADECA CAD-LC-04",
    href:       "/catalogo/laminas-carton-corrugado/separadores",
    specs: [
      { label: "Flauta",    value: "B 3 mm o E 1.5 mm" },
      { label: "Diseño",    value: "CAD gratis 24 hrs" },
      { label: "MOQ",       value: "200 piezas" },
      { label: "Entrega",   value: "3-5 días" },
    ],
    moq: "200 pzas",
  },
  {
    code:       "CAD-LC-05",
    badge:      "FSC",
    badgeColor: "green",
    featured:   false,
    title:      "Láminas Ecológicas FSC",
    desc:       "Láminas cartón reciclado certificado FSC. Mismas specs que virgen, ECT-32/44. Fibra 100% post-consumo. Para marcas sustentables. Desde 50 pzas.",
    imgSrc:     "/img/catalogo/laminas-carton-reciclado-ecologico-cdmx.avif",
    imgAlt:     "Láminas cartón reciclado ecológico FSC CDMX — CADECA CAD-LC-05",
    href:       "/catalogo/laminas-carton-corrugado/laminas-ecologicas",
    specs: [
      { label: "Certificación", value: "FSC Recycled" },
      { label: "ECT",           value: "ECT-32/44" },
      { label: "MOQ",           value: "50 piezas" },
      { label: "Entrega",       value: "3-5 días" },
    ],
    moq: "50 pzas",
  },
];
---

<PageLayout title={title} description={description} whatsapp={WHATSAPP}
  pageType="category"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Láminas Cartón Corrugado"}]}>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><span class="current">Láminas Cartón Corrugado</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="cat-lc-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">📦 Categoría 06 · 5 productos</span>
      <h1 id="cat-lc-title" class="cat-page-hero__title">
        Láminas <span>Cartón Corrugado</span>
      </h1>
      <p class="cat-page-hero__desc">
        Láminas simples, dobles, triples, separadores y ecológicas FSC. Desde corte a medida hasta sustituto de madera para exportación. Fabricante directo en CDMX.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">Productos: <strong>5</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>25 piezas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega CDMX: <strong>3-5 días</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>26 a 61+</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" aria-labelledby="prods-lc-title">
      <div class="container">
        <SectionHeader
          id="prods-lc-title"
          twoCol
          title="5 Productos — Láminas Cartón Corrugado"
          subtitle="Selecciona el tipo de lámina para ver la ficha técnica completa con medidas, resistencia y condiciones de pedido."
          link={{ text: "← Volver al catálogo", href: "/catalogo" }}
        >
          <p>Desde láminas simples para protección hasta triple corrugado sustituto de madera. Cada ficha incluye ECT, BCT, medidas estándar y corte personalizado.</p>
        </SectionHeader>
        <div class="sku-grid">
          {productos.map(p => (
            <article class={`sku-card${p.featured ? " sku-card--featured" : ""}`}>
              <div class="sku-card__img-wrap">
                <img src={p.imgSrc} alt={p.imgAlt}
                  class="sku-card__img" width="640" height="480"
                  loading="lazy" decoding="async" />
                <span class="sku-card__code">{p.code}</span>
                <span class={`sku-card__badge sku-card__badge--${p.badgeColor}`}>{p.badge}</span>
              </div>
              <div class="sku-card__body">
                <h2 class="sku-card__name">{p.title}</h2>
                <p class="sku-card__desc">{p.desc}</p>
                <div class="sku-card__specs">
                  {p.specs.map(s => (
                    <div>
                      <span class="sku-card__spec-label">{s.label}</span>
                      <span class="sku-card__spec-value">{s.value}</span>
                    </div>
                  ))}
                </div>
                <div class="sku-card__footer">
                  <a href={p.href} class="btn btn--primary">Ver ficha técnica</a>
                  <span class="sku-card__moq">MOQ: {p.moq}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>


  <!-- Del Blog CADECA -->
  <section class="cat-blog-links">
    <div class="container">
      <h2 class="cat-blog-links__title">📚 Del Blog CADECA</h2>
      <p class="cat-blog-links__subtitle">Guías y consejos de expertos para tu decisión de compra</p>
      <div class="cat-blog-links__grid">
        <a href="/blog/carton-reciclado-vs-virgen-analisis-completo" class="cat-blog-links__item">
          <span class="cat-blog-links__arrow">→</span>
          <span>Reciclado vs virgen: análisis completo</span>
        </a>
        <a href="/blog/glosario-terminos-carton-corrugado-mexico" class="cat-blog-links__item">
          <span class="cat-blog-links__arrow">→</span>
          <span>Glosario técnico del corrugado</span>
        </a>
        <a href="/blog/economia-circular-carton-empresa-mexico" class="cat-blog-links__item">
          <span class="cat-blog-links__arrow">→</span>
          <span>Economía circular con cartón</span>
        </a>
      </div>
      <a href="/blog" class="cat-blog-links__more">Ver todos los artículos →</a>
    </div>
  </section>

  <LeadCapture whatsapp={WHATSAPP} title="¿Qué tipo de lámina necesitas? Te asesoramos gratis en menos de 1 hora" />
</PageLayout>
