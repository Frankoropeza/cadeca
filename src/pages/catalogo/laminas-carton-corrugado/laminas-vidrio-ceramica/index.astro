---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Láminas de Cartón para Vidrio y Cerámica | CADECA";
const description = "Láminas de cartón corrugado para vidrio, cerámica y artículos frágiles en CDMX. Doble pared amortiguante, celdas de separación. MOQ 50 pzas.";

const specs = [
 ["Código SKU", "CAD-LA-09"],
 ["Pared", "Doble corrugado BC (7mm)"],
 ["Resistencia", "ECT-44"],
 ["Amortiguación", "Alta absorción de impacto"],
 ["Separadores", "Celda hexagonal opcional"],
 ["Material", "Kraft virgen"],
 ["Uso", "Vidrio / cerámica / frágiles"],
 ["Pedido mínimo", "50 láminas"],
 ["Entrega CDMX", "Según pedido"],
];

const faqs = [
 {
 id: "cad-la-09-f1",
 question: "¿Cómo elijo la medida adecuada para láminas de cartón para vidrio y cerámica?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "cad-la-09-f2",
 question: "¿Qué resistencia de cartón conviene para láminas de cartón para vidrio y cerámica?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "cad-la-09-f3",
 question: "¿Se pueden personalizar láminas de cartón para vidrio y cerámica con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "cad-la-09-f4",
 question: "¿Cómo debo almacenar láminas de cartón para vidrio y cerámica antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "cad-la-09-f5",
 question: "¿Qué datos necesito para cotizar láminas de cartón para vidrio y cerámica?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/lamina-doble-hero-cdmx.avif", alt: "Láminas corrugado vidrio cerámica CDMX" },
 { src: "/img/catalogo/lamina-doble-capas-cdmx.avif", alt: "Capas doble corrugado frágiles" },
 { src: "/img/catalogo/lamina-doble-bodega-cdmx.avif", alt: "Bodega láminas vidrio" },
 { src: "/img/catalogo/lamina-doble-perfil-cdmx.avif", alt: "Perfil doble pared amortiguante" },
 { src: "/img/catalogo/separadores-carton-corrugado-cdmx.avif", alt: "Separadores cartón cerámica" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Láminas de Cartón Corrugado",href:"/catalogo/laminas-carton-corrugado/"},{name:"Láminas Corrugado para Vidrio y Cerámica"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Láminas Corrugado para Vidrio y Cerámica",sku:"CAD-LA-09",description:"Láminas doble pared amortiguante para vidrio, cerámica y artículos frágiles. Con opción de celdas de separación hexagonal para mayor protección. Desde 50 piezas en CDMX.",image:gallery[0].src,material:"CAD-LA-09",category:"Láminas de Cartón Corrugado",moq:"50 láminas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/laminas-carton-corrugado/">Láminas de Cartón Corrugado</a></li>
 <li><span class="current">Láminas Corrugado para Vidrio y Cerámica</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadla09-title"
   eyebrow="Láminas · SKU CAD-LA-09"
   titleHtml={true}
   title="Láminas de cartón para vidrio <span>y cerámica</span>"
   desc="Láminas de cartón para vidrio y cerámica que ayudan a separar piezas frágiles durante empaque y transporte. Se cotizan para talleres, tiendas y operaciones en CDMX."
   desc2="Las láminas son de doble pared amortiguante para vidrio, cerámica y otros artículos frágiles. Pueden complementarse con celdas de separación hexagonal para mantener las piezas separadas y reducir el contacto entre ellas durante empaque, traslado y almacenamiento.||Para vidrio y cerámica, el tamaño de cada pieza, su peso y la separación requerida definen la lámina y las celdas. Envía dimensiones de la pieza, número por caja, peso y distribución deseada; CADECA revisa la <strong>protección de frágiles</strong>."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadla09-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-LA-09 · Familia: Láminas de Cartón Corrugado</p>
 <h2 id="detalle-cadla09-title" class="sku-detail__title">Láminas Corrugado para Vidrio y Cerámica</h2>
 <p class="sku-detail__desc">El vidrio y la cerámica son materiales frágiles que requieren amortiguación y separación para sobrevivir el transporte. CAD-LA-09 usa doble pared BC con alta capacidad de absorción de impactos, disponible en medidas estándar para la industria del vidrio en CDMX: vidrio flotado, espejos y cerámica decorativa. También ofrecemos separadores en celda hexagonal (honeycomb) como complemento para artículos de alto valor.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Doble pared</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Honeycomb</span><span class="sku-detail__strip-label">Separador op.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 lám.</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Stock CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-LA-09 Láminas Corrugado para Vidrio y Cerámica`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-LA-09</a>
 <a href="/catalogo/laminas-carton-corrugado/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="láminas de cartón para vidrio y cerámica" />
</PageLayout>
