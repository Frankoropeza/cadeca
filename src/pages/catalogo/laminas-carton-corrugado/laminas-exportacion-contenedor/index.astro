---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Láminas de Cartón para Exportación | CADECA";
const description = "Láminas de cartón corrugado para exportación y contenedores en CDMX. Triple pared ECT-71, dimensiones 20 y 40 pies. Protección para carga internacional.";

const specs = [
 ["Código SKU", "CAD-LA-07"],
 ["Resistencia", "ECT-71 triple pared"],
 ["Flauta", "BCB triple pared"],
 ["Dimensiones", "Para contenedor 20' y 40'"],
 ["Certificación", "ISTA-1A disponible"],
 ["Humedad", "Recubrimiento antihumedad opcional"],
 ["Presentación", "Palé enzunchado"],
 ["Pedido mínimo", "100 láminas"],
 ["Entrega CDMX", "Según pedido / embarque"],
];

const faqs = [
 {
 id: "cad-la-07-f1",
 question: "¿Cómo elijo la medida adecuada para láminas de cartón para exportación?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "cad-la-07-f2",
 question: "¿Qué resistencia de cartón conviene para láminas de cartón para exportación?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "cad-la-07-f3",
 question: "¿Se pueden personalizar láminas de cartón para exportación con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "cad-la-07-f4",
 question: "¿Cómo debo almacenar láminas de cartón para exportación antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "cad-la-07-f5",
 question: "¿Qué datos necesito para cotizar láminas de cartón para exportación?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/lamina-export-hero-cdmx.avif", alt: "Láminas corrugado exportación contenedor CDMX" },
 { src: "/img/catalogo/lamina-export-container-cdmx.avif", alt: "Láminas en contenedor exportación" },
 { src: "/img/catalogo/lamina-export-flete-cdmx.avif", alt: "Flete exportación corrugado" },
 { src: "/img/catalogo/lamina-export-proteccion-cdmx.avif", alt: "Protección carga exportación" },
 { src: "/img/catalogo/lamina-triple-pallet-cdmx.avif", alt: "Láminas triple pared pallet" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Láminas de Cartón Corrugado",href:"/catalogo/laminas-carton-corrugado/"},{name:"Láminas Corrugado para Exportación y Contenedor"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Láminas Corrugado para Exportación y Contenedor",sku:"CAD-LA-07",description:"Láminas triple pared para protección de carga en contenedores 20' y 40'. Dimensiones optimizadas para el interior de contenedor, ECT-71, aptas para carga marítima y aérea.",image:gallery[0].src,material:"CAD-LA-07",category:"Láminas de Cartón Corrugado",moq:"100 láminas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/laminas-carton-corrugado/">Láminas de Cartón Corrugado</a></li>
 <li><span class="current">Láminas Corrugado para Exportación y Contenedor</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadla07-title"
   eyebrow="Láminas · SKU CAD-LA-07"
   titleHtml={true}
   title="Láminas de cartón para exportación <span>en contenedor</span>"
   desc="Láminas de cartón para exportación que protegen carga dentro de contenedores de 20 y 40 pies. Se usan en embarques que requieren separación y protección de mercancía."
   desc2="Estas láminas se especifican en triple pared BCB con ECT-71 y dimensiones para el interior de contenedores de 20 y 40 pies. Funcionan como <strong>protección en contenedor</strong> para carga marítima o aérea, creando separación entre mercancía y las paredes del equipo.||CADECA coordina el surtido como proveedor de láminas para exportación. Indica medidas, cantidad, tipo de carga y zona de entrega al cotizar; te asesoramos para definir el formato, la pared y las necesidades de protección del embarque."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadla07-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-LA-07 · Familia: Láminas de Cartón Corrugado</p>
 <h2 id="detalle-cadla07-title" class="sku-detail__title">Láminas Corrugado para Exportación y Contenedor</h2>
 <p class="sku-detail__desc">La exportación de mercancías en contenedor requiere láminas de corrugado que cubran las paredes del contenedor, protejan la carga de los golpes y la humedad del océano, y que al mismo tiempo no sumen demasiado peso al embarque. CAD-LA-07 usa triple pared ECT-71 en dimensiones calculadas para el interior de contenedores estándar de 20' y 40'. Certificación ISTA disponible para cargamentos con requerimientos de aseguramiento de calidad exportación.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-71</span><span class="sku-detail__strip-label">Triple pared</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Cont. 20'/40'</span><span class="sku-detail__strip-label">Dimensiones</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ISTA</span><span class="sku-detail__strip-label">Certificación</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 lám.</span><span class="sku-detail__strip-label">MOQ</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-LA-07 Láminas Corrugado para Exportación y Contenedor`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-LA-07</a>
 <a href="/catalogo/laminas-carton-corrugado/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="láminas de cartón para exportación" />
</PageLayout>
