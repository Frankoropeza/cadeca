---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Láminas de Cartón Reciclado | CADECA";
const description = "Láminas cartón corrugado reciclado en CDMX. Mismas specs técnicas que virgen. ECT-32/44, desde 50 piezas, tiempo de entrega según pedido.";

const medidas = [
 { talla:"60×40 cm",  flauta:"Simple C",ect:"ECT-32",peso:"0.09 kg/ud",disp:"green",  label:"Stock",  hl:false },
 { talla:"80×60 cm",  flauta:"Simple C",ect:"ECT-32",peso:"0.16 kg/ud",disp:"green",  label:"Stock",  hl:false },
 { talla:"100×80 cm",  flauta:"Simple C",ect:"ECT-32",peso:"0.26 kg/ud",disp:"yellow", label:"3-5 días",hl:true  },
 { talla:"120×100 cm",  flauta:"Simple C",ect:"ECT-32",peso:"0.39 kg/ud",disp:"yellow", label:"3-5 días",hl:true  },
 { talla:"120×240 cm",  flauta:"Doble BC", ect:"ECT-44",peso:"0.94 kg/ud",disp:"yellow", label:"3-5 días",hl:false },
 { talla:"Medida personalizada",flauta:"A elegir",ect:"A elegir",peso:"—",  disp:"gray",  label:"Consultar",hl:false},
];

const specs = [
 ["Código SKU",  "CAD-LC-05"],
 ["Certificación",  "FSC: confirmar disponibilidad al cotizar"],
 ["Material",  "Fibra reciclada 100% post-consumo certificada"],
 ["ECT disponible",  "ECT-32 (simple) o ECT-44 (doble)"],
 ["Diferencia vs virgen","Mismas especificaciones técnicas"],
 ["Color liner",  "Kraft gris-marrón — diferente a kraft virgen marrón oscuro"],
 ["Certificado",  "Se confirma disponibilidad de FSC con el fabricante"],
 ["Flauta",  "C simple (4mm) o BC doble (7mm)"],
 ["Medida máxima",  "120 × 240 cm (simple) · 120 × 200 cm (doble)"],
 ["Corte a medida",  "Sí — tolerancia ±2mm"],
 ["Costo",  "Similar o menor al virgen en el mismo ECT"],
 ["Pedido mínimo",  "50 piezas"],
 ["Tiempo de entrega",  "Según pedido"],
];

const faqs = [
 {
 id: "lc05-f1",
 question: "¿Cómo elijo la medida adecuada para láminas de cartón corrugado reciclable?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "lc05-f2",
 question: "¿Qué resistencia de cartón conviene para láminas de cartón corrugado reciclable?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "lc05-f3",
 question: "¿Se pueden personalizar láminas de cartón corrugado reciclable con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "lc05-f4",
 question: "¿Cómo debo almacenar láminas de cartón corrugado reciclable antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "lc05-f5",
 question: "¿Qué datos necesito para cotizar láminas de cartón corrugado reciclable?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const mainImg = "/img/catalogo/laminas-carton-reciclado-ecologico-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/laminas-carton-reciclado-ecologico-cdmx.avif", alt: "Láminas ecológicas — principal" },
 { src: "/img/catalogo/lamina-medida-hero-cdmx.avif", alt: "Lámina medida — hero" },
 { src: "/img/catalogo/lamina-medida-corte-cdmx.avif", alt: "Corte a medida" },
 { src: "/img/catalogo/lamina-medida-tallas-cdmx.avif", alt: "Tallas disponibles" },
 { src: "/img/catalogo/lamina-medida-borde-cdmx.avif", alt: "Borde de corte limpio" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[
 {name:"Inicio", href:"/"},
 {name:"Catálogo", href:"/catalogo/"},
 {name:"Láminas Cartón", href:"/catalogo/laminas-carton-corrugado/"},
 {name:"Láminas Ecológicas FSC"}
 ]}
 faqItems={faqs}
 product={{
 name:"Láminas Cartón Corrugado Reciclado",
 sku:"CAD-LC-05",
 description:"Láminas cartón corrugado reciclado CDMX — mismas specs técnicas que virgen; FSC por confirmar",
 image:"/img/catalogo/laminas-carton-reciclado-ecologico-cdmx.avif",
 material:"Láminas cartón corrugado fibra reciclada ECT-32/44; FSC por confirmar",
 category:"Láminas de Cartón Corrugado",
 moq:"50"
 }}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/laminas-carton-corrugado/">Láminas Cartón</a></li>
 <li><span class="current">Láminas Ecológicas FSC</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-lc05-title"
   eyebrow="Láminas · SKU CAD-LC-05"
   titleHtml={true}
   title="Láminas de cartón reciclado <span>para protección</span>"
   desc="Láminas de cartón reciclado para proteger, separar y reforzar productos en empaque o traslado. Están disponibles con distintas resistencias para proyectos en CDMX y Estado de México."
   desc2="Estas láminas emplean fibra reciclada y se especifican con ECT-32 o ECT-44 según el uso. Las <strong>láminas ecológicas</strong> mantienen opciones de resistencia comparables al kraft virgen y se pueden solicitar en distintos formatos para empaque, separación o protección de mercancía.||Para láminas recicladas, el uso como separación, relleno o protección define entre ECT-32 y ECT-44. Envía largo y ancho requeridos, espesor o resistencia, aplicación y número de piezas; CADECA revisa el formato de cartón reciclado."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-lc05-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-LC-05 · Familia: Láminas de Cartón Corrugado</p>
 <h2 id="detalle-lc05-title" class="sku-detail__title">Láminas Cartón Corrugado Reciclado FSC</h2>
 <p class="sku-detail__desc">Láminas de fibra reciclada 100% post-consumo. Ofrecen las mismas especificaciones técnicas que el kraft virgen en ECT-32 y ECT-44. Si tu proyecto requiere cartón con certificación FSC, lo indicamos al cotizar y confirmamos disponibilidad con el fabricante.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">FSC</span><span class="sku-detail__strip-label">Por confirmar</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100%</span><span class="sku-detail__strip-label">Fibra reciclada</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3-5 días</span><span class="sku-detail__strip-label">Producción</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-LC-05 Láminas Recicladas FSC`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-LC-05</a>
 <a href="/catalogo/laminas-carton-corrugado/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-lc05-title">
 <div class="container">
 <h2 id="sizes-lc05-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-LC-05</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Medida (cm)</th><th>Flauta</th><th>ECT</th><th>Peso/unidad</th><th>Disponibilidad</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td><strong>{m.talla}</strong></td><td>{m.flauta}</td><td>{m.ect}</td><td>{m.peso}</td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"":m.disp==="yellow"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem"> Disponibilidad según pedido ·  Producción 3-5 días · Consultar</p>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="láminas de cartón reciclado" />
</PageLayout>
