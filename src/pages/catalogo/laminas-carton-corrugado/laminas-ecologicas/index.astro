---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem     from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";

const title       = "Láminas Cartón Reciclado FSC CDMX | ECT-32/44 Sustentable | CAD-LC-05 | CADECA";
const description = "Láminas cartón reciclado certificado FSC CDMX. Mismas specs que virgen, ECT-32/44, desde 50 pzas, 3-5 días. Para marcas sustentables. CADECA fabricante.";
const WHATSAPP    = "5255XXXXXXXX";

const medidas = [
  { talla:"60×40 cm", ml:"60×40 cm", real:"60×40", flauta:"C",ect:"ECT-32",vacío:"0.09 kg/ud",máx:"—", disp:"green", label:"Stock", hl:false },
  { talla:"80×60 cm", ml:"80×60 cm", real:"80×60", flauta:"C",ect:"ECT-32",vacío:"0.16 kg/ud",máx:"—", disp:"green", label:"Stock", hl:false },
  { talla:"100×80 cm", ml:"100×80 cm", real:"100×80", flauta:"C",ect:"ECT-32",vacío:"0.26 kg/ud",máx:"—", disp:"yellow", label:"3-5 días", hl:true },
  { talla:"120×100 cm", ml:"120×100 cm", real:"120×100", flauta:"C",ect:"ECT-32",vacío:"0.39 kg/ud",máx:"—", disp:"yellow", label:"3-5 días", hl:true },
  { talla:"120×240 cm", ml:"120×240 cm", real:"120×240", flauta:"BC",ect:"ECT-44",vacío:"0.94 kg/ud",máx:"—", disp:"yellow", label:"3-5 días", hl:false },
  { talla:"Personalizada", ml:"A definir", real:"A definir", flauta:"C/BC",ect:"ECT-32/44",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
  ["Código SKU", "CAD-LC-05"],
  ["Certificación", "FSC — Forest Stewardship Council"],
  ["Material", "Fibra reciclada 100% post-consumo"],
  ["ECT", "ECT-32 o ECT-44"],
  ["Diferencia vs virgen", "Mismas specs técnicas"],
  ["Color liner", "Kraft gris-marrón"],
  ["Certificado", "FSC Chain of Custody disponible"],
  ["Flauta", "C simple o BC doble"],
  ["Costo", "Similar o menor al virgen"],
  ["MOQ", "50 pzas"],
  ["Entrega", "3-5 días hábiles"],
];

const faqs = [
  {
    id:"lc05-f1",
    question:"¿Qué certifica exactamente la etiqueta FSC?",
    answer:"Certifica la cadena de custodia: que la fibra reciclada fue recolectada, procesada y transformada bajo estándares de trazabilidad verificados, sin mezcla con materiales prohibidos como madera de tala ilegal. El certificado FSC Recycled permite usar el logo FSC en el packaging con la licencia correspondiente, fundamental para reportes ESG.",
  },
  {
    id:"lc05-f2",
    question:"¿El reciclado FSC tiene menor resistencia que el virgen?",
    answer:"La diferencia es mínima: 5-8% menos en BCT a igual ECT. Los procesos modernos de papel reciclado hacen que ECT-44 reciclado y virgen sean prácticamente idénticos. Diferencia visual: liner reciclado tiene tono gris-marrón vs marrón oscuro del virgen. Para uso industrial donde el color no importa, reciclado FSC es equivalente al virgen a igual o menor costo.",
  },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"Láminas Cartón", href:"/catalogo/laminas-carton-corrugado"}, {name:"Láminas Ecológicas FSC"}]}
  faqItems={[{question:"¿Qué certifica exactamente la etiqueta FSC?", answer:"Certifica la cadena de custodia: que la fibra reciclada fue recolectada, procesada y transformada bajo estándares de trazabilidad verificados, sin mezcla con materiales prohibidos como madera de tala ilegal. El certificado FSC Recycled permite usar el logo FSC en el packaging con la licencia correspondiente, fundamental para reportes ESG."}, {question:"¿El reciclado FSC tiene menor resistencia que el virgen?", answer:"La diferencia es mínima: 5-8% menos en BCT a igual ECT. Los procesos modernos de papel reciclado hacen que ECT-44 reciclado y virgen sean prácticamente idénticos. Diferencia visual: liner reciclado tiene tono gris-marrón vs marrón oscuro del virgen. Para uso industrial donde el color no importa, reciclado FSC es equivalente al virgen a igual o menor costo."}]}
  product={{name:"Láminas Cartón Corrugado Reciclado FSC", sku:"CAD-LC-05", description:"Láminas Cartón Corrugado Reciclado FSC en CDMX — fabricante directo CADECA", image:"/img/catalogo/laminas-carton-reciclado-ecologico-cdmx.avif", material:"Láminas cartón corrugado fibra reciclada certificada FSC ECT-32/44", category:"Láminas de Cartón Corrugado", moq:"50"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/laminas-carton-corrugado">Láminas Cartón</a></li>
        <li><span class="current">Láminas Ecológicas FSC</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-lc05-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-LC-05 · Láminas de Cartón Corrugado</span>
      <h1 id="sku-lc05-title" class="cat-page-hero__title">Láminas Cartón Reciclado <span>FSC Certificado</span><br>— ECT-32/44 Sustentable CDMX</h1>
      <p class="cat-page-hero__desc">Fibra 100% reciclada post-consumo con certificación FSC Chain of Custody. Mismas especificaciones técnicas que virgen. ECT-32 simple o ECT-44 doble. Costo similar o menor. Desde 50 piezas.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-LC-05</strong></div>
        <div class="cat-page-hero__strip-item">Certificación: <strong>FSC Recycled</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>50 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>3-5 días</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-lc05-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div>
            <div class="sku-detail__img-wrap">
              <img src="/img/catalogo/laminas-carton-reciclado-ecologico-cdmx.avif"
                alt="Láminas cartón reciclado ecológico FSC CDMX — CADECA CAD-LC-05"
                class="sku-detail__img" width="880" height="560" loading="eager" decoding="async" fetchpriority="high" />
            </div>
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-LC-05 · Familia: Láminas de Cartón Corrugado</p>
            <h2 id="detalle-lc05-title" class="sku-detail__title">Láminas Reciclado FSC — ECT-32/44 Sustentable</h2>
            <p class="sku-detail__desc">Fibra reciclada 100% post-consumo certificada FSC. ECT-32 (simple C) o ECT-44 (doble BC) con especificaciones idénticas al virgen. Liner kraft gris-marrón. Certificado FSC Chain of Custody disponible para reportes ESG y uso del logo FSC.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">FSC</span><span class="sku-detail__strip-label">Certificación</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32/44</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3-5 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-LC-05 Láminas Reciclado FSC`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-LC-05</a>
              <a href="/catalogo/laminas-carton-corrugado" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-lc05-title">
      <div class="container">
        <h2 id="sizes-lc05-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-LC-05</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Medida</th><th>Dimensión (cm)</th><th>Medida real</th><th>Flauta</th><th>ECT</th><th>Peso/ud</th><th></th><th>Disponibilidad</th></tr></thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
                  <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td></td>
                  <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"✓":"⏱"} {m.label}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Corte a medida desde 50 piezas. ⏱ Producción bajo pedido.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-lc05-title">
      <div class="container">
        <h2 id="faq-lc05-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-LC-05</h2>
        <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
      </div>
    </section>
  </main>
  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-LC-05 — Láminas recicladas FSC desde 50 piezas, entrega 3-5 días" />
</PageLayout>
