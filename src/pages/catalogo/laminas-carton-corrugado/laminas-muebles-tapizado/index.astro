---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Láminas de Cartón para Muebles y Tapicería | CADECA";
const description = "Láminas de cartón corrugado para mueblería y tapizado en CDMX. Simple pared flexible, corte limpio, para carpinterías y tapicerías. MOQ 50 pzas.";

const specs = [
 ["Código SKU", "CAD-LA-08"],
 ["Pared", "Simple flauta B (3mm) o C (4mm)"],
 ["Flexibilidad", "Alta — apta para curvas"],
 ["Corte", "Limpio con cutter / sierra"],
 ["Acabados", "No raya superficies"],
 ["Uso", "Protección transporte muebles"],
 ["Material", "Kraft virgen / reciclado"],
 ["Pedido mínimo", "50 láminas"],
 ["Entrega CDMX", "Según pedido"],
];

const faqs = [
 {
 id: "cad-la-08-f1",
 question: "¿Cómo elijo la medida adecuada para láminas de cartón para muebles y tapizado?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "cad-la-08-f2",
 question: "¿Qué resistencia de cartón conviene para láminas de cartón para muebles y tapizado?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "cad-la-08-f3",
 question: "¿Se pueden personalizar láminas de cartón para muebles y tapizado con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "cad-la-08-f4",
 question: "¿Cómo debo almacenar láminas de cartón para muebles y tapizado antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "cad-la-08-f5",
 question: "¿Qué datos necesito para cotizar láminas de cartón para muebles y tapizado?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/lamina-simple-hero-cdmx.avif", alt: "Láminas corrugado muebles tapizado CDMX" },
 { src: "/img/catalogo/lamina-simple-corte-cdmx.avif", alt: "Corte lámina simple pared" },
 { src: "/img/catalogo/lamina-simple-pallet-cdmx.avif", alt: "Pallet láminas simple pared" },
 { src: "/img/catalogo/lamina-simple-topview-cdmx.avif", alt: "Vista superior láminas" },
 { src: "/img/catalogo/laminas-carton-corrugado-simple-cdmx.avif", alt: "Láminas corrugado simple pared" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Láminas de Cartón Corrugado",href:"/catalogo/laminas-carton-corrugado/"},{name:"Láminas Corrugado para Muebles y Tapizado"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Láminas Corrugado para Muebles y Tapizado",sku:"CAD-LA-08",description:"Láminas corrugado simple pared para mueblería, tapicería y carpintería en CDMX. Flexible, de corte limpio, protege acabados durante transporte y almacenaje.",image:gallery[0].src,material:"CAD-LA-08",category:"Láminas de Cartón Corrugado",moq:"50 láminas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/laminas-carton-corrugado/">Láminas de Cartón Corrugado</a></li>
 <li><span class="current">Láminas Corrugado para Muebles y Tapizado</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadla08-title"
   eyebrow="Láminas · SKU CAD-LA-08"
   titleHtml={true}
   title="Cartón para proteger muebles <span>y tapizado</span>"
   desc="Cartón para proteger muebles, tapizado y acabados de carpintería durante traslado o almacenaje. Es una opción de pared simple para talleres y mueblerías en CDMX."
   desc2="Las láminas son de cartón corrugado de pared simple, flexible y de corte limpio. Se usan como <strong>láminas para tapicería</strong> y para cubrir superficies de muebles o piezas de carpintería, evitando el contacto directo con otros objetos durante manejo y resguardo.||CADECA coordina el surtido como proveedor de cartón para proteger muebles. Indica medidas, cantidad, uso y zona de entrega al cotizar; te asesoramos para elegir el formato y la configuración de lámina adecuados para cada pedido."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadla08-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-LA-08 · Familia: Láminas de Cartón Corrugado</p>
 <h2 id="detalle-cadla08-title" class="sku-detail__title">Láminas Corrugado para Muebles y Tapizado</h2>
 <p class="sku-detail__desc">La industria del mueble y el tapizado necesita láminas de corrugado que sean lo suficientemente flexibles para envolver curvas, de fácil corte con cutter o sierra circular, y que no rayen los acabados de madera o tela. CAD-LA-08 usa simple pared flauta B o C que equilibra flexibilidad y amortiguación. Ampliamente usada por carpinterías de CDMX para proteger superficies terminadas durante el transporte a domicilio y por tapicerías para separadores entre piezas en taller.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Flauta B/C</span><span class="sku-detail__strip-label">Simple pared</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Flexible</span><span class="sku-detail__strip-label">Sin rayar</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 lám.</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Stock CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-LA-08 Láminas Corrugado para Muebles y Tapizado`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-LA-08</a>
 <a href="/catalogo/laminas-carton-corrugado/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cartón para proteger muebles" />
</PageLayout>
