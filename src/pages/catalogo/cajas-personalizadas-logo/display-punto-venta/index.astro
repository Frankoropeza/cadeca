---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja Display para Punto de Venta | CADECA";
const description = "Caja display PDQ personalizada para punto de venta en CDMX. Impresión 4 colores, estructura autoportante, resistente al manejo en tienda. MOQ 200 pzas.";

const specs = [
 ["Código SKU", "CAD-PL-08"],
 ["Tipo", "Display PDQ autoportante"],
 ["Impresión", "Full color CMYK 4 colores"],
 ["Liner", "Blanco alta blancura"],
 ["Estructura", "Autoportante en PDV"],
 ["Cierre", "Tapa removible exposición"],
 ["Resistencia", "ECT-32"],
 ["Pedido mínimo", "200 piezas"],
 ["Entrega", "7–10 días hábiles"],
];

const faqs = [
 {
 id: "cad-pl-08-f1",
 question: "¿Cómo elijo la medida adecuada para cajas display para punto de venta?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "cad-pl-08-f2",
 question: "¿Qué resistencia de cartón conviene para cajas display para punto de venta?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "cad-pl-08-f3",
 question: "¿Se pueden personalizar cajas display para punto de venta con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "cad-pl-08-f4",
 question: "¿Cómo debo almacenar cajas display para punto de venta antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "cad-pl-08-f5",
 question: "¿Qué datos necesito para cotizar cajas display para punto de venta?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-retail-pdv-hero-cdmx.avif", alt: "Caja display PDQ punto de venta CDMX" },
 { src: "/img/catalogo/caja-retail-pdv-display-cdmx.avif", alt: "Display PDQ en tienda" },
 { src: "/img/catalogo/caja-retail-pdv-flatpack-cdmx.avif", alt: "PDQ flatpack almacén" },
 { src: "/img/catalogo/caja-retail-pdv-floorstand-cdmx.avif", alt: "PDQ floorstand exhibidor" },
 { src: "/img/catalogo/caja-retail-punto-venta-pdv-cdmx.avif", alt: "Punto de venta PDQ personalizado" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas Personalizadas con Logo",href:"/catalogo/cajas-personalizadas-logo/"},{name:"Caja Display para Punto de Venta PDQ"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja Display para Punto de Venta PDQ",sku:"CAD-PL-08",description:"Caja tipo display PDQ para punto de venta: exhibe y vende al mismo tiempo. Impresión full color, estructura autoportante, compatible con mostradores y góndolas. Desde 200 piezas.",image:gallery[0].src,material:"CAD-PL-08",category:"Cajas Personalizadas con Logo",moq:"200 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Cajas Personalizadas con Logo</a></li>
 <li><span class="current">Caja Display para Punto de Venta PDQ</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadpl08-title"
   eyebrow="Personalizadas · SKU CAD-PL-08"
   titleHtml={true}
   title="Exhibidores de cartón <span>para punto de venta</span>"
   desc="Exhibidores de cartón para mostrar producto en mostradores y góndolas, con una estructura que combina empaque y presentación. Son útiles para marcas y comercios en CDMX."
   desc2="Los <strong>displays para punto de venta</strong> tipo PDQ se configuran con estructura autoportante e impresión a todo color. Están pensados para mostradores y góndolas, donde el empaque se convierte en exhibidor y permite presentar producto sin añadir un mueble independiente.||Para un display PDQ, el peso y número de productos, el espacio de mostrador y la gráfica definen la estructura. Envía medidas del producto, unidades por exhibidor, dimensiones del área y arte; CADECA revisa material, impresión y formato para cotizar."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadpl08-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-PL-08 · Familia: Cajas Personalizadas con Logo</p>
 <h2 id="detalle-cadpl08-title" class="sku-detail__title">Caja Display para Punto de Venta PDQ</h2>
 <p class="sku-detail__desc">La caja PDQ (Pre-Designed Quantity) es un empaque de envío que se convierte en exhibidor en el punto de venta sin necesidad de abrir o desarmar la caja. Solo retiras la tapa y el producto queda expuesto en un exhibidor limpio con tu gráfica. CAD-PL-08 está diseñada específicamente para tiendas de conveniencia, farmacias y supermercados donde el manejo es intensivo y la presencia de marca en góndola es clave. Impresión full color, liner blanco de alta blancura.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">PDQ</span><span class="sku-detail__strip-label">Tipo display</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">4 colores</span><span class="sku-detail__strip-label">Impresión</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">200 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">7–10 días</span><span class="sku-detail__strip-label">Entrega</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-PL-08 Caja Display para Punto de Venta PDQ`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-PL-08</a>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="exhibidores de cartón" />
</PageLayout>
