---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja Personalizada con Laminado Mate | CADECA";
const description = "Caja con laminado mate soft touch en CDMX. Textura suave al tacto, imagen premium. Ideal para marcas DTC, cosmética y moda. MOQ 300 pzas. Diseño incluido.";

const specs = [
 ["Código SKU", "CAD-PL-07"],
 ["Acabado", "Laminado BOPP mate soft touch"],
 ["Impresión", "Full color CMYK 4 colores"],
 ["Resistencia", "ECT-32"],
 ["Liner", "Blanco o Kraft"],
 ["Diseño", "Gratuito con logo vectorial"],
 ["Muestra física", "Sin costo"],
 ["Pedido mínimo", "300 piezas"],
 ["Entrega", "8–12 días hábiles"],
];

const faqs = [
 {
 id: "cad-pl-07-f1",
 question: "¿Cómo elijo la medida adecuada para cajas con laminado mate?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "cad-pl-07-f2",
 question: "¿Qué resistencia de cartón conviene para cajas con laminado mate?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "cad-pl-07-f3",
 question: "¿Se pueden personalizar cajas con laminado mate con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "cad-pl-07-f4",
 question: "¿Cómo debo almacenar cajas con laminado mate antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "cad-pl-07-f5",
 question: "¿Qué datos necesito para cotizar cajas con laminado mate?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-acabados-softtouch-cdmx.avif", alt: "Caja laminado mate soft touch premium" },
 { src: "/img/catalogo/caja-acabados-hero-cdmx.avif", alt: "Acabados especiales corrugado" },
 { src: "/img/catalogo/caja-cosmetica-premium-display-cdmx.avif", alt: "Display cosmética laminado mate" },
 { src: "/img/catalogo/caja-cosmetica-premium-interior-cdmx.avif", alt: "Interior caja premium mate" },
 { src: "/img/catalogo/caja-acabados-showcase-cdmx.avif", alt: "Showcase laminados acabados" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas Personalizadas con Logo",href:"/catalogo/cajas-personalizadas-logo/"},{name:"Caja Personalizada Laminado Mate Soft Touch"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja Personalizada Laminado Mate Soft Touch",sku:"CAD-PL-07",description:"Caja con laminado mate soft touch: acabado aterciopelado que comunica lujo y cuidado. Ideal para marcas DTC, cosmética premium y canastas navideñas. Desde 300 piezas.",image:gallery[0].src,material:"CAD-PL-07",category:"Cajas Personalizadas con Logo",moq:"300 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Cajas Personalizadas con Logo</a></li>
 <li><span class="current">Caja Personalizada Laminado Mate Soft Touch</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadpl07-title"
   eyebrow="Personalizadas · SKU CAD-PL-07"
   titleHtml={true}
   title="Cajas con laminado mate <span>soft touch</span>"
   desc="Cajas con laminado mate para cosmética, perfumería, moda y regalos que requieren una superficie suave al tacto. Se integran a proyectos de marca y presentación en CDMX."
   desc2="El laminado BOPP mate soft touch se aplica sobre impresión CMYK de cuatro colores y ECT-32. Su superficie aterciopelada ofrece mayor resistencia al roce frente al barniz UV y puede combinarse con hot stamping para empaques de cosmética, joyería, moda y regalos.||CADECA surte estas cajas como proveedor según cada requerimiento. Para cotizar, comparte medidas, cantidad, uso y zona de entrega; el equipo te asesora sobre el cartón, el arte impreso y la aplicación de <strong>soft touch</strong> adecuada."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadpl07-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-PL-07 · Familia: Cajas Personalizadas con Logo</p>
 <h2 id="detalle-cadpl07-title" class="sku-detail__title">Caja Personalizada Laminado Mate Soft Touch</h2>
 <p class="sku-detail__desc">El laminado mate soft touch transforma una caja ordinaria en un objeto de deseo: la textura suave al tacto comunica calidad antes de abrir el empaque. Es el acabado preferido de marcas de cosmética de lujo, perfumerías, marcas DTC de ropa y artículos de regalo. CAD-PL-07 combina impresión CMYK 4 colores con laminado BOPP mate soft touch aplicado en toda la superficie exterior. El resultado es una caja que protege mejor que el barniz UV y crea una experiencia de unboxing memorable.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Soft Touch</span><span class="sku-detail__strip-label">Acabado</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">CMYK</span><span class="sku-detail__strip-label">4 colores</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">300 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">8–12 días</span><span class="sku-detail__strip-label">Entrega</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-PL-07 Caja Personalizada Laminado Mate Soft Touch`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-PL-07</a>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas con laminado mate" />
</PageLayout>
