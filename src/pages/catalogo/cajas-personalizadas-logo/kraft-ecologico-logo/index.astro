---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja Kraft Personalizada con Logo | CADECA";
const description = "Caja personalizada kraft ecológico con logo en CDMX. Papel reciclado, 1–2 colores, imagen sustentable. MOQ 200 pzas.";

const specs = [
 ["Código SKU", "CAD-PL-11"],
 ["Material", "Kraft reciclado postconsumer; FSC por confirmar"],
 ["Certificación", "FSC por confirmar al cotizar"],
 ["Impresión", "1–2 colores tintas water-based"],
 ["Blanqueante", "Sin cloro elemental"],
 ["Resistencia", "ECT-32"],
 ["Diseño", "Gratuito"],
 ["Pedido mínimo", "200 piezas"],
 ["Entrega", "5–7 días hábiles"],
];

const faqs = [
 { id:"cad-pl-11-f1", question:"¿La certificación FSC tiene un costo adicional?", answer:"Si tu proyecto requiere cartón con certificación FSC, lo indicamos al cotizar y confirmamos disponibilidad con el fabricante. Cualquier costo o documentación específica se confirma en la cotización." },
 { id:"cad-pl-11-f2", question:"¿El kraft reciclado es igual de resistente que el kraft virgen?", answer:"La resistencia ECT-32 es la misma que en kraft virgen estándar. Donde puede diferir es en el aspecto: el kraft reciclado tiene más variaciones en el tono y puede mostrar pequeñas inclusiones de fibra, lo que en realidad muchas marcas usan como parte de su estética sustentable. Si necesitas homogeneidad perfecta de color, el kraft virgen es mejor opción." },
 { id:"cad-pl-11-f3", question:"¿Puedo presumir la certificación FSC en mi packaging?", answer:"Si el material disponible cuenta con certificación FSC, confirmamos contigo la documentación y las condiciones de uso del logo antes de imprimirlo en la caja." },
];

const gallery = [
 { src: "/img/catalogo/cajas-carton-personalizadas-1-color-logo-cdmx.avif", alt: "Caja kraft ecológico personalizada" },
 { src: "/img/catalogo/caja-1color-detalle-cdmx.avif", alt: "Detalle caja kraft ecológico" },
 { src: "/img/catalogo/caja-1color-stack-cdmx.avif", alt: "Cajas kraft reciclado apiladas" },
 { src: "/img/catalogo/laminas-carton-reciclado-ecologico-cdmx.avif", alt: "Material reciclado" },
 { src: "/img/catalogo/caja-1color-uso-cdmx.avif", alt: "Uso caja ecológica kraft" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas Personalizadas con Logo",href:"/catalogo/cajas-personalizadas-logo/"},{name:"Caja Personalizada Kraft Ecológico con Logo"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja Personalizada Kraft Ecológico con Logo",sku:"CAD-PL-11",description:"Caja personalizada en kraft reciclado para marcas con imagen sustentable. La disponibilidad de FSC se confirma al cotizar. Logo 1–2 colores, desde 200 piezas en CDMX.",image:gallery[0].src,material:"CAD-PL-11",category:"Cajas Personalizadas con Logo",moq:"200 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Cajas Personalizadas con Logo</a></li>
 <li><span class="current">Caja Personalizada Kraft Ecológico con Logo</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadpl11-title"
   eyebrow="Personalizadas · SKU CAD-PL-11"
   titleHtml={true}
   title="Cajas kraft personalizadas <span>con logo</span>"
   desc="Cajas kraft personalizadas para marcas que buscan integrar logo y una presentación de papel reciclado. Son una opción para empaques y envíos en CDMX y Estado de México."
   desc2="Estas cajas usan kraft reciclado postconsumo con impresión de uno o dos colores mediante tintas a base de agua. Con ECT-32, las <strong>cajas ecológicas con logo</strong> conservan las variaciones naturales del papel y se adaptan a proyectos que requieren una imagen de material reciclado.||CADECA coordina el suministro como proveedor de cajas kraft personalizadas. Indica medidas, cantidad, uso y zona de entrega al cotizar; te asesoramos para definir el cartón, la impresión y las condiciones del pedido según tu empaque."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadpl11-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-PL-11 · Familia: Cajas Personalizadas con Logo</p>
 <h2 id="detalle-cadpl11-title" class="sku-detail__title">Caja Personalizada Kraft Ecológico con Logo</h2>
 <p class="sku-detail__desc">Cada vez más consumidores eligen marcas con conciencia ambiental. La caja kraft ecológico de CAD-PL-11 usa papel reciclado postconsumer. Si tu proyecto requiere certificación FSC, lo indicamos al cotizar y confirmamos disponibilidad con el fabricante. La apariencia natural del kraft transmite autenticidad y compromiso medioambiental sin necesidad de decirlo explícitamente. Impresión de 1 a 2 colores con tintas a base de agua.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">FSC</span><span class="sku-detail__strip-label">Por confirmar</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Reciclado</span><span class="sku-detail__strip-label">Material</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">200 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Eco</span><span class="sku-detail__strip-label">Sin recargo</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-PL-11 Caja Personalizada Kraft Ecológico con Logo`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-PL-11</a>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-cadpl11-title">
 <div class="container">
 <h2 id="faq-cadpl11-title" class="sku-faq__title">Preguntas Frecuentes — Caja Personalizada Kraft Ecológico con Logo</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture title="¿Tu marca tiene valores sustentables? Cotiza una caja kraft reciclada" />
</PageLayout>
