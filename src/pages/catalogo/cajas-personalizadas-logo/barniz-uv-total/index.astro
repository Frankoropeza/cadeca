---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja Personalizada con Barniz UV Total | CADECA";
const description = "Caja personalizada con barniz UV total en CDMX. Acabado gloss de alto brillo, impresión full color. Ideal para cosmética y premium. Desde 300 pzas.";

const specs = [
 ["Código SKU", "CAD-PL-06"],
 ["Acabado", "Barniz UV Total gloss"],
 ["Impresión", "Full color CMYK 4/0 o 4/4"],
 ["Liner", "Blanco 90 g/m² o Kraft virgen"],
 ["Resistencia", "ECT-32 doble corrugado"],
 ["Arte", "Diseño incluido con logo vectorial"],
 ["Muestra", "Física sin costo en CDMX"],
 ["Pedido mínimo", "300 piezas"],
 ["Entrega", "7–10 días hábiles"],
];

const faqs = [
 {
 id: "cad-pl-06-f1",
 question: "¿Cómo elijo la medida adecuada para cajas con barniz UV total?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "cad-pl-06-f2",
 question: "¿Qué resistencia de cartón conviene para cajas con barniz UV total?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "cad-pl-06-f3",
 question: "¿Se pueden personalizar cajas con barniz UV total con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "cad-pl-06-f4",
 question: "¿Cómo debo almacenar cajas con barniz UV total antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "cad-pl-06-f5",
 question: "¿Qué datos necesito para cotizar cajas con barniz UV total?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-acabados-gloss-cdmx.avif", alt: "Caja personalizada barniz UV gloss" },
 { src: "/img/catalogo/caja-acabados-hero-cdmx.avif", alt: "Acabados especiales cajas CDMX" },
 { src: "/img/catalogo/caja-acabados-showcase-cdmx.avif", alt: "Showcase acabados barniz UV" },
 { src: "/img/catalogo/cajas-carton-personalizadas-acabados-especiales-barniz-uv.avif", alt: "Barniz UV total cajas corrugado" },
 { src: "/img/catalogo/caja-cosmetica-premium-gloss-cdmx.avif", alt: "Caja cosmética barniz UV" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas Personalizadas con Logo",href:"/catalogo/cajas-personalizadas-logo/"},{name:"Caja Personalizada Barniz UV Total"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja Personalizada Barniz UV Total",sku:"CAD-PL-06",description:"Caja personalizada con barniz UV total para acabado de alto brillo y protección del arte impreso. Ideal para cosmética, perfumería y marcas premium. Desde 300 piezas en CDMX.",image:gallery[0].src,material:"CAD-PL-06",category:"Cajas Personalizadas con Logo",moq:"300 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Cajas Personalizadas con Logo</a></li>
 <li><span class="current">Caja Personalizada Barniz UV Total</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadpl06-title"
   eyebrow="Personalizadas · SKU CAD-PL-06"
   titleHtml={true}
   title="Cajas con barniz UV <span>de alto brillo</span>"
   desc="Cajas con barniz UV para productos de cosmética, perfumería y marcas que requieren proteger el arte impreso con una superficie brillante. Disponibles para pedidos en CDMX."
   desc2="El barniz UV total se aplica sobre la superficie impresa para conseguir un <strong>acabado brillante</strong> y proteger el arte gráfico. Combina impresión CMYK a cuatro colores y cartón con ECT-32, una combinación apta para empaques de cosmética, perfumería y regalos.||CADECA coordina el suministro de estas cajas como proveedor. Al cotizar, indica medidas, cantidad, uso y zona de entrega para revisar el material y la impresión; el equipo te asesora para elegir el acabado y la configuración adecuados."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadpl06-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-PL-06 · Familia: Cajas Personalizadas con Logo</p>
 <h2 id="detalle-cadpl06-title" class="sku-detail__title">Caja Personalizada Barniz UV Total</h2>
 <p class="sku-detail__desc">El barniz UV total es el acabado más impactante visualmente: el papel queda con un brillo intenso que realza los colores y protege la impresión contra rayones y humedad superficial. CAD-PL-06 combina impresión full color CMYK con barniz UV total aplicado en toda la superficie exterior. Disponible en liner blanco o kraft. Desde 300 piezas en CDMX con entrega en 7 a 10 días hábiles. Usado por marcas de cosmética, perfumería, joyería y productos premium.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">UV Total</span><span class="sku-detail__strip-label">Acabado</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">CMYK</span><span class="sku-detail__strip-label">Impresión</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">300 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">7–10 días</span><span class="sku-detail__strip-label">Entrega</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-PL-06 Caja Personalizada Barniz UV Total`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-PL-06</a>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas con barniz UV" />
</PageLayout>
