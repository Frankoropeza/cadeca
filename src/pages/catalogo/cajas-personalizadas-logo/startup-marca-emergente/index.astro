---
import PageLayout    from "@/layouts/PageLayout.astro";
import FaqItem       from "@/components/FaqItem.astro";
import LeadCapture   from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Caja Personalizada Startup Marca Emergente CDMX | MOQ 100 | CAD-PL-10 | CADECA";
const description = "Caja personalizada para startups y marcas emergentes en CDMX. MOQ bajo 100 pzas, diseño gratis, turnaround 5–7 días. La mejor opción para marcas DTC que empiezan. CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const specs = [
  ["Código SKU", "CAD-PL-10"],
  ["MOQ", "100 piezas (el más bajo)"],
  ["Impresión", "1–2 colores"],
  ["Liner", "Kraft o blanco"],
  ["Diseño", "Gratuito con logo vectorial"],
  ["Turnaround", "5–7 días hábiles"],
  ["Resistencia", "ECT-32"],
  ["Escala", "Precio decremental desde 500 pzas"],
  ["Entrega CDMX", "24 hrs en neutra / 5–7 días con logo"],
];

const faqs = [
  { id:"cad-pl-10-f1", question:"¿Por qué su MOQ es tan bajo comparado con otras imprentas?", answer:"Usamos flexografía en planchas fotopolímeras que amortizamos diferente a las planchas metálicas tradicionales, lo que nos permite ofrecer tirajes bajos sin perder rentabilidad. El costo de plancha es fijo por diseño, no por tiraje, por lo que te conviene hacer pedidos más grandes a medida que creces para amortizar ese costo inicial." },
  { id:"cad-pl-10-f2", question:"¿Cuánto sube el precio unitario con mi logo vs caja neutra?", answer:"Para un pedido de 100 piezas, el precio unitario con 1 color de logo es aproximadamente 35% a 50% mayor que la caja neutra equivalente. Para 300 piezas baja al 20-25% de incremento y para 1,000+ piezas el incremento es menor al 15%. A partir de 500 piezas ya es muy competitivo." },
  { id:"cad-pl-10-f3", question:"¿Qué necesito para empezar el proceso?", answer:"Solo necesitas tu logo en formato vectorial (AI, EPS o PDF con tipografías convertidas), las dimensiones de tu producto (largo, ancho, alto) y el número aproximado de piezas. Con eso te mandamos cotización en menos de 2 horas y arte digital en 24 horas para tu aprobación." },
];

const gallery = [
  { src: "/img/catalogo/cajas-carton-personalizadas-pequenas-empresas-100-piezas.avif", alt: "Caja personalizada startup MOQ 100" },
  { src: "/img/catalogo/caja-1color-hero-cdmx.avif", alt: "Caja 1 color marca emergente" },
  { src: "/img/catalogo/caja-1color-stack-cdmx.avif", alt: "Cajas startup apiladas" },
  { src: "/img/catalogo/caja-1color-uso-cdmx.avif", alt: "Uso caja personalizada startup" },
  { src: "/img/catalogo/caja-pyme-hero-cdmx.avif", alt: "Caja PyME personalizada CDMX" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas Personalizadas con Logo",href:"/catalogo/cajas-personalizadas-logo"},{name:"Caja Personalizada para Startups y Marcas Emergentes"}]}
  faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
  product={{name:"Caja Personalizada para Startups y Marcas Emergentes",sku:"CAD-PL-10",description:"La caja personalizada con logo de menor MOQ del mercado: desde 100 piezas para startups y marcas emergentes en CDMX. Diseño gratuito y entrega en 5–7 días.",image:gallery[0].src,material:"CAD-PL-10",category:"Cajas Personalizadas con Logo",moq:"100 piezas (el más bajo)"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-personalizadas-logo">Cajas Personalizadas con Logo</a></li>
        <li><span class="current">Caja Personalizada para Startups y Marcas Emergentes</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-cadpl10-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-PL-10 · Cajas Personalizadas con Logo</span>
      <h1 id="sku-cadpl10-title" class="cat-page-hero__title">Caja Personalizada para <span>Startups</span> y Marcas Emergentes CDMX</h1>
      <p class="cat-page-hero__desc">La caja personalizada con logo de menor MOQ del mercado: desde 100 piezas para startups y marcas emergentes en CDMX. Diseño gratuito y entrega en 5–7 días.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-PL-10</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>100 piezas (el más bajo)</strong></div>
        <div class="cat-page-hero__strip-item">Fabricante: <strong>Directo</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-cadpl10-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-PL-10 · Familia: Cajas Personalizadas con Logo</p>
            <h2 id="detalle-cadpl10-title" class="sku-detail__title">Caja Personalizada para Startups y Marcas Emergentes</h2>
            <p class="sku-detail__desc">Empezar una marca no debería requerir comprar 1,000 cajas de golpe. CAD-PL-10 existe para que las marcas emergentes tengan su caja con logo desde el primer día sin sobre-inventariarse. MOQ de solo 100 piezas, diseño de artes gratuito con tu logo en vectores y turnaround de 5 a 7 días hábiles. Impresión de 1 a 2 colores en liner kraft o blanco. Al crecer a 500+ piezas, el precio baja y puedes agregar más colores.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ mínimo</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">1–2 col.</span><span class="sku-detail__strip-label">Impresión</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Diseño</span><span class="sku-detail__strip-label">Gratuito</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5–7 días</span><span class="sku-detail__strip-label">Entrega</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-PL-10 Caja Personalizada para Startups y Marcas Emergentes`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-PL-10</a>
              <a href="/catalogo/cajas-personalizadas-logo" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-faq" aria-labelledby="faq-cadpl10-title">
      <div class="container">
        <h2 id="faq-cadpl10-title" class="sku-faq__title">Preguntas Frecuentes — Caja Personalizada para Startups y Marcas Emergentes</h2>
        <div class="sku-faq__list">
          {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="¿Estás lanzando tu marca? Empieza con solo 100 cajas con tu logo — diseño gratis incluido" />
</PageLayout>
