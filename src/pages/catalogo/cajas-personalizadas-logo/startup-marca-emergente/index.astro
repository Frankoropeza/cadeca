---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas Personalizadas para Startups | CADECA";
const description = "Caja personalizada para startups y marcas emergentes en CDMX. MOQ bajo 100 pzas, diseño gratis, entrega programada según pedido.";

const specs = [
 ["Código SKU", "CAD-PL-10"],
 ["MOQ", "100 piezas (el más bajo)"],
 ["Impresión", "1–2 colores"],
 ["Liner", "Kraft o blanco"],
 ["Diseño", "Gratuito con logo vectorial"],
 ["Turnaround", "5–7 días hábiles"],
 ["Resistencia", "ECT-32"],
 ["Escala", "Precio decremental desde 500 pzas"],
 ["Entrega CDMX", "Según pedido"],
];

const faqs = [
 {
 id: "cad-pl-10-f1",
 question: "¿Cómo elijo la medida adecuada para cajas personalizadas para startups?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "cad-pl-10-f2",
 question: "¿Qué resistencia de cartón conviene para cajas personalizadas para startups?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "cad-pl-10-f3",
 question: "¿Se pueden personalizar cajas personalizadas para startups con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "cad-pl-10-f4",
 question: "¿Cómo debo almacenar cajas personalizadas para startups antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "cad-pl-10-f5",
 question: "¿Qué datos necesito para cotizar cajas personalizadas para startups?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/cajas-carton-personalizadas-pequenas-empresas-100-piezas.avif", alt: "Caja personalizada startup MOQ 100" },
 { src: "/img/catalogo/caja-1color-hero-cdmx.avif", alt: "Caja 1 color marca emergente" },
 { src: "/img/catalogo/caja-1color-stack-cdmx.avif", alt: "Cajas startup apiladas" },
 { src: "/img/catalogo/caja-1color-uso-cdmx.avif", alt: "Uso caja personalizada startup" },
 { src: "/img/catalogo/caja-pyme-hero-cdmx.avif", alt: "Caja PyME personalizada CDMX" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas Personalizadas con Logo",href:"/catalogo/cajas-personalizadas-logo/"},{name:"Caja Personalizada para Startups y Marcas Emergentes"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja Personalizada para Startups y Marcas Emergentes",sku:"CAD-PL-10",description:"La caja personalizada con logo de menor MOQ del mercado: desde 100 piezas para startups y marcas emergentes en CDMX. Diseño gratuito y entrega en 5–7 días.",image:gallery[0].src,material:"CAD-PL-10",category:"Cajas Personalizadas con Logo",moq:"100 piezas (el más bajo)"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Cajas Personalizadas con Logo</a></li>
 <li><span class="current">Caja Personalizada para Startups y Marcas Emergentes</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadpl10-title"
   eyebrow="Personalizadas · SKU CAD-PL-10"
   titleHtml={true}
   title="Cajas personalizadas para emprendedores <span>con logo</span>"
   desc="Cajas personalizadas para emprendedores que necesitan presentar sus productos con logo desde 100 piezas. Se adaptan a marcas nuevas, tiendas y envíos en CDMX y Estado de México."
   desc2="Estas cajas se trabajan en liner kraft o blanco, con impresión de uno o dos colores y pedido desde 100 piezas. Son una alternativa de <strong>empaques para marcas nuevas</strong> que requieren definir medidas y arte sin mantener una cantidad mayor a la necesaria para iniciar.||CADECA coordina el surtido como proveedor para proyectos de emprendimiento. Al cotizar, comparte medidas, cantidad, uso y zona de entrega; el equipo te asesora para seleccionar el cartón, la impresión y la configuración que se ajuste al producto."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadpl10-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-PL-10 · Familia: Cajas Personalizadas con Logo</p>
 <h2 id="detalle-cadpl10-title" class="sku-detail__title">Caja Personalizada para Startups y Marcas Emergentes</h2>
 <p class="sku-detail__desc">Empezar una marca no debería requerir comprar 1,000 cajas de golpe. CAD-PL-10 existe para que las marcas emergentes tengan su caja con logo desde el primer día sin sobre-inventariarse. MOQ de solo 100 piezas, diseño de artes gratuito con tu logo en vectores y turnaround de 5 a 7 días hábiles. Impresión de 1 a 2 colores en liner kraft o blanco. Al crecer a 500+ piezas, el precio baja y puedes agregar más colores.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ mínimo</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">1–2 col.</span><span class="sku-detail__strip-label">Impresión</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Diseño</span><span class="sku-detail__strip-label">Gratuito</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5–7 días</span><span class="sku-detail__strip-label">Entrega</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-PL-10 Caja Personalizada para Startups y Marcas Emergentes`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-PL-10</a>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas personalizadas para emprendedores" />
</PageLayout>
