---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem     from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Cajas Cartón Logo 2 Colores CDMX | Flexo ECT-32 | CAD-PL-02 | CADECA";
const description = "Cajas de cartón con logo 2 colores en CDMX. Impresión flexo 2 tintas pantone, ECT-32, desde 100 piezas, entrega 5-7 días. Logo + texto o 2 colores de marca. CADECA fabricante.";
const WHATSAPP    = "5255XXXXXXXX";

const medidas = [
  { talla:"XS", ml:"20×15×10 cm", real:"20×15×10", flauta:"C",ect:"ECT-32",vacío:"0.18 kg",máx:"5 kg", disp:"yellow", label:"5-7 días", hl:false },
  { talla:"S", ml:"28×22×12 cm", real:"28×22×12", flauta:"C",ect:"ECT-32",vacío:"0.28 kg",máx:"8 kg", disp:"yellow", label:"5-7 días", hl:true },
  { talla:"M", ml:"38×30×18 cm", real:"38×30×18", flauta:"C",ect:"ECT-32",vacío:"0.45 kg",máx:"12 kg", disp:"yellow", label:"5-7 días", hl:true },
  { talla:"L", ml:"50×38×25 cm", real:"50×38×25", flauta:"C",ect:"ECT-32",vacío:"0.70 kg",máx:"18 kg", disp:"yellow", label:"5-7 días", hl:false },
  { talla:"XL", ml:"60×45×30 cm", real:"60×45×30", flauta:"C",ect:"ECT-32",vacío:"1.00 kg",máx:"20 kg", disp:"gray", label:"7-10 días", hl:false },
  { talla:"A la Medida", ml:"Personalizada", real:"A definir", flauta:"C",ect:"ECT-32",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
  ["Código SKU", "CAD-PL-02"],
  ["Tipo impresión", "Flexograbado 2 tintas"],
  ["Colores máx.", "2 tintas pantone independientes"],
  ["Soporte impresión", "Kraft marrón o kraft blanco"],
  ["Resistencia ECT", "ECT-32"],
  ["Tipo de pared", "Simple corrugado"],
  ["Resolución impresión", "Hasta 85 lpi"],
  ["Secado", "Tinta UV base agua"],
  ["Registro", "±1mm entre tintas"],
  ["Diseño incluido", "Sí — 1 vectorización sin costo"],
  ["Archivo aceptado", "AI / EPS / PDF vectorizado"],
  ["Pedido mínimo", "100 piezas"],
  ["Entrega CDMX", "5-7 días hábiles"],
];

const faqs = [
  {
    id:"pl02-f1",
    question:"¿En qué casos vale la pena agregar un segundo color a mi caja?",
    answer:"El segundo color justifica su costo adicional (típicamente 15-25% más que 1 color) cuando: tu logo incluye el nombre de la marca en un color y el ícono o símbolo en otro; quieres agregar información de contacto en color distinto al logo; la caja irá a cliente final y el branding es parte de la experiencia; o estás diferenciando diferentes líneas de producto con código de color. Para uso interno o almacén, 1 color suele ser suficiente.",
  },
  {
    id:"pl02-f2",
    question:"¿Puedo combinar pantone con un color negro para mi logo?",
    answer:"Sí. La combinación más económica de 2 colores es Pantone + Negro, ya que el negro es la tinta base del sistema flexo y no requiere placa adicional en muchos casos. Esta combinación es ideal para logos con tipografía negra y un color corporativo de acento. El costo sería similar a 1 color personalizado + negro. Cualquier combinación de 2 Pantones también es posible; solo confirma los códigos Pantone Coated de tu marca al hacer el pedido.",
  },
];

const mainImg = "/img/catalogo/cajas-carton-personalizadas-2-colores-cdmx.avif";
const gallery = [
  { src: mainImg, alt: "Caja Personalizada Logo 2 Colores — vista frontal CDMX" },
  { src: mainImg, alt: "Caja Personalizada Logo 2 Colores — detalle corrugación" },
  { src: mainImg, alt: "Caja Personalizada Logo 2 Colores — stack apilado" },
  { src: mainImg, alt: "Caja Personalizada Logo 2 Colores — contexto uso industrial" },
  { src: mainImg, alt: "Caja Personalizada Logo 2 Colores — medidas referencia" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"Personalizadas con Logo", href:"/catalogo/cajas-personalizadas-logo"}, {name:"2 Colores Flexo"}]}
  faqItems={[{question:"¿En qué casos vale la pena agregar un segundo color a mi caja?", answer:"El segundo color justifica su costo adicional (típicamente 15-25% más que 1 color) cuando: tu logo incluye el nombre de la marca en un color y el ícono o símbolo en otro; quieres agregar información de contacto en color distinto al logo; la caja irá a cliente final y el branding es parte de la experiencia; o estás diferenciando diferentes líneas de producto con código de color. Para uso interno o almacén, 1 color suele ser suficiente."}, {question:"¿Puedo combinar pantone con un color negro para mi logo?", answer:"Sí. La combinación más económica de 2 colores es Pantone + Negro, ya que el negro es la tinta base del sistema flexo y no requiere placa adicional en muchos casos. Esta combinación es ideal para logos con tipografía negra y un color corporativo de acento. El costo sería similar a 1 color personalizado + negro. Cualquier combinación de 2 Pantones también es posible; solo confirma los códigos Pantone Coated de tu marca al hacer el pedido."}]}
  product={{name:"Caja Cartón Personalizada Logo 2 Colores Flexo", sku:"CAD-PL-02", description:"Caja Cartón Personalizada Logo 2 Colores Flexo en CDMX — fabricante directo CADECA", image:"/img/catalogo/cajas-carton-personalizadas-2-colores-cdmx.avif", material:"Cartón corrugado simple flauta C ECT-32 impresión flexo 2 tintas", category:"Cajas de Cartón Personalizadas con Logo", moq:"100"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-personalizadas-logo">Personalizadas con Logo</a></li>
        <li><span class="current">2 Colores Flexo</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-pl02-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-PL-02 · Personalizadas con Logo</span>
      <h1 id="sku-pl02-title" class="cat-page-hero__title">Cajas Personalizadas <span>Logo 2 Colores Flexo</span><br>— ECT-32 CDMX</h1>
      <p class="cat-page-hero__desc">Impresión flexo 2 tintas pantone independientes sobre kraft marrón o blanco. Logo en un color y texto o acento en otro. 15-25% más que 1 color con el doble de impacto visual.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-PL-02</strong></div>
        <div class="cat-page-hero__strip-item">Impresión: <strong>Flexo 2 tintas</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>100 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>5-7 días</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-pl02-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-PL-02 · Familia: Personalizadas con Logo</p>
            <h2 id="detalle-pl02-title" class="sku-detail__title">Caja Personalizada Logo 2 Colores — Flexo</h2>
            <p class="sku-detail__desc">Impresión flexograbada en 2 tintas pantone independientes sobre kraft marrón o blanco. Cada color se aplica con su propia placa de fotopolímero, permitiendo combinar logo + tipografía en colores distintos o los 2 colores principales de tu marca. Registro entre tintas de ±1mm.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Flexo 2 tintas</span><span class="sku-detail__strip-label">Impresión</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5-7 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-PL-02 Caja Logo 2 Colores`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-PL-02</a>
              <a href="/catalogo/cajas-personalizadas-logo" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-pl02-title">
      <div class="container">
        <h2 id="sizes-pl02-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-PL-02</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
                  <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
                  <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"✓":"⏱"} {m.label}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Fabricamos cualquier medida personalizada desde 100 piezas. ⏱ Producción bajo pedido.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-pl02-title">
      <div class="container">
        <h2 id="faq-pl02-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-PL-02</h2>
        <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
      </div>
    </section>
  </main>
  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-PL-02 — 2 colores de marca, entrega 5-7 días" />
</PageLayout>
