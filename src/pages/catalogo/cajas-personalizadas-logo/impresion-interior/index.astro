---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja con Impresión Interior para Unboxing | CADECA";
const description = "Caja con impresión interior personalizada en CDMX. Sorpresa al abrir, unboxing premium. Exterior kraft + interior full color. MOQ 300 pzas.";

const specs = [
 ["Código SKU", "CAD-PL-09"],
 ["Exterior", "Kraft natural o logo 1–2 colores"],
 ["Interior", "Impresión full color CMYK"],
 ["Resistencia", "ECT-32"],
 ["Unboxing", "Diseñado para redes sociales"],
 ["Arte", "Gratuito con logo vectorial"],
 ["Muestra", "Física sin costo"],
 ["Pedido mínimo", "300 piezas"],
 ["Entrega", "8–12 días hábiles"],
];

const faqs = [
 {
 id: "cad-pl-09-f1",
 question: "¿Cómo elijo la medida adecuada para cajas con impresión interior?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "cad-pl-09-f2",
 question: "¿Qué resistencia de cartón conviene para cajas con impresión interior?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "cad-pl-09-f3",
 question: "¿Se pueden personalizar cajas con impresión interior con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "cad-pl-09-f4",
 question: "¿Cómo debo almacenar cajas con impresión interior antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "cad-pl-09-f5",
 question: "¿Qué datos necesito para cotizar cajas con impresión interior?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-cmyk-unboxing-cdmx.avif", alt: "Unboxing caja impresión interior" },
 { src: "/img/catalogo/caja-cmyk-interior-cdmx.avif", alt: "Interior personalizado caja" },
 { src: "/img/catalogo/caja-shopify-unboxing-cdmx.avif", alt: "Unboxing premium DTC" },
 { src: "/img/catalogo/caja-2colores-retail-cdmx.avif", alt: "Caja personalizada exterior" },
 { src: "/img/catalogo/cajas-carton-personalizadas-full-color-cmyk-cdmx.avif", alt: "Full color impresión" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas Personalizadas con Logo",href:"/catalogo/cajas-personalizadas-logo/"},{name:"Caja con Impresión Interior Sorpresa"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja con Impresión Interior Sorpresa",sku:"CAD-PL-09",description:"Caja con impresión interior para crear sorpresa al abrir: exterior neutro o con logo y el interior totalmente personalizado con tu marca. Ideal para unboxing en redes sociales.",image:gallery[0].src,material:"CAD-PL-09",category:"Cajas Personalizadas con Logo",moq:"300 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Cajas Personalizadas con Logo</a></li>
 <li><span class="current">Caja con Impresión Interior Sorpresa</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadpl09-title"
   eyebrow="Personalizadas · SKU CAD-PL-09"
   titleHtml={true}
   title="Cajas con impresión interior <span>de marca</span>"
   desc="Cajas con impresión interior para marcas que quieren comunicar al momento de abrir el empaque. Permiten combinar un exterior neutro o con logo para ventas y envíos."
   desc2="La impresión puede aplicarse en el interior mientras el exterior queda neutro o lleva el logo de la marca. Esta configuración permite trabajar mensajes, color o gráficos para una experiencia de <strong>unboxing</strong> en productos de venta directa, regalos y pedidos de comercio electrónico.||Para impresión interior, la distribución del arte y el exterior neutro o con logo definen la experiencia de <strong>unboxing</strong>. Envía medidas de la caja, archivo gráfico interior, tratamiento exterior y cantidad; CADECA revisa el cartón y la configuración del empaque."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadpl09-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-PL-09 · Familia: Cajas Personalizadas con Logo</p>
 <h2 id="detalle-cadpl09-title" class="sku-detail__title">Caja con Impresión Interior Sorpresa</h2>
 <p class="sku-detail__desc">La impresión interior es el detalle que diferencia una marca memorable de una genérica. El cliente abre la caja y descubre un mundo de color, mensajes personalizados o ilustraciones que refuerzan la identidad de marca. CAD-PL-09 tiene exterior en kraft natural o con logo de 1 a 2 colores, e interior impreso en full color CMYK. Ideal para marcas DTC, suscripción boxes y regalos corporativos que quieren crear contenido viral de unboxing en TikTok e Instagram.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Interior CMYK</span><span class="sku-detail__strip-label">Impresión</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Kraft</span><span class="sku-detail__strip-label">Exterior</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">300 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Unboxing</span><span class="sku-detail__strip-label">Viral</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-PL-09 Caja con Impresión Interior Sorpresa`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-PL-09</a>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas con impresión interior" />
</PageLayout>
