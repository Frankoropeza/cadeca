---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas con Acabados Especiales y Barniz UV | CADECA";
const description = "Cajas de cartón con acabados especiales en CDMX. Barniz UV spot y total, laminado mate y brillante, troquelado y relieve seco. Desde 500 piezas.";

const medidas = [
 { talla:"S", ml:"20×15×10 cm", real:"20×15×10", flauta:"C",ect:"ECT-32",vacío:"0.20 kg",máx:"5 kg", disp:"gray", label:"10-15 días", hl:false },
 { talla:"M", ml:"30×25×15 cm", real:"30×25×15", flauta:"C",ect:"ECT-32",vacío:"0.38 kg",máx:"10 kg", disp:"yellow", label:"10-15 días", hl:true },
 { talla:"L", ml:"45×35×20 cm", real:"45×35×20", flauta:"BC",ect:"ECT-44",vacío:"0.75 kg",máx:"18 kg", disp:"yellow", label:"10-15 días", hl:true },
 { talla:"XL", ml:"55×45×25 cm", real:"55×45×25", flauta:"BC",ect:"ECT-44",vacío:"1.10 kg",máx:"25 kg", disp:"gray", label:"10-15 días", hl:false },
 { talla:"A la Medida", ml:"Personalizada", real:"A definir", flauta:"—",ect:"—",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
 ["Código SKU", "CAD-PL-04"],
 ["Acabados disponibles", "Barniz UV spot · UV total · Laminado mate · Laminado brillante"],
 ["Técnica adicional", "Troquelado · Relieve seco · Hot stamping"],
 ["Impresión base", "Offset CMYK o serigrafía"],
 ["Papel exterior", "Kraft blanco coated 200-250g"],
 ["Tipo de pared", "Simple ECT-32 o doble ECT-44"],
 ["Aplicación barniz UV", "Serigráfica o digital"],
 ["Tiempo curado UV", "Instantáneo — línea de curado UV"],
 ["Pedido mínimo", "500 piezas"],
 ["Entrega CDMX", "10-15 días hábiles"],
 ["Ideal para", "Cosméticos · Lujo · Unboxing premium"],
];

const faqs = [
 {
 id: "pl04-f1",
 question: "¿Cómo elijo la medida adecuada para cajas con acabados especiales?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "pl04-f2",
 question: "¿Qué resistencia de cartón conviene para cajas con acabados especiales?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "pl04-f3",
 question: "¿Se pueden personalizar cajas con acabados especiales con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "pl04-f4",
 question: "¿Cómo debo almacenar cajas con acabados especiales antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "pl04-f5",
 question: "¿Qué datos necesito para cotizar cajas con acabados especiales?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const mainImg = "/img/catalogo/cajas-carton-personalizadas-acabados-especiales-barniz-uv.avif";
const gallery = [
 { src: "/img/catalogo/cajas-carton-personalizadas-acabados-especiales-barniz-uv.avif", alt: "Acabados especiales — principal" },
 { src: "/img/catalogo/caja-acabados-hero-cdmx.avif", alt: "Barniz UV — hero" },
 { src: "/img/catalogo/caja-acabados-gloss-cdmx.avif", alt: "Efecto gloss/matte selectivo" },
 { src: "/img/catalogo/caja-acabados-softtouch-cdmx.avif", alt: "Soft touch + stamping gold" },
 { src: "/img/catalogo/caja-acabados-showcase-cdmx.avif", alt: "Showcase acabados premium" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"Personalizadas con Logo", href:"/catalogo/cajas-personalizadas-logo/"}, {name:"Acabados Especiales"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja Cartón Acabados Especiales Barniz UV Laminado", sku:"CAD-PL-04", description:"Caja Cartón Acabados Especiales Barniz UV Laminado en CDMX — proveedor CADECA", image:"/img/catalogo/cajas-carton-personalizadas-acabados-especiales-barniz-uv.avif", material:"Cartón corrugado con acabados UV laminado mate brillante troquelado", category:"Cajas de Cartón Personalizadas con Logo", moq:"500"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Personalizadas con Logo</a></li>
 <li><span class="current">Acabados Especiales</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-pl04-title"
   eyebrow="Personalizadas · SKU CAD-PL-04"
   titleHtml={true}
   title="Cajas con acabados especiales <span>para marca</span>"
   desc="Cajas con acabados especiales para cosmética, productos de regalo y marcas que buscan destacar su presentación. Integran opciones de impresión y terminado para pedidos en CDMX."
   desc2="Admite barniz UV selectivo o total, laminado mate o brillante, troquelado y relieve seco. Estas <strong>cajas de lujo</strong> se pueden aplicar a empaques con impresión CMYK para cosméticos, regalos y productos que requieren una presentación cuidada.||CADECA surte como proveedor según las especificaciones de cada proyecto. Comparte medidas, cantidad, uso y zona de entrega para cotizar; te asesoramos sobre el cartón, la impresión y el acabado especial que mejor corresponda con el empaque."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-pl04-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-PL-04 · Familia: Personalizadas con Logo</p>
 <h2 id="detalle-pl04-title" class="sku-detail__title">Acabados Especiales — Barniz UV · Laminado · Relieve</h2>
 <p class="sku-detail__desc">Acabados premium sobre impresión offset CMYK o serigrafía. Barniz UV spot para resaltar logos y elementos clave. Laminado mate o brillante para protección y estética. Troquelado, relieve seco y hot stamping para el máximo impacto táctil y visual. Ideal para cosméticos, perfumería, chocolates premium y electrónica de consumo.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">UV · Laminado</span><span class="sku-detail__strip-label">Acabados</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Offset CMYK</span><span class="sku-detail__strip-label">Impresión base</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">500 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">10-15 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-PL-04 Acabados Especiales Barniz UV`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-PL-04</a>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-pl04-title">
 <div class="container">
 <h2 id="sizes-pl04-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-PL-04</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
 <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Surtimos cualquier medida personalizada desde 500 piezas.  Producción coordinada bajo pedido.</p>
 </div>
 </section>

 </main>
 <FaqCotizacion faqs={faqs} tema="cajas con acabados especiales" />
</PageLayout>
