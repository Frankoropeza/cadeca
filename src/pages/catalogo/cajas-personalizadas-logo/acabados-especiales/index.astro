---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem     from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";

const title       = "Cajas Cartón Acabados Especiales Barniz UV CDMX | CAD-PL-04 | Packaging Premium | CADECA";
const description = "Cajas de cartón con acabados especiales en CDMX. Barniz UV spot y total, laminado mate y brillante, troquelado y relieve seco. Desde 500 piezas. Packaging premium. CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const medidas = [
  { talla:"S", ml:"20×15×10 cm", real:"20×15×10", flauta:"C",ect:"ECT-32",vacío:"0.20 kg",máx:"5 kg", disp:"gray", label:"10-15 días", hl:false },
  { talla:"M", ml:"30×25×15 cm", real:"30×25×15", flauta:"C",ect:"ECT-32",vacío:"0.38 kg",máx:"10 kg", disp:"yellow", label:"10-15 días", hl:true },
  { talla:"L", ml:"45×35×20 cm", real:"45×35×20", flauta:"BC",ect:"ECT-44",vacío:"0.75 kg",máx:"18 kg", disp:"yellow", label:"10-15 días", hl:true },
  { talla:"XL", ml:"55×45×25 cm", real:"55×45×25", flauta:"BC",ect:"ECT-44",vacío:"1.10 kg",máx:"25 kg", disp:"gray", label:"10-15 días", hl:false },
  { talla:"A la Medida", ml:"Personalizada", real:"A definir", flauta:"—",ect:"—",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
  ["Código SKU", "CAD-PL-04"],
  ["Acabados disponibles", "Barniz UV spot · UV total · Laminado mate · Laminado brillante"],
  ["Técnica adicional", "Troquelado · Relieve seco · Hot stamping"],
  ["Impresión base", "Offset CMYK o serigrafía"],
  ["Papel exterior", "Kraft blanco coated 200-250g"],
  ["Tipo de pared", "Simple ECT-32 o doble ECT-44"],
  ["Aplicación barniz UV", "Serigráfica o digital"],
  ["Tiempo curado UV", "Instantáneo — línea de curado UV"],
  ["Pedido mínimo", "500 piezas"],
  ["Entrega CDMX", "10-15 días hábiles"],
  ["Ideal para", "Cosméticos · Lujo · Unboxing premium"],
];

const faqs = [
  {
    id:"pl04-f1",
    question:"¿Qué es el barniz UV spot y cuándo se usa en packaging?",
    answer:"El barniz UV spot es una capa de barniz transparente de altísimo brillo aplicada solo en zonas específicas del diseño (spot = punto), como el logo, el nombre de la marca o un elemento decorativo. El contraste entre el área brillante y el resto impreso crea un efecto visual y táctil muy distintivo. Se cura con luz ultravioleta en milisegundos. Es el acabado más solicitado en perfumería, cosméticos, chocolates premium y electrónica de consumo porque añade percepción de valor al packaging sin cambiar el diseño base.",
  },
  {
    id:"pl04-f2",
    question:"¿Cuándo vale la pena invertir en laminado mate o brillante?",
    answer:"El laminado (film de polipropileno aplicado por calor sobre el impreso) protege la impresión contra humedad, rozaduras y manipulación, y mejora el aspecto visual. El brillante amplifica los colores y da sensación de lujo accesible; el mate da una apariencia sofisticada y moderna muy usada en moda, tecnología y gastronomía premium. Vale la pena cuando: el producto tiene precio de venta mayor a 200 pesos y el packaging forma parte de la decisión de compra; cuando el producto será exhibido en punto de venta; o cuando el cliente final recibirá la caja directamente (e-commerce premium, gifts).",
  },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"Personalizadas con Logo", href:"/catalogo/cajas-personalizadas-logo"}, {name:"Acabados Especiales"}]}
  faqItems={[{question:"¿Qué es el barniz UV spot y cuándo se usa en packaging?", answer:"El barniz UV spot es una capa de barniz transparente de altísimo brillo aplicada solo en zonas específicas del diseño (spot = punto), como el logo, el nombre de la marca o un elemento decorativo. El contraste entre el área brillante y el resto impreso crea un efecto visual y táctil muy distintivo. Se cura con luz ultravioleta en milisegundos. Es el acabado más solicitado en perfumería, cosméticos, chocolates premium y electrónica de consumo porque añade percepción de valor al packaging sin cambiar el diseño base."}, {question:"¿Cuándo vale la pena invertir en laminado mate o brillante?", answer:"El laminado (film de polipropileno aplicado por calor sobre el impreso) protege la impresión contra humedad, rozaduras y manipulación, y mejora el aspecto visual. El brillante amplifica los colores y da sensación de lujo accesible; el mate da una apariencia sofisticada y moderna muy usada en moda, tecnología y gastronomía premium. Vale la pena cuando: el producto tiene precio de venta mayor a 200 pesos y el packaging forma parte de la decisión de compra; cuando el producto será exhibido en punto de venta; o cuando el cliente final recibirá la caja directamente (e-commerce premium, gifts)."}]}
  product={{name:"Caja Cartón Acabados Especiales Barniz UV Laminado", sku:"CAD-PL-04", description:"Caja Cartón Acabados Especiales Barniz UV Laminado en CDMX — fabricante directo CADECA", image:"/img/catalogo/cajas-carton-personalizadas-acabados-especiales-barniz-uv.avif", material:"Cartón corrugado con acabados UV laminado mate brillante troquelado", category:"Cajas de Cartón Personalizadas con Logo", moq:"500"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-personalizadas-logo">Personalizadas con Logo</a></li>
        <li><span class="current">Acabados Especiales</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-pl04-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-PL-04 · Personalizadas con Logo</span>
      <h1 id="sku-pl04-title" class="cat-page-hero__title">Cajas <span>Acabados Especiales</span><br>— Barniz UV · Laminado · Relieve</h1>
      <p class="cat-page-hero__desc">Barniz UV spot y total, laminado mate y brillante, troquelado y relieve seco. Para cosméticos, lujo, unboxing premium y productos con alto valor percibido. Desde 500 piezas.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-PL-04</strong></div>
        <div class="cat-page-hero__strip-item">Acabados: <strong>UV · Laminado · Relieve</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>500 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>10-15 días</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-pl04-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div>
            <div class="sku-detail__img-wrap">
              <img src="/img/catalogo/cajas-carton-personalizadas-acabados-especiales-barniz-uv.avif"
                alt="Cajas cartón acabados especiales barniz UV laminado relieve — CADECA CAD-PL-04"
                class="sku-detail__img" width="880" height="560" loading="eager" decoding="async" fetchpriority="high" />
            </div>
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-PL-04 · Familia: Personalizadas con Logo</p>
            <h2 id="detalle-pl04-title" class="sku-detail__title">Acabados Especiales — Barniz UV · Laminado · Relieve</h2>
            <p class="sku-detail__desc">Acabados premium sobre impresión offset CMYK o serigrafía. Barniz UV spot para resaltar logos y elementos clave. Laminado mate o brillante para protección y estética. Troquelado, relieve seco y hot stamping para el máximo impacto táctil y visual. Ideal para cosméticos, perfumería, chocolates premium y electrónica de consumo.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">UV · Laminado</span><span class="sku-detail__strip-label">Acabados</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Offset CMYK</span><span class="sku-detail__strip-label">Impresión base</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">500 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">10-15 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-PL-04 Acabados Especiales Barniz UV`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-PL-04</a>
              <a href="/catalogo/cajas-personalizadas-logo" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-pl04-title">
      <div class="container">
        <h2 id="sizes-pl04-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-PL-04</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
                  <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
                  <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"✓":"⏱"} {m.label}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Fabricamos cualquier medida personalizada desde 500 piezas. ⏱ Producción bajo pedido.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-pl04-title">
      <div class="container">
        <h2 id="faq-pl04-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-PL-04</h2>
        <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
      </div>
    </section>
  </main>
  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-PL-04 — Acabados premium, entrega 10-15 días" />
</PageLayout>
