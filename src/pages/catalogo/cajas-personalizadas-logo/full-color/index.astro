---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas Personalizadas Full Color | CADECA";
const description = "Cajas de cartón full color CMYK en CDMX. Impresión offset o digital de alta resolución, papel coated blanco, desde 200 piezas, entrega 7-10 días.";

const medidas = [
 { talla:"S", ml:"28×22×12 cm", real:"28×22×12", flauta:"C",ect:"ECT-32",vacío:"0.30 kg",máx:"8 kg", disp:"yellow", label:"7-10 días", hl:true },
 { talla:"M", ml:"38×30×18 cm", real:"38×30×18", flauta:"C",ect:"ECT-32",vacío:"0.48 kg",máx:"12 kg", disp:"yellow", label:"7-10 días", hl:true },
 { talla:"L", ml:"50×38×25 cm", real:"50×38×25", flauta:"BC",ect:"ECT-44",vacío:"0.82 kg",máx:"18 kg", disp:"yellow", label:"7-10 días", hl:false },
 { talla:"XL", ml:"60×45×30 cm", real:"60×45×30", flauta:"BC",ect:"ECT-44",vacío:"1.20 kg",máx:"25 kg", disp:"gray", label:"10-15 días", hl:false },
 { talla:"A la Medida", ml:"Personalizada", real:"A definir", flauta:"—",ect:"—",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
 ["Código SKU", "CAD-PL-03"],
 ["Tipo impresión", "Offset litográfico o digital"],
 ["Colores", "CMYK + Pantone especial opcional"],
 ["Papel exterior", "Kraft blanco coated 170g"],
 ["Resolución", "200 lpi offset / 720 dpi digital"],
 ["Acabados", "Barniz mate o brillante estándar"],
 ["Tipo de pared", "Simple ECT-32 o doble ECT-44"],
 ["Diseño", "Gratis — requiere archivo PDF CMYK"],
 ["Perfil de color", "ISO Coated V2"],
 ["Pedido mínimo", "200 piezas"],
 ["Entrega CDMX", "7-10 días hábiles"],
];

const faqs = [
 {
 id: "pl03-f1",
 question: "¿Cómo elijo la medida adecuada para cajas impresas full color?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "pl03-f2",
 question: "¿Qué resistencia de cartón conviene para cajas impresas full color?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "pl03-f3",
 question: "¿Se pueden personalizar cajas impresas full color con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "pl03-f4",
 question: "¿Cómo debo almacenar cajas impresas full color antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "pl03-f5",
 question: "¿Qué datos necesito para cotizar cajas impresas full color?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const mainImg = "/img/catalogo/cajas-carton-personalizadas-full-color-cmyk-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/cajas-carton-personalizadas-full-color-cmyk-cdmx.avif", alt: "Caja full color CMYK — principal" },
 { src: "/img/catalogo/caja-cmyk-hero-cdmx.avif", alt: "Full color CMYK — hero" },
 { src: "/img/catalogo/caja-cmyk-stack-cdmx.avif", alt: "Cajas CMYK — apiladas" },
 { src: "/img/catalogo/caja-cmyk-unboxing-cdmx.avif", alt: "Caja CMYK — experiencia unboxing" },
 { src: "/img/catalogo/caja-cmyk-detalle-cdmx.avif", alt: "Detalle impresión CMYK" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"Personalizadas con Logo", href:"/catalogo/cajas-personalizadas-logo/"}, {name:"Full Color CMYK"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja Cartón Full Color CMYK Impresión Offset", sku:"CAD-PL-03", description:"Caja Cartón Full Color CMYK Impresión Offset en CDMX — proveedor CADECA", image:"/img/catalogo/cajas-carton-personalizadas-full-color-cmyk-cdmx.avif", material:"Cartón corrugado simple kraft blanco coated impresión offset CMYK", category:"Cajas de Cartón Personalizadas con Logo", moq:"200"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Personalizadas con Logo</a></li>
 <li><span class="current">Full Color CMYK</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-pl03-title"
   eyebrow="Personalizadas · SKU CAD-PL-03"
   titleHtml={true}
   title="Cajas impresas a todo color <span>con CMYK</span>"
   desc="Cajas impresas a todo color para marcas que usan fotografías, degradados e ilustraciones en su empaque. Se cotizan para proyectos de presentación y venta en CDMX."
   desc2="La <strong>impresión CMYK</strong> puede realizarse en offset o digital sobre papel coated blanco, con resolución para fotografías, degradados e ilustraciones. Esta alternativa se adapta a cajas destinadas a productos cuyo arte requiere reproducir varios colores en toda la superficie.||Para <strong>impresión CMYK</strong>, el arte con fotografías, degradados o ilustraciones define la elección entre offset y digital. Para cotizar, envía el archivo gráfico, medidas de la caja, tipo de producto y cantidad; CADECA revisa el papel coated blanco y la configuración de impresión."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-pl03-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-PL-03 · Familia: Personalizadas con Logo</p>
 <h2 id="detalle-pl03-title" class="sku-detail__title">Caja Full Color CMYK — Offset / Digital</h2>
 <p class="sku-detail__desc">Impresión offset litográfico o digital de alta resolución sobre liner kraft blanco coated. Reproduce cualquier diseño: fotografías, degradados, ilustraciones, colores corporativos exactos. Acabado estándar con barniz mate o brillante incluido. Para marcas premium, e-commerce con experiencia de unboxing, o productos que compiten en punto de venta.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">CMYK Offset</span><span class="sku-detail__strip-label">Impresión</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">200 lpi</span><span class="sku-detail__strip-label">Resolución</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">200 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">7-10 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-PL-03 Caja Full Color CMYK`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-PL-03</a>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-pl03-title">
 <div class="container">
 <h2 id="sizes-pl03-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-PL-03</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
 <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Surtimos cualquier medida personalizada desde 200 piezas.  Producción coordinada bajo pedido.</p>
 </div>
 </section>

 </main>
 <FaqCotizacion faqs={faqs} tema="cajas impresas a todo color" />
</PageLayout>
