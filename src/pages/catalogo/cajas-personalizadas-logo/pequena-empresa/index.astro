---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas Personalizadas para Pequeña Empresa | CADECA";
const description = "Cajas de cartón personalizadas para pequeñas empresas en CDMX. Desde 100 piezas, diseño incluido sin costo, 1-2 colores, tiempo de entrega según pedido.";

const medidas = [
 { talla:"XS", ml:"20×15×10 cm", real:"20×15×10", flauta:"C",ect:"ECT-32",vacío:"0.18 kg",máx:"5 kg", disp:"yellow", label:"5-7 días", hl:false },
 { talla:"S", ml:"28×22×12 cm", real:"28×22×12", flauta:"C",ect:"ECT-32",vacío:"0.28 kg",máx:"8 kg", disp:"yellow", label:"5-7 días", hl:true },
 { talla:"M", ml:"38×30×18 cm", real:"38×30×18", flauta:"C",ect:"ECT-32",vacío:"0.45 kg",máx:"12 kg", disp:"yellow", label:"5-7 días", hl:true },
 { talla:"L", ml:"50×38×25 cm", real:"50×38×25", flauta:"C",ect:"ECT-32",vacío:"0.70 kg",máx:"18 kg", disp:"yellow", label:"5-7 días", hl:false },
 { talla:"A la Medida", ml:"Personalizada", real:"A definir", flauta:"C",ect:"ECT-32",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
 ["Código SKU", "CAD-PL-05"],
 ["Diseñado para", "PYME · Emprendedores · Inicio de marca"],
 ["Tipo impresión", "Flexo 1 o 2 colores"],
 ["Diseño incluido", "Sí — sin costo en 1 revisión"],
 ["Asesoría de selección", "Gratis — recomendamos medida ideal"],
 ["Resistencia ECT", "ECT-32 estándar"],
 ["Tipo de pared", "Simple corrugado flauta C"],
 ["Ajuste de medida", "Sin costo en primera orden"],
 ["Pago", "50% anticipo · 50% contra entrega"],
 ["Pedido mínimo", "100 piezas"],
 ["Entrega CDMX", "5-7 días hábiles"],
 ["Colores disponibles", "Kraft marrón · Kraft blanco"],
];

const faqs = [
 {
 id: "pl05-f1",
 question: "¿Cómo elijo la medida adecuada para cajas personalizadas para pequeña empresa?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "pl05-f2",
 question: "¿Qué resistencia de cartón conviene para cajas personalizadas para pequeña empresa?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "pl05-f3",
 question: "¿Se pueden personalizar cajas personalizadas para pequeña empresa con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "pl05-f4",
 question: "¿Cómo debo almacenar cajas personalizadas para pequeña empresa antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "pl05-f5",
 question: "¿Qué datos necesito para cotizar cajas personalizadas para pequeña empresa?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const mainImg = "/img/catalogo/cajas-carton-personalizadas-pequenas-empresas-100-piezas.avif";
const gallery = [
 { src: "/img/catalogo/cajas-carton-personalizadas-pequenas-empresas-100-piezas.avif", alt: "Cajas PyME — principal" },
 { src: "/img/catalogo/caja-pyme-hero-cdmx.avif", alt: "Cajas PyME — hero" },
 { src: "/img/catalogo/caja-pyme-despacho-cdmx.avif", alt: "Cajas PyME — despacho" },
 { src: "/img/catalogo/caja-pyme-stack-cdmx.avif", alt: "Cajas PyME — apiladas" },
 { src: "/img/catalogo/caja-pyme-uso-cdmx.avif", alt: "Caja PyME — en uso real" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"Personalizadas con Logo", href:"/catalogo/cajas-personalizadas-logo/"}, {name:"Pequeña Empresa"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Cajas Cartón Personalizadas Pequeña Empresa", sku:"CAD-PL-05", description:"Cajas Cartón Personalizadas Pequeña Empresa en CDMX — proveedor CADECA", image:"/img/catalogo/cajas-carton-personalizadas-pequenas-empresas-100-piezas.avif", material:"Cartón corrugado simple ECT-32 impresión flexo 1-2 colores para PyME", category:"Cajas de Cartón Personalizadas con Logo", moq:"100"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-personalizadas-logo/">Personalizadas con Logo</a></li>
 <li><span class="current">Pequeña Empresa</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-pl05-title"
   eyebrow="Personalizadas · SKU CAD-PL-05"
   titleHtml={true}
   title="Cajas personalizadas para pequeñas empresas <span>con logo</span>"
   desc="Cajas personalizadas para pequeñas empresas que requieren integrar logo en pedidos desde 100 piezas. Sirven para productos, tiendas y envíos en CDMX y Estado de México."
   desc2="Se surte en cartón corrugado simple, flauta C y ECT-32 con impresión flexográfica de uno o dos colores. Hay medidas estándar y opciones a la medida desde 100 piezas, para que las <strong>cajas con logo</strong> correspondan al tamaño y uso de cada producto.||CADECA coordina el suministro como proveedor para negocios pequeños. Comparte medidas, cantidad, uso y zona de entrega al solicitar cotización; te asesoramos para elegir la flauta, el tipo de cartón y la impresión de acuerdo con tu pedido."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-pl05-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-PL-05 · Familia: Personalizadas con Logo</p>
 <h2 id="detalle-pl05-title" class="sku-detail__title">Cajas Personalizadas — Pequeña Empresa desde 100 Pzas</h2>
 <p class="sku-detail__desc">Programa especial para PyMEs y emprendedores que quieren personalizar su empaque desde la primera orden. Diseño vectorizado incluido sin costo, asesoría de selección de medida gratis, impresión flexo 1 o 2 colores sobre kraft marrón o blanco. Pago flexible: 50% anticipo y 50% contra entrega.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">1-2 colores</span><span class="sku-detail__strip-label">Impresión</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Incluido</span><span class="sku-detail__strip-label">Diseño</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5-7 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-PL-05 Cajas Pequeña Empresa`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-PL-05</a>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-pl05-title">
 <div class="container">
 <h2 id="sizes-pl05-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-PL-05</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
 <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas estándar disponibles. Surtimos cualquier medida personalizada desde 100 piezas.  Producción coordinada bajo pedido.</p>
 </div>
 </section>

 </main>
 <FaqCotizacion faqs={faqs} tema="cajas personalizadas para pequeñas empresas" />
</PageLayout>
