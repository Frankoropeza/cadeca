---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja Archivo Transición Digital Digitalización CDMX | CAD-AH-10 | CADECA";
const description = "Caja de archivo para transición digital y digitalización de documentos en CDMX. Resistente, etiquetado completo, compatible con carros de archivo. MOQ 50 pzas. CADECA.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU", "CAD-AH-10"],
 ["Uso", "Transición digital / archivo"],
 ["Etiquetado", "Completo: caja/área/estado"],
 ["Compatibilidad", "Carros de archivo estándar"],
 ["Resistencia", "ECT-32"],
 ["Cierre", "Tapa independiente"],
 ["Tamaño", "Oficio y carta"],
 ["Pedido mínimo", "50 piezas"],
 ["Entrega CDMX", "24 hrs en stock"],
];

const faqs = [
 { id:"cad-ah-10-f1", question:"¿La caja puede marcarse con plumón y borrarse para reutilización?", answer:"Para el proceso de digitalización, generalmente las cajas se usan una vez por lote de documentos. Sin embargo, el liner kraft es compatible con etiquetas adhesivas removibles que pueden cambiarse sin dañar la caja. Para etiquetado permanente, usamos marcadores industriales que adhieren bien al kraft." },
 { id:"cad-ah-10-f2", question:"¿Tienen algún sistema de folio o numeración para las cajas?", answer:"No incluimos numeración de serie en el producto estándar, pero podemos producir cajas con numeración preimpresa secuencial bajo pedido especial (MOQ 500 piezas). Para proyectos de transición digital, muchos clientes usan etiquetas de código de barras generadas por su propio sistema de gestión documental." },
 { id:"cad-ah-10-f3", question:"¿Puedo usar estas cajas para el traslado final al archivo muerto?", answer:"Sí. CAD-AH-10 es compatible con el protocolo de archivo muerto según la NOM-004 de IMSS y las guías de archivo del AGN. La resistencia ECT-32 soporta el apilado de 4 a 5 cajas llenas de papel, que es el estándar para archivo muerto en bodegas climatizadas. Para almacenaje de más de 5 años, recomendamos condiciones de humedad relativa menor al 55%." },
];

const gallery = [
 { src: "/img/catalogo/caja-archivo-oficio-hero-cdmx.avif", alt: "Caja archivo transición digital CDMX" },
 { src: "/img/catalogo/caja-archivo-oficio-interior-cdmx.avif", alt: "Interior archivo digitalización" },
 { src: "/img/catalogo/caja-documentos-carta-despacho-cdmx.avif", alt: "Despacho archivo transición digital" },
 { src: "/img/catalogo/caja-mudanza-archivo-corporativo-cdmx.avif", alt: "Traslado archivo corporativo" },
 { src: "/img/catalogo/caja-archivo-oficio-sala-cdmx.avif", alt: "Sala digitalización archivos" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas de Archivo y Almacenaje",href:"/catalogo/cajas-archivo-almacenaje"},{name:"Caja de Archivo para Transición Digital"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja de Archivo para Transición Digital",sku:"CAD-AH-10",description:"Caja diseñada para el proceso de transición digital: resguarda documentos físicos durante la digitalización con etiquetado completo y compatible con carros de traslado.",image:gallery[0].src,material:"CAD-AH-10",category:"Cajas de Archivo y Almacenaje",moq:"50 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-archivo-almacenaje">Cajas de Archivo y Almacenaje</a></li>
 <li><span class="current">Caja de Archivo para Transición Digital</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-cadah10-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-AH-10 · Cajas de Archivo y Almacenaje</span>
 <h1 id="sku-cadah10-title" class="cat-page-hero__title">Caja de Archivo para <span>Transición Digital</span> — Digitalización CDMX</h1>
 <p class="cat-page-hero__desc">Caja diseñada para el proceso de transición digital: resguarda documentos físicos durante la digitalización con etiquetado completo y compatible con carros de traslado.</p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AH-10</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>50 piezas</strong></div>
 <div class="cat-page-hero__strip-item">Fabricante: <strong>Directo</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadah10-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AH-10 · Familia: Cajas de Archivo y Almacenaje</p>
 <h2 id="detalle-cadah10-title" class="sku-detail__title">Caja de Archivo para Transición Digital</h2>
 <p class="sku-detail__desc">La digitalización masiva de archivos físicos es un proceso que puede durar meses o años y requiere un sistema de cajas que permita identificar el contenido, rastrear el estado del proceso (pendiente/en proceso/digitalizado) y mover grandes volúmenes de documentos entre áreas o instalaciones sin riesgo de daño. CAD-AH-10 tiene diseño específico con zonas de etiquetado para número de caja, área, contenido, estado de digitalización y responsable del proceso.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Transición</span><span class="sku-detail__strip-label">Digital</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Etiquetado</span><span class="sku-detail__strip-label">Completo</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AH-10 Caja de Archivo para Transición Digital`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AH-10</a>
 <a href="/catalogo/cajas-archivo-almacenaje" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-cadah10-title">
 <div class="container">
 <h2 id="faq-cadah10-title" class="sku-faq__title">Preguntas Frecuentes — Caja de Archivo para Transición Digital</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="¿Estás digitalizando tu archivo físico? Cotiza las cajas con sistema de etiquetado para trazabilidad" />
</PageLayout>
