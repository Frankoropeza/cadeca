---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja de Almacenaje para Farmacia y Hospital | CADECA";
const description = "Caja de almacenaje para farmacia y hospital en CDMX. Corrugado blanco BPM, compatible COFEPRIS, apilable en racks selectivos. MOQ 100 pzas.";

const specs = [
 ["Código SKU", "CAD-AH-07"],
 ["Liner", "Blanco alta blancura"],
 ["Certificación", "Compatible BPM COFEPRIS"],
 ["Sin tintas", "Interior libre de químicos"],
 ["Apilado", "Racks selectivos estándar"],
 ["Etiquetado", "Frontal y lateral visible"],
 ["Resistencia", "ECT-32 apilable 1.2m"],
 ["Pedido mínimo", "100 piezas"],
 ["Entrega CDMX", "Según pedido"],
];

const faqs = [
 { id:"cad-ah-07-f1", question:"¿La caja tiene alguna certificación COFEPRIS?", answer:"Una caja de cartón no sustituye los requisitos sanitarios aplicables al medicamento o a su envase primario. Para uso como empaque secundario o terciario, define con tu área responsable las condiciones de identificación, manejo y resguardo necesarias." },
 { id:"cad-ah-07-f2", question:"¿Cuáles son las dimensiones estándar para racks farmacéuticos?", answer:"Las medidas más comunes en bodegas farmacéuticas en CDMX son: 60×40×30 cm y 40×30×20 cm. CAD-AH-07 tiene estas dos medidas en stock. Para racks con especificaciones distintas, coordinamos la medida con talleres especializados según pedido. Consulta las dimensiones internas de tu rack al solicitar cotización." },
 { id:"cad-ah-07-f3", question:"¿Puedo imprimir etiquetas adhesivas que peguen bien en el liner blanco?", answer:"Sí. El liner blanco de alta blancura de CAD-AH-07 es compatible con etiquetas adhesivas de papel y polipropileno. Las impresoras de etiquetas térmicas (Zebra, Datamax) producen etiquetas que adhieren perfectamente a esta superficie. El liner blanco también es compatible con rotulado directo con marcadores industriales." },
 { id:"cad-ah-07-f4", question:"¿Cómo se elige una caja para almacenar insumos de farmacia?", answer:"La elección considera dimensiones, peso, acomodo, rotación y condiciones de almacenaje de los insumos. El cartón funciona como empaque secundario o terciario cuando el producto tiene su envase primario correspondiente." },
 { id:"cad-ah-07-f5", question:"¿Qué datos necesito para cotizar cajas para farmacia u hospital?", answer:"Comparte medidas, peso, cantidad, tipo de insumo y condiciones de traslado o resguardo. Si requieres identificación impresa o zonas de etiqueta, inclúyelo para revisar el material y formato adecuados." },
];

const gallery = [
 { src: "/img/catalogo/caja-documentos-carta-hero-cdmx.avif", alt: "Caja almacenaje farmacia hospital CDMX" },
 { src: "/img/catalogo/caja-documentos-carta-interior-cdmx.avif", alt: "Interior almacenaje farmacéutico" },
 { src: "/img/catalogo/caja-almacen-industrial-rack-cdmx.avif", alt: "Rack farmacéutico almacenaje" },
 { src: "/img/catalogo/caja-documentos-carta-stack-cdmx.avif", alt: "Apilado cajas farmacia" },
 { src: "/img/catalogo/caja-archivo-oficio-sala-cdmx.avif", alt: "Sala almacenaje farmacia" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas de Archivo y Almacenaje",href:"/catalogo/cajas-archivo-almacenaje/"},{name:"Caja de Almacenaje para Farmacia y Hospital"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja de Almacenaje para Farmacia y Hospital",sku:"CAD-AH-07",description:"Caja de almacenaje corrugado blanco compatible con BPM COFEPRIS para farmacias y hospitales. Apilable en racks selectivos, etiquetado visible, desde 100 piezas en CDMX.",image:gallery[0].src,material:"CAD-AH-07",category:"Cajas de Archivo y Almacenaje",moq:"100 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-archivo-almacenaje/">Cajas de Archivo y Almacenaje</a></li>
 <li><span class="current">Caja de Almacenaje para Farmacia y Hospital</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadah07-title"
   eyebrow="Archivo y almacenaje · SKU CAD-AH-07"
   titleHtml={true}
   title="Cajas de almacenaje para <span>farmacia y hospital</span>"
   desc="Cajas de almacenaje para farmacia y hospital en corrugado blanco, con etiquetado visible y uso en racks selectivos. Son una alternativa para organizar insumos por área."
   desc2="Las <strong>cajas para insumos médicos</strong> se presentan en corrugado blanco, con etiquetado visible y posibilidad de apilarse en racks selectivos. La especificación se revisa con el tipo de insumo, su presentación y los requerimientos operativos de cada área.||CADECA coordina el suministro como proveedor. Indica medidas, cantidad, uso y zona de entrega en CDMX o Estado de México para cotizar. El equipo asesora al elegir la caja de acuerdo con la organización, el resguardo y manejo de los insumos."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadah07-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AH-07 · Familia: Cajas de Archivo y Almacenaje</p>
 <h2 id="detalle-cadah07-title" class="sku-detail__title">Caja de Almacenaje para Farmacia y Hospital</h2>
 <p class="sku-detail__desc">Las farmacias y hospitales tienen requerimientos específicos de almacenaje que van más allá del peso y las medidas: deben cumplir con las Buenas Prácticas de Manufactura (BPM) según COFEPRIS, usar materiales que no contaminen medicamentos y facilitar el sistema FIFO en racks. CAD-AH-07 usa liner blanco de alta blancura sin tintas tóxicas, apilable en racks selectivos estándar, con área frontal y lateral para etiquetado de producto y fecha de caducidad.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">BPM</span><span class="sku-detail__strip-label">COFEPRIS</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Blanco</span><span class="sku-detail__strip-label">Liner</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Según pedido</span><span class="sku-detail__strip-label">CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-AH-07 Caja de Almacenaje para Farmacia y Hospital`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-AH-07</a>
 <a href="/catalogo/cajas-archivo-almacenaje/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas de almacenaje para farmacia y hospital" />
</PageLayout>
