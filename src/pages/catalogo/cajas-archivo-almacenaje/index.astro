---
import PageLayout    from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture   from "@/components/LeadCapture.astro";

const title       = "Cajas de Archivo y Almacenaje CDMX | 5 Productos | CADECA";
const description = "Cajas de cartón para archivo muerto, almacén industrial y almacenaje en CDMX. Tamaño oficio, carta, apilables y mudanza. Fichas técnicas, medidas y precios mayoreo.";
const WHATSAPP    = "5255XXXXXXXX";

const productos = [
  {
    code:    "CAD-AH-01",
    badge:   "Más vendida",
    badgeColor: "orange",
    featured: true,
    title:   "Archivo Muerto Tamaño Oficio",
    desc:    "Caja estándar para archivo muerto tamaño oficio. Flauta C, ECT-32. Tapa integrada o separada. La solución más usada en oficinas, despachos y archivos corporativos en CDMX. Sin pedido mínimo.",
    imgSrc:  "/img/catalogo/caja-archivo-muerto-oficio-corporativo-cdmx.avif",
    imgAlt:  "Caja archivo muerto tamaño oficio cartón corrugado CDMX — CADECA",
    href:    "/catalogo/cajas-archivo-almacenaje/archivo-muerto-oficio",
    specs: [
      { label: "Tamaño",     value: "Oficio (legal)" },
      { label: "ECT",        value: "ECT-32" },
      { label: "Flauta",     value: "C (4mm)" },
      { label: "Peso máx.",  value: "Hasta 20 kg" },
    ],
    moq: "Sin mínimo",
  },
  {
    code:    "CAD-AH-02",
    badge:   "Industrial",
    badgeColor: "red",
    featured: false,
    title:   "Almacén Industrial — Doble Pared",
    desc:    "Caja de almacén industrial doble pared BC. ECT-44 y ECT-51 para almacenaje pesado en racks, bodegas y centros de distribución. Resistencia superior al apilamiento prolongado.",
    imgSrc:  "/img/catalogo/caja-almacen-industrial-triple-pared-cdmx.avif",
    imgAlt:  "Caja almacén industrial doble pared corrugado CDMX — CADECA",
    href:    "/catalogo/cajas-archivo-almacenaje/almacen-industrial",
    specs: [
      { label: "Pared",      value: "Doble (BC)" },
      { label: "ECT",        value: "ECT-44 / ECT-51" },
      { label: "Flauta",     value: "BC" },
      { label: "Peso máx.",  value: "Hasta 35 kg" },
    ],
    moq: "50 pzas",
  },
  {
    code:    "CAD-AH-03",
    badge:   "Oficina",
    badgeColor: "blue",
    featured: false,
    title:   "Documentos Tamaño Carta",
    desc:    "Caja para documentos tamaño carta. Flauta B/C, ECT-32. Compacta y ligera para oficinas con espacio limitado. Tapa integrada con ranuras de identificación. Sin mínimo, stock permanente.",
    imgSrc:  "/img/catalogo/caja-documentos-carta-despacho-cdmx.avif",
    imgAlt:  "Caja documentos tamaño carta cartón corrugado CDMX — CADECA",
    href:    "/catalogo/cajas-archivo-almacenaje/documentos-carta",
    specs: [
      { label: "Tamaño",     value: "Carta (letter)" },
      { label: "ECT",        value: "ECT-32" },
      { label: "Flauta",     value: "B / C" },
      { label: "Peso máx.",  value: "Hasta 15 kg" },
    ],
    moq: "Sin mínimo",
  },
  {
    code:    "CAD-AH-04",
    badge:   "Resistente",
    badgeColor: "red",
    featured: false,
    title:   "Apilable Resistente — Triple Pared",
    desc:    "Caja apilable de triple pared BCB/BCF. ECT-51 y ECT-71 para almacenaje prolongado con máxima resistencia a la compresión. Ideal para bodegas industriales y archivos de largo plazo.",
    imgSrc:  "/img/catalogo/caja-apilable-resistente-triple-pared-cdmx.avif",
    imgAlt:  "Caja apilable resistente triple pared corrugado CDMX — CADECA",
    href:    "/catalogo/cajas-archivo-almacenaje/apilable-resistente",
    specs: [
      { label: "Pared",      value: "Triple (BCB/BCF)" },
      { label: "ECT",        value: "ECT-51 / ECT-71" },
      { label: "Flauta",     value: "BCB · BCF" },
      { label: "Peso máx.",  value: "+40 kg" },
    ],
    moq: "50 pzas",
  },
  {
    code:    "CAD-AH-05",
    badge:   "Con asas",
    badgeColor: "green",
    featured: false,
    title:   "Mudanza y Archivo — Con Asas",
    desc:    "Caja doble uso para mudanza y archivo con asas troqueladas. Doble pared BC, ECT-44. Diseño ergonómico para manejo manual frecuente. Sin mínimo, stock permanente en CDMX.",
    imgSrc:  "/img/catalogo/caja-mudanza-archivo-corporativo-cdmx.avif",
    imgAlt:  "Caja mudanza y archivo con asas cartón corrugado CDMX — CADECA",
    href:    "/catalogo/cajas-archivo-almacenaje/mudanza-archivo",
    specs: [
      { label: "Pared",      value: "Doble (BC) + Asas" },
      { label: "ECT",        value: "ECT-44" },
      { label: "Flauta",     value: "BC" },
      { label: "Peso máx.",  value: "Hasta 25 kg" },
    ],
    moq: "Sin mínimo",
  },
];
---

<PageLayout title={title} description={description} whatsapp={WHATSAPP}>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Catálogo</a></li>
      <li><span class="current">Archivo y Almacenaje</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="cat-ah-hub-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">🗄️ Categoría 09 · 5 productos</span>
      <h1 id="cat-ah-hub-title" class="cat-page-hero__title">
        Cajas de Archivo <span>y Almacenaje</span>
      </h1>
      <p class="cat-page-hero__desc">
        Archivo muerto oficio, documentos carta, almacén industrial y cajas apilables. Línea especializada en organización documental y almacenaje prolongado. Stock permanente en CDMX, sin pedido mínimo en modelos estándar.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">Productos: <strong>5</strong></div>
        <div class="cat-page-hero__strip-item">MOQ desde: <strong>Sin mínimo</strong></div>
        <div class="cat-page-hero__strip-item">Entrega CDMX: <strong>24-48 hrs</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-32 a ECT-71</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" aria-labelledby="prods-ah-title">
      <div class="container">
        <SectionHeader
          id="prods-ah-title"
          twoCol
          title="5 Productos — Archivo y Almacenaje"
          subtitle="Selecciona el producto para ver ficha técnica completa con medidas, especificaciones ECT y condiciones de pedido."
          link={{ text: "← Volver al catálogo", href: "/catalogo" }}
        >
          <p>Cada producto tiene su propia ficha técnica con tabla de medidas disponibles, especificaciones de material, resistencia ECT, flauta, gramaje, peso máximo y condiciones de pedido. Haz clic en cualquier producto para ver todos los detalles.</p>
        </SectionHeader>

        <div class="sku-grid">
          {productos.map(p => (
            <article class={`sku-card${p.featured ? " sku-card--featured" : ""}`}>
              <div class="sku-card__img-wrap">
                <img src={p.imgSrc} alt={p.imgAlt}
                  class="sku-card__img" width="640" height="480"
                  loading="lazy" decoding="async" />
                <span class="sku-card__code">{p.code}</span>
                <span class={`sku-card__badge sku-card__badge--${p.badgeColor}`}>{p.badge}</span>
              </div>
              <div class="sku-card__body">
                <h2 class="sku-card__name">{p.title}</h2>
                <p class="sku-card__desc">{p.desc}</p>
                <div class="sku-card__specs">
                  {p.specs.map(s => (
                    <div>
                      <span class="sku-card__spec-label">{s.label}</span>
                      <span class="sku-card__spec-value">{s.value}</span>
                    </div>
                  ))}
                </div>
                <div class="sku-card__footer">
                  <a href={p.href} class="btn btn--primary">Ver ficha técnica</a>
                  <span class="sku-card__moq">MOQ: {p.moq}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="¿Necesitas cajas de archivo o almacenaje? Nuestro asesor responde en menos de 2 horas" />

</PageLayout>
