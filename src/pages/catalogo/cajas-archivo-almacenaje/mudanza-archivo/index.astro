---
import PageLayout   from "@/layouts/PageLayout.astro";
import FaqItem      from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title   = "Caja Mudanza y Archivo con Asas CDMX | CAD-AH-05 | CADECA";
const description = "Ficha técnica caja mudanza y archivo con asas troqueladas en CDMX. Doble pared BC, ECT-44, dual-purpose. 6 medidas disponibles. Sin mínimo, entrega 24-48 hrs. CADECA fabricante.";
const WHATSAPP = "5255XXXXXXXX";

const medidas = [
  { nombre:"Chica",              lah:"35×25×30",  flauta:"BC", ect:"ECT-44",vacío:"0.65 kg",máx:"20 kg", disp:"green",  label:"Stock" },
  { nombre:"Mediana",            lah:"45×35×35",  flauta:"BC", ect:"ECT-44",vacío:"0.95 kg",máx:"25 kg", disp:"green",  label:"Stock", hl:true },
  { nombre:"Grande",             lah:"55×40×40",  flauta:"BC", ect:"ECT-44",vacío:"1.30 kg",máx:"25 kg", disp:"green",  label:"Stock" },
  { nombre:"Extra Grande",       lah:"65×50×45",  flauta:"BC", ect:"ECT-44",vacío:"1.75 kg",máx:"25 kg", disp:"yellow", label:"48 hrs" },
  { nombre:"Libros/Documentos",  lah:"45×35×25",  flauta:"BC", ect:"ECT-44",vacío:"0.82 kg",máx:"25 kg", disp:"green",  label:"Stock" },
  { nombre:"A la Medida",        lah:"Cualquier", flauta:"A elegir",ect:"A elegir",vacío:"—",máx:"—",    disp:"gray",   label:"3-5 días" },
];

const specs = [
  ["Código SKU",             "CAD-AH-05"],
  ["Tipo de caja",           "Mudanza y archivo con asas troqueladas"],
  ["Uso",                    "Dual: mudanza + archivo permanente"],
  ["Construcción",           "Doble pared (2 flautas + 3 liners)"],
  ["Tipo de flauta",         "BC (B 2.5 mm + C 4.0 mm = 6.5 mm)"],
  ["Resistencia ECT",        "ECT-44 lb/pulg"],
  ["Gramaje liner exterior", "170 g/m² kraft"],
  ["Gramaje liner interior", "170 g/m² kraft"],
  ["Gramaje médium",         "150 g/m² (doble capa)"],
  ["Material",               "Kraft corrugado doble pared"],
  ["Color exterior",         "Kraft marrón natural"],
  ["Asas",                   "Troqueladas reforzadas con doble pestaña (4 pzas)"],
  ["Cierre",                 "Solapas RSC con interlock"],
  ["Armado",                 "Fácil armado sin pegamento ni cinta (auto-lock)"],
  ["Peso máximo soportado",  "20 – 25 kg según medida"],
  ["Apilamiento máximo",     "5 niveles cargadas"],
  ["Resistencia a compresión (BCT)", "≥ 450 kgf"],
  ["Área de etiquetado",     "Zona impresa para identificación por área"],
  ["Reutilización estimada", "3 – 5 usos con manejo adecuado"],
  ["Pedido mínimo",          "Sin mínimo (stock)"],
  ["Tiempo de entrega",      "24-48 hrs stock · 3-5 días especial"],
];

const faqs = [
  {
    id:"ah05-f1",
    question:"¿Cuánto peso soportan las asas de la caja de mudanza CAD-AH-05?",
    answer:"Las asas troqueladas reforzadas con <strong>doble pestaña</strong> soportan hasta <strong>25 kg de carga sin desgarre</strong>. Están diseñadas con un corte ergonómico que <strong>distribuye el peso en una superficie mayor de la mano</strong>, reduciendo la fatiga durante la carga y descarga. Cada caja tiene <strong>4 asas (2 por lado corto)</strong> para manejo por una o dos personas. Para cargas superiores a 20 kg, recomendamos que dos personas manipulen la caja.",
  },
  {
    id:"ah05-f2",
    question:"¿Las cajas CAD-AH-05 sirven para archivo permanente después de la mudanza?",
    answer:"Sí, ese es el diseño <strong>dual-purpose</strong> de esta caja. Después de la mudanza, puede almacenar documentos, materiales de oficina o inventario de manera permanente. La construcción <strong>doble pared BC con ECT-44</strong> garantiza resistencia suficiente para <strong>almacenamiento prolongado mayor a 2 años</strong> en condiciones controladas. La medida <strong>Libros/Documentos (45×35×25 cm)</strong> está específicamente optimizada para archivo a largo plazo.",
  },
  {
    id:"ah05-f3",
    question:"¿Cómo organizo las cajas por zona o departamento durante la mudanza?",
    answer:"Cada caja CAD-AH-05 incluye una <strong>zona impresa lateral para identificación</strong>. Recomendamos un sistema de <strong>etiquetas por colores</strong>: rojo para dirección, azul para administración, verde para operaciones, amarillo para TI y naranja para áreas comunes. También puede <strong>numerar cada caja</strong> y llevar un inventario en hoja de cálculo con el contenido detallado para facilitar la ubicación en el nuevo espacio.",
  },
  {
    id:"ah05-f4",
    question:"¿Las cajas de mudanza con asas son reutilizables?",
    answer:"Sí. La construcción <strong>doble pared BC con ECT-44</strong> permite entre <strong>3 y 5 usos con manejo adecuado</strong>. Para maximizar la vida útil, recomendamos <strong>armar y desarmar siguiendo las líneas de doblez</strong>, evitar exposición a lluvia directa y almacenar desarmadas en posición vertical cuando no estén en uso. El sistema <strong>auto-lock no requiere pegamento ni cinta</strong>, facilitando el armado y desarmado repetido.",
  },
  {
    id:"ah05-f5",
    question:"¿Qué medida es mejor para libros y documentos pesados?",
    answer:"Para libros y documentos pesados, recomendamos la medida <strong>Libros/Documentos (45×35×25 cm)</strong> o la <strong>Chica (35×25×30 cm)</strong>. Estas medidas limitan el volumen interior para que el <strong>peso total no exceda los 20-25 kg</strong>, haciendo la caja manejable por una persona. Evite la medida Grande o Extra Grande para libros, ya que al llenarla completamente superaría el peso cómodo de carga manual.",
  },
  {
    id:"ah05-f6",
    question:"¿Cuál es el tiempo de entrega para mudanza corporativa urgente?",
    answer:"Para presentaciones en stock <strong>(Chica, Mediana, Grande y Libros/Documentos)</strong>, la entrega es de <strong>24 a 48 horas hábiles</strong> en toda la zona metropolitana de la CDMX. Para pedidos urgentes el mismo día, <strong>consulte disponibilidad por WhatsApp</strong>. La medida <strong>Extra Grande</strong> requiere <strong>48 horas de producción</strong>. Las medidas a la medida se fabrican en <strong>3 a 5 días hábiles</strong>.",
  },
];

const mainImg = "/img/catalogo/caja-mudanza-archivo-corporativo-cdmx.avif";
const gallery = [
  { src: "/img/catalogo/caja-mudanza-archivo-corporativo-cdmx.avif", alt: "Mudanza corporativa — principal" },
  { src: "/img/catalogo/caja-mudanza-corporativa-hero-cdmx.avif", alt: "Mudanza corporativa — hero" },
  { src: "/img/catalogo/caja-mudanza-corporativa-lobby-cdmx.avif", alt: "Lobby corporativo — elegante" },
  { src: "/img/catalogo/caja-mudanza-corporativa-stack-cdmx.avif", alt: "Cajas mudanza — apiladas" },
  { src: "/img/catalogo/caja-mudanza-corporativa-interior-cdmx.avif", alt: "Interior con partición" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"Archivo y Almacenaje", href:"/catalogo/cajas-archivo-almacenaje"}, {name:"Mudanza y Archivo"}]}
  faqItems={faqs.map(f=>({question:f.question,answer:f.answer.replace(/<[^>]+>/g,'')}))}
  product={{name:"Caja Mudanza y Archivo con Asas", sku:"CAD-AH-05", description:"Caja doble uso mudanza y archivo con asas troqueladas, doble pared BC ECT-44 — CADECA CDMX", image:"/img/catalogo/caja-mudanza-archivo-corporativo-cdmx.avif", material:"Cartón kraft corrugado doble pared BC ECT-44", category:"Cajas de Archivo y Almacenaje", moq:"1"}}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Catálogo</a></li>
      <li><a href="/catalogo/cajas-archivo-almacenaje">Archivo y Almacenaje</a></li>
      <li><span class="current">Mudanza y Archivo</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-ah05-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-AH-05 · Archivo y Almacenaje</span>
      <h1 id="sku-ah05-title" class="cat-page-hero__title">
        Caja Mudanza y Archivo con Asas<br><span>Doble Pared BC — CDMX</span>
      </h1>
      <p class="cat-page-hero__desc">
        Caja doble uso para mudanza y archivo con asas troqueladas reforzadas de doble pestaña. Cartón corrugado doble pared BC con ECT-44. Diseño ergonómico para manejo manual frecuente, sistema auto-lock sin pegamento. Sin mínimo, stock permanente en CDMX.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AH-05</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-44</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>Sin mínimo</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24-48 hrs</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">

    <section class="sku-detail" aria-labelledby="detalle-ah05-title">
      <div class="container">
        <div class="sku-detail__grid">

          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>

          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-AH-05 · Familia: Archivo y Almacenaje</p>
            <h2 id="detalle-ah05-title" class="sku-detail__title">Mudanza y Archivo — Con Asas Doble Pared BC</h2>
            <p class="sku-detail__desc">
              Caja de doble uso para mudanza y archivo fabricada en cartón kraft corrugado doble pared con flauta BC (6.5 mm de espesor). Resistencia ECT-44 y BCT superior a 450 kgf. Cuenta con 4 asas troqueladas reforzadas con doble pestaña ergonómica que soportan hasta 25 kg sin desgarre. Sistema de armado auto-lock que no requiere pegamento ni cinta. Disponible en 5 tamaños: desde Chica (35×25×30 cm) hasta Extra Grande (65×50×45 cm), más la medida Libros/Documentos (45×35×25 cm) optimizada para archivo. Reutilizable de 3 a 5 veces con manejo adecuado.
            </p>

            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">ECT-44</span>
                <span class="sku-detail__strip-label">Resistencia</span>
              </div>
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">25 kg</span>
                <span class="sku-detail__strip-label">Peso máx.</span>
              </div>
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">Sin mín.</span>
                <span class="sku-detail__strip-label">Pedido</span>
              </div>
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">24 hrs</span>
                <span class="sku-detail__strip-label">Entrega CDMX</span>
              </div>
            </div>

            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table">
              <tbody>
                {specs.map(([label, val]) => (
                  <tr><td>{label}</td><td>{val}</td></tr>
                ))}
              </tbody>
            </table>

            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AH-05 Mudanza y Archivo con Asas`}
                 target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AH-05</a>
              <a href="/catalogo/cajas-archivo-almacenaje" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-ah05-title">
      <div class="container">
        <h2 id="sizes-ah05-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">
          Medidas Disponibles — CAD-AH-05
        </h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead>
              <tr>
                <th>Tamaño</th>
                <th>L × A × H (cm)</th>
                <th>Flauta</th>
                <th>ECT</th>
                <th>Peso vacío</th>
                <th>Peso máx.</th>
                <th>Disponibilidad</th>
              </tr>
            </thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td>{m.nombre}</td>
                  <td><strong>{m.lah}</strong></td>
                  <td>{m.flauta}</td>
                  <td>{m.ect}</td>
                  <td>{m.vacío}</td>
                  <td><strong>{m.máx}</strong></td>
                  <td>
                    <span class={`stock-chip stock-chip--${m.disp}`}>
                      {m.disp==="green"?"✓":m.disp==="yellow"?"⏱":"○"} {m.label}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">
          ✓ Stock permanente · ⏱ Producción rápida · ○ Pedido especial — 3 a 5 días hábiles. Pesos bajo condiciones estándar: 20°C y 50% HR.
        </p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-ah05-title">
      <div class="container">
        <h2 id="faq-ah05-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">
          Preguntas Técnicas — CAD-AH-05
        </h2>
        <div class="faq__list">
          {faqs.map(f => <FaqItem {...f} />)}
        </div>
      </div>
    </section>

  </main>

  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-AH-05 — Sin mínimo, entrega 24-48 hrs en CDMX" />

</PageLayout>
