---
// Hub «Cajas de cartón para regalo» — plantilla homologada de categoría.
// Datos: src/data/catalogo/regalo.ts · Estructura definida con Ahrefs MX (2026-09-28).
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import { categoria, fichas } from "@/data/catalogo/regalo";

const title = "Cajas de Regalo de Cartón por Mayoreo | CADECA";
const description = "Cajas de regalo de cartón por mayoreo: sorpresa, navideñas, para dulces, vino, grandes, con tapa, magnéticas y corporativas. Cotiza con o sin logo.";
const url = `https://cajas-de-carton.com${categoria.href}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${url}#webpage`,
  name: title,
  url,
  description,
  about: { "@id": "https://cajas-de-carton.com/#org" },
  isPartOf: { "@id": "https://cajas-de-carton.com/#website" },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: fichas.length,
    itemListElement: fichas.map((f, i) => ({ "@type": "ListItem", position: i + 1, name: f.nombre, url: `${url}${f.slug}/` })),
  },
};

// Guía de elección (se construye desde las fichas para no duplicar datos)
const guia = fichas.map((f) => ({ codigo: f.codigo, nombre: f.nombre, href: `${categoria.href}${f.slug}/`, ideal: f.tarjeta.desc, material: f.tarjeta.datos[0]?.value ?? "", pedido: f.tarjeta.pedido }));

// Fichas de otras líneas que también se usan para regalo (se conservan del hub anterior)
const otrasLineas = [
  { codigo: "CAD-TX-07", nombre: "Caja para joyería y accesorios", href: "/catalogo/cajas-textil-moda-retail/caja-joyeria-premium/" },
  { codigo: "CAD-TX-08", nombre: "Cajas para canastas y gift sets de temporada", href: "/catalogo/cajas-textil-moda-retail/caja-temporada-navidad/" },
  { codigo: "CAD-PL-03", nombre: "Cajas personalizadas full color", href: "/catalogo/cajas-personalizadas-logo/full-color/" },
  { codigo: "CAD-PL-07", nombre: "Caja personalizada con laminado mate", href: "/catalogo/cajas-personalizadas-logo/laminado-mate/" },
  { codigo: "CAD-PL-06", nombre: "Caja personalizada con barniz UV", href: "/catalogo/cajas-personalizadas-logo/barniz-uv-total/" },
  { codigo: "CAD-PL-11", nombre: "Caja kraft personalizada con logo", href: "/catalogo/cajas-personalizadas-logo/kraft-ecologico-logo/" },
];

const faqs = [
  { id: "rg-hub-1", question: "¿Qué tipos de cajas de regalo manejan?", answer: `Cotizamos ${fichas.length} tipos de cajas de regalo de cartón: sorpresa, navideñas, para dulces y galletas, para vino y botellas, grandes, con tapa, para regalos corporativos y magnéticas. Todas se surten <strong>vacías</strong>, lisas o con impresión.` },
  { id: "rg-hub-2", question: "¿Venden cajas de regalo por mayoreo?", answer: "Sí. Las cajas de regalo se cotizan por volumen; como referencia, desde <strong>100 piezas</strong> por modelo (cajas grandes desde 50). El mínimo final depende de la medida, el material y el acabado." },
  { id: "rg-hub-3", question: "¿Pueden llevar el logo de mi negocio?", answer: "Sí. Se cotizan con impresión a 1 tinta o full color, y con acabados como laminado mate o barniz. Para cajas con impresión el mínimo suele ser mayor que en cajas lisas." },
  { id: "rg-hub-4", question: "¿Qué diferencia hay entre una caja de cartón corrugado y una caja rígida para regalo?", answer: "El <strong>corrugado</strong> (micro flauta E o flauta B) es ligero y protege en el envío; la <strong>caja rígida</strong> de cartón gris forrado se siente más firme y se usa en regalos de presentación, como las cajas magnéticas o con tapa." },
  { id: "rg-hub-5", question: "¿Qué datos necesito para cotizar cajas de regalo?", answer: "Medida del producto o de la caja (largo × ancho × alto), cantidad, tipo de caja, color o material y si lleva impresión, ventana o separadores. Con eso te respondemos en horario hábil." },
  { id: "rg-hub-6", question: "¿Entregan en CDMX y Estado de México?", answer: "Sí. Coordinamos la entrega en CDMX y Estado de México; la fecha se confirma según el volumen, el modelo y la zona." },
];
---

<PageLayout title={title} description={description} pageType="catalog" schema={schema} ogImage={fichas[0].imagenes[0].src}
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Catálogo", href: "/catalogo/" }, { name: categoria.nombre }]}
  faqItems={faqs.map(({ question, answer }) => ({ question, answer: answer.replace(/<[^>]+>/g, "") }))}>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo/">Catálogo</a></li>
        <li><span class="current">{categoria.nombre}</span></li>
      </ol>
    </div>
  </div>

  <PageHero
    id="rg-hub-title"
    eyebrow="Catálogo · Cajas para regalo"
    titleHtml={true}
    title="Cajas de regalo <span>de cartón</span>"
    desc="Cajas de regalo de cartón por mayoreo para tiendas, florerías, reposterías y empresas: sorpresa, navideñas, para dulces, vino, grandes, con tapa, magnéticas y corporativas."
    desc2="Las <strong>cajas de cartón para regalo</strong> se eligen por el producto que van a contener y por la presentación que buscas: corrugado ligero para armar y enviar, o cartón rígido forrado para regalos de presentación con tapa o cierre magnético.||CADECA cotiza <strong>cajas para regalo</strong> lisas o con tu logo, en medidas de referencia o a la medida, con entrega coordinada en CDMX y Estado de México. Te ayudamos a definir material, medida y cantidad."
  />

  <main id="contenido-principal" role="main">

    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" aria-labelledby="rg-tipos-title">
      <div class="container">
        <SectionHeader
          id="rg-tipos-title"
          twoCol
          title={`${fichas.length} tipos de cajas de regalo`}
          subtitle="Selecciona un tipo para ver especificaciones, medidas de referencia y opciones de personalización."
          link={{ text: "Volver al catálogo", href: "/catalogo/" }}
        >
          <p>Cada tipo tiene su ficha con material, cierre, opciones de impresión, medidas de referencia, usos y preguntas frecuentes. Las cajas se surten vacías, para que tu negocio arme el regalo.</p>
          <p>Si no encuentras la medida exacta, cotizamos la caja a la medida del producto con el mismo tipo de cierre y acabado.</p>
        </SectionHeader>

        <div class="sku-grid">
          {fichas.map((f) => (
            <article class="sku-card">
              <div class="sku-card__img-wrap">
                <img src={f.imagenes[0].src} alt={f.imagenes[0].alt} class="sku-card__img" width="640" height="480" loading="lazy" decoding="async" />
                <span class="sku-card__code">{f.codigo}</span>
                <span class="sku-card__badge sku-card__badge--orange">{f.badge}</span>
              </div>
              <div class="sku-card__body">
                <h2 class="sku-card__name"><a href={`${categoria.href}${f.slug}/`}>{f.nombre}</a></h2>
                <p class="sku-card__desc">{f.tarjeta.desc}</p>
                <div class="sku-card__specs">
                  {f.tarjeta.datos.map((d) => (
                    <div><span class="sku-card__spec-label">{d.label}</span><span class="sku-card__spec-value">{d.value}</span></div>
                  ))}
                </div>
                <div class="sku-card__footer">
                  <a href={`${categoria.href}${f.slug}/`} class="btn btn--primary">Ver ficha</a>
                  <span class="sku-card__moq">{f.tarjeta.pedido}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="rg-guia-title">
      <div class="container">
        <h2 id="rg-guia-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Cómo elegir la caja de regalo</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Tipo de caja</th><th>Ideal para</th><th>Material</th><th>Pedido</th></tr></thead>
            <tbody>
              {guia.map((g) => (
                <tr>
                  <td><a href={g.href}><strong>{g.nombre}</strong></a></td>
                  <td>{g.ideal}</td>
                  <td>{g.material}</td>
                  <td>{g.pedido}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="rg-nota">Referencias generales. El material, la medida y la cantidad mínima se confirman en la cotización.</p>
      </div>
    </section>

    <section class="rg-otras" aria-labelledby="rg-otras-title">
      <div class="container">
        <h2 id="rg-otras-title" class="section-header__title">También para regalo en otras líneas</h2>
        <p class="section-header__subtitle">Fichas de cajas personalizadas y de moda que se usan con frecuencia como empaque de regalo.</p>
        <ul class="rg-otras__list">
          {otrasLineas.map((o) => (
            <li><a href={o.href} class="rg-otras__link"><span class="rg-otras__code">{o.codigo}</span><span class="rg-otras__name">{o.nombre}</span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="seo-content" aria-labelledby="rg-seo-title">
      <div class="container">
        <h2 id="rg-seo-title" class="seo-content__title">Cajas de regalo por mayoreo para negocios</h2>
        <p class="seo-content__text">Las cajas de regalo de cartón resuelven dos necesidades a la vez: presentar el producto y protegerlo mientras se entrega. Para regalos que viajan por paquetería conviene el corrugado micro flauta E o flauta B; para regalos de presentación, como perfumes, joyería o kits ejecutivos, se usa cartón rígido forrado con tapa o cierre magnético.</p>
        <p class="seo-content__text">La medida se define a partir del contenido ya acomodado, con relleno o separadores si hace falta. Indica si la medida que compartes es interior o exterior, la cantidad por modelo y si llevará impresión, ventana o listón. Con esos datos preparamos una cotización comparable entre opciones.</p>
      </div>
    </section>

  </main>

  <FaqCotizacion faqs={faqs} tema="cajas de cartón para regalo" producto="Cajas de cartón para regalo" />
</PageLayout>

<style>
  .rg-nota { font-size: 0.75rem; color: var(--color-text-light); margin-top: 0.6rem; }
  .sku-card__name a { color: inherit; text-decoration: none; }
  .sku-card__name a:hover { color: var(--color-primary); }
  .rg-otras { padding: var(--spacing-3xl) 0; }
  .rg-otras__list { list-style: none; margin: var(--spacing-lg) 0 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 0.6rem; }
  @media (min-width: 640px) { .rg-otras__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .rg-otras__list { grid-template-columns: repeat(3, 1fr); } }
  .rg-otras__link { display: flex; flex-direction: column; gap: 0.2rem; height: 100%; padding: 0.9rem 1rem; border: 1px solid var(--color-border); border-radius: var(--border-radius); background: #fff; text-decoration: none; transition: border-color var(--transition-fast), box-shadow var(--transition-fast); }
  .rg-otras__link:hover { border-color: var(--color-primary); box-shadow: var(--shadow-sm); }
  .rg-otras__code { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.08em; color: var(--color-primary); }
  .rg-otras__name { font-size: var(--font-size-sm); font-weight: 700; color: var(--color-secondary); }
</style>
