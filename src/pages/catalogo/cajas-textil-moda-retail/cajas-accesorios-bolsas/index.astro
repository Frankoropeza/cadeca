---
import PageLayout   from "@/layouts/PageLayout.astro";
import FaqItem      from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";

const title   = "Cajas Accesorios, Bolsas y Joyería CDMX | CAD-TX-03 | CADECA";
const description = "Cajas premium pequeñas de cartón para accesorios, bolsas y joyería en CDMX. Micro-flauta E, impresión CMYK, barniz UV y laminado. Fabricante directo CADECA — insertos personalizados.";
const WHATSAPP = "5255XXXXXXXX";

const medidas = [
  { nombre:"Anillo",            lah:"6×6×4",    flauta:"E",ect:"ECT-23",vacío:"0.01 kg",máx:"0.1 kg",  disp:"green",  label:"Stock" },
  { nombre:"Pulsera / Reloj",   lah:"10×10×5",  flauta:"E",ect:"ECT-23",vacío:"0.02 kg",máx:"0.3 kg",  disp:"green",  label:"Stock", hl:true },
  { nombre:"Collar / Aretes",   lah:"15×12×4",  flauta:"E",ect:"ECT-23",vacío:"0.03 kg",máx:"0.3 kg",  disp:"green",  label:"Stock", hl:true },
  { nombre:"Bolsa Pequeña",     lah:"25×18×8",  flauta:"E",ect:"ECT-23",vacío:"0.06 kg",máx:"1 kg",    disp:"green",  label:"Stock" },
  { nombre:"Bolsa Mediana",     lah:"35×25×12", flauta:"E",ect:"ECT-23",vacío:"0.10 kg",máx:"2 kg",    disp:"yellow", label:"48 hrs" },
  { nombre:"Set Regalo Accesorios", lah:"30×20×10",flauta:"E",ect:"ECT-23",vacío:"0.08 kg",máx:"1.5 kg",disp:"yellow",label:"48 hrs" },
  { nombre:"A la Medida",       lah:"Cualquier",flauta:"A elegir",ect:"A elegir",vacío:"—",máx:"—",disp:"gray",label:"3-5 días" },
];

const specs = [
  ["Código SKU",          "CAD-TX-03"],
  ["Tipo de caja",        "Premium pequeña con inserto"],
  ["Flauta",              "E micro (1.5 mm)"],
  ["Resistencia ECT",     "ECT-23"],
  ["Gramaje liner",       "150 – 200 g/m²"],
  ["Gramaje médium",      "112 g/m²"],
  ["Material",            "SBS blanqueado · GC1 recubierto · Cartón compacto"],
  ["Impresión",           "Full color CMYK offset"],
  ["Barniz UV",           "Selectivo o total — incluido en MOQ 300+"],
  ["Laminado",            "Mate · Brillante · Soft Touch"],
  ["Acabados premium",    "Hot Stamping oro/plata · UV spot · Relieve seco (emboss)"],
  ["Inserto interior",    "Espuma EVA · Cartón troquelado · Satín — a la medida del producto"],
  ["Cierre",              "Magnético · Solapa con imán · Tapa rígida"],
  ["Resistencia al estallido", "250 kPa (Mullen)"],
  ["Peso máx. producto",  "Hasta 2 kg"],
  ["Pedido mínimo",       "200 pzas (con inserto personalizado)"],
  ["Tiempo de entrega",   "Stock genérica: 24 hrs · Personalizada: 5-7 días hábiles"],
];

const faqs = [
  {
    id:"tx03-f1",
    question:"¿Qué tipo de inserto recomiendan para joyería?",
    answer:"Para joyería recomendamos <strong>inserto de espuma EVA recubierta con satín o terciopelo</strong>. Se troquela a la forma exacta del anillo, pulsera o collar para que la pieza quede sujeta y protegida. Para piezas económicas, ofrecemos inserto de cartón troquelado con ranura. Ambas opciones se fabrican a la medida exacta de tu producto.",
  },
  {
    id:"tx03-f2",
    question:"¿Pueden lograr un acabado premium en corridas pequeñas?",
    answer:"Sí, a partir de <strong>200 piezas</strong> ofrecemos impresión CMYK offset con acabados premium como barniz UV selectivo, laminado soft touch y hot stamping. Para corridas de 200-500 piezas, el costo unitario es competitivo comparado con proveedores de importación. Para menos de 200 piezas, ofrecemos cajas genéricas con etiqueta personalizada como alternativa económica.",
  },
  {
    id:"tx03-f3",
    question:"¿Las cajas pequeñas sirven para venta en mostrador de joyería?",
    answer:"Sí, nuestras cajas CAD-TX-03 están diseñadas tanto para <strong>venta en mostrador como para e-commerce</strong>. El cierre magnético permite una apertura suave y elegante ideal para la experiencia en tienda. El acabado exterior premium comunica el valor del producto. Para exhibidores de mostrador, ofrecemos bandejas de presentación que sostienen múltiples cajas abiertas.",
  },
  {
    id:"tx03-f4",
    question:"¿Qué opciones de acabado premium ofrecen?",
    answer:"Ofrecemos la gama completa de <strong>acabados premium</strong>: laminado mate o brillante como base, barniz UV selectivo para resaltar logotipos, hot stamping en oro, plata, oro rosa o holográfico, relieve seco (emboss/deboss) para texturas táctiles, y laminado soft touch para efecto aterciopelado. Se pueden combinar varios acabados en una misma caja para máximo impacto visual.",
  },
  {
    id:"tx03-f5",
    question:"¿Pueden fabricar cajas para bolsas de diseñador?",
    answer:"Sí, fabricamos cajas para <strong>bolsas y accesorios de diseñador</strong> en medidas desde 25×18×8 cm hasta 35×25×12 cm. Para bolsas premium, recomendamos cartón GC1 de 300 g/m² con laminado mate y hot stamping del logotipo. Incluimos papel tissue personalizado y, opcionalmente, bolsa de tela antipolvo como complemento. Consulta con tu asesor CADECA para cotización de packaging integral.",
  },
  {
    id:"tx03-f6",
    question:"¿Las cajas de joyería son ecológicas y reciclables?",
    answer:"Sí, nuestras cajas de joyería son <strong>reciclables y fabricadas con materiales responsables</strong>. El cartón base es reciclable y biodegradable. Los laminados mate y brillante son de BOPP reciclable. Para marcas con compromiso ambiental, ofrecemos versión sin laminado con barniz base agua y tintas vegetales, manteniendo un acabado elegante. Certificación FSC disponible bajo pedido.",
  },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Textil, Moda y Retail",href:"/catalogo/cajas-textil-moda-retail"},{name:"Accesorios, Bolsas y Joyería"}]}
  faqItems={faqs.map(f=>({question:f.question,answer:f.answer.replace(/<[^>]+>/g,'')}))}
  product={{name:"Cajas Accesorios, Bolsas y Joyería",sku:"CAD-TX-03",description:"Cajas premium pequeñas de cartón para accesorios, bolsas y joyería en CDMX — fabricante directo CADECA",image:"/img/catalogo/cajas-carton-personalizadas-full-color-cmyk-cdmx.avif",material:"Cartón GC1/SBS micro-flauta E con acabados premium",category:"Cajas Textil, Moda y Retail",moq:"200"}}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container"><ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Catálogo</a></li>
      <li><a href="/catalogo/cajas-textil-moda-retail">Textil, Moda y Retail</a></li>
      <li><span class="current">Accesorios, Bolsas y Joyería</span></li>
    </ol></div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-tx03-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-TX-03 · Textil, Moda y Retail</span>
      <h1 id="sku-tx03-title" class="cat-page-hero__title">
        Accesorios, Bolsas y Joyería<br><span>Cajas Premium Pequeñas — CDMX</span>
      </h1>
      <p class="cat-page-hero__desc">
        Cajas premium de cartón micro-flauta E para joyería, accesorios de moda y bolsas de diseñador. Impresión full color CMYK con acabados de lujo: barniz UV selectivo, hot stamping, laminado soft touch y relieve seco. Insertos personalizados para cada pieza.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-TX-03</strong></div>
        <div class="cat-page-hero__strip-item">Acabados: <strong>UV · Stamping · Soft Touch</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>200 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>5-7 días</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">

    <section class="sku-detail" aria-labelledby="detalle-tx03-title">
      <div class="container">
        <div class="sku-detail__grid">

          <div>
            <div class="sku-detail__img-wrap">
              <img src="/img/catalogo/cajas-carton-personalizadas-full-color-cmyk-cdmx.avif"
                alt="Cajas premium de cartón para accesorios, bolsas y joyería CDMX — CADECA CAD-TX-03"
                class="sku-detail__img" width="880" height="560"
                loading="eager" decoding="async" fetchpriority="high" />
            </div>
          </div>

          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-TX-03 · Familia: Textil, Moda y Retail</p>
            <h2 id="detalle-tx03-title" class="sku-detail__title">Accesorios, Bolsas y Joyería — Cajas Premium</h2>
            <p class="sku-detail__desc">
              La caja premium CAD-TX-03 está diseñada para productos de alto valor percibido: anillos, pulseras, collares, relojes, bolsas de diseñador y accesorios de moda. Fabricada en cartón GC1 o SBS de alta blancura con micro-flauta E, acepta impresión offset CMYK de alta resolución y la gama completa de acabados premium. Incluye inserto interior personalizado (espuma EVA, cartón troquelado o satín) para sujetar y proteger cada pieza.
            </p>

            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">Premium</span>
                <span class="sku-detail__strip-label">Acabados de lujo</span>
              </div>
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">2 kg</span>
                <span class="sku-detail__strip-label">Peso máx.</span>
              </div>
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">200 pzas</span>
                <span class="sku-detail__strip-label">Pedido mín.</span>
              </div>
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">5-7 días</span>
                <span class="sku-detail__strip-label">Entrega CDMX</span>
              </div>
            </div>

            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table">
              <tbody>
                {specs.map(([label, val]) => (
                  <tr><td>{label}</td><td>{val}</td></tr>
                ))}
              </tbody>
            </table>

            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-TX-03 Cajas Accesorios y Joyería`}
                 target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-TX-03</a>
              <a href="/catalogo/cajas-textil-moda-retail" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-tx03-title">
      <div class="container">
        <h2 id="sizes-tx03-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">
          Medidas Disponibles — CAD-TX-03
        </h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead>
              <tr>
                <th>Tamaño</th>
                <th>L × A × H (cm)</th>
                <th>Flauta</th>
                <th>ECT</th>
                <th>Peso vacío</th>
                <th>Peso máx.</th>
                <th>Disponibilidad</th>
              </tr>
            </thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td>{m.nombre}</td>
                  <td><strong>{m.lah}</strong></td>
                  <td>{m.flauta}</td>
                  <td>{m.ect}</td>
                  <td>{m.vacío}</td>
                  <td><strong>{m.máx}</strong></td>
                  <td>
                    <span class={`stock-chip stock-chip--${m.disp}`}>
                      {m.disp==="green"?"✓":m.disp==="yellow"?"⏱":"○"} {m.label}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">
          ✓ Stock permanente · ⏱ Producción rápida · ○ Pedido especial — 3 a 5 días hábiles. Pesos bajo condiciones estándar: 20°C y 50% HR.
        </p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-tx03-title">
      <div class="container">
        <h2 id="faq-tx03-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">
          Preguntas Técnicas — CAD-TX-03
        </h2>
        <div class="faq__list">
          {faqs.map(f => <FaqItem {...f} />)}
        </div>
      </div>
    </section>

  </main>

  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-TX-03 — Cajas premium para accesorios, bolsas y joyería" />

</PageLayout>
