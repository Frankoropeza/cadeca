---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas para Canastas Navideñas y Temporada | CADECA";
const description = "Caja para temporada navideña y canastas regalo en CDMX. Diseño festivo o neutro, kraft o blanco, resistente al apilado, ideal para gift sets.";

const specs = [
 ["Código SKU",  "CAD-TX-08"],
 ["Tipo de pared", "Simple / Doble corrugado (B/C · BC)"],
 ["Flauta",  "B (3mm) / C (4mm) / BC (7mm)"],
 ["Resistencia",  "ECT-32 / ECT-44"],
 ["Gramaje liner", "127–150 g/m²"],
 ["Material",  "Kraft virgen o corrugado blanco"],
 ["Cierre",  "4 solapas o tapa separada con ventana"],
 ["Pedido mínimo", "100 piezas"],
 ["Entrega CDMX",  "Según pedido"],
];

const faqs = [
 {
 id: "tx08-f1",
 question: "¿Cómo elijo la medida adecuada para cajas para canastas navideñas?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "tx08-f2",
 question: "¿Qué resistencia de cartón conviene para cajas para canastas navideñas?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "tx08-f3",
 question: "¿Se pueden personalizar cajas para canastas navideñas con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "tx08-f4",
 question: "¿Cómo debo almacenar cajas para canastas navideñas antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "tx08-f5",
 question: "¿Qué datos necesito para cotizar cajas para canastas navideñas?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-retail-pdv-display-cdmx.avif",  alt: "Caja temporada navideña display punto de venta — CAD-TX-08" },
 { src: "/img/catalogo/caja-retail-pdv-hero-cdmx.avif",  alt: "Caja para canastas navideñas corrugado CDMX" },
 { src: "/img/catalogo/caja-retail-pdv-flatpack-cdmx.avif",  alt: "Cajas navideñas flat pack para armado rápido" },
 { src: "/img/catalogo/caja-retail-pdv-floorstand-cdmx.avif",  alt: "Floor stand con cajas de temporada navideña" },
 { src: "/img/catalogo/caja-retail-punto-venta-pdv-cdmx.avif",  alt: "Punto de venta con cajas de gift set navideño" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Textil, Moda y Retail",href:"/catalogo/cajas-textil-moda-retail/"},{name:"Temporada Navideña"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja para Temporada y Canastas Navideñas",sku:"CAD-TX-08",description:"Caja para canastas navideñas y gift sets — diseño festivo o neutro, kraft o blanco",image:gallery[0].src,material:"Kraft o corrugado blanco B/C ECT-32",category:"Cajas para Textil, Moda y Retail",moq:"100"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container"><ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-textil-moda-retail/">Textil, Moda y Retail</a></li>
 <li><span class="current">Temporada Navideña</span></li>
 </ol></div>
 </div>

 <PageHero
   id="sku-tx08-title"
   eyebrow="Textil y moda · SKU CAD-TX-08"
   titleHtml={true}
   title="Cajas navideñas <span>para canastas y regalos</span>"
   desc="Cajas navideñas para canastas corporativas y sets de regalo de temporada. Se adaptan a marcas y empresas que preparan presentaciones para entregar en CDMX y Estado de México."
   desc2="Las cajas pueden trabajarse en kraft natural o corrugado blanco, con diseño festivo o neutro según el proyecto. Su estructura está pensada para el apilado y transporte de canastas, regalos y sets de temporada, con espacio para organizar los artículos del interior.||CADECA coordina el surtido como proveedor de <strong>cajas para canastas navideñas</strong>. Comparte medidas, cantidad, contenido y zona de entrega al cotizar; te asesoramos para definir el cartón y la configuración que proteja tus regalos."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-tx08-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-TX-08 · Familia: Textil, Moda y Retail</p>
 <h2 id="detalle-tx08-title" class="sku-detail__title">Caja Temporada Navideña y Gift Sets</h2>
 <p class="sku-detail__desc">
 La caja CAD-TX-08 es nuestra solución de empaque para canastas navideñas, gift sets corporativos y cajas de temporada festiva. Disponible en tres medidas estándar (chica, mediana y grande) en kraft natural o corrugado blanco con opciones de impresión festiva full color. Flauta B/C ECT-32 con capacidad de apilado seguro hasta 1 metro. Ideal para empresas que preparan canastas navideñas, tiendas departamentales y marcas de moda con colecciones de temporada en CDMX.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3 medidas</span><span class="sku-detail__strip-label">Ch · Med · Gde</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Full color</span><span class="sku-detail__strip-label">Diseño festivo</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-TX-08 Caja Temporada Navideña`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-TX-08</a>
 <a href="/catalogo/cajas-textil-moda-retail/" class="btn btn--outline">Ver categoría</a>
 </div>
 <p class="sku-detail__crosslink" style="margin-top:var(--spacing-md);font-size:var(--font-size-sm);color:var(--color-text-light);">¿Buscas cajas individuales para regalo de fin de año? Revisa las <a href="/catalogo/cajas-de-carton-para-regalo/cajas-navidenas/" style="color:var(--color-primary);font-weight:700;">cajas navideñas para regalo</a>.</p>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas navideñas" />

</PageLayout>
