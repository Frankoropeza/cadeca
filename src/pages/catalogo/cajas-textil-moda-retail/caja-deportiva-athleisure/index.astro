---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja para Ropa Deportiva y Athleisure | CADECA";
const description = "Caja corrugado para ropa deportiva y athleisure en CDMX. Medidas para playeras, pants y calzado deportivo. Compatible con paqueterías, ECT-32.";

const specs = [
 ["Código SKU",  "CAD-TX-09"],
 ["Tipo de pared", "Simple (flauta B/C)"],
 ["Flauta",  "B (3mm) / C (4mm)"],
 ["Resistencia",  "ECT-32"],
 ["Gramaje liner", "127–150 g/m²"],
 ["Material",  "Kraft virgen o corrugado blanco"],
 ["Cierre",  "4 solapas RSC o autoblocante"],
 ["Pedido mínimo", "100 piezas"],
 ["Entrega CDMX",  "Según pedido"],
];

const faqs = [
 {
 id: "tx09-f1",
 question: "¿Cómo elijo la medida adecuada para cajas para ropa deportiva?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "tx09-f2",
 question: "¿Qué resistencia de cartón conviene para cajas para ropa deportiva?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "tx09-f3",
 question: "¿Se pueden personalizar cajas para ropa deportiva con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "tx09-f4",
 question: "¿Cómo debo almacenar cajas para ropa deportiva antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "tx09-f5",
 question: "¿Qué datos necesito para cotizar cajas para ropa deportiva?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-calzado-zapatos-hero-cdmx.avif",  alt: "Caja ropa deportiva y athleisure corrugado — CAD-TX-09" },
 { src: "/img/catalogo/caja-calzado-zapatos-stack-cdmx.avif",  alt: "Apilado de cajas deportivas en almacén CDMX" },
 { src: "/img/catalogo/caja-calzado-zapatos-display-cdmx.avif",  alt: "Display de cajas para calzado deportivo" },
 { src: "/img/catalogo/caja-calzado-zapatos-ventana-cdmx.avif",  alt: "Caja deportiva con ventana de exhibición" },
 { src: "/img/catalogo/caja-calzado-zapatos-corrugado-cdmx.avif",  alt: "Corrugado kraft para ropa athleisure CDMX" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Textil, Moda y Retail",href:"/catalogo/cajas-textil-moda-retail/"},{name:"Deportiva y Athleisure"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja para Ropa Deportiva y Athleisure",sku:"CAD-TX-09",description:"Caja corrugado para ropa deportiva — compatible con paqueterías, ECT-32, entrega CDMX",image:gallery[0].src,material:"Kraft o blanco flauta B/C ECT-32",category:"Cajas para Textil, Moda y Retail",moq:"100"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container"><ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-textil-moda-retail/">Textil, Moda y Retail</a></li>
 <li><span class="current">Deportiva y Athleisure</span></li>
 </ol></div>
 </div>

 <PageHero
   id="sku-tx09-title"
   eyebrow="Textil y moda · SKU CAD-TX-09"
   titleHtml={true}
   title="Cajas para ropa deportiva <span>y athleisure</span>"
   desc="Cajas para ropa deportiva y athleisure diseñadas para playeras, pants, shorts y calzado. Ayudan a marcas a preparar sus productos para venta y distribución en CDMX."
   desc2="Las cajas se especifican en cartón corrugado con flauta B o C y ECT-32, para prendas deportivas y calzado. Sus medidas se ajustan al formato de playeras, pants y shorts, con una estructura pensada para proteger el producto durante manejo y transporte.||CADECA coordina el surtido como proveedor de <strong>empaque para athleisure</strong>. Comparte medidas, cantidad, uso y zona de entrega al cotizar; te asesoramos para seleccionar la flauta y configuración de caja que corresponda con tus prendas."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-tx09-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-TX-09 · Familia: Textil, Moda y Retail</p>
 <h2 id="detalle-tx09-title" class="sku-detail__title">Caja Ropa Deportiva y Athleisure</h2>
 <p class="sku-detail__desc">
 La caja CAD-TX-09 está diseñada para marcas de ropa deportiva, athleisure y activewear en CDMX. Medidas optimizadas para playeras, pants, shorts y kits deportivos completos con calzado. Flauta B/C ECT-32 que resiste el manejo de paqueterías nacionales (Estafeta, DHL, FedEx) sin deformarse. Disponible en kraft natural para imagen eco-sport o corrugado blanco para impresión full color de marca. Ventana de acetato opcional para exhibición en punto de venta.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Paquetería</span><span class="sku-detail__strip-label">Compatible</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-TX-09 Caja Ropa Deportiva Athleisure`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-TX-09</a>
 <a href="/catalogo/cajas-textil-moda-retail/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas para ropa deportiva" />

</PageLayout>
