---
import PageLayout    from "@/layouts/PageLayout.astro";
import FaqItem       from "@/components/FaqItem.astro";
import LeadCapture   from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Caja para Ropa Deportiva y Athleisure CDMX | CAD-TX-09 | CADECA";
const description = "Caja corrugado para ropa deportiva y athleisure en CDMX. Medidas para playeras, pants y calzado deportivo. Compatible con paqueterías, ECT-32. Fabricante CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const specs = [
  ["Código SKU",    "CAD-TX-09"],
  ["Tipo de pared", "Simple (flauta B/C)"],
  ["Flauta",        "B (3mm) / C (4mm)"],
  ["Resistencia",   "ECT-32"],
  ["Gramaje liner", "127–150 g/m²"],
  ["Material",      "Kraft virgen o corrugado blanco"],
  ["Cierre",        "4 solapas RSC o autoblocante"],
  ["Pedido mínimo", "100 piezas"],
  ["Entrega CDMX",  "24–48 hrs"],
];

const faqs = [
  {
    id: "tx09-f1",
    question: "¿Qué medidas recomiendan para cajas de ropa deportiva y athleisure?",
    answer: "Para sets de ropa deportiva (playera + pants/shorts) recomendamos 35×25×12 cm en flauta B ECT-32. Para cajas que incluyen calzado deportivo, la medida ideal es 40×30×15 cm en flauta C ECT-32. Para kits completos de athleisure (prenda superior, inferior y calzado) utilizamos 45×35×20 cm. Todas las medidas son compatibles con las dimensiones estándar de paqueterías como Estafeta, DHL y FedEx para envío nacional.",
  },
  {
    id: "tx09-f2",
    question: "¿La caja resiste el envío por paquetería sin dañar la ropa deportiva?",
    answer: "Sí. La flauta B/C ECT-32 ofrece resistencia al apilamiento de hasta 80 kg y protección contra humedad ambiental estándar. Para marcas con venta online, diseñamos la caja con solapa interior que cubre el contenido, evitando el contacto de la prenda con la cinta de sellado. También ofrecemos papel tissue kraft o seda como complemento para una presentación premium al abrir. La caja soporta el manejo estándar de paqueterías nacionales sin deformarse.",
  },
  {
    id: "tx09-f3",
    question: "¿Pueden hacer cajas con ventana para exhibir la prenda deportiva?",
    answer: "Sí. Ofrecemos troquelado con ventana de acetato transparente o PLA biodegradable en la cara frontal o superior de la caja. La ventana permite ver el color y textura de la prenda sin abrir el empaque, ideal para punto de venta en tiendas deportivas. El acetato se adhiere por la cara interior con adhesivo apto para contacto con textiles. Disponible en cualquier forma (rectangular, circular, logo shape) desde 200 pzas en CDMX.",
  },
];

const gallery = [
  { src: "/img/catalogo/caja-calzado-zapatos-hero-cdmx.avif",       alt: "Caja ropa deportiva y athleisure corrugado — CAD-TX-09" },
  { src: "/img/catalogo/caja-calzado-zapatos-stack-cdmx.avif",      alt: "Apilado de cajas deportivas en almacén CDMX" },
  { src: "/img/catalogo/caja-calzado-zapatos-display-cdmx.avif",    alt: "Display de cajas para calzado deportivo" },
  { src: "/img/catalogo/caja-calzado-zapatos-ventana-cdmx.avif",    alt: "Caja deportiva con ventana de exhibición" },
  { src: "/img/catalogo/caja-calzado-zapatos-corrugado-cdmx.avif",  alt: "Corrugado kraft para ropa athleisure CDMX" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Textil, Moda y Retail",href:"/catalogo/cajas-textil-moda-retail"},{name:"Deportiva y Athleisure"}]}
  faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
  product={{name:"Caja para Ropa Deportiva y Athleisure",sku:"CAD-TX-09",description:"Caja corrugado para ropa deportiva — compatible con paqueterías, ECT-32, entrega CDMX",image:gallery[0].src,material:"Kraft o blanco flauta B/C ECT-32",category:"Cajas para Textil, Moda y Retail",moq:"100"}}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container"><ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Catálogo</a></li>
      <li><a href="/catalogo/cajas-textil-moda-retail">Textil, Moda y Retail</a></li>
      <li><span class="current">Deportiva y Athleisure</span></li>
    </ol></div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-tx09-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-TX-09 · Textil, Moda y Retail</span>
      <h1 id="sku-tx09-title" class="cat-page-hero__title">
        Caja para <span>Ropa Deportiva</span> y Athleisure
      </h1>
      <p class="cat-page-hero__desc">
        Caja corrugado diseñada para marcas de ropa deportiva y athleisure. Medidas optimizadas para playeras, pants, shorts y calzado deportivo. Compatible con paqueterías nacionales. Flauta B/C ECT-32 con entrega en CDMX en 24–48 horas.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-TX-09</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-32</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>100 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-tx09-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-TX-09 · Familia: Textil, Moda y Retail</p>
            <h2 id="detalle-tx09-title" class="sku-detail__title">Caja Ropa Deportiva y Athleisure</h2>
            <p class="sku-detail__desc">
              La caja CAD-TX-09 está diseñada para marcas de ropa deportiva, athleisure y activewear en CDMX. Medidas optimizadas para playeras, pants, shorts y kits deportivos completos con calzado. Flauta B/C ECT-32 que resiste el manejo de paqueterías nacionales (Estafeta, DHL, FedEx) sin deformarse. Disponible en kraft natural para imagen eco-sport o corrugado blanco para impresión full color de marca. Ventana de acetato opcional para exhibición en punto de venta.
            </p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Paquetería</span><span class="sku-detail__strip-label">Compatible</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-TX-09 Caja Ropa Deportiva Athleisure`}
                 target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-TX-09</a>
              <a href="/catalogo/cajas-textil-moda-retail" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-faq" aria-labelledby="faq-tx09-title">
      <div class="container">
        <h2 id="faq-tx09-title" class="sku-faq__title">Preguntas Frecuentes — Ropa Deportiva y Athleisure</h2>
        <div class="sku-faq__list">
          {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="Cotiza cajas para tu marca deportiva — Compatible con envío por paquetería en CDMX" />

</PageLayout>
