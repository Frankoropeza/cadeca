---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja para Uniformes y Ropa Corporativa | CADECA";
const description = "Caja de cartón para uniformes y ropa corporativa en CDMX. Kraft o blanco, medidas para uniformes doblados o colgados, pedidos masivos. Proveedor CADECA.";

const specs = [
 ["Código SKU",  "CAD-TX-06"],
 ["Tipo de pared", "Simple (flauta B/C)"],
 ["Flauta",  "B (3mm) / C (4mm)"],
 ["Resistencia",  "ECT-32"],
 ["Gramaje liner", "127–150 g/m²"],
 ["Material",  "Kraft virgen o corrugado blanco"],
 ["Cierre",  "4 solapas estándar RSC"],
 ["Pedido mínimo", "100 piezas"],
 ["Entrega CDMX",  "Según pedido"],
];

const faqs = [
 {
 id: "tx06-f1",
 question: "¿Cómo elijo la medida adecuada para cajas para uniformes corporativos?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "tx06-f2",
 question: "¿Qué resistencia de cartón conviene para cajas para uniformes corporativos?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "tx06-f3",
 question: "¿Se pueden personalizar cajas para uniformes corporativos con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "tx06-f4",
 question: "¿Cómo debo almacenar cajas para uniformes corporativos antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "tx06-f5",
 question: "¿Qué datos necesito para cotizar cajas para uniformes corporativos?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-ropa-prendas-hero-cdmx.avif",  alt: "Caja para uniformes corporativos corrugado — CAD-TX-06" },
 { src: "/img/catalogo/caja-ropa-prendas-interior-cdmx.avif",  alt: "Interior de caja para uniformes doblados CDMX" },
 { src: "/img/catalogo/caja-ropa-prendas-stack-cdmx.avif",  alt: "Apilado de cajas de ropa corporativa en almacén" },
 { src: "/img/catalogo/caja-ropa-prendas-despacho-cdmx.avif",  alt: "Despacho de cajas de uniformes corporativos" },
 { src: "/img/catalogo/caja-ropa-prendas-envio-moda-cdmx.avif", alt: "Envío de uniformes en caja corrugado kraft" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Textil, Moda y Retail",href:"/catalogo/cajas-textil-moda-retail/"},{name:"Uniformes Corporativos"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja para Uniformes y Ropa Corporativa",sku:"CAD-TX-06",description:"Caja kraft o blanco para uniformes corporativos — pedidos masivos con entrega CDMX",image:gallery[0].src,material:"Kraft virgen o blanco flauta B/C ECT-32",category:"Cajas para Textil, Moda y Retail",moq:"100"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container"><ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-textil-moda-retail/">Textil, Moda y Retail</a></li>
 <li><span class="current">Uniformes Corporativos</span></li>
 </ol></div>
 </div>

 <PageHero
   id="sku-tx06-title"
   eyebrow="Textil y moda · SKU CAD-TX-06"
   titleHtml={true}
   title="Cajas para uniformes <span>y ropa corporativa</span>"
   desc="Cajas para uniformes que ordenan prendas dobladas o colgadas para empresas y distribuidores. Se adaptan a pedidos de ropa corporativa en CDMX y Estado de México."
   desc2="Se surte en cartón corrugado kraft o blanco con medidas para uniformes doblados o colgados. La estructura sirve para preparar pedidos de ropa corporativa, organizar conjuntos por talla y proteger las prendas durante el traslado y la entrega.||Para uniformes, el acomodo doblado o colgado, las tallas por pedido y el número de piezas definen la caja. Indica tipo de uniforme, dimensiones del conjunto, prendas por caja y acabado kraft o blanco; CADECA revisa el <strong>empaque para ropa corporativa</strong>."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-tx06-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-TX-06 · Familia: Textil, Moda y Retail</p>
 <h2 id="detalle-tx06-title" class="sku-detail__title">Caja Uniformes y Ropa Corporativa</h2>
 <p class="sku-detail__desc">
 La caja CAD-TX-06 está diseñada específicamente para empresas que distribuyen uniformes a sus colaboradores. Disponible en kraft natural o corrugado blanco, con medidas optimizadas para uniformes doblados (40×30×15 cm) o colgados en percha (60×50×25 cm). Flauta B/C ECT-32 con resistencia suficiente para apilado en almacén y transporte por paquetería. Impresión de logo corporativo disponible desde 200 pzas en CDMX.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Kraft/Blanco</span><span class="sku-detail__strip-label">Material</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-TX-06 Caja Uniformes Corporativos`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-TX-06</a>
 <a href="/catalogo/cajas-textil-moda-retail/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas para uniformes" />

</PageLayout>
