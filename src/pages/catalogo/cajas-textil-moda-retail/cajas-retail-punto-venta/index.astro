---
import PageLayout   from "@/layouts/PageLayout.astro";
import FaqItem      from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";

const title   = "Caja Retail Punto de Venta Display CDMX | CAD-TX-04 | CADECA";
const description = "Ficha técnica caja display y exhibidor punto de venta en CDMX. Flauta B/C, ECT-32, mostrador, floor stand y pallet display. Impresión full color, MOQ 100 pzas. CADECA fabricante directo.";
const WHATSAPP = "5255XXXXXXXX";

const medidas = [
  { nombre:"Mostrador Chico",      lah:"25×20×30",   flauta:"B",  ect:"ECT-32",vacío:"0.18 kg",máx:"3 kg",   disp:"green",  label:"Stock" },
  { nombre:"Mostrador Mediano",    lah:"35×25×40",   flauta:"B",  ect:"ECT-32",vacío:"0.30 kg",máx:"5 kg",   disp:"green",  label:"Stock", hl:true },
  { nombre:"Floor Stand",          lah:"40×30×120",  flauta:"C",  ect:"ECT-32",vacío:"1.10 kg",máx:"15 kg",  disp:"yellow", label:"48 hrs", hl:true },
  { nombre:"Exhibidor Lateral",    lah:"30×15×50",   flauta:"B",  ect:"ECT-32",vacío:"0.35 kg",máx:"5 kg",   disp:"yellow", label:"48 hrs" },
  { nombre:"Pallet Display",       lah:"60×40×140",  flauta:"BC", ect:"ECT-44",vacío:"2.40 kg",máx:"40 kg",  disp:"gray",   label:"5 días" },
  { nombre:"A la Medida",          lah:"Cualquier",flauta:"A elegir",ect:"A elegir",vacío:"—",máx:"—",disp:"gray",label:"3-5 días" },
];

const specs = [
  ["Código SKU",              "CAD-TX-04"],
  ["Tipo de producto",        "Display y exhibidor punto de venta (PDV/POP)"],
  ["Tipo de pared",           "Simple (flauta B/C) · Doble (flauta BC)"],
  ["Flautas disponibles",     "B (3 mm) · C (4 mm) · BC (7 mm)"],
  ["Resistencia ECT",         "ECT-32 (simple) · ECT-44 (doble pared)"],
  ["Gramaje liner",           "150 – 250 g/m²"],
  ["Gramaje médium",          "112 – 150 g/m²"],
  ["Material",                "Kraft liner blanco · SBS recubierto · Corrugado reciclado"],
  ["Color exterior",          "Blanco recubierto para impresión full color"],
  ["Peso máx. producto",      "Hasta 40 kg (pallet display BC)"],
  ["Carga de apilado",        "Hasta 80 kg (floor display condiciones ideales)"],
  ["Impresión",               "Full color CMYK offset · Flexografía hasta 6 tintas"],
  ["Acabado",                 "Barniz UV total · UV selectivo · Laminado mate/brillante"],
  ["Montaje",                 "Sin herramientas — armado en menos de 60 segundos"],
  ["Certificación",           "FSC disponible · Tintas base agua · 100 % reciclable"],
  ["Pedido mínimo",           "100 pzas"],
  ["Tiempo de entrega",       "48-72 hrs stock · 5-7 días personalizado"],
];

const faqs = [
  {
    id:"tx04-f1",
    question:"¿Qué tipo de display es mejor para mostrador de tienda?",
    answer:"Para mostrador recomendamos el <strong>Mostrador Mediano de 35×25×40 cm</strong> con flauta B y ECT-32. Su diseño compacto permite colocarse junto a la caja registradora o en el counter principal sin obstruir la operación. Soporta hasta 5 kg de producto y su impresión full color CMYK atrae la compra por impulso. Incluye troquel de exhibición frontal inclinado para máxima visibilidad del producto.",
  },
  {
    id:"tx04-f2",
    question:"¿Los floor displays se arman sin herramientas?",
    answer:"Sí, todos nuestros <strong>floor displays se arman sin herramientas en menos de 60 segundos</strong>. Utilizan un sistema de lengüetas y ranuras presuajadas que encajan a presión. Incluimos instrucciones impresas en la base del display y un video QR de armado. Son ideales para campañas temporales en tiendas de autoservicio, departamentales y farmacias donde el personal de piso necesita montaje rápido y sin capacitación.",
  },
  {
    id:"tx04-f3",
    question:"¿Cuánto dura un display de cartón en punto de venta?",
    answer:"Un display de cartón corrugado CADECA tiene una <strong>vida útil de 3 a 6 meses</strong> en condiciones normales de tienda (ambiente seco, temperatura controlada, sin contacto directo con agua). Con laminado protector, la vida útil se extiende hasta <strong>12 meses</strong>. Para campañas estacionales (Buen Fin, Hot Sale, Navidad, regreso a clases), un display sin laminado es suficiente y más económico.",
  },
  {
    id:"tx04-f4",
    question:"¿Ofrecen diseño estructural del display o solo fabricación?",
    answer:"Ofrecemos el <strong>servicio integral: diseño estructural + diseño gráfico + prototipo + producción</strong>. Nuestro equipo de ingeniería desarrolla la estructura del display considerando el peso del producto, número de charolas o niveles, ángulo de visibilidad óptimo y estabilidad anti-vuelco. Entregamos <strong>prototipo físico blanco</strong> para aprobación antes de producción en volumen, sin costo adicional en pedidos de 200+ piezas.",
  },
  {
    id:"tx04-f5",
    question:"¿Qué es un sidekick o exhibidor lateral y para qué sirve?",
    answer:"El <strong>sidekick o exhibidor lateral</strong> (30×15×50 cm) es un display diseñado para colgarse o fijarse en el costado de un anaquel o góndola. Su perfil delgado maximiza el espacio en pasillos estrechos y captura la atención del comprador desde un ángulo lateral que normalmente no se aprovecha. Es muy efectivo para <strong>lanzamientos de producto, promociones cruzadas y compras por impulso</strong> en tiendas de autoservicio y farmacias.",
  },
  {
    id:"tx04-f6",
    question:"¿Cuál es el pedido mínimo para displays personalizados?",
    answer:"El <strong>pedido mínimo es de 100 piezas</strong> para displays personalizados con impresión full color CMYK offset. Para tirajes mayores a 500 pzas, ofrecemos descuento por volumen escalonado de hasta 25 %. Incluimos troquel, suaje, diseño gráfico, prueba digital 3D y prototipo sin costo adicional. Para campañas nacionales con más de 1,000 puntos de venta, contacta a tu asesor para <strong>cotización de proyecto integral</strong>.",
  },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Textil, Moda y Retail",href:"/catalogo/cajas-textil-moda-retail"},{name:"Retail Punto de Venta"}]}
  faqItems={faqs.map(f=>({question:f.question,answer:f.answer.replace(/<[^>]+>/g,'')}))}
  product={{name:"Caja Retail Punto de Venta Display",sku:"CAD-TX-04",description:"Cajas display y exhibidores punto de venta en cartón corrugado CDMX — fabricante directo CADECA",image:"/img/catalogo/cajas-mercado-envios-chica-mediana-grande-cdmx.avif",material:"Cartón corrugado flauta B/C/BC con impresión full color CMYK",category:"Cajas para Textil, Moda y Retail",moq:"100"}}
>

  <!-- Breadcrumb -->
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container"><ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Catálogo</a></li>
      <li><a href="/catalogo/cajas-textil-moda-retail">Textil, Moda y Retail</a></li>
      <li><span class="current">Retail Punto de Venta</span></li>
    </ol></div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-tx04-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-TX-04 · Cajas para Textil, Moda y Retail</span>
      <h1 id="sku-tx04-title" class="cat-page-hero__title">
        Caja Retail Punto de Venta<br><span>Display y Exhibidores — CDMX</span>
      </h1>
      <p class="cat-page-hero__desc">
        Exhibidores y displays de cartón corrugado para punto de venta: mostrador, floor stand, exhibidor lateral y pallet display. Armado sin herramientas en menos de 60 segundos, impresión full color CMYK y acabados premium. Entrega en CDMX.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-TX-04</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-32 / ECT-44</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>100 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>48-72 hrs</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">

    <section class="sku-detail" aria-labelledby="detalle-tx04-title">
      <div class="container">
        <div class="sku-detail__grid">

          <div>
            <div class="sku-detail__img-wrap">
              <img src="/img/catalogo/cajas-mercado-envios-chica-mediana-grande-cdmx.avif"
                alt="Caja display retail punto de venta exhibidores CDMX — CADECA CAD-TX-04"
                class="sku-detail__img" width="880" height="560"
                loading="eager" decoding="async" fetchpriority="high" />
            </div>
          </div>

          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-TX-04 · Familia: Textil, Moda y Retail</p>
            <h2 id="detalle-tx04-title" class="sku-detail__title">Retail Punto de Venta — Display y Exhibidores</h2>
            <p class="sku-detail__desc">
              Los displays CAD-TX-04 están diseñados para maximizar la visibilidad de tu producto en punto de venta. Fabricados en cartón corrugado de alta resistencia con flauta B, C o doble pared BC según el modelo, soportan desde 3 hasta 40 kg de producto. Su sistema de armado sin herramientas permite instalación inmediata por el personal de tienda. Impresión offset full color CMYK con acabados premium disponibles para máximo impacto visual en anaquel.
            </p>

            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">Full Color</span>
                <span class="sku-detail__strip-label">Impresión CMYK offset</span>
              </div>
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">40 kg</span>
                <span class="sku-detail__strip-label">Peso máx.</span>
              </div>
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">100 pzas</span>
                <span class="sku-detail__strip-label">Pedido mín.</span>
              </div>
              <div class="sku-detail__strip-item">
                <span class="sku-detail__strip-value">48-72 hrs</span>
                <span class="sku-detail__strip-label">Entrega CDMX</span>
              </div>
            </div>

            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table">
              <tbody>
                {specs.map(([label, val]) => (
                  <tr><td>{label}</td><td>{val}</td></tr>
                ))}
              </tbody>
            </table>

            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-TX-04 Display Retail Punto de Venta`}
                 target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-TX-04</a>
              <a href="/catalogo/cajas-textil-moda-retail" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- TABLA DE MEDIDAS -->
    <section class="sku-sizes" aria-labelledby="sizes-tx04-title">
      <div class="container">
        <h2 id="sizes-tx04-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">
          Medidas Disponibles — CAD-TX-04
        </h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead>
              <tr>
                <th>Tamaño</th>
                <th>L × A × H (cm)</th>
                <th>Flauta</th>
                <th>ECT</th>
                <th>Peso vacío</th>
                <th>Peso máx.</th>
                <th>Disponibilidad</th>
              </tr>
            </thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td>{m.nombre}</td>
                  <td><strong>{m.lah}</strong></td>
                  <td>{m.flauta}</td>
                  <td>{m.ect}</td>
                  <td>{m.vacío}</td>
                  <td><strong>{m.máx}</strong></td>
                  <td>
                    <span class={`stock-chip stock-chip--${m.disp}`}>
                      {m.disp==="green"?"✓":m.disp==="yellow"?"⏱":"○"} {m.label}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">
          ✓ Stock permanente · ⏱ Producción rápida · ○ Pedido especial — 3 a 5 días hábiles. Pesos bajo condiciones estándar: 20°C y 50% HR.
        </p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-tx04-title">
      <div class="container">
        <h2 id="faq-tx04-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">
          Preguntas Técnicas — CAD-TX-04
        </h2>
        <div class="faq__list">
          {faqs.map(f => <FaqItem {...f} />)}
        </div>
      </div>
    </section>

  </main>

  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-TX-04 — Displays y exhibidores punto de venta, entrega 48-72 hrs CDMX" />

</PageLayout>
