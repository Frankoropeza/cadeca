---
import PageLayout    from "@/layouts/PageLayout.astro";
import FaqItem       from "@/components/FaqItem.astro";
import LeadCapture   from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Caja de Lujo y Premium para Moda CDMX | CAD-TX-10 | CADECA";
const description = "Caja de lujo corrugado blanco laminado para moda premium y couture en CDMX. Barniz UV, hot stamping opcional, acabados especiales. Fabricante directo CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const specs = [
  ["Código SKU",    "CAD-TX-10"],
  ["Tipo de pared", "Doble corrugado BC"],
  ["Flauta",        "BC (7mm)"],
  ["Resistencia",   "ECT-32"],
  ["Gramaje liner", "150–175 g/m²"],
  ["Material",      "Corrugado blanco laminado mate o brillante"],
  ["Cierre",        "Cierre magnético oculto o tapa-base"],
  ["Pedido mínimo", "200 piezas"],
  ["Entrega CDMX",  "24–48 hrs"],
];

const faqs = [
  {
    id: "tx10-f1",
    question: "¿Qué acabados especiales están disponibles para la caja de lujo CAD-TX-10?",
    answer: "La caja CAD-TX-10 ofrece una gama completa de acabados premium: laminado mate o brillante sobre corrugado blanco, barniz UV selectivo para resaltar logos y elementos gráficos, hot stamping en dorado, plateado, oro rosa o cualquier Pantone metálico, embossing/debossing para relieve y bajo relieve, y acabado soft touch para una textura aterciopelada. Todos los acabados son combinables entre sí desde 200 pzas.",
  },
  {
    id: "tx10-f2",
    question: "¿Para qué tipo de marcas de moda es ideal esta caja premium?",
    answer: "La CAD-TX-10 está diseñada para marcas de moda premium, couture, diseñadores independientes y casas de moda que requieren un empaque que comunique exclusividad. Es ideal para prendas de autor, colecciones cápsula, colaboraciones especiales, ediciones limitadas y regalos VIP. El unboxing de lujo genera contenido espontáneo en redes sociales y refuerza el posicionamiento de precio alto de la marca. Usada por boutiques de Polanco, Santa Fe y Masaryk.",
  },
  {
    id: "tx10-f3",
    question: "¿Pueden fabricar la caja con cierre magnético y apertura tipo libro?",
    answer: "Sí. Ofrecemos dos configuraciones de apertura de lujo: cierre magnético oculto con apertura frontal (tipo cofre) y apertura tipo libro con bisagra reforzada. Ambas incluyen imanes de neodimio encapsulados en el cartón que garantizan un cierre preciso y silencioso. La apertura tipo libro es particularmente impactante para prendas que se presentan horizontalmente. Desde 200 pzas con entrega en 7 días hábiles en CDMX.",
  },
];

const gallery = [
  { src: "/img/catalogo/caja-shopify-hero-cdmx.avif",           alt: "Caja de lujo premium para moda corrugado blanco — CAD-TX-10" },
  { src: "/img/catalogo/caja-shopify-unboxing-cdmx.avif",       alt: "Unboxing premium caja de lujo para moda CDMX" },
  { src: "/img/catalogo/caja-shopify-moda-cdmx.avif",           alt: "Caja premium para moda con acabados especiales" },
  { src: "/img/catalogo/caja-envio-tienda-online-shopify-cdmx.avif", alt: "Caja de lujo para envío de moda couture" },
  { src: "/img/catalogo/caja-accesorios-bolsas-premium-cdmx.avif",  alt: "Acabado premium con barniz UV y hot stamping" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Textil, Moda y Retail",href:"/catalogo/cajas-textil-moda-retail"},{name:"Lujo Premium"}]}
  faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
  product={{name:"Caja de Lujo y Premium para Moda",sku:"CAD-TX-10",description:"Caja corrugado blanco laminado con barniz UV y hot stamping para moda premium y couture",image:gallery[0].src,material:"Corrugado blanco BC laminado ECT-32",category:"Cajas para Textil, Moda y Retail",moq:"200"}}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container"><ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Catálogo</a></li>
      <li><a href="/catalogo/cajas-textil-moda-retail">Textil, Moda y Retail</a></li>
      <li><span class="current">Lujo Premium</span></li>
    </ol></div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-tx10-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-TX-10 · Textil, Moda y Retail</span>
      <h1 id="sku-tx10-title" class="cat-page-hero__title">
        Caja de <span>Lujo y Premium</span> para Moda
      </h1>
      <p class="cat-page-hero__desc">
        Corrugado blanco laminado con acabados de lujo: barniz UV selectivo, hot stamping, embossing y cierre magnético oculto. Diseñada para marcas premium, couture y ediciones limitadas. El empaque que tu marca de moda merece.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-TX-10</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-32</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>200 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-tx10-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-TX-10 · Familia: Textil, Moda y Retail</p>
            <h2 id="detalle-tx10-title" class="sku-detail__title">Caja de Lujo Premium — Moda y Couture</h2>
            <p class="sku-detail__desc">
              La caja CAD-TX-10 es nuestro empaque más exclusivo para la industria de la moda en CDMX. Corrugado blanco doble pared BC ECT-32 con laminado mate o brillante, barniz UV selectivo, hot stamping en metálicos y cierre magnético oculto con imanes de neodimio. Diseñada para marcas premium, diseñadores independientes, casas de couture y ediciones limitadas que necesitan un unboxing impactante. Ideal para boutiques de Polanco, Santa Fe y Masaryk con entrega en CDMX.
            </p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Laminado</span><span class="sku-detail__strip-label">Mate/Brillante</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Hot Stamp</span><span class="sku-detail__strip-label">Metálicos</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">200 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-TX-10 Caja Lujo Premium Moda`}
                 target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-TX-10</a>
              <a href="/catalogo/cajas-textil-moda-retail" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-faq" aria-labelledby="faq-tx10-title">
      <div class="container">
        <h2 id="faq-tx10-title" class="sku-faq__title">Preguntas Frecuentes — Lujo Premium para Moda</h2>
        <div class="sku-faq__list">
          {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="Tu marca de moda premium merece un empaque a la altura — Cotiza CAD-TX-10 en CDMX" />

</PageLayout>
