---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja para Joyería y Accesorios Premium CDMX | CAD-TX-07 | CADECA";
const description = "Caja corrugado blanco interior suave para joyería y accesorios premium en CDMX. Presentación de lujo, unboxing premium, doble pared ECT-32. Fabricante directo CADECA.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU",  "CAD-TX-07"],
 ["Tipo de pared", "Doble corrugado BC"],
 ["Flauta",  "BC (7mm)"],
 ["Resistencia",  "ECT-32"],
 ["Gramaje liner", "150 g/m²"],
 ["Material",  "Corrugado blanco premium / interior suave al tacto"],
 ["Cierre",  "Tapa y base separadas con cierre magnético opcional"],
 ["Pedido mínimo", "200 piezas"],
 ["Entrega CDMX",  "24–48 hrs"],
];

const faqs = [
 {
 id: "tx07-f1",
 question: "¿Qué tipo de acabado interior tiene la caja de joyería CAD-TX-07?",
 answer: "La caja CAD-TX-07 tiene un interior en corrugado blanco con laminado suave al tacto (soft touch) que protege piezas delicadas como anillos, pulseras, collares y relojes. Opcionalmente podemos agregar insert de espuma cortada a la medida con ranuras para cada pieza, o un forro de tela tipo gamuza adherido al interior. El resultado es una experiencia de unboxing premium que refuerza el posicionamiento de marcas de joyería y accesorios de lujo.",
 },
 {
 id: "tx07-f2",
 question: "¿Ofrecen opciones de personalización para marcas de joyería premium?",
 answer: "Sí. Disponemos de hot stamping en dorado, plateado o cualquier Pantone metálico sobre corrugado blanco, barniz UV selectivo para resaltar el logo, grabado en relieve (embossing) y ventana de acetato para exhibición del producto. También ofrecemos cierre magnético oculto para una apertura ceremonial. Todas estas opciones están disponibles desde 200 piezas con diseño de arte sin costo y entrega en 7 días hábiles en CDMX.",
 },
 {
 id: "tx07-f3",
 question: "¿La caja protege suficiente la joyería durante el envío por paquetería?",
 answer: "Absolutamente. La doble pared BC ECT-32 ofrece una resistencia al apilamiento de hasta 120 kg y protección contra impactos durante el transporte. El insert interior de espuma o cartón troquelado inmoviliza cada pieza, previniendo rayones y golpes. La caja ha sido probada bajo condiciones de envío por paquetería (Estafeta, DHL, Fedex) sin incidentes de daño. Ideal para joyerías con venta online y envío a domicilio.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-accesorios-bolsas-joyeria-cdmx.avif",  alt: "Caja joyería premium corrugado blanco — CAD-TX-07" },
 { src: "/img/catalogo/caja-accesorios-bolsas-premium-cdmx.avif",  alt: "Caja accesorios premium con acabado de lujo" },
 { src: "/img/catalogo/caja-accesorios-bolsas-interior-cdmx.avif", alt: "Interior suave al tacto para joyería delicada" },
 { src: "/img/catalogo/caja-accesorios-bolsas-hero-cdmx.avif",  alt: "Caja premium para accesorios y joyería CDMX" },
 { src: "/img/catalogo/caja-accesorios-bolsas-stack-cdmx.avif",  alt: "Apilado de cajas de joyería premium en almacén" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Textil, Moda y Retail",href:"/catalogo/cajas-textil-moda-retail"},{name:"Joyería Premium"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para Joyería y Accesorios Premium",sku:"CAD-TX-07",description:"Caja corrugado blanco con interior suave para joyería premium — unboxing de lujo",image:gallery[0].src,material:"Corrugado blanco BC ECT-32 interior soft touch",category:"Cajas para Textil, Moda y Retail",moq:"200"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container"><ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-textil-moda-retail">Textil, Moda y Retail</a></li>
 <li><span class="current">Joyería Premium</span></li>
 </ol></div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-tx07-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-TX-07 · Textil, Moda y Retail</span>
 <h1 id="sku-tx07-title" class="cat-page-hero__title">
 Caja para <span>Joyería y Accesorios Premium</span>
 </h1>
 <p class="cat-page-hero__desc">
 Corrugado blanco doble pared ECT-32 con interior suave al tacto para joyería, relojes y accesorios de lujo. Acabados de hot stamping, barniz UV selectivo y cierre magnético opcional. Presentación premium para tu marca.
 </p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-TX-07</strong></div>
 <div class="cat-page-hero__strip-item">ECT: <strong>ECT-32</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>200 pzas</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-tx07-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-TX-07 · Familia: Textil, Moda y Retail</p>
 <h2 id="detalle-tx07-title" class="sku-detail__title">Caja Joyería Premium — Interior Suave</h2>
 <p class="sku-detail__desc">
 La caja CAD-TX-07 es la solución de empaque para marcas de joyería y accesorios premium en CDMX. Corrugado blanco doble pared BC ECT-32 con laminado interior soft touch que protege piezas delicadas. Disponible con hot stamping, barniz UV selectivo, embossing y cierre magnético oculto para una experiencia de unboxing memorable. Insert de espuma o cartón troquelado a la medida para fijación segura de anillos, pulseras, collares y relojes.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Soft Touch</span><span class="sku-detail__strip-label">Interior</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Hot Stamp</span><span class="sku-detail__strip-label">Acabado</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">200 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-TX-07 Caja Joyería Premium`}
 target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-TX-07</a>
 <a href="/catalogo/cajas-textil-moda-retail" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-tx07-title">
 <div class="container">
 <h2 id="faq-tx07-title" class="sku-faq__title">Preguntas Frecuentes — Joyería Premium</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="Eleva tu marca de joyería con empaque premium — Cotiza CAD-TX-07 en CDMX" />

</PageLayout>
