---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja para Joyería y Accesorios | CADECA";
const description = "Caja corrugado blanco interior suave para joyería y accesorios premium en CDMX. Presentación de lujo, unboxing premium, doble pared ECT-32.";

const specs = [
 ["Código SKU",  "CAD-TX-07"],
 ["Tipo de pared", "Doble corrugado BC"],
 ["Flauta",  "BC (7mm)"],
 ["Resistencia",  "ECT-32"],
 ["Gramaje liner", "150 g/m²"],
 ["Material",  "Corrugado blanco premium / interior suave al tacto"],
 ["Cierre",  "Tapa y base separadas con cierre magnético opcional"],
 ["Pedido mínimo", "200 piezas"],
 ["Entrega CDMX",  "Según pedido"],
];

const faqs = [
 {
 id: "tx07-f1",
 question: "¿Cómo elijo la medida adecuada para cajas para joyería?",
 answer: "Mide el producto ya protegido y deja espacio para el cierre sin que el contenido se mueva. Comparte largo, ancho, alto, cantidad y uso en el formulario para revisar si conviene una medida estándar o un corte a la medida.",
 },
 {
 id: "tx07-f2",
 question: "¿Qué resistencia de cartón conviene para cajas para joyería?",
 answer: "La resistencia se elige por el peso, la forma del producto y el manejo previsto. El ECT indica la resistencia al aplastamiento del canto; una flauta simple sirve para protección general y una pared doble o triple aporta mayor rigidez.",
 },
 {
 id: "tx07-f3",
 question: "¿Se pueden personalizar cajas para joyería con impresión o acabado?",
 answer: "La personalización depende del material, el diseño y el proceso de impresión disponible para el pedido. Envía el arte, los colores requeridos y la cantidad en el formulario para confirmar la alternativa compatible con el empaque.",
 },
 {
 id: "tx07-f4",
 question: "¿Cómo debo almacenar cajas para joyería antes de utilizarlas?",
 answer: "Guarda el cartón en un lugar limpio, seco y sin contacto directo con el piso o muros húmedos. Mantén las piezas planas o apiladas de forma uniforme para evitar deformaciones antes de empacar.",
 },
 {
 id: "tx07-f5",
 question: "¿Qué datos necesito para cotizar cajas para joyería?",
 answer: "Indica medida, cantidad, tipo de producto, peso aproximado, uso y zona de entrega. Si hay impresión, agrega el archivo o una referencia visual; con esos datos se puede revisar material, flauta y formato adecuados.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-accesorios-bolsas-joyeria-cdmx.avif",  alt: "Caja joyería premium corrugado blanco — CAD-TX-07" },
 { src: "/img/catalogo/caja-accesorios-bolsas-premium-cdmx.avif",  alt: "Caja accesorios premium con acabado de lujo" },
 { src: "/img/catalogo/caja-accesorios-bolsas-interior-cdmx.avif", alt: "Interior suave al tacto para joyería delicada" },
 { src: "/img/catalogo/caja-accesorios-bolsas-hero-cdmx.avif",  alt: "Caja premium para accesorios y joyería CDMX" },
 { src: "/img/catalogo/caja-accesorios-bolsas-stack-cdmx.avif",  alt: "Apilado de cajas de joyería premium en almacén" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Textil, Moda y Retail",href:"/catalogo/cajas-textil-moda-retail/"},{name:"Joyería Premium"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja para Joyería y Accesorios Premium",sku:"CAD-TX-07",description:"Caja corrugado blanco con interior suave para joyería premium — unboxing de lujo",image:gallery[0].src,material:"Corrugado blanco BC ECT-32 interior soft touch",category:"Cajas para Textil, Moda y Retail",moq:"200"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container"><ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-textil-moda-retail/">Textil, Moda y Retail</a></li>
 <li><span class="current">Joyería Premium</span></li>
 </ol></div>
 </div>

 <PageHero
   id="sku-tx07-title"
   eyebrow="Textil y moda · SKU CAD-TX-07"
   titleHtml={true}
   title="Cajas para joyería <span>con presentación premium</span>"
   desc="Cajas para joyería, relojes y accesorios que requieren proteger la pieza y cuidar su presentación. Se configuran para marcas y tiendas con pedidos en CDMX y Estado de México."
   desc2="Se surte en corrugado blanco de doble pared con ECT-32 e interior suave al tacto. Puede incorporar hot stamping, barniz UV selectivo y cierre magnético opcional, para que las <strong>cajas para joyería personalizadas</strong> se adapten a la pieza y a su presentación.||CADECA coordina el suministro como proveedor de cajas para joyería. Indica medidas, cantidad, tipo de pieza y zona de entrega al cotizar; te asesoramos para elegir el cartón, el interior y los acabados de acuerdo con el uso."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-tx07-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-TX-07 · Familia: Textil, Moda y Retail</p>
 <h2 id="detalle-tx07-title" class="sku-detail__title">Caja Joyería Premium — Interior Suave</h2>
 <p class="sku-detail__desc">
 La caja CAD-TX-07 es la solución de empaque para marcas de joyería y accesorios premium en CDMX. Corrugado blanco doble pared BC ECT-32 con laminado interior soft touch que protege piezas delicadas. Disponible con hot stamping, barniz UV selectivo, embossing y cierre magnético oculto para una experiencia de unboxing memorable. Insert de espuma o cartón troquelado a la medida para fijación segura de anillos, pulseras, collares y relojes.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Soft Touch</span><span class="sku-detail__strip-label">Interior</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Hot Stamp</span><span class="sku-detail__strip-label">Acabado</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">200 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-TX-07 Caja Joyería Premium`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-TX-07</a>
 <a href="/catalogo/cajas-textil-moda-retail/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas para joyería" />

</PageLayout>
