---
import PageLayout   from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture  from "@/components/LeadCapture.astro";

const title       = "Catálogo de Productos CADECA | Cajas de Cartón Corrugado CDMX";
const description = "Catálogo técnico completo de cajas de cartón corrugado CADECA. Fichas técnicas, medidas, especificaciones ECT, flautas y precios mayoreo. CDMX y Estado de México.";
const WHATSAPP    = "5255XXXXXXXX";

const catalogSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Catálogo de Productos CADECA",
  "description": "Catálogo técnico completo de cajas de cartón corrugado en CDMX y Estado de México.",
  "url": "https://cadeca.com.mx/catalogo",
  "publisher": { "@type": "Organization", "name": "CADECA" }
};

const familias = [
  {
    chapter: "Capítulo 01",
    title:   "Cajas Corrugado Estándar",
    desc:    "Simple, doble y triple pared. La línea de mayor rotación y disponibilidad inmediata. Desde ECT-23 hasta ECT-71 con inventario permanente en CDMX.",
    imgSrc:  "/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif",
    imgAlt:  "Catálogo cajas de cartón corrugado estándar CADECA",
    href:    "/catalogo/cajas-corrugado-estandar",
    variants: 4,
    moq:     "Sin mínimo",
    entrega: "24-48 hrs",
    specs: [
      { label: "Tipos de pared", value: "Simple · Doble · Triple" },
      { label: "Rango ECT",      value: "ECT-23 a ECT-71" },
      { label: "Flautas",        value: "B · C · E · BC" },
      { label: "Medidas",        value: "+50 estándar" },
    ],
  },
  {
    chapter: "Capítulo 02",
    title:   "Cajas para E-commerce",
    desc:    "Medidas exactas para Mercado Libre, Amazon MX, DHL, FedEx y Estafeta. Stock permanente de las medidas oficiales de Mercado Envíos y Amazon Seller Central.",
    imgSrc:  "/img/productos/cajas-de-carton-para-ecommerce-mercado-libre-amazon-cdmx.avif",
    imgAlt:  "Catálogo cajas de cartón para e-commerce CADECA",
    href:    "/catalogo/cajas-para-ecommerce",
    variants: 4,
    moq:     "50 pzas",
    entrega: "24 hrs",
    specs: [
      { label: "Plataformas",   value: "ML · Amazon · DHL · FedEx" },
      { label: "Pared estándar",value: "Doble corrugado (BC)" },
      { label: "ECT",           value: "ECT-44" },
      { label: "Medidas",       value: "Chica · Med · Grande · XL" },
    ],
  },
  {
    chapter: "Capítulo 03",
    title:   "Cajas Personalizadas con Logo",
    desc:    "Impresión 1 color Pantone, 4 colores y full color CMYK. Acabados mate, brillante y soft touch. Diseño gráfico sin costo con prueba digital antes de producir.",
    imgSrc:  "/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif",
    imgAlt:  "Catálogo cajas de cartón personalizadas con logo CADECA",
    href:    "/catalogo/cajas-personalizadas-logo",
    variants: 4,
    moq:     "100 pzas",
    entrega: "3-5 días",
    specs: [
      { label: "Impresión",  value: "1 col · 4 col · Full CMYK" },
      { label: "Acabados",   value: "Mate · Brillante · Soft Touch" },
      { label: "Tintas",     value: "Base agua (ecológicas)" },
      { label: "Diseño",     value: "Gratis + prueba digital" },
    ],
  },
  {
    chapter: "Capítulo 04",
    title:   "Cajas a la Medida",
    desc:    "Cualquier dimensión exacta sin costo adicional. Diseño CAD gratuito en 24 horas. Asesoría técnica de ingeniería de empaque incluida en cada cotización.",
    imgSrc:  "/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif",
    imgAlt:  "Catálogo cajas de cartón a la medida CADECA",
    href:    "/catalogo/cajas-a-la-medida",
    variants: 4,
    moq:     "50 pzas",
    entrega: "3-5 días",
    specs: [
      { label: "Dimensiones",  value: "Cualquier L × A × H" },
      { label: "Tamaño máx.", value: "200 × 120 × 100 cm" },
      { label: "CAD",          value: "Gratis en 24 hrs" },
      { label: "Normas",       value: "FSC · ISTA · ASTM" },
    ],
  },
  {
    chapter: "Capítulo 05",
    title:   "Cajas para Alimentos",
    desc:    "Materiales aptos para contacto con alimentos según COFEPRIS. Resistentes a grasa, humedad y temperatura. Para pizza, dark kitchen, frutas y exportación orgánica.",
    imgSrc:  "/img/productos/cajas-de-carton-para-alimentos-pizza-restaurantes-cdmx.avif",
    imgAlt:  "Catálogo cajas de cartón para alimentos CADECA",
    href:    "/catalogo/cajas-para-alimentos",
    variants: 4,
    moq:     "Sin mínimo",
    entrega: "24-48 hrs",
    specs: [
      { label: "Norma",       value: "NOM-051 COFEPRIS" },
      { label: "Exportación", value: "FDA · Normas EU" },
      { label: "Resistencia", value: "Grasa · Humedad · Frío" },
      { label: "Tintas",      value: "Base agua (no migran)" },
    ],
  },
  {
    chapter: "Capítulo 06",
    title:   "Láminas y Empaques Ecológicos",
    desc:    "Cartón reciclado posconsumo (PCR) y certificación FSC Cadena de Custodia. Para fabricantes, marcas con metas ESG y exportadores con requerimientos ambientales.",
    imgSrc:  "/img/productos/laminas-carton-corrugado-ecologico-reciclado-fsc-cdmx.avif",
    imgAlt:  "Catálogo láminas cartón corrugado ecológico FSC CADECA",
    href:    "/catalogo/laminas-carton-corrugado",
    variants: 4,
    moq:     "Por m²",
    entrega: "48-72 hrs",
    specs: [
      { label: "Material",       value: "PCR reciclado posconsumo" },
      { label: "Certificación",  value: "FSC Cadena de Custodia" },
      { label: "Documentación",  value: "ESG · GRI · TCFD" },
      { label: "Gramaje",        value: "115 – 175 g/m²" },
    ],
  },
];
---

<PageLayout title={title} description={description} schema={catalogSchema} whatsapp={WHATSAPP}>

  <!-- HERO -->
  <section class="catalog-hero" aria-labelledby="catalogo-title">
    <div class="container">
      <div class="catalog-hero__inner">
        <span class="catalog-hero__eyebrow">📋 Catálogo Técnico 2025–2026</span>
        <h1 id="catalogo-title" class="catalog-hero__title">
          Catálogo de <span>Cajas de Cartón</span><br>Corrugado CADECA
        </h1>
        <p class="catalog-hero__subtitle">
          Fichas técnicas completas con especificaciones ECT, flautas, medidas disponibles, pedido mínimo y tiempos de entrega. Fabricante directo en CDMX y Estado de México.
        </p>
        <div class="catalog-hero__meta">
          <div class="catalog-hero__meta-item">
            <span>Familias de producto:</span>
            <strong>6 capítulos</strong>
          </div>
          <div class="catalog-hero__meta-item">
            <span>Variantes totales:</span>
            <strong>24+ SKUs</strong>
          </div>
          <div class="catalog-hero__meta-item">
            <span>Actualizado:</span>
            <strong>2025–2026</strong>
          </div>
          <div class="catalog-hero__meta-item">
            <span>Zona de entrega:</span>
            <strong>CDMX y Estado de México</strong>
          </div>
        </div>
        <div class="catalog-hero__ctas">
          <a href="#familias"                    class="btn btn--primary">Ver Catálogo Completo</a>
          <a href={`https://wa.me/${WHATSAPP}`}
             target="_blank" rel="noopener"     class="btn btn--outline">Solicitar por WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- NAV DEL CATÁLOGO -->
  <nav class="catalog-nav" aria-label="Navegación del catálogo">
    <div class="container">
      <div class="catalog-nav__inner">
        <div class="catalog-nav__breadcrumb">
          <a href="/">Inicio</a>
          <span class="sep">/</span>
          <span>Catálogo</span>
        </div>
        <div class="catalog-nav__actions">
          {familias.map(f => (
            <a href={f.href} class="catalog-nav__chapter-link">{f.chapter.replace("Capítulo ","Cap.")}</a>
          ))}
        </div>
      </div>
    </div>
  </nav>

  <main id="contenido-principal" role="main">

    <!-- ÍNDICE DE FAMILIAS -->
    <section class="catalog-index" id="familias" aria-labelledby="idx-title">
      <div class="container">
        <SectionHeader
          id="idx-title"
          twoCol
          title="Catálogo CADECA: 6 Familias de Producto"
          subtitle="Selecciona la familia que necesitas para ver la ficha técnica completa con todas las variantes, medidas y especificaciones."
        >
          <p>Cada familia de producto está documentada con fichas técnicas detalladas: especificaciones de material, flautas disponibles, resistencia ECT, tabla de medidas estándar, pedido mínimo y tiempos de producción. La información que necesita tu equipo de compras o producción para tomar la decisión correcta.</p>
          <p>¿No encuentras lo que necesitas? Fabricamos cajas a la medida en cualquier dimensión. <a href="/catalogo/cajas-a-la-medida" style="color:var(--color-primary);font-weight:700;">Ver capítulo de medidas especiales →</a></p>
        </SectionHeader>

        <div class="catalog-index__grid">
          {familias.map(f => (
            <article class="catalog-card">
              <div class="catalog-card__img-wrap">
                <img
                  src={f.imgSrc}
                  alt={f.imgAlt}
                  class="catalog-card__img"
                  width="640" height="360"
                  loading="lazy"
                  decoding="async"
                />
                <span class="catalog-card__chapter">{f.chapter}</span>
                <span class="catalog-card__variants-count">{f.variants} variantes</span>
              </div>
              <div class="catalog-card__body">
                <h2 class="catalog-card__title">{f.title}</h2>
                <p class="catalog-card__desc">{f.desc}</p>
                <div class="catalog-card__specs">
                  {f.specs.map(s => (
                    <div class="catalog-card__spec">
                      <span class="catalog-card__spec-label">{s.label}</span>
                      <span class="catalog-card__spec-value">{s.value}</span>
                    </div>
                  ))}
                </div>
                <div class="catalog-card__footer">
                  <a href={f.href} class="catalog-card__link">
                    Ver ficha técnica →
                  </a>
                  <span class="catalog-card__moq">MOQ: {f.moq}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- TABLA RESUMEN GENERAL -->
    <section class="catalog-summary" aria-labelledby="summary-title">
      <div class="container">
        <h2 id="summary-title" class="catalog-summary__title">Resumen de Familias — Comparativa General</h2>
        <p class="catalog-summary__subtitle">Vista rápida de todas las familias para facilitar la selección del producto correcto</p>
        <div class="catalog-summary__table-wrap">
          <table class="catalog-summary__table">
            <thead>
              <tr>
                <th>Familia</th>
                <th>Variantes</th>
                <th>ECT disponible</th>
                <th>Pedido mínimo</th>
                <th>Entrega CDMX</th>
                <th>Personalización</th>
                <th>Certificación</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><a href="/catalogo/cajas-corrugado-estandar" style="color:var(--color-primary-light)">Corrugado Estándar</a></td>
                <td>Simple · Doble · Triple · Mudanza</td>
                <td>ECT-23 a ECT-71</td>
                <td>Sin mínimo</td>
                <td>24 – 48 hrs</td>
                <td>Logo opcional</td>
                <td>FSC disponible</td>
              </tr>
              <tr class="recommended">
                <td><a href="/catalogo/cajas-para-ecommerce" style="color:var(--color-primary-light)">E-commerce</a></td>
                <td>ML · Amazon · Paqueterías · Tienda</td>
                <td>ECT-44 (estándar)</td>
                <td>50 pzas</td>
                <td>24 hrs</td>
                <td>Logo desde 100 pzas</td>
                <td>FSC disponible</td>
              </tr>
              <tr>
                <td><a href="/catalogo/cajas-personalizadas-logo" style="color:var(--color-primary-light)">Personalizadas</a></td>
                <td>1 col · Full Color · Premium · Unboxing</td>
                <td>A especificar</td>
                <td>100 pzas</td>
                <td>3 – 5 días</td>
                <td>Full color CMYK</td>
                <td>Tintas base agua</td>
              </tr>
              <tr>
                <td><a href="/catalogo/cajas-a-la-medida" style="color:var(--color-primary-light)">A la Medida</a></td>
                <td>Exactas · Alta ECT · Flautas · Industrial</td>
                <td>A calcular</td>
                <td>50 pzas</td>
                <td>3 – 5 días</td>
                <td>Logo opcional</td>
                <td>FSC · ISTA · ASTM</td>
              </tr>
              <tr>
                <td><a href="/catalogo/cajas-para-alimentos" style="color:var(--color-primary-light)">Para Alimentos</a></td>
                <td>Pizza · Dark Kitchen · Frutas · Orgánicos</td>
                <td>ECT-32 / ECT-44</td>
                <td>Sin mínimo</td>
                <td>24 – 48 hrs</td>
                <td>Logo en tintas no migran</td>
                <td>NOM · FDA · FSC</td>
              </tr>
              <tr>
                <td><a href="/catalogo/laminas-carton-corrugado" style="color:var(--color-primary-light)">Ecológicas FSC</a></td>
                <td>Láminas m² · PCR · FSC · Cajas eco</td>
                <td>ECT estándar</td>
                <td>Por m²</td>
                <td>48 – 72 hrs</td>
                <td>Tintas vegetales</td>
                <td>FSC · PCR · ESG</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- SEO CONTENT -->
    <section class="seo-content" aria-labelledby="seo-cat-title">
      <div class="container">
        <h2 id="seo-cat-title" class="seo-content__title">
          Catálogo Técnico de Cajas de Cartón Corrugado en CDMX — CADECA
        </h2>
        <p class="seo-content__text">
          El catálogo técnico de CADECA es la referencia completa para equipos de compras, producción y logística que necesitan especificaciones exactas antes de cotizar. Cada ficha técnica incluye: tipo de material, rango de resistencia ECT, flautas disponibles, tabla de medidas estándar con pesos y cargas máximas, pedido mínimo y tiempos de entrega en CDMX y Estado de México. Como <strong>fabricante de cajas de cartón corrugado en la Ciudad de México</strong>, producimos directamente sin intermediarios — lo que significa información técnica real y precios competitivos sin márgenes de distribución.
        </p>
        <p class="seo-content__text">
          Nuestro catálogo cubre las 6 familias de producto más demandadas en el mercado metropolitano: <a href="/catalogo/cajas-corrugado-estandar">corrugado estándar</a> (la línea de mayor rotación con stock permanente), <a href="/catalogo/cajas-para-ecommerce">cajas para e-commerce</a> (Mercado Libre, Amazon, DHL y FedEx), <a href="/catalogo/cajas-personalizadas-logo">cajas personalizadas con logo</a> (desde 1 color hasta full color CMYK), <a href="/catalogo/cajas-a-la-medida">cajas a la medida</a> (cualquier dimensión con CAD gratis), <a href="/catalogo/cajas-para-alimentos">cajas para alimentos</a> (certificadas COFEPRIS) y <a href="/catalogo/laminas-carton-corrugado">empaques ecológicos FSC</a>. Para solicitar cotización con referencia a algún capítulo específico, contáctanos por WhatsApp con el número de capítulo y variante.
        </p>
      </div>
    </section>

  </main>

  <LeadCapture whatsapp={WHATSAPP} title="¿Necesitas asesoría técnica? Tu consultor CADECA responde en menos de 2 horas" />

</PageLayout>
