---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja a la Medida Exportación IATA/ISTA CDMX | CAD-AM-08 | CADECA";
const description = "Cajas a la medida para exportación IATA/ISTA en CDMX. Certificación ISTA-1A, apta carga aérea y marítima, ECT-51/61. MOQ 25 pzas. CADECA fabricante directo.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU",  "CAD-AM-08"],
 ["Tipo de pared", "Doble o triple corrugado BC/BCB"],
 ["Flauta",  "BC (7mm) / BCB (12mm)"],
 ["Resistencia",  "ECT-51 / ECT-61"],
 ["Gramaje liner", "175–200 g/m²"],
 ["Material",  "Kraft virgen alta resistencia"],
 ["Cierre",  "4 solapas con refuerzo y esquineros"],
 ["Pedido mínimo", "25 piezas"],
 ["Entrega CDMX",  "5–7 días hábiles"],
];

const faqs = [
 {
 id:"am08-f1",
 question:"¿Qué diferencia hay entre certificación ISTA y normas IATA para cajas de exportación?",
 answer:"ISTA (International Safe Transit Association) es un estándar de pruebas de empaque que simula el ciclo completo de distribución: vibración, impacto, compresión y humedad. La certificación ISTA-1A es la más básica para envíos de hasta 68 kg por tierra o aire. IATA (International Air Transport Association) establece regulaciones operativas para carga aérea que incluyen restricciones de dimensión, peso y materiales peligrosos. En CADECA diseñamos las cajas para cumplir ambos estándares simultáneamente, usando ECT-51 para aéreo y ECT-61 triple corrugado para marítimo.",
 },
 {
 id:"am08-f2",
 question:"¿Necesito esquineros en mis cajas de exportación? ¿Vienen incluidos?",
 answer:"Los esquineros son altamente recomendables para exportación, especialmente en carga aérea donde las cajas pueden recibir impactos laterales en el manejo aeroportuario. Aumentan la resistencia a la compresión vertical hasta un 60% adicional. En el SKU CAD-AM-08 los esquineros de cartón de 50mm se incluyen en la cotización base para pedidos de 25 piezas o más. También ofrecemos esquineros de espuma de polietileno para productos de alto valor que requieren amortiguación adicional.",
 },
 {
 id:"am08-f3",
 question:"¿Puedo incluir documentación de certificación del empaque para mis clientes en el extranjero?",
 answer:"Sí. Para exportaciones que requieren documentación técnica del empaque, emitimos la ficha técnica del cartón con gramajes, ECT real medido en laboratorio, BCT estimado y conformidad con estándares ISTA aplicables. Este documento es aceptado por clientes en USA, Canadá, Europa y Asia como evidencia de calidad del empaque. El tiempo adicional para preparar esta documentación es de 2 días hábiles y no tiene costo adicional en pedidos de 25 piezas o más.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-medida-export-hero-cdmx.avif",  alt: "Caja a la medida exportación IATA ISTA CDMX" },
 { src: "/img/catalogo/caja-medida-export-container-cdmx.avif",  alt: "Cajas exportación en contenedor marítimo" },
 { src: "/img/catalogo/caja-medida-export-refuerzo-cdmx.avif",  alt: "Detalle refuerzo caja exportación CDMX" },
 { src: "/img/catalogo/caja-medida-export-ventilacion-cdmx.avif",  alt: "Ventilación caja para exportación" },
 { src: "/img/catalogo/cajas-medida-exportacion-normas-iata-cdmx.avif", alt: "Cajas exportación normas IATA ISTA" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas a la Medida",href:"/catalogo/cajas-a-la-medida"},{name:"Exportación IATA/ISTA"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja a la Medida para Exportación IATA/ISTA",sku:"CAD-AM-08",description:"Caja a la medida para exportación con certificación IATA/ISTA en CDMX — CADECA",image:gallery[0].src,material:"Cartón doble/triple corrugado ECT-51/61 para exportación",category:"Cajas a la Medida",moq:"25"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-a-la-medida">Cajas a la Medida</a></li>
 <li><span class="current">Exportación IATA/ISTA</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-am08-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-AM-08 · Cajas a la Medida</span>
 <h1 id="sku-am08-title" class="cat-page-hero__title">Caja a la Medida para <span>Exportación IATA/ISTA</span><br>— CDMX</h1>
 <p class="cat-page-hero__desc">Cajas de cartón corrugado que cumplen normas internacionales IATA y certificación ISTA-1A. Aptas para carga aérea y marítima. ECT-51 para aéreo, ECT-61 triple corrugado para contenedor. MOQ desde 25 piezas con documentación técnica incluida.</p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AM-08</strong></div>
 <div class="cat-page-hero__strip-item">ECT: <strong>ECT-51/61</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>25 pzas</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-am08-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AM-08 · Familia: Cajas a la Medida</p>
 <h2 id="detalle-am08-title" class="sku-detail__title">Caja a la Medida para Exportación IATA/ISTA</h2>
 <p class="sku-detail__desc">Cajas de exportación fabricadas a la medida exacta con certificación ISTA-1A y cumplimiento de normas IATA para carga aérea y marítima. Doble corrugado BC ECT-51 para envíos aéreos y triple corrugado BCB ECT-61 para contenedores marítimos. Esquineros incluidos, liner kraft virgen de alto gramaje y documentación técnica de calidad disponible para tus clientes internacionales. CADECA, fabricante de cajas de exportación en CDMX con más de 20 años de experiencia.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ISTA-1A</span><span class="sku-detail__strip-label">Certificación</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-51/61</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">25 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5–7 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AM-08 Caja a la Medida Exportación IATA/ISTA`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AM-08</a>
 <a href="/catalogo/cajas-a-la-medida" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-am08-title">
 <div class="container">
 <h2 id="faq-am08-title" class="sku-faq__title">Preguntas Frecuentes — Caja Exportación IATA/ISTA</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="Exporta con confianza — Cotiza tu Caja IATA/ISTA a la Medida" />
</PageLayout>
