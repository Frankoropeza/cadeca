---
import PageLayout    from "@/layouts/PageLayout.astro";
import FaqItem       from "@/components/FaqItem.astro";
import LeadCapture   from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Caja a la Medida Estándar Personalizada CDMX | CAD-AM-06 | CADECA";
const description = "Cajas a la medida estándar personalizadas en CDMX. Medidas exactas desde diseño CAD, ECT-32/44, MOQ 50 pzas. Para productos que no caben en tallas estándar. CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const specs = [
  ["Código SKU",    "CAD-AM-06"],
  ["Tipo de pared", "Simple o doble corrugado BC"],
  ["Flauta",        "C (4mm) o BC (7mm)"],
  ["Resistencia",   "ECT-32 / ECT-44"],
  ["Gramaje liner", "127–150 g/m²"],
  ["Material",      "Kraft virgen o reciclado"],
  ["Cierre",        "4 solapas RSC estándar"],
  ["Pedido mínimo", "50 piezas"],
  ["Entrega CDMX",  "3–5 días hábiles"],
];

const faqs = [
  {
    id:"am06-f1",
    question:"¿Qué ventajas tiene una caja estándar personalizada frente a una talla fija de catálogo?",
    answer:"Una caja a la medida estándar se diseña con las dimensiones exactas de tu producto, eliminando el espacio muerto interior. Esto reduce el peso volumétrico que cobran las paqueterías, disminuye el uso de relleno como papel arrugado o air pillows, y protege mejor el producto al evitar movimiento interno. Además, la imagen de tu empaque se ve más profesional y cuidada, lo que impacta positivamente en la experiencia de tu cliente. En CADECA fabricamos desde 50 piezas con diseño CAD gratuito en 24 horas.",
  },
  {
    id:"am06-f2",
    question:"¿Qué información necesito para solicitar una caja a la medida estándar?",
    answer:"Para cotizar necesitas proporcionar las tres dimensiones de tu producto: largo, ancho y alto en centímetros o milímetros. También es útil conocer el peso del producto para recomendarte el ECT adecuado (ECT-32 hasta 15 kg, ECT-44 hasta 30 kg). Si tienes varios productos con dimensiones similares, podemos optimizar una medida que sirva para todos y reducir el costo por pieza. Nuestros asesores solicitan esos datos por WhatsApp y entregan la cotización el mismo día hábil.",
  },
  {
    id:"am06-f3",
    question:"¿Cuánto tiempo toma producir una caja a la medida por primera vez?",
    answer:"El proceso completo desde primer contacto hasta entrega es de 5 a 7 días hábiles en pedidos nuevos: 1 día para diseño CAD, 1 día para revisión y aprobación del cliente, y 3 a 5 días de producción e impresión. En pedidos de reposición (mismo diseño aprobado) el tiempo se reduce a 3 días hábiles. Para urgencias menores a 48 horas contacta a nuestro equipo para evaluar disponibilidad de producción acelerada.",
  },
];

const gallery = [
  { src: "/img/catalogo/caja-medida-estandar-hero-cdmx.avif",   alt: "Caja a la medida estándar personalizada CDMX" },
  { src: "/img/catalogo/caja-medida-estandar-fit-cdmx.avif",    alt: "Caja a la medida ajustada al producto" },
  { src: "/img/catalogo/caja-medida-estandar-tallas-cdmx.avif", alt: "Diferentes tallas de cajas a la medida" },
  { src: "/img/catalogo/caja-medida-estandar-tecnica-cdmx.avif",alt: "Vista técnica caja medida estándar" },
  { src: "/img/catalogo/cajas-medida-industrial-reforzada-cdmx.avif", alt: "Cajas a la medida CADECA" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas a la Medida",href:"/catalogo/cajas-a-la-medida"},{name:"Estándar Personalizada"}]}
  faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
  product={{name:"Caja a la Medida Estándar Personalizada",sku:"CAD-AM-06",description:"Caja de cartón a la medida estándar personalizada en CDMX — CADECA",image:gallery[0].src,material:"Cartón simple/doble corrugado ECT-32/44 a la medida",category:"Cajas a la Medida",moq:"50"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-a-la-medida">Cajas a la Medida</a></li>
        <li><span class="current">Estándar Personalizada</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-am06-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-AM-06 · Cajas a la Medida</span>
      <h1 id="sku-am06-title" class="cat-page-hero__title">Caja a la Medida <span>Estándar Personalizada</span><br>— CDMX</h1>
      <p class="cat-page-hero__desc">Cajas de cartón corrugado fabricadas con las medidas exactas de tu producto desde diseño CAD. ECT-32 o ECT-44 según carga. Sin espacio muerto, sin relleno innecesario. Diseño CAD gratuito en 24 horas con MOQ desde 50 piezas.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-AM-06</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-32/44</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>50 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-am06-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-AM-06 · Familia: Cajas a la Medida</p>
            <h2 id="detalle-am06-title" class="sku-detail__title">Caja a la Medida Estándar Personalizada</h2>
            <p class="sku-detail__desc">Fabricamos cajas de cartón corrugado en cualquier dimensión exacta según el diseño CAD de tu producto. Ideal para empresas cuyos artículos no encajan en tallas estándar de catálogo. Corrugado simple flauta C (ECT-32) para productos ligeros hasta 15 kg, o doble corrugado BC (ECT-44) para cargas hasta 30 kg. Entrega en CDMX en 3 a 5 días hábiles desde aprobación del diseño. CADECA, fabricante directo sin intermediarios.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32/44</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">CAD Gratis</span><span class="sku-detail__strip-label">Diseño 24 hrs</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3–5 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-AM-06 Caja a la Medida Estándar Personalizada`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-AM-06</a>
              <a href="/catalogo/cajas-a-la-medida" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-faq" aria-labelledby="faq-am06-title">
      <div class="container">
        <h2 id="faq-am06-title" class="sku-faq__title">Preguntas Frecuentes — Caja a la Medida Estándar</h2>
        <div class="sku-faq__list">
          {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="Cotiza tu Caja Estándar Personalizada — Diseño CAD gratis en 24 hrs, desde 50 piezas" />
</PageLayout>
