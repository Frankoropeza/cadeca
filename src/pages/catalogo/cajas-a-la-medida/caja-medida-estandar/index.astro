---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja de Cartón a la Medida Estándar | CADECA";
const description = "Cajas a la medida estándar personalizadas en CDMX. Medidas exactas desde diseño CAD, ECT-32/44, MOQ 50 pzas.";

const specs = [
 ["Código SKU",  "CAD-AM-06"],
 ["Tipo de pared", "Simple o doble corrugado BC"],
 ["Flauta",  "C (4mm) o BC (7mm)"],
 ["Resistencia",  "ECT-32 / ECT-44"],
 ["Gramaje liner", "127–150 g/m²"],
 ["Material",  "Kraft virgen o reciclado"],
 ["Cierre",  "4 solapas RSC estándar"],
 ["Pedido mínimo", "50 piezas"],
 ["Entrega CDMX",  "3–5 días hábiles"],
];

const faqs = [
 {
 id:"am06-f1",
 question:"¿Qué ventajas tiene una caja estándar personalizada frente a una talla fija de catálogo?",
 answer:"Una caja a la medida estándar se diseña con las dimensiones exactas de tu producto, eliminando el espacio muerto interior. Esto reduce el peso volumétrico que cobran las paqueterías, disminuye el uso de relleno como papel arrugado o air pillows, y protege mejor el producto al evitar movimiento interno. Además, la imagen de tu empaque se ve más profesional y cuidada, lo que impacta positivamente en la experiencia de tu cliente. En CADECA surtimos desde 50 piezas con diseño CAD gratuito.",
 },
 {
 id:"am06-f2",
 question:"¿Qué información necesito para solicitar una caja a la medida estándar?",
 answer:"Para cotizar necesitas proporcionar las tres dimensiones de tu producto: largo, ancho y alto en centímetros o milímetros. También es útil conocer el peso del producto para recomendarte el ECT adecuado (ECT-32 hasta 15 kg, ECT-44 hasta 30 kg). Si tienes varios productos con dimensiones similares, podemos optimizar una medida que sirva para todos y reducir el costo por pieza. Te orientamos para elegir la caja correcta y te respondemos en horario hábil.",
 },
 {
 id:"am06-f3",
 question:"¿Cuánto tiempo toma producir una caja a la medida por primera vez?",
 answer:"El proceso completo desde primer contacto hasta entrega se confirma según pedido: incluye diseño CAD, revisión y aprobación del cliente, y coordinación de producción e impresión. En pedidos de reposición se revisa la disponibilidad del diseño aprobado. Para urgencias consulta disponibilidad.",
 },
 { id:"am06-f4", question:"¿Cómo se toman las medidas para una caja de cartón a la medida?", answer:"Mide el producto ya armado en largo, ancho y alto, y considera separadores o protección si los llevará dentro. Esas medidas permiten valorar el espacio interior y evitar que el producto quede suelto o presionado durante el manejo." },
 { id:"am06-f5", question:"¿Puedo agregar impresión a una caja estándar personalizada?", answer:"La impresión puede incluirse para identificación, instrucciones o marca, según el arte y el número de tintas. Envía el diseño y la cantidad requerida en el formulario para revisar las caras disponibles y el método de impresión apropiado." },
];

const gallery = [
 { src: "/img/catalogo/caja-medida-estandar-hero-cdmx.avif",  alt: "Caja a la medida estándar personalizada CDMX" },
 { src: "/img/catalogo/caja-medida-estandar-fit-cdmx.avif",  alt: "Caja a la medida ajustada al producto" },
 { src: "/img/catalogo/caja-medida-estandar-tallas-cdmx.avif", alt: "Diferentes tallas de cajas a la medida" },
 { src: "/img/catalogo/caja-medida-estandar-tecnica-cdmx.avif",alt: "Vista técnica caja medida estándar" },
 { src: "/img/catalogo/cajas-medida-industrial-reforzada-cdmx.avif", alt: "Cajas a la medida CADECA" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas a la Medida",href:"/catalogo/cajas-a-la-medida/"},{name:"Estándar Personalizada"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja a la Medida Estándar Personalizada",sku:"CAD-AM-06",description:"Caja de cartón a la medida estándar personalizada en CDMX — CADECA",image:gallery[0].src,material:"Cartón simple/doble corrugado ECT-32/44 a la medida",category:"Cajas a la Medida",moq:"50"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-a-la-medida/">Cajas a la Medida</a></li>
 <li><span class="current">Estándar Personalizada</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-am06-title"
   eyebrow="Cajas a la medida · SKU CAD-AM-06"
   titleHtml={true}
   title="Caja de cartón a la medida <span>estándar</span>"
   desc="Caja de cartón a la medida estándar para productos que requieren dimensiones definidas y ECT-32 o ECT-44 según carga. Es una alternativa para empaque y distribución."
   desc2="Las <strong>cajas con medidas especiales</strong> se revisan con las dimensiones del producto y el nivel de carga. Se surte en cartón corrugado con ECT-32 o ECT-44 para definir una caja que reduzca espacio libre y la necesidad de material de relleno.||Para una <strong>caja con medidas especiales</strong>, el ajuste interior y la carga definen si conviene ECT-32 o ECT-44. Para cotizar, comparte largo, ancho y alto internos, peso del contenido, tipo de relleno y cantidad requerida; CADECA revisa la configuración de corrugado aplicable."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-am06-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AM-06 · Familia: Cajas a la Medida</p>
 <h2 id="detalle-am06-title" class="sku-detail__title">Caja a la Medida Estándar Personalizada</h2>
 <p class="sku-detail__desc">Surtimos cajas de cartón corrugado en cualquier dimensión exacta según el diseño CAD de tu producto. Ideal para empresas cuyos artículos no encajan en tallas estándar de catálogo. Corrugado simple flauta C (ECT-32) para productos ligeros hasta 15 kg, o doble corrugado BC (ECT-44) para cargas hasta 30 kg. Entrega programada según pedido en CDMX desde la aprobación del diseño. CADECA trabaja con talleres especializados.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32/44</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">CAD Gratis</span><span class="sku-detail__strip-label">Diseño según pedido</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3–5 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-AM-06 Caja a la Medida Estándar Personalizada`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-AM-06</a>
 <a href="/catalogo/cajas-a-la-medida/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="caja de cartón a la medida estándar" />
</PageLayout>
