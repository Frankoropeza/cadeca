---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas Industriales a la Medida ECT-44/51 | CADECA";
const description = "Ficha técnica cajas a la medida industrial en CDMX. ECT-44 o ECT-51 según carga, hasta 50 kg, CAD gratis, entrega según pedido.";

const medidas = [
 { talla:"S hasta 10kg",  ml:"A definir", real:"A definir", flauta:"BC",ect:"ECT-44",vacío:"varía",máx:"10 kg",  disp:"yellow", label:"3-5 días",  hl:false },
 { talla:"M hasta 20kg",  ml:"A definir", real:"A definir", flauta:"BC",ect:"ECT-44",vacío:"varía",máx:"20 kg",  disp:"yellow", label:"3-5 días",  hl:true  },
 { talla:"L hasta 30kg",  ml:"A definir", real:"A definir", flauta:"BC",ect:"ECT-44/51",vacío:"varía",máx:"30 kg",  disp:"yellow", label:"3-5 días",  hl:true  },
 { talla:"XL hasta 50kg", ml:"A definir", real:"A definir", flauta:"BC",ect:"ECT-51",vacío:"varía",máx:"50 kg",  disp:"gray",  label:"5-7 días",  hl:false },
 { talla:"XXL >50kg",  ml:"A definir", real:"A definir", flauta:"BCB",ect:"ECT-61",vacío:"varía",máx:"+50 kg", disp:"gray",  label:"Consultar", hl:false },
 { talla:"A la medida",  ml:"Personalizada", real:"A definir", flauta:"—",ect:"—",vacío:"—",máx:"—", disp:"gray", label:"Consultar", hl:false },
];

const specs = [
 ["Código SKU",  "CAD-AM-01"],
 ["Tipo",  "A la medida — cualquier L×A×H"],
 ["Tipo de pared",  "Doble corrugado BC"],
 ["ECT disponible",  "ECT-44 / ECT-51 a elegir"],
 ["Peso máx. producto",  "Hasta 50 kg con ECT-51"],
 ["Diseño CAD",  "Gratis"],
 ["Gramaje liner",  "150-175 g/m² · 175-200 g/m²"],
 ["Aplicaciones",  "Manufactura · Distribución · Automotive · Electrónica"],
 ["Esquineros",  "Opcionales — sin costo extra"],
 ["Certificación",  "ECT verificado en laboratorio"],
 ["Pedido mínimo",  "50 piezas"],
 ["Entrega CDMX",  "3-5 días hábiles desde aprobación CAD"],
];

const faqs = [
 {
 id:"am01-f1",
 question:"¿Cómo sé qué ECT necesito para mi producto industrial?",
 answer:"El ECT (Edge Crush Test) define la resistencia del corrugado. Regla práctica: productos hasta 15 kg → ECT-32; 15-30 kg → ECT-44; 30-50 kg → ECT-51; más de 50 kg → ECT-61 (triple corrugado). Sin embargo, también importa el método de apilamiento: cajas apiladas en tarima 4 niveles necesitan mayor ECT que una caja que va sola. Nuestros asesores realizan el cálculo de BCT (Box Compression Test) estimado gratis para confirmar el ECT correcto para tu aplicación específica.",
 },
 {
 id:"am01-f2",
 question:"¿Qué son los esquineros de cartón y cuándo se usan con cajas industriales?",
 answer:"Los esquineros son perfiles de cartón corrugado en forma de ángulo recto de 90° que se colocan en las esquinas verticales de la caja o de la tarima. Aumentan la resistencia al aplastamiento vertical en un 40-60% adicional al ECT de la caja base. Se usan cuando: el producto es pesado y se apila en múltiples niveles, la caja viajará en camión por largas distancias con vibración, o el cliente exige protección de esquinas visible. CADECA los fabrica a la medida sin costo extra en pedidos de 50+ piezas que los incluyan.",
 },
 { id:"am01-f3", question:"¿Qué diferencia hay entre corrugado simple, doble y triple?", answer:"La pared simple tiene una flauta entre dos liners; la doble incorpora dos flautas y la triple tres. La elección responde al peso, tamaño, apilamiento y manejo del producto, además de la protección interna que llevará." },
 { id:"am01-f4", question:"¿Cómo se toman las medidas de una caja industrial a la medida?", answer:"Mide largo, ancho y alto del producto, incluyendo salientes, y define si llevará protección interna. Añade el peso y la forma de acomodo para valorar el espacio útil, el tipo de cartón y el cierre adecuado." },
 { id:"am01-f5", question:"¿Qué información requiere una cotización de caja industrial?", answer:"Envía por el formulario dimensiones, peso, cantidad, uso y condiciones de almacenaje o transporte. Si habrá tarima, apilamiento o impresión, inclúyelo para revisar la especificación de corrugado y acabados disponibles." },
];

const mainImg = "/img/catalogo/cajas-medida-industrial-reforzada-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/cajas-medida-industrial-reforzada-cdmx.avif", alt: "Caja medida industrial — principal" },
 { src: "/img/catalogo/caja-medida-industrial-hero-cdmx.avif", alt: "Industrial — hero" },
 { src: "/img/catalogo/caja-medida-industrial-carga-cdmx.avif", alt: "Caja industrial — carga" },
 { src: "/img/catalogo/caja-medida-industrial-rack-cdmx.avif", alt: "Cajas industriales — rack" },
 { src: "/img/catalogo/caja-medida-industrial-detalle-cdmx.avif", alt: "Caja industrial — detalle esquina" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"Cajas a la Medida", href:"/catalogo/cajas-a-la-medida/"}, {name:"Industrial Reforzada"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja a la Medida Industrial Reforzada", sku:"CAD-AM-01", description:"Caja a la Medida Industrial Reforzada en CDMX — proveedor CADECA", image:"/img/catalogo/cajas-medida-industrial-reforzada-cdmx.avif", material:"Cartón doble corrugado BC ECT-44/51 a la medida para uso industrial", category:"Cajas a la Medida", moq:"50"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-a-la-medida/">Cajas a la Medida</a></li>
 <li><span class="current">Industrial Reforzada</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-am01-title"
   eyebrow="Cajas a la medida · SKU CAD-AM-01"
   titleHtml={true}
   title="Cajas industriales a la medida <span>reforzadas</span>"
   desc="Cajas industriales a la medida en doble corrugado BC, con ECT-44 o ECT-51 según carga. Son una opción para manufactura, distribución, automotriz y electrónica."
   desc2="Las <strong>cajas de cartón para industria</strong> se configuran en doble corrugado BC con ECT-44 o ECT-51 según la carga. Se usan para manufactura, distribución, automotriz y electrónica, con medidas acordes al producto y a la operación de empaque.||Para empaque industrial, la carga y el manejo definen entre ECT-44 y ECT-51. Comparte dimensiones y peso de la pieza, unidades por caja, tipo de estiba y sector de aplicación; CADECA puede revisar la estructura adecuada para tu operación."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-am01-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AM-01 · Familia: Cajas a la Medida</p>
 <h2 id="detalle-am01-title" class="sku-detail__title">Caja a la Medida — Industrial Reforzada</h2>
 <p class="sku-detail__desc">Cajas de doble corrugado BC coordinadas en cualquier dimensión exacta para uso industrial. ECT-44 estándar para cargas hasta 30 kg; ECT-51 para cargas hasta 50 kg. Diseño CAD gratuito con asesoría para elegir la caja correcta. Esquineros opcionales sin costo extra.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44/51</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Hasta 50 kg</span><span class="sku-detail__strip-label">Carga máx.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3-5 días</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-AM-01 Caja Industrial a la Medida`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-AM-01</a>
 <a href="/catalogo/cajas-a-la-medida/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-am01-title">
 <div class="container">
 <h2 id="sizes-am01-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas — CAD-AM-01</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Talla</th><th>Medida (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
 <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Todas las medidas son a definir según su producto. Diseño CAD gratuito.  Producción bajo pedido.</p>
 </div>
 </section>

 </main>
 <FaqCotizacion faqs={faqs} tema="cajas industriales a la medida" />
</PageLayout>
