---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja a la Medida para E-commerce | CADECA";
const description = "Cajas a la medida para ecommerce en CDMX. Optimizadas para peso volumétrico, reducen costo de envío. ECT-32/44, MOQ 50 pzas.";

const specs = [
 ["Código SKU",  "CAD-AM-07"],
 ["Tipo de pared", "Simple o doble corrugado BC"],
 ["Flauta",  "C (4mm) o BC (7mm)"],
 ["Resistencia",  "ECT-32 / ECT-44"],
 ["Gramaje liner", "127–150 g/m²"],
 ["Material",  "Kraft natural o blanco"],
 ["Cierre",  "4 solapas RSC autoblocante"],
 ["Pedido mínimo", "50 piezas"],
 ["Entrega CDMX",  "24–48 hrs"],
];

const faqs = [
 {
 id:"am07-f1",
 question:"¿Cómo reduce el costo de envío una caja a la medida para ecommerce?",
 answer:"Las paqueterías cobran el mayor entre peso real y peso volumétrico. El peso volumétrico se calcula como (largo × ancho × alto) / 5000. Si tu caja tiene 10 cm de espacio libre en cada dimensión, estás pagando por aire. Una caja exacta al producto elimina ese espacio muerto y reduce el peso volumétrico hasta un 40%, lo que puede significar ahorros de 20 a 50 pesos por envío. En volúmenes de 1,000 envíos mensuales el ahorro supera los 30,000 pesos al mes.",
 },
 {
 id:"am07-f2",
 question:"¿Son compatibles estas cajas con las guías de DHL, FedEx, Estafeta y Mercado Envíos?",
 answer:"Sí. Surtimos las cajas con las dimensiones exactas que defines para cumplir con los rangos de cada paquetería. DHL, FedEx y Estafeta aceptan cualquier medida dentro de sus límites de dimensión y peso. Mercado Envíos tiene reglas de peso volumétrico específicas y podemos optimizar la caja para cada rango tarifario. Te recomendamos compartir tu producto y la guía de tu paquetería preferida; te orientamos para elegir la medida óptima.",
 },
 {
 id:"am07-f3",
 question:"¿Puedo imprimir mi logo en la caja de ecommerce a medida desde 50 piezas?",
 answer:"La impresión puede incluir identificación, instrucciones o marca en las caras disponibles de la caja. Comparte el arte, cantidad y ubicación deseada en el formulario para revisar el método de impresión y los acabados que correspondan al producto.",
 },
 { id:"am07-f4", question:"¿Qué medida reduce el espacio vacío en una caja para ecommerce?", answer:"La medida interior parte de largo, ancho y alto del producto, además del material de protección que realmente necesita. Un ajuste razonable reduce movimiento y volumen innecesario; comparte esos datos en el formulario para revisar una opción de corrugado." },
 { id:"am07-f5", question:"¿Qué ECT se recomienda para una caja de envío de ecommerce?", answer:"El ECT se elige según el peso, fragilidad y recorrido del paquete, no sólo por el tamaño. Para productos ligeros puede bastar pared simple; cuando aumenta la carga o el apilamiento se puede valorar una especificación de mayor resistencia." },
];

const gallery = [
 { src: "/img/catalogo/caja-medida-ecom-hero-cdmx.avif",  alt: "Caja a la medida para ecommerce CDMX" },
 { src: "/img/catalogo/caja-medida-ecom-bodega-cdmx.avif",  alt: "Cajas ecommerce en bodega CDMX" },
 { src: "/img/catalogo/caja-medida-ecom-comparacion-cdmx.avif",alt: "Comparación caja estándar vs medida ecommerce" },
 { src: "/img/catalogo/caja-medida-ecom-eficiencia-cdmx.avif", alt: "Eficiencia de empaque ecommerce CDMX" },
 { src: "/img/catalogo/caja-medida-estandar-hero-cdmx.avif",  alt: "Caja a la medida para envíos CDMX" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas a la Medida",href:"/catalogo/cajas-a-la-medida/"},{name:"E-commerce"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja a la Medida para E-commerce",sku:"CAD-AM-07",description:"Caja a la medida optimizada para ecommerce y paqueterías en CDMX — CADECA",image:gallery[0].src,material:"Cartón corrugado ECT-32/44 optimizado peso volumétrico",category:"Cajas a la Medida",moq:"50"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-a-la-medida/">Cajas a la Medida</a></li>
 <li><span class="current">E-commerce</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-am07-title"
   eyebrow="Cajas a la medida · SKU CAD-AM-07"
   titleHtml={true}
   title="Cajas a la medida para <span>e-commerce</span>"
   desc="Cajas a la medida para e-commerce que se definen con las dimensiones del producto y el peso volumétrico. Son útiles para negocios que envían por DHL, FedEx, Estafeta o Mercado Envíos."
   desc2="Estas <strong>cajas para envíos personalizadas</strong> se plantean con medidas acordes al producto y al peso volumétrico. Pueden considerarse para operaciones que despachan mediante DHL, FedEx, Estafeta o Mercado Envíos y que requieren proteger el contenido y su presentación.||CADECA coordina el suministro como proveedor. Envía medidas, cantidad, uso y zona de entrega en CDMX o Estado de México. El equipo asesora para elegir la caja que corresponde al producto, al tipo de envío y a las condiciones de tu cotización."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-am07-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-AM-07 · Familia: Cajas a la Medida</p>
 <h2 id="detalle-am07-title" class="sku-detail__title">Caja a la Medida para E-commerce</h2>
 <p class="sku-detail__desc">Cajas de cartón corrugado coordinadas con las dimensiones exactas de tu producto para optimizar el peso volumétrico y reducir el costo de envío en paqueterías. Corrugado simple ECT-32 para productos ligeros o doble BC ECT-44 para mayor protección en tránsito. Compatibles con todos los operadores logísticos en México: DHL, FedEx, Estafeta, Redpack y Mercado Envíos. CADECA surte desde 50 piezas con diseño CAD gratuito y entrega programada en CDMX.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32/44</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">-40% envío</span><span class="sku-detail__strip-label">Ahorro flete</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-AM-07 Caja a la Medida para E-commerce`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-AM-07</a>
 <a href="/catalogo/cajas-a-la-medida/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas a la medida para e-commerce" />
</PageLayout>
