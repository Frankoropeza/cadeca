---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";

const title = "Cajas de Cartón Grandes | Medidas y Fichas | CADECA";
const description = "Cajas de cartón grandes para mudanza, almacén y envíos. Consulta medidas publicadas, ECT y cantidades de las fichas del catálogo CADECA.";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://cajas-de-carton.com/catalogo/cajas-de-carton-grandes/#webpage",
  "name": title,
  "url": "https://cajas-de-carton.com/catalogo/cajas-de-carton-grandes/",
  "description": description,
  "about": { "@id": "https://cajas-de-carton.com/#org" },
  "isPartOf": { "@id": "https://cajas-de-carton.com/#website" }
};

const productos = [
  {
    code: "CAD-CM-01", title: "Cajas para Mudanza con Asas", badge: "Mudanza", badgeColor: "orange",
    desc: "Doble corrugado BC, ECT-44 y cinco tallas publicadas para manejo manual y objetos voluminosos.",
    imgSrc: "/img/catalogo/cajas-carton-mudanza-resistentes-cdmx.avif", imgAlt: "Cajas de cartón grandes para mudanza",
    href: "/catalogo/cajas-corrugado-estandar/cajas-mudanza/",
    specs: [["Medidas", "30×25×25 a 50×50×90 cm"], ["Flauta", "BC (7 mm)"], ["ECT", "ECT-44"], ["Pedido", "Sin mínimo publicado"]]
  },
  {
    code: "CAD-AH-02", title: "Caja de Almacén Industrial Doble Pared", badge: "Almacén", badgeColor: "blue",
    desc: "Referencia para racks, tarimas y centros de distribución, en doble pared y con medidas de mediano a formato pallet.",
    imgSrc: "/img/catalogo/caja-almacen-industrial-triple-pared-cdmx.avif", imgAlt: "Caja grande para almacén industrial",
    href: "/catalogo/cajas-archivo-almacenaje/almacen-industrial/",
    specs: [["Medidas", "40×30×30 a 120×100×60 cm"], ["Pared", "Doble corrugado BC"], ["ECT", "ECT-44 / ECT-51"], ["Pedido", "50 piezas"]]
  },
  {
    code: "CAD-EC-09", title: "Caja Gran Formato para Electrodomésticos", badge: "Gran formato", badgeColor: "green",
    desc: "Caja de doble corrugado BC para artículos de formato XL y XXL, con especificación ECT-44 en su ficha técnica.",
    imgSrc: "/img/catalogo/caja-almacen-industrial-hero-cdmx.avif", imgAlt: "Caja gran formato de cartón",
    href: "/catalogo/cajas-para-ecommerce/caja-gran-formato/",
    specs: [["Medidas", "XL y XXL"], ["Flauta", "BC (7 mm)"], ["ECT", "ECT-44"], ["Pedido", "50 piezas"]]
  },
  {
    code: "CAD-AH-01", title: "Caja Archivo Muerto Tamaño Oficio", badge: "Archivo", badgeColor: "blue",
    desc: "Caja para resguardo y almacenaje con una medida estándar publicada de 50×35×25 cm.",
    imgSrc: "/img/catalogo/caja-archivo-muerto-oficio-corporativo-cdmx.avif", imgAlt: "Caja grande para archivo muerto tamaño oficio",
    href: "/catalogo/cajas-archivo-almacenaje/archivo-muerto-oficio/",
    specs: [["Medida", "50×35×25 cm"], ["Flauta", "C (4 mm)"], ["ECT", "ECT-32"], ["Pedido", "Sin mínimo publicado"]]
  }
];

const faqs = [
  { id: "grandes-1", question: "¿Qué medidas hay en cajas de cartón grandes?", answer: "Las fichas seleccionadas publican desde 30×25×25 cm hasta 120×100×60 cm. La ficha de mudanza incluye 40×30×30, 50×40×40, 60×45×45 y 50×50×90 cm; revisa cada ficha antes de solicitar una cantidad." },
  { id: "grandes-2", question: "¿Qué resistencia conviene para una caja grande?", answer: "La elección depende del peso, el apilamiento y el recorrido. En las fichas de esta selección aparecen ECT-32 para archivo, ECT-44 para mudanza y gran formato, y ECT-44 o ECT-51 para almacén industrial." },
  { id: "grandes-3", question: "¿Cuántas piezas puedo pedir?", answer: "Las cantidades publicadas cambian por ficha: hay opciones sin mínimo publicado y otras con 50 piezas. Indica la referencia, la medida y la cantidad requerida al pedir cotización." },
  { id: "grandes-4", question: "¿Las cajas grandes sirven para mudanza?", answer: "La ficha CAD-CM-01 publica tallas para mudanza, de chica a ropa/wardrobe, en doble corrugado BC ECT-44. Conviene distribuir el peso en más de una caja en vez de concentrarlo en una sola." },
  { id: "grandes-5", question: "¿Cómo comparo una caja de almacén con una de gran formato?", answer: "Compara el largo, ancho y alto internos requeridos, la pared y el ECT publicados. Para racks y tarimas consulta CAD-AH-02; para formato XL y XXL, consulta CAD-EC-09." }
];
---

<PageLayout title={title} description={description} pageType="catalog" schema={schema}
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Catálogo", href: "/catalogo/" }, { name: "Cajas de cartón grandes" }]}
  faqItems={faqs.map(({ question, answer }) => ({ question, answer }))}>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación"><div class="container"><ol>
    <li><a href="/">Inicio</a></li><li><a href="/catalogo/">Catálogo</a></li><li><span class="current">Cajas de cartón grandes</span></li>
  </ol></div></div>

  <PageHero eyebrow="Catálogo · Formatos grandes" title="Cajas de cartón grandes <span>para almacén</span>" desc="Cajas de cartón grandes para mudanza, almacén, archivo y artículos de formato XL. Consulta en cada ficha las medidas, resistencia ECT, cantidad y uso publicado antes de cotizar." desc2="Las <strong>cajas grandes para mudanza y almacén</strong> se revisan por medida, peso del contenido, espacio para relleno y forma de apilado. Las fichas disponibles indican el ECT, la cantidad y el uso previsto para comparar alternativas antes de definir el empaque.||Para formatos grandes, la carga, el volumen y la altura de estiba pesan más que el nombre de la caja. Comparte dimensiones del contenido, peso por unidad, necesidad de relleno y forma de almacenaje; CADECA revisa una estructura acorde con el manejo previsto." />

  <main id="contenido-principal" role="main">
    <section id="fichas" style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" aria-labelledby="fichas-title"><div class="container">
      <h2 id="fichas-title" class="section-header__title">Fichas para cajas grandes</h2>
      <p class="section-header__subtitle">La rejilla concentra productos existentes con medidas o formatos grandes publicados en el catálogo.</p>
      <div class="sku-grid">{productos.map((p) => <article class="sku-card">
        <div class="sku-card__img-wrap"><img src={p.imgSrc} alt={p.imgAlt} class="sku-card__img" width="640" height="480" loading="lazy" decoding="async" /><span class="sku-card__code">{p.code}</span><span class={`sku-card__badge sku-card__badge--${p.badgeColor}`}>{p.badge}</span></div>
        <div class="sku-card__body"><h3 class="sku-card__name">{p.title}</h3><p class="sku-card__desc">{p.desc}</p><div class="sku-card__specs">{p.specs.map(([label, value]) => <div><span class="sku-card__spec-label">{label}</span><span class="sku-card__spec-value">{value}</span></div>)}</div><div class="sku-card__footer"><a class="btn btn--primary" href={p.href}>Ver ficha técnica</a></div></div>
      </article>)}</div>
    </div></section>

    <section class="sku-detail" aria-labelledby="elegir-title"><div class="container"><div class="sku-detail__content">
      <h2 id="elegir-title" class="sku-detail__title">Cómo elegir tamaño y resistencia</h2>
      <p>Primero mide el producto ya preparado para envío: largo, ancho y alto. A esa medida interior agrega el espacio que necesita el material de protección; una caja muy amplia ocupa más volumen y una demasiado ajustada puede transferir golpes al contenido. La guía de <a href="/blog/como-calcular-medidas-caja-carton-producto/">cómo calcular medidas de caja</a> explica el orden L×A×H y la holgura por tipo de producto.</p>
      <p>Después define la pared. Las fichas de esta selección muestran corrugado sencillo para archivo y doble pared para mudanza, almacén o formatos de mayor tamaño. El <a href="/blog/diferencias-corrugado-simple-doble-triple-pared/">comparativo de corrugado simple, doble y triple pared</a> ayuda a relacionar peso, apilamiento y tipo de cartón; el ECT es un dato útil para comparar la compresión vertical de las opciones publicadas.</p>
      <p>Para un pedido, no basta con decir “grande”. Comparte el SKU o el uso, la medida interior deseada, el peso aproximado por caja, si habrá apilamiento y cuántas piezas necesitas. Con esa información es más sencillo revisar si una medida publicada funciona o si conviene consultar la categoría de <a href="/catalogo/cajas-a-la-medida/">cajas a la medida</a>.</p>
    </div></div></section>

    <section class="sku-sizes" aria-labelledby="medidas-title"><div class="container">
      <h2 id="medidas-title" class="section-header__title">Medidas publicadas en las fichas</h2>
      <div class="catalog-sizes-table-wrap"><table class="catalog-sizes-table"><thead><tr><th>Ficha</th><th>Medida L×A×H (cm)</th><th>Pared / flauta</th><th>ECT</th><th>Uso publicado</th></tr></thead><tbody>
        <tr><td><a href="/catalogo/cajas-corrugado-estandar/cajas-mudanza/">CAD-CM-01</a></td><td>30×25×25; 40×30×30; 50×40×40; 60×45×45; 50×50×90</td><td>BC</td><td>ECT-44</td><td>Mudanza</td></tr>
        <tr><td><a href="/catalogo/cajas-archivo-almacenaje/almacen-industrial/">CAD-AH-02</a></td><td>40×30×30 a 120×100×60</td><td>Doble pared BC</td><td>ECT-44 / ECT-51</td><td>Almacén industrial</td></tr>
        <tr><td><a href="/catalogo/cajas-archivo-almacenaje/archivo-muerto-oficio/">CAD-AH-01</a></td><td>50×35×25</td><td>Flauta C</td><td>ECT-32</td><td>Archivo y almacenaje</td></tr>
      </tbody></table></div>
      <p style="font-size:0.9rem;color:var(--color-text-light);margin-top:var(--spacing-md);">Las medidas de la tabla provienen de las fichas enlazadas. CAD-EC-09 publica formato XL y XXL, sin dimensiones L×A×H en su ficha.</p>
    </div></section>

    <section class="sku-detail" aria-labelledby="usos-title"><div class="container"><div class="sku-detail__content">
      <h2 id="usos-title" class="sku-detail__title">Usos habituales de una caja grande</h2>
      <p>En una mudanza, las medidas no deben usarse para llenar cada caja con el mayor peso posible. La ficha CAD-CM-01 separa tallas chica, mediana, grande, extra grande y ropa/wardrobe; esa variedad permite reservar las cajas compactas para contenido más denso y las de mayor volumen para piezas ligeras o textiles. Las asas y el cierre son parte del uso que se publica para esa referencia, pero la carga debe mantenerse dentro de los límites indicados en la ficha.</p>
      <p>Para archivo, una caja de 50×35×25 cm responde a un uso distinto al de una de gran formato. CAD-AH-01 se orienta al resguardo de documentos tamaño oficio, mientras que CAD-AH-02 reúne medidas para bodega, racks y tarimas. Si el producto ocupa mucho espacio pero no requiere una tarima, CAD-EC-09 permite revisar una opción marcada como XL y XXL. El uso define el primer filtro; la medida y el ECT completan la comparación.</p>
      <p>Si habrá almacenamiento, confirma cómo se acomodarán las cajas: si irán en columna, en rack, en tarima o separadas. Anota también si el producto tiene esquinas expuestas, si necesita divisores y si el cartón estará en un entorno con humedad. Esta información da contexto a las especificaciones de pared y evita pedir una caja grande que sólo coincida en volumen.</p>
    </div></div></section>

  </main>
  <FaqCotizacion faqs={faqs} tema="cajas de cartón grandes" producto="Cajas de cartón grandes" />
</PageLayout>
