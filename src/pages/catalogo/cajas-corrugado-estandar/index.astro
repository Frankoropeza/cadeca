---
import PageLayout    from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture   from "@/components/LeadCapture.astro";

const title       = "Catálogo Cajas Corrugado Estándar CDMX | 5 Productos | CADECA";
const description = "Catálogo de cajas de cartón corrugado estándar en CDMX. Corrugado simple, doble, triple, mudanza y flauta E. Fichas técnicas con medidas, ECT y precios mayoreo.";
const WHATSAPP    = "5255XXXXXXXX";

const productos = [
  {
    code:    "CAD-CS-01",
    badge:   "Más popular",
    badgeColor: "orange",
    featured: true,
    title:   "Corrugado Simple — Pared Simple",
    desc:    "Una sola capa de flauta. La opción más económica y versátil. Ideal para e-commerce, ropa, accesorios y productos hasta 15 kg. Inventario permanente en CDMX.",
    imgSrc:  "/img/productos/cajas-carton-corrugado-simple-pared-cdmx.avif",
    imgAlt:  "Caja de cartón corrugado simple pared simple CDMX — CADECA",
    href:    "/catalogo/cajas-corrugado-estandar/corrugado-simple",
    specs: [
      { label: "Pared",      value: "Simple" },
      { label: "ECT",        value: "ECT-23 / ECT-32" },
      { label: "Flauta",     value: "B · C · E" },
      { label: "Peso máx.",  value: "Hasta 15 kg" },
    ],
    moq: "Sin mínimo",
  },
  {
    code:    "CAD-CD-01",
    badge:   "Recomendado",
    badgeColor: "blue",
    featured: false,
    title:   "Doble Corrugado — Pared Doble (BC)",
    desc:    "Dos capas de flauta BC. Mayor resistencia al impacto y aplastamiento. Para electrónica, menaje, Amazon FBA y distribución industrial. Hasta 25 kg.",
    imgSrc:  "/img/productos/cajas-carton-doble-corrugado-resistente-cdmx.avif",
    imgAlt:  "Caja de cartón doble corrugado pared doble BC CDMX — CADECA",
    href:    "/catalogo/cajas-corrugado-estandar/doble-corrugado",
    specs: [
      { label: "Pared",      value: "Doble (BC)" },
      { label: "ECT",        value: "ECT-44 / ECT-51" },
      { label: "Flauta",     value: "BC · BB" },
      { label: "Peso máx.",  value: "Hasta 25 kg" },
    ],
    moq: "Sin mínimo",
  },
  {
    code:    "CAD-CT-01",
    badge:   "Industrial",
    badgeColor: "red",
    featured: false,
    title:   "Triple Corrugado — Pared Triple",
    desc:    "Tres capas de flauta BCB o BCF. Máxima resistencia estructural para industria pesada, exportación y nearshoring. ECT-51 y ECT-71 disponibles.",
    imgSrc:  "/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif",
    imgAlt:  "Caja de cartón triple corrugado industrial pared triple CDMX — CADECA",
    href:    "/catalogo/cajas-corrugado-estandar/triple-corrugado",
    specs: [
      { label: "Pared",      value: "Triple (BCB/BCF)" },
      { label: "ECT",        value: "ECT-51 / ECT-71" },
      { label: "Flauta",     value: "BCB · BCF" },
      { label: "Peso máx.",  value: "+25 kg" },
    ],
    moq: "50 pzas",
  },
  {
    code:    "CAD-CM-01",
    badge:   "Con asas",
    badgeColor: "green",
    featured: false,
    title:   "Cajas para Mudanza — Asas Reforzadas",
    desc:    "Doble corrugado BC con asas troqueladas reforzadas para manejo manual frecuente. Sin mínimo, en stock permanente. Chica, mediana, grande y extra grande.",
    imgSrc:  "/img/productos/cajas-carton-mudanza-resistentes-cdmx.avif",
    imgAlt:  "Caja de cartón para mudanza con asas reforzadas CDMX — CADECA",
    href:    "/catalogo/cajas-corrugado-estandar/cajas-mudanza",
    specs: [
      { label: "Pared",      value: "Doble (BC) + Asas" },
      { label: "ECT",        value: "ECT-44" },
      { label: "Flauta",     value: "BC" },
      { label: "Peso máx.",  value: "Hasta 20 kg" },
    ],
    moq: "Sin mínimo",
  },
  {
    code:    "CAD-CE-01",
    badge:   "Micro",
    badgeColor: "blue",
    featured: false,
    title:   "Corrugado Micro — Flauta E",
    desc:    "Flauta E de 1.5mm para cajas pequeñas con alta calidad de impresión. Ideal para cosméticos, joyería, suplementos y productos de presentación premium.",
    imgSrc:  "/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif",
    imgAlt:  "Caja de cartón corrugado micro flauta E premium CDMX — CADECA",
    href:    "/catalogo/cajas-corrugado-estandar/corrugado-flauta-e",
    specs: [
      { label: "Pared",      value: "Simple (Micro)" },
      { label: "ECT",        value: "ECT-23" },
      { label: "Flauta",     value: "E (1.5mm)" },
      { label: "Ideal para", value: "Cosméticos y joyería" },
    ],
    moq: "100 pzas",
  },
];
---

<PageLayout title={title} description={description} whatsapp={WHATSAPP}>

  <!-- HERO CATEGORÍA -->
  <section class="cat-page-hero" aria-labelledby="cat-cs-hub-title">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta de navegación" style="margin-bottom:var(--spacing-md)">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item"><a href="/" class="breadcrumb__link">Inicio</a></li>
          <li class="breadcrumb__item"><a href="/catalogo" class="breadcrumb__link">Catálogo</a></li>
          <li class="breadcrumb__item breadcrumb__item--active" aria-current="page">Corrugado Estándar</li>
        </ol>
      </nav>
      <span class="cat-page-hero__eyebrow">📦 Categoría 01 · 5 productos</span>
      <h1 id="cat-cs-hub-title" class="cat-page-hero__title">
        Cajas Corrugado <span>Estándar</span>
      </h1>
      <p class="cat-page-hero__desc">
        Simple, doble, triple pared y mudanza. La línea de mayor rotación con inventario permanente en CDMX. Sin pedido mínimo en modelos estándar, entrega en 24-48 hrs.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">Productos: <strong>5</strong></div>
        <div class="cat-page-hero__strip-item">MOQ desde: <strong>Sin mínimo</strong></div>
        <div class="cat-page-hero__strip-item">Entrega CDMX: <strong>24-48 hrs</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-23 a ECT-71</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" aria-labelledby="prods-cs-title">
      <div class="container">
        <SectionHeader
          id="prods-cs-title"
          twoCol
          title="5 Productos — Corrugado Estándar"
          subtitle="Selecciona el producto para ver ficha técnica completa con medidas, especificaciones ECT y condiciones de pedido."
          link={{ text: "← Volver al catálogo", href: "/catalogo" }}
        >
          <p>Cada producto tiene su propia ficha técnica con tabla de medidas disponibles, especificaciones de material, resistencia ECT, flauta, gramaje, peso máximo y condiciones de pedido. Haz clic en cualquier producto para ver todos los detalles.</p>
        </SectionHeader>

        <div class="sku-grid">
          {productos.map(p => (
            <article class={`sku-card${p.featured ? " sku-card--featured" : ""}`}>
              <div class="sku-card__img-wrap">
                <img src={p.imgSrc} alt={p.imgAlt}
                  class="sku-card__img" width="640" height="480"
                  loading="lazy" decoding="async" />
                <span class="sku-card__code">{p.code}</span>
                <span class={`sku-card__badge sku-card__badge--${p.badgeColor}`}>{p.badge}</span>
              </div>
              <div class="sku-card__body">
                <h2 class="sku-card__name">{p.title}</h2>
                <p class="sku-card__desc">{p.desc}</p>
                <div class="sku-card__specs">
                  {p.specs.map(s => (
                    <div>
                      <span class="sku-card__spec-label">{s.label}</span>
                      <span class="sku-card__spec-value">{s.value}</span>
                    </div>
                  ))}
                </div>
                <div class="sku-card__footer">
                  <a href={p.href} class="btn btn--primary">Ver ficha técnica</a>
                  <span class="sku-card__moq">MOQ: {p.moq}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="¿Tienes dudas técnicas? Nuestro asesor responde en menos de 2 horas" />

</PageLayout>
