---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja Corrugado para Almacén Industrial CDMX | CAD-CS-12 | Racks | CADECA";
const description = "Caja corrugado para almacén industrial en CDMX. Alta resistencia al apilado, compatible con racks selectivos. ECT-44 doble pared. Desde 50 pzas. Entrega 24 hrs. CADECA.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU",  "CAD-CS-12"],
 ["Tipo de pared", "Doble corrugado BC"],
 ["Flauta",  "BC (7mm)"],
 ["Resistencia",  "ECT-44"],
 ["Gramaje liner", "175 g/m² kraft virgen"],
 ["Material",  "Kraft virgen reforzado"],
 ["Cierre",  "4 solapas con refuerzo esquinas"],
 ["Apilado",  "Hasta 450 kg en condiciones estándar"],
 ["Pedido mínimo", "50 piezas"],
 ["Entrega CDMX",  "24–48 hrs"],
];

const faqs = [
 {
 id: "cs12-f1",
 question: "¿Qué diferencia tiene la caja de almacén industrial versus la caja estándar?",
 answer: "La caja CAD-CS-12 está optimizada para el ciclo de vida de almacén: recepción, almacenamiento en rack, picking y despacho. Sus diferencias clave son: (1) Liner 175 g/m² virgen para mayor resistencia a la humedad en cámaras frías y almacenes sin climatizar. (2) Esquinas reforzadas para mantener la integridad dimensional después de múltiples movimientos con montacargas y transpaletas. (3) ECT-44 que garantiza apilado seguro en rack selectivo hasta 5 niveles estándar. (4) Fondo automático opcional para mayor velocidad en líneas de empaque.",
 },
 {
 id: "cs12-f2",
 question: "¿Cuántas cajas CAD-CS-12 puedo apilar de forma segura en un rack selectivo?",
 answer: "Con ECT-44 y liner 175 g/m², una caja CAD-CS-12 resiste 450 kg de apilado estático en condiciones de almacén estándar (temperatura hasta 25°C, humedad relativa hasta 65%). En rack selectivo con escantillones de 1.2 m de alto, esto equivale a 3-4 cajas por posición de picking según el peso del producto. Para almacenes con alta rotación donde las cajas permanecen más de 30 días en rack, recomendamos revisar la resistencia real con el producto cargado en una prueba piloto antes de definir la configuración definitiva.",
 },
 {
 id: "cs12-f3",
 question: "¿Están disponibles con código de barras o etiquetado de almacén?",
 answer: "Sí. El CAD-CS-12 puede solicitarse con zona de etiquetado predefinida en el exterior (área blanca para etiqueta de almacén), preimpresión de código de barras o QR, y marcas de orientación para montacargas. También fabricamos con ventana de polietileno para visualización del contenido sin abrir la caja, muy útil en almacenes de alta rotación con picking frecuente. Estos acabados tienen un costo adicional y requieren MOQ de 200 pzas con tiempo de producción de 5-7 días hábiles.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-almacen-industrial-hero-cdmx.avif",  alt: "Caja corrugado almacén industrial CDMX — hero" },
 { src: "/img/catalogo/caja-almacen-industrial-rack-cdmx.avif",  alt: "Cajas almacén industrial en rack selectivo CDMX" },
 { src: "/img/catalogo/caja-almacen-industrial-capas-cdmx.avif",  alt: "Detalle capas doble pared caja almacén industrial" },
 { src: "/img/catalogo/caja-almacen-industrial-triple-pared-cdmx.avif",alt: "Caja almacén industrial triple pared apilada CDMX" },
 { src: "/img/catalogo/caja-apilable-stack-5-cdmx.avif",  alt: "Cajas industriales apiladas 5 niveles CDMX" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Corrugado Estándar",href:"/catalogo/cajas-corrugado-estandar"},{name:"Caja Almacén Industrial"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja Corrugado para Almacén Industrial",sku:"CAD-CS-12",description:"Caja corrugado ECT-44 para almacén industrial y racks en CDMX — CADECA",image:gallery[0].src,material:"Kraft virgen 175g/m² doble corrugado BC ECT-44",category:"Cajas Corrugado Estándar",moq:"50"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-corrugado-estandar">Corrugado Estándar</a></li>
 <li><span class="current">Caja Almacén Industrial</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-cs12-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-CS-12 · Corrugado Estándar</span>
 <h1 id="sku-cs12-title" class="cat-page-hero__title">Caja Corrugado para <span>Almacén Industrial</span></h1>
 <p class="cat-page-hero__desc">
 Alta resistencia al apilado ECT-44 compatible con racks selectivos y pasillos de almacén. Liner kraft virgen 175 g/m², doble corrugado BC, hasta 450 kg de carga apilada. Entrega en 24–48 hrs en CDMX desde 50 pzas.
 </p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-CS-12</strong></div>
 <div class="cat-page-hero__strip-item">ECT: <strong>ECT-44</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>50 pzas</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cs12-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-CS-12 · Familia: Corrugado Estándar</p>
 <h2 id="detalle-cs12-title" class="sku-detail__title">Caja Corrugado para Almacén Industrial</h2>
 <p class="sku-detail__desc">
 El CAD-CS-12 es la caja corrugado diseñada específicamente para el ciclo de vida completo en almacén industrial: ingreso, almacenamiento en rack selectivo, picking y despacho. Doble corrugado BC con liner kraft virgen 175 g/m², ECT-44 y esquinas reforzadas. Compatible con montacargas, transpaletas y sistemas WMS. Stock permanente en CDMX para pedidos desde 50 piezas.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">450 kg</span><span class="sku-detail__strip-label">Apilado máx.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Rack OK</span><span class="sku-detail__strip-label">Selectivo</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-CS-12 Caja Corrugado Almacén Industrial`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-CS-12</a>
 <a href="/catalogo/cajas-corrugado-estandar" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-cs12-title">
 <div class="container">
 <h2 id="faq-cs12-title" class="sku-faq__title">Preguntas Frecuentes — Caja Almacén Industrial</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="Cotiza Caja para Almacén Industrial — ECT-44, Compatible con Racks, CDMX" />
</PageLayout>
