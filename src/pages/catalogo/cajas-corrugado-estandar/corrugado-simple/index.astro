---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja de Cartón Corrugado Simple Pared | CADECA";
const description = "Ficha técnica caja corrugado simple pared simple en CDMX. ECT-23 y ECT-32, flauta B, C y E. Medidas chica a extra grande.";

const medidas = [
 { nombre:"Micro Chica",  lah:"20×15×15",flauta:"E",  ect:"ECT-23",vacío:"0.18 kg",máx:"5 kg",  disp:"green",  label:"Stock" },
 { nombre:"Chica",  lah:"30×20×20",flauta:"B/C",ect:"ECT-32",vacío:"0.32 kg",máx:"10 kg", disp:"green",  label:"Stock",  hl:true },
 { nombre:"Mediana",  lah:"40×30×25",flauta:"C",  ect:"ECT-32",vacío:"0.51 kg",máx:"12 kg", disp:"green",  label:"Stock",  hl:true },
 { nombre:"Grande",  lah:"50×40×30",flauta:"C",  ect:"ECT-32",vacío:"0.74 kg",máx:"15 kg", disp:"green",  label:"Stock" },
 { nombre:"Extra Grande", lah:"60×50×40",flauta:"C",  ect:"ECT-32",vacío:"1.12 kg",máx:"15 kg", disp:"yellow", label:"48 hrs" },
 { nombre:"A la Medida",  lah:"Cualquier",flauta:"A elegir",ect:"A elegir",vacío:"—",máx:"—",disp:"gray",label:"3-5 días" },
];

const specs = [
 ["Código SKU",  "CAD-CS-01"],
 ["Tipo de pared",  "Simple (pared simple)"],
 ["Flautas disponibles", "B (3mm) · C (4mm) · E (1.5mm)"],
 ["Resistencia ECT",  "ECT-23 · ECT-32"],
 ["Gramaje liner",  "115 – 150 g/m²"],
 ["Gramaje médium",  "112 – 127 g/m²"],
 ["Material",  "Kraft virgen · Test · PCR reciclado"],
 ["Color exterior",  "Kraft marrón natural"],
 ["Peso máx. producto",  "Hasta 15 kg (ECT-32, flauta C)"],
 ["Carga de apilado",  "Hasta 80 kg (condiciones ideales)"],
 ["Impresión",  "Flexografía 1-4 colores (opcional)"],
 ["Certificación",  "FSC disponible bajo pedido"],
 ["Pedido mínimo",  "Sin mínimo (stock) · 50 pzas (producción)"],
 ["Tiempo de entrega",  "24-48 hrs stock · 48-72 hrs especial"],
];

const faqs = [
 {
 id:"cs-f1",
 question:"¿En qué se diferencian la flauta B y la flauta C en pared simple?",
 answer:"<strong>Flauta B (3mm):</strong> Más rígida y mejor superficie de impresión. Ideal para cajas con logo donde la impresión es importante. Mejor resistencia al aplastamiento lateral. <strong>Flauta C (4mm):</strong> Mayor acolchado y resistencia al impacto. Es la estándar para cajas de envío porque protege mejor el contenido durante el transporte. Para e-commerce con fines de envío, recomendamos flauta C.",
 },
 {
 id:"cs-f2",
 question:"¿Cuándo debería elegir pared doble en vez de simple?",
 answer:"Cambia a <strong>doble corrugado</strong> cuando: el producto pesa más de 10 kg, es frágil o electrónico, se almacenará por más de 1 semana apilado, o si el destino final es el centro de distribución de Amazon (que exige ECT-44). Para envíos estándar de Mercado Libre con productos hasta 8-10 kg, el corrugado simple ECT-32 es suficiente.",
 },
 { id:"cs-f3", question:"¿Qué peso soporta una caja de cartón corrugado simple?", answer:"La capacidad depende de medida, flauta, ECT, cierre y condiciones de manejo. Para definir una opción segura conviene compartir el peso del producto, si habrá apilamiento y el tipo de protección interior que usará." },
 { id:"cs-f4", question:"¿Cómo se almacenan cajas de corrugado simple antes de usarlas?", answer:"Guarda las cajas plegadas en un espacio seco y limpio, lejos de condensación o contacto directo con el piso húmedo. Evita colocarles peso encima para que conserven su forma y se armen correctamente." },
 { id:"cs-f5", question:"¿Cómo cotizo cajas de cartón de pared simple?", answer:"Envía por el formulario las medidas, peso, cantidad y uso del producto. Si deseas impresión o un tipo de flauta específico, inclúyelo para valorar una especificación adecuada para el empaque." },
];

const mainImg = "/img/productos/cajas-carton-corrugado-simple-pared-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/cajas-carton-corrugado-simple-pared-cdmx.avif", alt: "Caja corrugado simple — vista principal" },
 { src: "/img/catalogo/corrugado-simple-angulo-45-cdmx.avif", alt: "Caja corrugado simple — ángulo 45°" },
 { src: "/img/catalogo/corrugado-simple-apilado-cdmx.avif", alt: "Cajas corrugado simple — apiladas" },
 { src: "/img/catalogo/corrugado-simple-detalle-flauta-cdmx.avif", alt: "Corrugado simple — detalle flauta C" },
 { src: "/img/catalogo/corrugado-simple-uso-envio-cdmx.avif", alt: "Caja corrugado simple — uso real" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"Corrugado Estándar", href:"/catalogo/cajas-corrugado-estandar/"}, {name:"Corrugado Simple"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja Corrugado Simple Flauta C", sku:"CAD-CS-01", description:"Caja Corrugado Simple Flauta C en CDMX — proveedor CADECA", image:"/img/catalogo/cajas-carton-corrugado-simple-pared-cdmx.avif", material:"Cartón corrugado simple flauta C ECT-32", category:"Cajas de Cartón Corrugado Estándar", moq:"50"}}
>

 <!-- Breadcrumb -->
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-corrugado-estandar/">Corrugado Estándar</a></li>
 <li><span class="current">Corrugado Simple</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cs-title"
   eyebrow="Corrugado estándar · SKU CAD-CS-01"
   titleHtml={true}
   title="Cajas de cartón corrugado <span>sencillo</span>"
   desc="Cajas de cartón corrugado sencillo con una capa de flauta entre dos liners. Son una opción para productos ligeros y operaciones que requieren un empaque de pared simple."
   desc2="La <strong>caja de pared simple</strong> se integra por una capa de flauta entre dos liners de cartón. Esta configuración se contempla para productos ligeros y usos de empaque que no requieren doble o triple pared, con un formato sencillo de cartón corrugado.||CADECA coordina el suministro como proveedor. Indica medidas, cantidad, uso y zona de entrega para cotizar. El equipo asesora al elegir la caja según el producto, el nivel de protección requerido y la forma de manejo que tendrá durante la entrega."
 />

 <main id="contenido-principal" role="main">

 <section class="sku-detail" aria-labelledby="detalle-cs-title">
 <div class="container">
 <div class="sku-detail__grid">

 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>

 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-CS-01 · Familia: Corrugado Estándar</p>
 <h2 id="detalle-cs-title" class="sku-detail__title">Corrugado Simple — Pared Simple</h2>
 <p class="sku-detail__desc">
 La caja de cartón corrugado simple es la solución más versátil y económica del catálogo CADECA. Con una sola capa de flauta entre dos liners de papel kraft o test, ofrece la combinación correcta de protección y costo para e-commerce, ropa, accesorios y productos ligeros. Disponibilidad según pedido en CDMX; el plazo se confirma al cotizar.
 </p>

 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item">
 <span class="sku-detail__strip-value">ECT-32</span>
 <span class="sku-detail__strip-label">Resistencia estándar</span>
 </div>
 <div class="sku-detail__strip-item">
 <span class="sku-detail__strip-value">15 kg</span>
 <span class="sku-detail__strip-label">Peso máx.</span>
 </div>
 <div class="sku-detail__strip-item">
 <span class="sku-detail__strip-value">Sin mín.</span>
 <span class="sku-detail__strip-label">Pedido</span>
 </div>
 <div class="sku-detail__strip-item">
 <span class="sku-detail__strip-value">24 hrs</span>
 <span class="sku-detail__strip-label">Entrega CDMX</span>
 </div>
 </div>

 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table">
 <tbody>
 {specs.map(([label, val]) => (
 <tr><td>{label}</td><td>{val}</td></tr>
 ))}
 </tbody>
 </table>

 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-CS-01 Corrugado Simple`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-CS-01</a>
 <a href="/catalogo/cajas-corrugado-estandar/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>

 </div>
 </div>
 </section>

 <!-- TABLA DE MEDIDAS -->
 <section class="sku-sizes" aria-labelledby="sizes-cs-title">
 <div class="container">
 <h2 id="sizes-cs-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">
 Medidas Disponibles — CAD-CS-01
 </h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead>
 <tr>
 <th>Tamaño</th>
 <th>L × A × H (cm)</th>
 <th>Flauta</th>
 <th>ECT</th>
 <th>Peso vacío</th>
 <th>Peso máx.</th>
 <th>Disponibilidad</th>
 </tr>
 </thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td>{m.nombre}</td>
 <td><strong>{m.lah}</strong></td>
 <td>{m.flauta}</td>
 <td>{m.ect}</td>
 <td>{m.vacío}</td>
 <td><strong>{m.máx}</strong></td>
 <td>
 <span class={`stock-chip stock-chip--${m.disp}`}>
 {m.disp==="green"?"":m.disp==="yellow"?"":""} {m.label}
 </span>
 </td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">
 Disponibilidad según pedido ·  Producción rápida · Pedido especial — 3 a 5 días hábiles. Pesos bajo condiciones estándar: 20°C y 50% HR.
 </p>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas de cartón corrugado sencillo" />

</PageLayout>
