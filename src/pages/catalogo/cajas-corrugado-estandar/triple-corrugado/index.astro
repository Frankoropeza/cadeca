---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem     from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Caja Triple Corrugado Pared Triple Industrial CDMX | CAD-CT-01 | CADECA";
const description = "Ficha técnica caja triple corrugado pared triple en CDMX. ECT-51 y ECT-71. Para industria pesada, nearshoring y exportación. Desde 50 pzas, entrega 48-72 hrs. CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const medidas = [
  { nombre:"Industrial M",  lah:"60×40×40",  flauta:"BCB",ect:"ECT-51",vacío:"2.20 kg",máx:"+30 kg", disp:"yellow",label:"48 hrs" },
  { nombre:"Industrial L",  lah:"80×60×50",  flauta:"BCB",ect:"ECT-51",vacío:"3.50 kg",máx:"+40 kg", disp:"yellow",label:"48 hrs", hl:true },
  { nombre:"Industrial XL", lah:"100×70×60", flauta:"BCF",ect:"ECT-71",vacío:"5.20 kg",máx:"+50 kg", disp:"gray",  label:"3-5 días", hl:true },
  { nombre:"Maquinaria",    lah:"120×80×80", flauta:"BCF",ect:"ECT-71",vacío:"7.80 kg",máx:"+60 kg", disp:"gray",  label:"3-5 días" },
  { nombre:"Exportación",   lah:"150×100×90",flauta:"BCF",ect:"ECT-71",vacío:"11.0 kg",máx:"+80 kg", disp:"gray",  label:"5-7 días" },
  { nombre:"A la Medida",   lah:"Hasta 200×120×100",flauta:"A calcular",ect:"A calcular",vacío:"—",máx:"—",disp:"gray",label:"Consultar" },
];

const specs = [
  ["Código SKU",          "CAD-CT-01"],
  ["Tipo de pared",       "Triple (pared triple)"],
  ["Flautas disponibles", "BCB · BCF"],
  ["Resistencia ECT",     "ECT-51 · ECT-71"],
  ["Gramaje liner",       "175 – 200 g/m²"],
  ["Gramaje médium",      "127 – 150 g/m² por capa"],
  ["Material",            "Kraft virgen de alta resistencia"],
  ["Peso máx. producto",  "+25 kg (sin límite según diseño)"],
  ["Carga de apilado",    "Hasta 500+ kg (condiciones controladas)"],
  ["Impresión",           "Flexografía 1-2 colores (superficie rugosa)"],
  ["Normas",              "FSC · ISTA · ASTM disponibles"],
  ["Uso recomendado",     "Industria pesada · Nearshoring · Exportación"],
  ["Pedido mínimo",       "50 piezas (producción bajo pedido)"],
  ["Tiempo de entrega",   "48-72 hrs standard · 3-5 días especial"],
];

const faqs = [
  {
    id:"ct-f1",
    question:"¿El triple corrugado cumple con los estándares ISTA para exportación?",
    answer:"Sí. Podemos fabricar con especificación ISTA (International Safe Transit Association) bajo pedido. ISTA define protocolos de prueba de vibración, caída y compresión para empaques de exportación. Nuestros ingenieros seleccionan el ECT, gramaje y configuración de flauta necesarios para cumplir el protocolo ISTA específico que requiere tu cliente o mercado de destino.",
  },
  {
    id:"ct-f2",
    question:"¿Puedo imprimir mi logo en cajas de triple corrugado?",
    answer:"Sí, con limitaciones. La superficie del triple corrugado (BCB o BCF) es más rugosa que el simple o doble, lo que limita la calidad de impresión a flexografía de 1 o 2 colores. Para una impresión de mayor calidad en cajas industriales, recomendamos usar una etiqueta o sticker impreso y pegarlo sobre la caja en lugar de impresión directa sobre el cartón.",
  },
];

const mainImg = "/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif";
const gallery = [
  { src: mainImg, alt: "Triple Corrugado — vista frontal CDMX" },
  { src: mainImg, alt: "Triple Corrugado — detalle corrugación" },
  { src: mainImg, alt: "Triple Corrugado — stack apilado" },
  { src: mainImg, alt: "Triple Corrugado — contexto uso industrial" },
  { src: mainImg, alt: "Triple Corrugado — medidas referencia" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"Corrugado Estándar", href:"/catalogo/cajas-corrugado-estandar"}, {name:"Triple Corrugado"}]}
  faqItems={[{question:"¿Cuándo es necesario usar triple corrugado en lugar de doble corrugado?", answer:"Triple corrugado (BCB, ECT-61+) es necesario cuando: el producto pesa más de 30 kg, el producto es maquinaria o equipo con bordes metálicos que podrían perforar doble corrugado, la caja será exportada por vía marítima (mínimo 30 días en contenedor con humedad), el producto requiere certificación ISTA 2A o 3A para transporte aéreo de carga, o el producto es electrodoméstico de línea blanca grande. Para productos menores a 20-25 kg y envíos nacionales, el doble corrugado ECT-44 es suficiente."}, {question:"¿El triple corrugado puede sustituir la madera como material de embalaje industrial?", answer:"En muchos casos sí. El triple corrugado BCB ECT-61+ ofrece una relación resistencia/peso superior a la madera contrachapada de 12mm, es 100% reciclable (la madera a veces requiere tratamiento NIMF 15 para exportación), se puede imprimir y marcar con mayor facilidad, y cumple regulaciones de embalaje internacional sin restricciones fitosanitarias. Sus limitaciones frente a madera son: menor resistencia a humedad extrema en exposición prolongada y menor rigidez lateral en estructuras muy altas. Para pallets y contenedores, la combinación cartón BCB + esquineros de cartón reemplaza madera en muchas aplicaciones industriales."}]}
  product={{name:"Caja Triple Corrugado BCB Industrial", sku:"CAD-CT-01", description:"Caja Triple Corrugado BCB Industrial en CDMX — fabricante directo CADECA", image:"/img/catalogo/cajas-carton-triple-corrugado-industrial-cdmx.avif", material:"Cartón triple corrugado flauta BCB ECT-61", category:"Cajas de Cartón Corrugado Estándar", moq:"25"}}
>
    <!-- Breadcrumb -->
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Catálogo</a></li>
      <li><a href="/catalogo/cajas-corrugado-estandar">Corrugado Estándar</a></li>
      <li><span class="current">Triple Corrugado</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-ct-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-CT-01 · Corrugado Estándar</span>
      <h1 id="sku-ct-title" class="cat-page-hero__title">Triple Corrugado<br><span>Pared Triple Industrial — CDMX</span></h1>
      <p class="cat-page-hero__desc">Tres capas de flauta BCB o BCF. Máxima resistencia en cartón corrugado. Para industria pesada, nearshoring y exportación. ECT-51 y ECT-71, normas ISTA y ASTM disponibles.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-CT-01</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-51 / ECT-71</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>50 piezas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>48-72 hrs</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-ct-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-CT-01 · Familia: Corrugado Estándar</p>
            <h2 id="detalle-ct-title" class="sku-detail__title">Triple Corrugado — Pared Triple</h2>
            <p class="sku-detail__desc">La máxima resistencia estructural disponible en cartón corrugado. Tres capas de flauta entre cuatro liners de papel kraft de alto gramaje. Para plantas manufactureras, proyectos de nearshoring en Estado de México, exportación internacional y transporte de maquinaria y equipo de alto valor.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-71</span><span class="sku-detail__strip-label">Resistencia máx.</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">+25 kg</span><span class="sku-detail__strip-label">Peso máx.</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">48-72h</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([label, val]) => <tr><td>{label}</td><td>{val}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-CT-01 Triple Corrugado`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-CT-01</a>
              <a href="/catalogo/cajas-corrugado-estandar" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-ct-title">
      <div class="container">
        <h2 id="sizes-ct-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-CT-01</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Tamaño</th><th>L × A × H (cm)</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
            <tbody>{medidas.map(m => <tr class={m.hl?"highlight":""}><td>{m.nombre}</td><td><strong>{m.lah}</strong></td><td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td><td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"✓":m.disp==="yellow"?"⏱":"○"} {m.label}</span></td></tr>)}</tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">⏱ Producción rápida · ○ Pedido especial. Tamaños personalizados disponibles hasta 200×120×100 cm.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-ct-title">
      <div class="container">
        <h2 id="faq-ct-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-CT-01</h2>
        <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-CT-01 — ECT-71, normas ISTA y ASTM disponibles" />
</PageLayout>
