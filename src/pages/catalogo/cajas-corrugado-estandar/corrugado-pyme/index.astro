---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja Corrugado para PyME y Negocio Local CDMX | CAD-CS-08 | CADECA";
const description = "Caja corrugado para PyME y negocio local en CDMX. ECT-32 alta resistencia, medidas estándar, sin mínimo alto. Precio mayoreo desde 50 pzas. Entrega 24 hrs. CADECA.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU",  "CAD-CS-08"],
 ["Tipo de pared", "Simple / Doble corrugado"],
 ["Flauta",  "B / C (3–4mm)"],
 ["Resistencia",  "ECT-32"],
 ["Gramaje liner", "115–150 g/m²"],
 ["Material",  "Kraft test / virgen"],
 ["Cierre",  "4 solapas autoblocante"],
 ["Pedido mínimo", "50 piezas"],
 ["Entrega CDMX",  "24–48 hrs"],
];

const faqs = [
 {
 id: "cs08-f1",
 question: "¿Cuál es la caja más económica para una PyME en CDMX?",
 answer: "Para PyMEs con despacho diario de pedidos, la caja CAD-CS-08 en corrugado simple ECT-32 flauta C es la opción más económica con resistencia adecuada para la mayoría de los productos. El precio por pieza baja significativamente a partir de 200-500 pzas. Para negocios con despachos variables, mantenemos stock en CDMX sin mínimo estricto: desde 50 pzas. Recomendamos 3 medidas estándar (chica, mediana, grande) para cubrir la mayoría de los pedidos sin desperdiciar espacio de caja.",
 },
 {
 id: "cs08-f2",
 question: "¿Puedo pedir distintas medidas en un solo pedido?",
 answer: "Sí. El CAD-CS-08 está diseñado para PyMEs con catálogo variado. Puedes combinar distintas medidas estándar en un solo pedido, con el MOQ de 50 pzas aplicado por referencia. Ofrecemos 6 medidas estándar (micro chica, chica, mediana, grande, extra grande y altura extra) con stock permanente en CDMX. Para medidas especiales fuera del estándar, el MOQ es de 200 pzas con entrega de 3-5 días hábiles.",
 },
 {
 id: "cs08-f3",
 question: "¿Puedo personalizar la caja para mi PyME con logo desde cantidades bajas?",
 answer: "Sí. Ofrecemos impresión flexo 1 color en la caja CAD-CS-08 desde 100 piezas, incluyendo diseño de la plancha en el primer pedido. El setup es un costo único. A partir del segundo pedido, solo pagas el costo de producción. El turnaround es de 5-7 días hábiles con logo. Si aún no tienes logo definido, nuestro equipo de diseño te asesora sin costo en la elección de formato y medida ideal para tu tipo de producto.",
 },
];

const gallery = [
 { src: "/img/catalogo/corrugado-simple-angulo-45-cdmx.avif",  alt: "Caja corrugado PyME negocio local — vista general" },
 { src: "/img/catalogo/corrugado-simple-pared-apilado-cdmx.avif",  alt: "Cajas corrugado para PyME apiladas CDMX" },
 { src: "/img/catalogo/corrugado-simple-uso-envio-cdmx.avif",  alt: "Caja corrugado PyME en despacho real CDMX" },
 { src: "/img/catalogo/corrugado-simple-detalle-flauta-cdmx.avif",  alt: "Detalle flauta caja corrugado económica PyME" },
 { src: "/img/catalogo/cajas-carton-mudanza-resistentes-cdmx.avif", alt: "Cajas corrugado estándar para negocio local CDMX" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Corrugado Estándar",href:"/catalogo/cajas-corrugado-estandar"},{name:"Corrugado PyME"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja Corrugado para PyME y Negocio Local",sku:"CAD-CS-08",description:"Caja corrugado económica ECT-32 para PyME en CDMX — CADECA",image:gallery[0].src,material:"Kraft test ECT-32 pared simple/doble",category:"Cajas Corrugado Estándar",moq:"50"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-corrugado-estandar">Corrugado Estándar</a></li>
 <li><span class="current">Corrugado PyME</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-cs08-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-CS-08 · Corrugado Estándar</span>
 <h1 id="sku-cs08-title" class="cat-page-hero__title">Caja Corrugado para <span>PyME y Negocio Local</span></h1>
 <p class="cat-page-hero__desc">
 La caja ideal para negocios locales, tiendas físicas y despachos diarios en CDMX. ECT-32 con alta resistencia, medidas estándar siempre en stock, sin pedido mínimo alto. Precio mayoreo desde 50 pzas con entrega en 24–48 hrs.
 </p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-CS-08</strong></div>
 <div class="cat-page-hero__strip-item">ECT: <strong>ECT-32</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>50 pzas</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cs08-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-CS-08 · Familia: Corrugado Estándar</p>
 <h2 id="detalle-cs08-title" class="sku-detail__title">Caja Corrugado para PyME y Negocio Local</h2>
 <p class="sku-detail__desc">
 El CAD-CS-08 está diseñado específicamente para PyMEs, tiendas físicas y negocios locales en CDMX que despachan pedidos diariamente y necesitan stock confiable sin comprometer grandes cantidades. Con ECT-32, 6 medidas estándar disponibles y precio competitivo desde 50 piezas, es la opción de entrada ideal para negocios en crecimiento que aún no justifican producción a medida.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">6 medidas</span><span class="sku-detail__strip-label">En stock</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-CS-08 Caja Corrugado para PyME`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-CS-08</a>
 <a href="/catalogo/cajas-corrugado-estandar" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-cs08-title">
 <div class="container">
 <h2 id="faq-cs08-title" class="sku-faq__title">Preguntas Frecuentes — Caja Corrugado PyME</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="Precio Mayoreo para tu PyME — Sin mínimo alto, entrega 24 hrs CDMX" />
</PageLayout>
