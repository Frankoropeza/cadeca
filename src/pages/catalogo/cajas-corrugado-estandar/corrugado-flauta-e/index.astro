---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja de Cartón Micro Flauta E | CADECA";
const description = "Ficha técnica caja corrugado micro flauta E en CDMX. 1.5mm, ECT-23. Para cosméticos, joyería, suplementos y productos de presentación premium.";

const medidas = [
 { nombre:"XS Cosméticos",  lah:"10×8×5",  flauta:"E",ect:"ECT-23",vacío:"0.06 kg",máx:"1 kg",  disp:"yellow",label:"3-5 días" },
 { nombre:"S Joyería",  lah:"15×10×8", flauta:"E",ect:"ECT-23",vacío:"0.09 kg",máx:"2 kg",  disp:"yellow",label:"3-5 días", hl:true },
 { nombre:"M Suplementos",  lah:"20×15×10",flauta:"E",ect:"ECT-23",vacío:"0.14 kg",máx:"3 kg",  disp:"yellow",label:"3-5 días", hl:true },
 { nombre:"L Presentación", lah:"25×20×12",flauta:"E",ect:"ECT-23",vacío:"0.20 kg",máx:"5 kg",  disp:"yellow",label:"3-5 días" },
 { nombre:"XL Premium",  lah:"30×25×15",flauta:"E",ect:"ECT-23",vacío:"0.28 kg",máx:"5 kg",  disp:"gray",  label:"5-7 días" },
 { nombre:"A la Medida",  lah:"Cualquier pequeña",flauta:"E",ect:"ECT-23",vacío:"—",máx:"—",disp:"gray",label:"Consultar" },
];

const specs = [
 ["Código SKU",  "CAD-CE-01"],
 ["Tipo de pared",  "Simple (micro)"],
 ["Flauta",  "E (1.5mm) — microflauta"],
 ["Resistencia ECT",  "ECT-23"],
 ["Gramaje liner",  "115 – 135 g/m²"],
 ["Gramaje médium",  "112 g/m²"],
 ["Grosor total",  "~2mm (más delgado que flauta B o C)"],
 ["Material",  "Kraft virgen o kraft blanco coated"],
 ["Superficie impresión", "Excelente — la mejor en corrugado"],
 ["Ideal para",  "Cosméticos · Joyería · Suplementos · Lujo"],
 ["Peso máx. producto",  "Hasta 5 kg"],
 ["Impresión",  "Offset o digital de alta resolución"],
 ["Certificación",  "FSC disponible"],
 ["Pedido mínimo",  "100 piezas"],
 ["Tiempo de entrega",  "3 a 5 días hábiles"],
];

const faqs = [
 {
 id:"ce-f1",
 question:"¿Por qué la flauta E tiene mejor calidad de impresión que la B o C?",
 answer:"La flauta E (1.5mm) produce una superficie más plana y uniforme que las flautas B (3mm) y C (4mm). El corrugado más fino hace que las ondulaciones del médium no se reflejen en la superficie exterior, resultado en una base de impresión casi tan lisa como el cartón sólido. Esto permite impresión offset, digital de alta resolución y detalles finos de logotipo sin el efecto de 'tablero de ajedrez' que aparece en flautas grandes.",
 },
 {
 id:"ce-f2",
 question:"¿La flauta E tiene menos resistencia que la B o C?",
 answer:"Sí, la flauta E tiene menor resistencia estructural que las flautas más gruesas. Por eso se recomienda solo para productos ligeros (hasta 5 kg) y es ideal para packaging de presentación donde la imagen es prioritaria sobre la resistencia bruta. Para productos que requieren ambos (buena impresión Y alta resistencia), la flauta B es un buen punto medio. Si el producto pesa más de 5 kg, cambia a corrugado simple flauta C o doble corrugado BC.",
 },
];

const mainImg = "/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/cajas-exportacion-ista-doble-flauta-bc-cdmx.avif", alt: "Caja exportación — vista principal" },
 { src: "/img/catalogo/caja-exportacion-pallet-cdmx.avif", alt: "Caja exportación — pallet emplayado" },
 { src: "/img/catalogo/caja-exportacion-hero-cdmx.avif", alt: "Caja exportación — hero" },
 { src: "/img/catalogo/caja-exportacion-container-cdmx.avif", alt: "Cajas exportación — en contenedor" },
 { src: "/img/catalogo/caja-exportacion-esquina-cdmx.avif", alt: "Caja exportación — refuerzo esquina" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"Corrugado Estándar", href:"/catalogo/cajas-corrugado-estandar/"}, {name:"Corrugado Micro Flauta E"}]}
 faqItems={[{question:"¿Por qué la flauta E tiene mejor calidad de impresión que la B o C?", answer:"La flauta E (1.5mm) produce una superficie más plana y uniforme que las flautas B (3mm) y C (4mm). El corrugado más fino hace que las ondulaciones del médium no se reflejen en la superficie exterior, resultando en una base de impresión casi tan lisa como el cartón sólido. Esto permite impresión offset, digital de alta resolución y detalles finos de logotipo sin el efecto de tablero de ajedrez que aparece en flautas grandes."}, {question:"¿La flauta E tiene menos resistencia que la B o C?", answer:"Sí, la flauta E tiene menor resistencia estructural. Por eso se recomienda solo para productos ligeros (hasta 5 kg) y es ideal para packaging de presentación donde la imagen es prioritaria. Para productos que requieren buena impresión Y alta resistencia, la flauta B es un buen punto medio. Si el producto pesa más de 5 kg, cambia a corrugado simple flauta C o doble corrugado BC."}]}
 product={{name:"Caja Corrugado Micro Flauta E Presentación", sku:"CAD-CE-01", description:"Caja Corrugado Micro Flauta E Presentación en CDMX — proveedor CADECA", image:"/img/catalogo/cajas-carton-personalizadas-impresion-logo-1-color-cdmx.avif", material:"Cartón corrugado micro flauta E ECT-23 para cosméticos", category:"Cajas de Cartón Corrugado Estándar", moq:"100"}}
>
 <!-- Breadcrumb -->
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-corrugado-estandar/">Corrugado Estándar</a></li>
 <li><span class="current">Corrugado Micro Flauta E</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-ce-title"
   eyebrow="Corrugado estándar · SKU CAD-CE-01"
   titleHtml={true}
   title="Cajas de micro corrugado <span>flauta E</span>"
   desc="Cajas de micro corrugado flauta E de 1.5 mm para cosméticos, joyería, suplementos y empaques de presentación. Su superficie favorece una impresión definida en formatos de cartón delgado."
   desc2="Estas <strong>cajas de micro corrugado flauta E</strong> usan una microflauta de 1.5 mm que aporta una superficie uniforme para impresión. Se usan para cosméticos, joyería, suplementos y productos donde el empaque de presentación requiere un cartón de perfil delgado.||CADECA surte como proveedor desde 100 piezas. Comparte medidas, cantidad, uso y zona de entrega para cotizar. El equipo asesora al elegir la caja según el producto, el acabado de impresión y el nivel de protección que requiere el empaque."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-ce-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-CE-01 · Familia: Corrugado Estándar</p>
 <h2 id="detalle-ce-title" class="sku-detail__title">Corrugado Micro — Flauta E (1.5mm)</h2>
 <p class="sku-detail__desc">La microflauta E produce la superficie de impresión más lisa del cartón corrugado — comparable al cartón sólido. Ideal para marcas que necesitan alta calidad visual con la resistencia y sustentabilidad del corrugado. Perfecta para cosméticos, joyería, suplementos y cualquier producto de presentación premium donde el packaging forma parte de la experiencia de marca.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Flauta E</span><span class="sku-detail__strip-label">Microflauta 1.5mm</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5 kg</span><span class="sku-detail__strip-label">Peso máx.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3-5 días</span><span class="sku-detail__strip-label">Producción</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([label, val]) => <tr><td>{label}</td><td>{val}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-CE-01 Corrugado Flauta E`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-CE-01</a>
 <a href="/catalogo/cajas-corrugado-estandar/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-ce-title">
 <div class="container">
 <h2 id="sizes-ce-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-CE-01</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Talla</th><th>L × A × H (cm)</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
 <tbody>{medidas.map(m => <tr class={m.hl?"highlight":""}><td>{m.nombre}</td><td><strong>{m.lah}</strong></td><td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td><td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"":m.disp==="yellow"?"":""} {m.label}</span></td></tr>)}</tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem"> Producción 3-5 días · Pedido especial. Medidas personalizadas disponibles bajo pedido.</p>
 </div>
 </section>

 </main>
 <FaqCotizacion faqs={faqs} tema="cajas de micro corrugado flauta E" />
</PageLayout>
