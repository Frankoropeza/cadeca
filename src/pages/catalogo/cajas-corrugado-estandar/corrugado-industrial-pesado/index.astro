---
import PageLayout    from "@/layouts/PageLayout.astro";
import FaqItem       from "@/components/FaqItem.astro";
import LeadCapture   from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Caja Corrugado Industrial Carga Pesada ECT-71 CDMX | CAD-CS-09 | CADECA";
const description = "Caja corrugado industrial carga pesada en CDMX. Triple pared ECT-71, para maquinaria, autopartes y electrónicos pesados. Desde 50 pzas, entrega 24–48 hrs. CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const specs = [
  ["Código SKU",    "CAD-CS-09"],
  ["Tipo de pared", "Triple corrugado BCB"],
  ["Flauta",        "BCB (11mm)"],
  ["Resistencia",   "ECT-71"],
  ["Gramaje liner", "200 g/m² kraft virgen"],
  ["Material",      "Kraft virgen triple pared"],
  ["Cierre",        "4 solapas reforzadas + flap adicional"],
  ["Carga apilado", "Hasta 800 kg en condiciones ideales"],
  ["Pedido mínimo", "50 piezas"],
  ["Entrega CDMX",  "24–48 hrs"],
];

const faqs = [
  {
    id: "cs09-f1",
    question: "¿Qué tipo de productos requieren una caja ECT-71 triple pared?",
    answer: "La resistencia ECT-71 está diseñada para productos que superan los 25 kg por pieza o que requieren protección extrema contra impactos en tránsito. Los casos más comunes son: motores y componentes de maquinaria industrial, autopartes metálicas (motores, transmisiones, carters), equipos electrónicos de gran formato (servidores, equipos de medición, UPS), materiales de construcción pesados y piezas de fundición. También se usa ampliamente en exportación cuando el producto pasará por múltiples puntos de transbordo.",
  },
  {
    id: "cs09-f2",
    question: "¿Cuánto peso puede soportar la caja triple pared ECT-71 apilada?",
    answer: "Una caja CAD-CS-09 con ECT-71 y triple pared BCB resiste una carga estática de apilado de hasta 800 kg en condiciones ideales (temperatura 20°C, humedad relativa 50%). En la práctica de almacén con temperatura hasta 30°C y humedad hasta 70%, la resistencia operativa efectiva es de 400-500 kg. Para tarimas estándar de 1.2×1.0m con 4 columnas de cajas, esto equivale a 5-6 capas seguras sin deformación. Siempre verificar resistencia con el producto real antes de producir a escala.",
  },
  {
    id: "cs09-f3",
    question: "¿Cuál es el tiempo de entrega para cajas industriales ECT-71 en CDMX?",
    answer: "Para las 5 medidas estándar del CAD-CS-09, mantenemos stock en nuestro almacén de CDMX con entrega en 24-48 horas hábiles. Para medidas especiales (fuera de catálogo estándar) o lotes mayores a 1,000 pzas, el tiempo de producción es de 3-5 días hábiles adicionales. El pedido mínimo es de 50 piezas para medidas en stock. Para pedidos urgentes de hasta 200 pzas, ofrecemos servicio same-day en CDMX con solicitud antes de las 10 am.",
  },
];

const gallery = [
  { src: "/img/catalogo/corrugado-triple-pared-hero-cdmx.avif",          alt: "Caja corrugado industrial carga pesada triple pared — hero" },
  { src: "/img/catalogo/corrugado-triple-pared-capas-cdmx.avif",         alt: "Detalle capas triple pared corrugado industrial ECT-71" },
  { src: "/img/catalogo/corrugado-triple-pared-apilado-cdmx.avif",       alt: "Cajas corrugado industrial apiladas en almacén CDMX" },
  { src: "/img/catalogo/corrugado-triple-pared-pallet-cdmx.avif",        alt: "Pallet cajas corrugado industrial carga pesada CDMX" },
  { src: "/img/catalogo/cajas-carton-triple-corrugado-industrial-cdmx.avif", alt: "Caja triple corrugado industrial pesado CDMX" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Corrugado Estándar",href:"/catalogo/cajas-corrugado-estandar"},{name:"Corrugado Industrial Pesado"}]}
  faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
  product={{name:"Caja Corrugado Industrial Carga Pesada",sku:"CAD-CS-09",description:"Caja triple pared ECT-71 para carga pesada e industria en CDMX — CADECA",image:gallery[0].src,material:"Kraft virgen triple pared BCB ECT-71",category:"Cajas Corrugado Estándar",moq:"50"}}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-corrugado-estandar">Corrugado Estándar</a></li>
        <li><span class="current">Corrugado Industrial Pesado</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-cs09-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-CS-09 · Corrugado Estándar</span>
      <h1 id="sku-cs09-title" class="cat-page-hero__title">Caja Corrugado <span>Industrial Carga Pesada</span></h1>
      <p class="cat-page-hero__desc">
        Triple pared BCB con resistencia ECT-71. La opción más robusta del catálogo CADECA para maquinaria, autopartes y electrónicos de alto valor. Hasta 800 kg de carga apilada. Entrega en 24–48 hrs en CDMX desde 50 pzas.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-CS-09</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-71</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>50 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-cs09-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-CS-09 · Familia: Corrugado Estándar</p>
            <h2 id="detalle-cs09-title" class="sku-detail__title">Caja Corrugado Industrial Carga Pesada</h2>
            <p class="sku-detail__desc">
              El CAD-CS-09 es la caja de mayor resistencia del catálogo CADECA. Triple pared BCB con liner kraft virgen 200 g/m², ECT-71 y carga de apilado hasta 800 kg. Diseñada para los requerimientos más exigentes de la industria automotriz, electrónica y de manufactura en CDMX y EDOMEX. Compatible con operaciones nearshoring, exportación y transporte multimodal.
            </p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-71</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">800 kg</span><span class="sku-detail__strip-label">Apilado máx.</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">11 mm</span><span class="sku-detail__strip-label">Espesor pared</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-CS-09 Caja Corrugado Industrial Carga Pesada`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-CS-09</a>
              <a href="/catalogo/cajas-corrugado-estandar" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-faq" aria-labelledby="faq-cs09-title">
      <div class="container">
        <h2 id="faq-cs09-title" class="sku-faq__title">Preguntas Frecuentes — Corrugado Industrial ECT-71</h2>
        <div class="sku-faq__list">
          {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="Cotiza Caja Industrial ECT-71 — Fabricante Directo en CDMX" />
</PageLayout>
