---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja de Cartón Doble Corrugado (BC) | CADECA";
const description = "Ficha técnica caja doble corrugado pared doble BC en CDMX. ECT-44 y ECT-51. Para electrónica, Amazon FBA, industria media.";

const medidas = [
 { nombre:"Chica",  lah:"30×20×20",flauta:"BC",ect:"ECT-44",vacío:"0.52 kg",máx:"15 kg", disp:"green",  label:"Stock" },
 { nombre:"Mediana",  lah:"40×30×25",flauta:"BC",ect:"ECT-44",vacío:"0.78 kg",máx:"20 kg", disp:"green",  label:"Stock",  hl:true },
 { nombre:"Grande",  lah:"50×40×30",flauta:"BC",ect:"ECT-44",vacío:"1.10 kg",máx:"25 kg", disp:"green",  label:"Stock",  hl:true },
 { nombre:"Extra Grande", lah:"60×50×40",flauta:"BC",ect:"ECT-44",vacío:"1.60 kg",máx:"25 kg", disp:"yellow", label:"Según pedido" },
 { nombre:"Industrial 1", lah:"70×50×50",flauta:"BC",ect:"ECT-51",vacío:"2.10 kg",máx:"25 kg", disp:"yellow", label:"Según pedido" },
 { nombre:"A la Medida",  lah:"Cualquier",flauta:"BC/BB",ect:"A elegir",vacío:"—",máx:"—",disp:"gray",label:"3-5 días" },
];

const specs = [
 ["Código SKU",  "CAD-CD-01"],
 ["Tipo de pared",  "Doble (pared doble)"],
 ["Flautas disponibles", "BC (7mm) · BB (6mm)"],
 ["Resistencia ECT",  "ECT-44 (estándar) · ECT-51 (reforzado)"],
 ["Gramaje liner",  "150 – 175 g/m²"],
 ["Gramaje médium",  "127 g/m² por capa"],
 ["Material",  "Kraft virgen · Test · PCR reciclado"],
 ["Color exterior",  "Kraft marrón natural"],
 ["Peso máx. producto",  "Hasta 25 kg (ECT-44, flauta BC)"],
 ["Carga de apilado",  "Hasta 200 kg (condiciones ideales)"],
 ["Impresión",  "Flexografía 1-4 colores (opcional)"],
 ["Certificación",  "FSC disponible · Cumple Amazon FBA"],
 ["Pedido mínimo",  "Sin mínimo (stock) · 50 pzas (producción)"],
 ["Tiempo de entrega",  "Según pedido"],
];

const faqs = [
 {
 id:"cd-f1",
 question:"¿Por qué Amazon FBA exige doble corrugado como mínimo?",
 answer:"Los centros de distribución pueden someter las cajas a bandas, compresión y apilamiento. La resistencia requerida depende de las reglas vigentes del canal y del producto; confirma con tu plataforma o transportista qué especificación de empaque solicita.",
 },
 {
 id:"cd-f2",
 question:"¿Cuánto más cuesta el doble corrugado vs el simple?",
 answer:"El doble corrugado tiene un costo superior al simple, generalmente entre un 30% y un 50% más por pieza dependiendo de la medida y el volumen. Sin embargo, este costo extra se justifica cuando el producto cuesta más que la caja (electrónica, maquinaria, artículos de lujo) o cuando los rechazos por daños en tránsito generan más pérdidas que el diferencial de precio del empaque.",
 },
 { id:"cd-f3", question:"¿Qué diferencia hay entre doble corrugado BC y EB?", answer:"Ambas combinaciones usan dos flautas, pero cambian espesor, rigidez y superficie de impresión. La alternativa adecuada depende del peso, fragilidad, apilamiento y presentación requerida para el producto y su recorrido." },
 { id:"cd-f4", question:"¿Cómo se elige una caja de doble corrugado para envío?", answer:"Considera medidas, peso, tipo de producto, protección interna y condiciones de transporte. La pared doble puede aportar más estructura que la simple, pero el ECT y cierre deben definirse con las necesidades reales." },
 { id:"cd-f5", question:"¿Cómo cotizo cajas de cartón doble corrugado?", answer:"Envía dimensiones internas, peso, cantidad y uso de la caja en el formulario. Indica si habrá apilamiento, impresión o requerimientos de cierre para revisar la combinación de flautas adecuada." },
];

const mainImg = "/img/productos/cajas-carton-doble-corrugado-resistente-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/cajas-carton-doble-corrugado-resistente-cdmx.avif", alt: "Caja doble corrugado — vista principal" },
 { src: "/img/catalogo/corrugado-doble-pared-hero-cdmx.avif", alt: "Caja doble corrugado — hero" },
 { src: "/img/catalogo/corrugado-doble-pared-angulo-cdmx.avif", alt: "Caja doble corrugado — ángulo 45°" },
 { src: "/img/catalogo/corrugado-doble-pared-frontal-cdmx.avif", alt: "Caja doble corrugado — apiladas" },
 { src: "/img/catalogo/corrugado-doble-pared-detalle-cdmx.avif", alt: "Doble corrugado — capas BC" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"Corrugado Estándar", href:"/catalogo/cajas-corrugado-estandar/"}, {name:"Doble Corrugado"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Caja Doble Corrugado BC", sku:"CAD-CD-01", description:"Caja Doble Corrugado BC en CDMX — proveedor CADECA", image:"/img/catalogo/cajas-carton-doble-corrugado-resistente-cdmx.avif", material:"Cartón doble corrugado flauta BC ECT-44", category:"Cajas de Cartón Corrugado Estándar", moq:"50"}}
>

 <!-- Breadcrumb -->
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-corrugado-estandar/">Corrugado Estándar</a></li>
 <li><span class="current">Doble Corrugado</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cd-title"
   eyebrow="Corrugado estándar · SKU CAD-CD-01"
   titleHtml={true}
   title="Cajas de doble corrugado <span>pared BC</span>"
   desc="Cajas de doble corrugado con pared BC y ECT-44 para electrónica, menaje, Amazon FBA y distribución industrial. Sus dos capas de flauta ayudan a resistir impacto y aplastamiento."
   desc2="La <strong>caja doble corrugado</strong> integra dos capas de flauta BC y resistencia ECT-44. Se usa en electrónica, menaje, Amazon FBA y distribución industrial, con una capacidad indicada de hasta 25 kg para productos que requieren mayor protección.||Para cargas de hasta 25 kg, la flauta BC y el ECT-44 se valoran con el peso, fragilidad y estiba. Comparte dimensiones del producto, peso por caja, altura de apilamiento y si viaja por paquetería; CADECA revisa el formato de doble pared."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cd-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-CD-01 · Familia: Corrugado Estándar</p>
 <h2 id="detalle-cd-title" class="sku-detail__title">Doble Corrugado — Pared Doble (BC)</h2>
 <p class="sku-detail__desc">
 Dos capas de flauta BC entre tres liners de papel kraft o test. Mayor resistencia al impacto lateral y al aplastamiento vertical. El estándar de la industria para electrónica, menaje, distribución industrial y Amazon FBA. ECT-44 especificado de fábrica, disponible en ECT-51 bajo pedido.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Resistencia estándar</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">25 kg</span><span class="sku-detail__strip-label">Peso máx.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Sin mín.</span><span class="sku-detail__strip-label">Pedido</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Según pedido</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([label, val]) => <tr><td>{label}</td><td>{val}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-CD-01 Doble Corrugado`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-CD-01</a>
 <a href="/catalogo/cajas-corrugado-estandar/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-cd-title">
 <div class="container">
 <h2 id="sizes-cd-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-CD-01</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Tamaño</th><th>L × A × H (cm)</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td>{m.nombre}</td><td><strong>{m.lah}</strong></td><td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"":m.disp==="yellow"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem"> Disponibilidad según pedido ·  Producción rápida · Pedido especial. Pesos bajo condiciones estándar.</p>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas de doble corrugado" />
</PageLayout>
