---
import PageLayout from "@/layouts/PageLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";

const title = "Cajas de Cartón Pequeñas | Medidas y Fichas | CADECA";
const description = "Cajas de cartón pequeñas para joyería, cosmética, suplementos y envíos. Consulta medidas, flauta, ECT y cantidades en fichas del catálogo.";

const schema = {
  "@context": "https://schema.org", "@type": "CollectionPage",
  "@id": "https://cajas-de-carton.com/catalogo/cajas-de-carton-pequenas/#webpage",
  "name": title, "url": "https://cajas-de-carton.com/catalogo/cajas-de-carton-pequenas/", "description": description,
  "about": { "@id": "https://cajas-de-carton.com/#org" }, "isPartOf": { "@id": "https://cajas-de-carton.com/#website" }
};

const productos = [
  { code: "CAD-CS-11", title: "Caja Corrugado Chica Estándar", badge: "Medidas chicas", badgeColor: "orange", desc: "Cuatro medidas publicadas para accesorios, cosmética, farmacia y e-commerce.", imgSrc: "/img/catalogo/caja-chica-estandar-hero-cdmx.avif", imgAlt: "Caja de cartón chica estándar", href: "/catalogo/cajas-corrugado-estandar/caja-chica-estandar/", specs: [["Medidas", "10×10×10 a 25×20×15 cm"], ["Flauta", "B / E"], ["ECT", "ECT-32"], ["Pedido", "50 piezas"]] },
  { code: "CAD-FC-04", title: "Caja para Suplementos y Nutrición", badge: "Suplementos", badgeColor: "green", desc: "Formatos para frasco individual, bote de proteína, kits y display, con medidas visibles en la ficha.", imgSrc: "/img/catalogo/caja-suplementos-nutricion-deportiva-cdmx.avif", imgAlt: "Caja pequeña para suplementos", href: "/catalogo/cajas-farmaceutica-cosmetica/suplementos-nutricion/", specs: [["Medidas", "10×10×15 a 35×25×20 cm"], ["Flauta", "B / C"], ["ECT", "ECT-32"], ["Pedido", "200 piezas"]] },
  { code: "CAD-FC-07", title: "Caja para Marca de Cosmética Emergente", badge: "Cosmética", badgeColor: "blue", desc: "Caja de flauta E disponible en kraft o corrugado blanco para presentación de productos cosméticos.", imgSrc: "/img/catalogo/caja-cosmetica-premium-barniz-uv-cdmx.avif", imgAlt: "Caja pequeña para cosmética", href: "/catalogo/cajas-farmaceutica-cosmetica/caja-cosmetica-startup/", specs: [["Pared", "Simple"], ["Flauta", "E (1.5 mm)"], ["ECT", "ECT-23"], ["Pedido", "100 piezas"]] },
  { code: "CAD-EC-06", title: "Caja de Envío Online Universal", badge: "Envío", badgeColor: "blue", desc: "Referencia de e-commerce con cinco medidas estándar publicadas para envíos de productos pequeños y medianos.", imgSrc: "/img/catalogo/caja-envio-online-hero-cdmx.avif", imgAlt: "Caja pequeña para envío en línea", href: "/catalogo/cajas-para-ecommerce/caja-envio-online/", specs: [["Medidas", "5 estándar e-commerce"], ["Pared", "Doble corrugado BC"], ["ECT", "ECT-32"], ["Pedido", "50 piezas por medida"]] }
];

const faqs = [
  { id: "pequenas-1", question: "¿Qué medidas tienen las cajas de cartón pequeñas?", answer: "La ficha CAD-CS-11 publica 10×10×10, 15×10×10, 20×15×10 y 25×20×15 cm. La ficha de suplementos también muestra 10×10×15, 15×15×25, 30×15×15 y 35×25×20 cm." },
  { id: "pequenas-2", question: "¿Qué flauta se usa para cajas pequeñas?", answer: "Las fichas de esta selección muestran flautas B, C y E. La elección cambia según el producto, la superficie requerida y la protección; revisa la especificación completa en cada ficha." },
  { id: "pequenas-3", question: "¿Qué caja pequeña conviene para joyería o accesorios?", answer: "La medida 10×10×10 cm de CAD-CS-11 se publica para joyería y accesorios. Antes de pedirla, mide el producto y considera el espacio para cualquier protección interior." },
  { id: "pequenas-4", question: "¿Puedo usar una caja pequeña para cosmética?", answer: "Sí, las fichas CAD-CS-11 y CAD-FC-07 se dirigen a cosmética. CAD-FC-07 publica flauta E y pedido mínimo de 100 piezas; CAD-CS-11 publica cuatro medidas estándar y ECT-32." },
  { id: "pequenas-5", question: "¿Cómo pido una caja pequeña?", answer: "Comparte el SKU, las dimensiones internas necesarias, el peso por caja, si llevará relleno y la cantidad de piezas. Si ninguna medida publicada ajusta, consulta cajas a la medida." }
];
---

<PageLayout title={title} description={description} pageType="catalog" schema={schema}
  breadcrumbs={[{ name: "Inicio", href: "/" }, { name: "Catálogo", href: "/catalogo/" }, { name: "Cajas de cartón pequeñas" }]}
  faqItems={faqs.map(({ question, answer }) => ({ question, answer }))}>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación"><div class="container"><ol><li><a href="/">Inicio</a></li><li><a href="/catalogo/">Catálogo</a></li><li><span class="current">Cajas de cartón pequeñas</span></li></ol></div></div>
  <PageHero eyebrow="Catálogo · Formatos pequeños" title="Cajas de cartón pequeñas <span>para envío</span>" desc="Cajas de cartón pequeñas para artículos compactos, accesorios, cosmética, suplementos y envío en línea. Consulta sus medidas, flautas, ECT y cantidades publicadas en cada ficha." desc2="Las <strong>cajas chicas para envío</strong> requieren medir el producto en su punto más amplio y considerar el espacio para relleno. La medida interior es la referencia para compararla con el artículo; las fichas incluyen flauta, ECT y cantidad cuando esos datos están publicados.||Para una caja pequeña, la medida interior y el espacio para relleno definen el ajuste del artículo compacto. Para cotizar, comparte largo, ancho y alto del producto, peso, material de protección y tipo de envío; CADECA revisa flauta y ECT entre los formatos publicados." />
  <main id="contenido-principal" role="main">
    <section id="fichas" style="padding:var(--spacing-3xl) 0;background:var(--color-accent);" aria-labelledby="fichas-title"><div class="container"><h2 id="fichas-title" class="section-header__title">Fichas para formato pequeño</h2><p class="section-header__subtitle">Selecciona una ficha para revisar la especificación completa y confirmar que la medida es compatible con tu producto.</p><div class="sku-grid">{productos.map((p) => <article class="sku-card"><div class="sku-card__img-wrap"><img src={p.imgSrc} alt={p.imgAlt} class="sku-card__img" width="640" height="480" loading="lazy" decoding="async" /><span class="sku-card__code">{p.code}</span><span class={`sku-card__badge sku-card__badge--${p.badgeColor}`}>{p.badge}</span></div><div class="sku-card__body"><h3 class="sku-card__name">{p.title}</h3><p class="sku-card__desc">{p.desc}</p><div class="sku-card__specs">{p.specs.map(([label, value]) => <div><span class="sku-card__spec-label">{label}</span><span class="sku-card__spec-value">{value}</span></div>)}</div><div class="sku-card__footer"><a class="btn btn--primary" href={p.href}>Ver ficha técnica</a></div></div></article>)}</div></div></section>
    <section class="sku-detail" aria-labelledby="seleccion-title"><div class="container"><div class="sku-detail__content"><h2 id="seleccion-title" class="sku-detail__title">Elige por medida interior, peso y uso</h2><p>Una caja chica debe dejar suficiente holgura para introducir el producto sin forzar las paredes. La <a href="/blog/como-calcular-medidas-caja-carton-producto/">guía para calcular medidas</a> usa largo, ancho y alto interiores y recomienda sumar espacio para protección cuando el producto lo requiere. El objetivo es que el contenido quede estable, no holgado en exceso.</p><p>La flauta también importa. CAD-CS-11 publica flauta B o E; CAD-FC-07 usa flauta E y CAD-FC-04 publica B o C. No elijas por tamaño solamente: compara el peso del artículo, la fragilidad y el trayecto. Para profundizar en la pared del corrugado, consulta la <a href="/blog/diferencias-corrugado-simple-doble-triple-pared/">guía de simple, doble y triple pared</a>.</p><p>En envíos, el espacio sin usar aumenta el volumen del paquete. Si vendes en línea, revisa el artículo sobre <a href="/blog/peso-volumetrico-cajas-medida-ecommerce-ahorro-envios/">peso volumétrico</a> antes de fijar una medida. Las fichas ayudan a iniciar la comparación, pero la elección final debe incluir el producto ya protegido.</p></div></div></section>
    <section class="sku-sizes" aria-labelledby="medidas-title"><div class="container"><h2 id="medidas-title" class="section-header__title">Medidas publicadas en las fichas</h2><div class="catalog-sizes-table-wrap"><table class="catalog-sizes-table"><thead><tr><th>Ficha</th><th>Medida L×A×H (cm)</th><th>Flauta</th><th>ECT</th><th>Uso publicado</th></tr></thead><tbody><tr><td><a href="/catalogo/cajas-corrugado-estandar/caja-chica-estandar/">CAD-CS-11</a></td><td>10×10×10; 15×10×10; 20×15×10; 25×20×15</td><td>B / E</td><td>ECT-32</td><td>Accesorios, cosmética y e-commerce</td></tr><tr><td><a href="/catalogo/cajas-farmaceutica-cosmetica/suplementos-nutricion/">CAD-FC-04</a></td><td>10×10×15; 15×15×25; 30×15×15; 35×25×20</td><td>B / C</td><td>ECT-32</td><td>Suplementos y kits</td></tr></tbody></table></div><p style="font-size:0.9rem;color:var(--color-text-light);margin-top:var(--spacing-md);">Las dos fichas restantes publican especificaciones y cantidades, pero no una medida L×A×H individual en su encabezado.</p></div></section>
    <section class="sku-detail" aria-labelledby="usos-title"><div class="container"><div class="sku-detail__content"><h2 id="usos-title" class="sku-detail__title">Usos típicos en formato pequeño</h2><p>Las medidas de CAD-CS-11 ayudan a ordenar productos compactos por volumen. La ficha relaciona 10×10×10 cm con joyería y accesorios; 15×10×10 cm con velas, perfumes y cosméticos individuales; 20×15×10 cm con cosméticos medianos, libros de bolsillo y artículos pequeños; y 25×20×15 cm con ropa doblada o productos de salud. Toma esos usos como referencias de tamaño, no como sustituto de medir tu producto.</p><p>Para suplementos, CAD-FC-04 distingue frasco individual, bote de proteína, kit de tres productos y display. Esa diferencia muestra por qué una caja pequeña no siempre es cúbica: el alto del frasco o la combinación de varios artículos cambia la relación entre largo, ancho y alto. Si el contenido requiere separación, considera el espacio que tomarán los divisores o el relleno antes de comparar una medida.</p><p>Cuando la caja se usará para envío en línea, revisa además el cierre y el volumen final. CAD-EC-06 publica doble corrugado BC, ECT-32 y cinco medidas estándar para e-commerce. Su ficha es una referencia para preguntar por una opción de envío, mientras que la medición de tu producto determina cuál de esas medidas vale la pena evaluar.</p></div></div></section>
  </main>
  <FaqCotizacion faqs={faqs} tema="cajas de cartón pequeñas" producto="Cajas de cartón pequeñas" />
</PageLayout>
