---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Cajas E-commerce a la Medida CDMX | CAD-EC-05 | Peso Volumétrico | CADECA";
const description = "Ficha técnica cajas e-commerce a la medida en CDMX. Cualquier dimensión exacta que minimice peso volumétrico. Diseño CAD gratis, desde 50 pzas, entrega 3-5 días. CADECA.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU",  "CAD-EC-05"],
 ["Tipo",  "E-commerce a la medida exacta"],
 ["Tipo de pared",  "Simple (ligero) · Doble (pesado)"],
 ["Flauta",  "C (simple) · BC (doble)"],
 ["Resistencia ECT",  "ECT-32 o ECT-44 según peso"],
 ["Dimensiones",  "Cualquier L × A × H sin costo extra"],
 ["Objetivo",  "Minimizar peso volumétrico por carrier"],
 ["Diseño CAD",  "Gratuito en 24 horas"],
 ["Asesoría vol. weight","Incluida sin costo"],
 ["Material",  "Kraft virgen marrón"],
 ["Logo impreso",  "Opcional, desde 100 pzas adicionales"],
 ["Pedido mínimo",  "50 piezas"],
 ["Tiempo de entrega",  "3-5 días hábiles desde aprobación CAD"],
];

const faqs = [
 {
 id:"ec05-f1",
 question:"¿Cómo me ayudan a encontrar la medida exacta que minimiza mi costo de envío?",
 answer:"Es simple: compártenos las dimensiones de tu producto (largo, ancho y alto empacado) y la paquetería que usas. Calculamos el peso volumétrico de varias opciones de caja y te recomendamos la medida que reduce más ese cálculo sin sacrificar protección. Para la mayoría de los productos el ahorro es de 15% a 35% en el costo de envío por pieza. El servicio de cálculo es completamente gratuito.",
 },
 {
 id:"ec05-f2",
 question:"¿Cuándo tiene sentido hacer una caja a la medida en lugar de usar medidas estándar?",
 answer:"Tiene sentido cuando: 1) Tu producto tiene dimensiones irregulares y las cajas estándar te generan exceso de peso volumétrico. 2) Vendes más de 200 piezas/mes y el diferencial de costo por envío justifica la inversión en producción personalizada. 3) Tu producto requiere un ajuste exacto para que no se mueva dentro de la caja sin usar relleno adicional. 4) Tu empaque forma parte de la experiencia de marca y necesitas dimensiones precisas.",
 },
];

const mainImg = "/img/catalogo/cajas-medida-ecommerce-peso-volumetrico-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/cajas-medida-ecommerce-peso-volumetrico-cdmx.avif", alt: "Caja medida e-commerce — principal" },
 { src: "/img/catalogo/caja-medida-ecom-hero-cdmx.avif", alt: "Medida e-com — hero" },
 { src: "/img/catalogo/caja-medida-ecom-eficiencia-cdmx.avif", alt: "Eficiencia volumétrica" },
 { src: "/img/catalogo/caja-medida-ecom-bodega-cdmx.avif", alt: "Cajas — bodega" },
 { src: "/img/catalogo/caja-medida-ecom-comparacion-cdmx.avif", alt: "Comparación tallas" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"E-commerce", href:"/catalogo/cajas-para-ecommerce"}, {name:"E-commerce a la Medida"}]}
 faqItems={[{question:"¿Cómo me ayudan a encontrar la medida exacta que minimiza mi costo de envío?", answer:"Compártenos las dimensiones de tu producto empacado y la paquetería que usas. Calculamos el peso volumétrico de varias opciones de caja y te recomendamos la medida que reduce más ese cálculo sin sacrificar protección. Para la mayoría de los productos el ahorro es de 15 a 35 por ciento en el costo de envío por pieza. El servicio de cálculo es completamente gratuito."}, {question:"¿Cuándo tiene sentido hacer una caja a la medida en lugar de usar medidas estándar?", answer:"Tiene sentido cuando: tu producto tiene dimensiones irregulares y las cajas estándar generan exceso de peso volumétrico; vendes más de 200 piezas al mes y el diferencial de costo por envío justifica la inversión; tu producto requiere ajuste exacto para que no se mueva sin relleno adicional; o tu empaque forma parte de la experiencia de marca y necesitas dimensiones precisas."}]}
 product={{name:"Cajas E-commerce a la Medida CDMX", sku:"CAD-EC-05", description:"Cajas E-commerce a la Medida CDMX en CDMX — fabricante directo CADECA", image:"/img/catalogo/cajas-medida-ecommerce-peso-volumetrico-cdmx.avif", material:"Cartón corrugado a la medida para e-commerce optimización volumétrica", category:"Cajas para E-commerce", moq:"50"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-ecommerce">E-commerce</a></li>
 <li><span class="current">E-commerce a la Medida</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-ec05-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-EC-05 · E-commerce</span>
 <h1 id="sku-ec05-title" class="cat-page-hero__title">Cajas E-commerce<br><span>a la Medida — Peso Volumétrico</span></h1>
 <p class="cat-page-hero__desc">Cuando ninguna medida estándar se ajusta a tu producto. Calculamos la dimensión exacta que minimiza el peso volumétrico en tu paquetería. CAD gratis en 24 hrs, desde 50 piezas.</p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-EC-05</strong></div>
 <div class="cat-page-hero__strip-item">CAD: <strong>Gratis 24 hrs</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>50 piezas</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>3-5 días</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-ec05-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-EC-05 · Familia: E-commerce</p>
 <h2 id="detalle-ec05-title" class="sku-detail__title">Cajas E-commerce a la Medida</h2>
 <p class="sku-detail__desc">Fabricamos la dimensión exacta que minimiza el peso volumétrico calculado por tu paquetería, reduciendo el costo de envío por pieza entre un 15% y un 35% comparado con usar cajas estándar sobredimensionadas. CAD gratuito en 24 hrs, asesoría de optimización volumétrica incluida sin costo.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">-35%</span><span class="sku-detail__strip-label">Ahorro envío est.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">CAD gratis</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">3-5 días</span><span class="sku-detail__strip-label">Producción</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-EC-05 cajas e-commerce a la medida`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar + CAD Gratis</a>
 <a href="/catalogo/cajas-para-ecommerce" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="faq" aria-labelledby="faq-ec05-title">
 <div class="container">
 <h2 id="faq-ec05-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-EC-05</h2>
 <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
 </div>
 </section>
 </main>
 <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-EC-05 — CAD gratis, calculamos el vol. weight óptimo para tu producto" />
</PageLayout>
