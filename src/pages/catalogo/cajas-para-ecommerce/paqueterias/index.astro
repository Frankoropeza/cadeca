---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas para DHL, FedEx, Estafeta y J&T | CADECA";
const description = "Ficha técnica cajas para DHL, FedEx, Estafeta, J&T y 99Minutos en CDMX. Medidas optimizadas para reducir peso volumétrico. Doble corrugado ECT-44.";

const medidas = [
 { talla:"XS Express",  dims:"20×15×10",factor:"3,000",vol:"1.0 kg",flauta:"BC",ect:"ECT-44",vacío:"0.22 kg",disp:"yellow",label:"3-5 días" },
 { talla:"S Estándar",  dims:"30×20×15",factor:"5,000",vol:"1.8 kg",flauta:"BC",ect:"ECT-44",vacío:"0.38 kg",disp:"yellow",label:"3-5 días",hl:true },
 { talla:"M Estándar",  dims:"40×30×20",factor:"5,000",vol:"4.8 kg",flauta:"BC",ect:"ECT-44",vacío:"0.62 kg",disp:"yellow",label:"3-5 días",hl:true },
 { talla:"L Estándar",  dims:"50×40×30",factor:"5,000",vol:"12.0 kg",flauta:"BC",ect:"ECT-44",vacío:"0.95 kg",disp:"yellow",label:"3-5 días" },
 { talla:"XL Express",  dims:"60×50×40",factor:"3,000",vol:"40.0 kg",flauta:"BC",ect:"ECT-44",vacío:"1.45 kg",disp:"gray",  label:"5-7 días" },
 { talla:"Optimizada",  dims:"A calcular",factor:"Auto",vol:"Mín.",flauta:"BC",ect:"ECT-44",vacío:"—",disp:"gray",label:"Consultar" },
];

const specs = [
 ["Código SKU",  "CAD-EC-03"],
 ["Paqueterías",  "DHL · FedEx · Estafeta · J&T · 99Minutos"],
 ["Tipo de pared",  "Doble corrugado (BC)"],
 ["Flauta",  "BC (7mm)"],
 ["Resistencia ECT",  "ECT-44"],
 ["Optimización",  "Reducción de peso volumétrico"],
 ["Factor DHL/FedEx",  "÷ 3,000 (courier express)"],
 ["Factor Estafeta/J&T", "÷ 5,000 (paquetería terrestre)"],
 ["Asesoría",  "Cálculo gratis de vol. weight óptimo"],
 ["Material",  "Kraft virgen marrón"],
 ["Pedido mínimo",  "50 piezas por medida"],
 ["Entrega CDMX",  "3-5 días (producción bajo pedido)"],
];

const faqs = [
 {
 id:"ec03-f1",
 question:"¿Cómo se calcula el peso volumétrico y cómo lo reduzco?",
 answer:"El peso volumétrico = Largo × Ancho × Alto ÷ Factor divisor. DHL y FedEx usan factor 3,000 (más estricto); Estafeta y J&T usan 5,000. La paquetería cobra por el mayor entre peso real y volumétrico. Para reducirlo, la clave es usar la caja más pequeña que proteja el producto, eliminando espacio vacío. Nuestros asesores calculan gratis cuál medida de caja minimiza el vol. weight para tus productos específicos.",
 },
 {
 id:"ec03-f2",
 question:"¿Qué paquetería conviene más para e-commerce en CDMX?",
 answer:"Depende del destino, peso y urgencia: <strong>DHL:</strong> opción para envíos urgentes y zonas remotas. <strong>FedEx:</strong> opción para productos de alto valor. <strong>Estafeta:</strong> puede convenir para paquetes pesados en zonas metropolitanas. <strong>J&T:</strong> puede ser competitiva en precio para e-commerce masivo. <strong>99Minutos:</strong> revisa su disponibilidad de entrega para tu zona. Usa la que te ofrezca el menor costo total considerando tarifas + peso volumétrico + tiempo.",
 },
];

const mainImg = "/img/catalogo/cajas-dhl-fedex-estafeta-paqueterias-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/cajas-carton-paqueterias-dhl-fedex-estafeta-cdmx.avif", alt: "Cajas paquetería — principal" },
 { src: "/img/catalogo/caja-paqueteria-hero-cdmx.avif", alt: "Cajas paquetería — hero" },
 { src: "/img/catalogo/caja-paqueteria-sorteo-cdmx.avif", alt: "Cajas — centro de clasificación" },
 { src: "/img/catalogo/caja-paqueteria-tallas-cdmx.avif", alt: "Cajas paquetería — tallas XS–XL" },
 { src: "/img/catalogo/caja-paqueteria-lista-cdmx.avif", alt: "Caja sellada — lista para courier" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"E-commerce", href:"/catalogo/cajas-para-ecommerce/"}, {name:"DHL · FedEx · Estafeta"}]}
 faqItems={[{question:"¿Cómo se calcula el peso volumétrico y cómo lo reduzco?", answer:"El peso volumétrico = Largo × Ancho × Alto ÷ Factor divisor. DHL y FedEx usan factor 3000 (más estricto); Estafeta y J&T usan 5000. La paquetería cobra por el mayor entre peso real y volumétrico. Para reducirlo, la clave es usar la caja más pequeña que proteja el producto, eliminando espacio vacío. Te asesoramos para comparar qué medida de caja minimiza el vol. weight para tus productos específicos."}, {question:"¿Qué paquetería conviene más para e-commerce en CDMX?", answer:"Depende del destino y urgencia: DHL puede convenir para envíos urgentes y zonas remotas. FedEx para productos de alto valor. Estafeta puede convenir para paquetes pesados en zonas metropolitanas. J&T puede ser competitiva en precio para e-commerce masivo. 99Minutos depende de la disponibilidad para tu zona. Usa la que ofrezca el menor costo total considerando tarifas más peso volumétrico más tiempo."}]}
 product={{name:"Cajas DHL FedEx Estafeta Peso Volumétrico", sku:"CAD-EC-03", description:"Cajas DHL FedEx Estafeta Peso Volumétrico en CDMX — surtido coordinado por CADECA", image:"/img/catalogo/cajas-dhl-fedex-estafeta-paqueterias-cdmx.avif", material:"Cartón doble corrugado BC ECT-44 optimizado para paqueterías", category:"Cajas para E-commerce", moq:"50"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-ecommerce/">E-commerce</a></li>
 <li><span class="current">DHL · FedEx · Estafeta</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-ec03-title"
   eyebrow="E-commerce · SKU CAD-EC-03"
   titleHtml={true}
   title="Cajas para DHL, FedEx y Estafeta <span>en envío</span>"
   desc="Cajas para DHL, FedEx y Estafeta que ayudan a definir dimensiones para distintos servicios de paquetería. Se revisan según producto, peso y cálculo de volumen del envío."
   desc2="La propuesta considera doble corrugado BC ECT-44 y medidas XS a XL para comparar el cálculo volumétrico de cada servicio. Las <strong>cajas para paquetería</strong> se definen con largo, ancho y alto del producto para elegir una configuración de envío adecuada.||CADECA coordina el surtido con talleres aliados al confirmar medidas, cantidad, uso y zona de entrega. Comparte el producto, peso y paquetería prevista para asesorarte sobre la medida, resistencia y formato de caja de cada envío."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-ec03-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-EC-03 · Familia: E-commerce</p>
 <h2 id="detalle-ec03-title" class="sku-detail__title">Cajas para Paqueterías — Peso Volumétrico Optimizado</h2>
 <p class="sku-detail__desc">Cajas en medidas que minimizan el peso volumétrico calculado por DHL (÷3,000), FedEx (÷3,000), Estafeta (÷5,000) y J&T (÷5,000). Nuestros asesores calculan gratuitamente cuál medida exacta reduce más tu costo de envío por pieza según las dimensiones de tu producto.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5 carriers</span><span class="sku-detail__strip-label">Compatibles</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Gratis</span><span class="sku-detail__strip-label">Asesoría vol.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-EC-03 cajas paqueterías y calcular peso volumétrico`)} class="btn btn--primary" {...contactoAttrs}>Cotizar + Calcular Vol.</a>
 <a href="/catalogo/cajas-para-ecommerce/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-ec03-title">
 <div class="container">
 <h2 id="sizes-ec03-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas y Peso Volumétrico Estimado — CAD-EC-03</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Talla</th><th>L×A×H (cm)</th><th>Factor ÷</th><th>Vol. weight est.</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Disponib.</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td><strong>{m.talla}</strong></td><td>{m.dims}</td><td>{m.factor}</td><td>{m.vol}</td>
 <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="yellow"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Vol. weight estimado = L×A×H÷factor. Peso real puede ser mayor. Consulta tu paquetería para tarifa exacta.</p>
 </div>
 </section>

 <section class="faq" aria-labelledby="faq-ec03-title">
 <div class="container">
 <h2 id="faq-ec03-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-EC-03</h2>
 <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
 </div>
 </section>
 </main>
 <LeadCapture title="Cotiza CAD-EC-03 — Calculamos gratis el peso volumétrico óptimo para tu producto" />
</PageLayout>
