---
import PageLayout    from "@/layouts/PageLayout.astro";
import FaqItem       from "@/components/FaqItem.astro";
import LeadCapture   from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Caja Gran Formato Electrodomésticos CDMX | ECT-44 | CAD-EC-09 | CADECA";
const description = "Caja gran formato para electrodomésticos, línea blanca y muebles en CDMX. Doble corrugado ECT-44, medidas XL y XXL. Compatible con Amazon grande, Walmart y PIMSA. CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const specs = [
  ["Código SKU", "CAD-EC-09"],
  ["Tipo", "Doble corrugado BC"],
  ["Resistencia", "ECT-44"],
  ["Flauta", "BC (7mm)"],
  ["Material", "Kraft virgen marrón"],
  ["Medidas", "XL y XXL gran formato"],
  ["Esquinas", "Reforzadas"],
  ["Pedido mínimo", "50 piezas"],
  ["Entrega CDMX", "24–48 hrs en stock"],
];

const faqs = [
  { id:"cad-ec-09-f1", question:"¿Qué tipo de productos protege esta caja?", answer:"CAD-EC-09 está diseñada para electrodomésticos de hasta 25 kg, televisores de hasta 55 pulgadas, impresoras, aspiradoras y línea blanca pequeña. El doble corrugado ECT-44 absorbe los impactos de caída y compresión que ocurren durante el transporte terrestre en unidades de paquetería." },
  { id:"cad-ec-09-f2", question:"¿Cumple los requisitos de embalaje de Amazon México?", answer:"Sí. Las medidas XL y XXL de CAD-EC-09 están dentro de los rangos aceptados por Amazon México para envíos de gran formato tanto en FBA como en FBM. El ECT-44 supera el mínimo requerido por Amazon para productos pesados. Podemos documentar las especificaciones técnicas para tu proceso de alta de producto." },
  { id:"cad-ec-09-f3", question:"¿Puedo agregar material de relleno o protección interior?", answer:"Sí, ofrecemos separadores de cartón corrugado, papel kraft de relleno y espuma EPE como complemento. Pregunta por nuestro kit de empaque completo para electrodomésticos que incluye la caja + esquineros de cartón + papel kraft a un precio de paquete." },
];

const gallery = [
  { src: "/img/catalogo/caja-almacen-industrial-hero-cdmx.avif", alt: "Caja gran formato electrodomésticos CDMX" },
  { src: "/img/catalogo/caja-almacen-industrial-rack-cdmx.avif", alt: "Cajas gran formato en rack" },
  { src: "/img/catalogo/corrugado-doble-pared-hero-cdmx.avif", alt: "Doble corrugado ECT-44" },
  { src: "/img/catalogo/caja-exportacion-pallet-cdmx.avif", alt: "Cajas gran formato en pallet" },
  { src: "/img/catalogo/caja-almacen-industrial-capas-cdmx.avif", alt: "Apilado cajas gran formato" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas para E-commerce",href:"/catalogo/cajas-para-ecommerce"},{name:"Caja Gran Formato para Electrodomésticos y Blancos"}]}
  faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
  product={{name:"Caja Gran Formato para Electrodomésticos y Blancos",sku:"CAD-EC-09",description:"Caja de gran formato en doble corrugado ECT-44 para electrodomésticos, línea blanca y muebles. Medidas XL/XXL compatibles con Amazon grande, Walmart y PIMSA en CDMX.",image:gallery[0].src,material:"CAD-EC-09",category:"Cajas para E-commerce",moq:"50 piezas"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-para-ecommerce">Cajas para E-commerce</a></li>
        <li><span class="current">Caja Gran Formato para Electrodomésticos y Blancos</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-cadec09-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-EC-09 · Cajas para E-commerce</span>
      <h1 id="sku-cadec09-title" class="cat-page-hero__title">Caja Gran Formato <span>Electrodomésticos</span> y Blancos CDMX</h1>
      <p class="cat-page-hero__desc">Caja de gran formato en doble corrugado ECT-44 para electrodomésticos, línea blanca y muebles. Medidas XL/XXL compatibles con Amazon grande, Walmart y PIMSA en CDMX.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-EC-09</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>50 piezas</strong></div>
        <div class="cat-page-hero__strip-item">Fabricante: <strong>Directo</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-cadec09-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-EC-09 · Familia: Cajas para E-commerce</p>
            <h2 id="detalle-cadec09-title" class="sku-detail__title">Caja Gran Formato para Electrodomésticos y Blancos</h2>
            <p class="sku-detail__desc">Cuando el producto es grande y el riesgo de daño en tránsito es alto, se necesita una caja con corrugado de alta resistencia. CAD-EC-09 usa doble pared ECT-44 con esquinas reforzadas para proteger electrodomésticos, televisores, impresoras y línea blanca durante el envío. Disponible en medidas XL y XXL compatibles con los requisitos de embalaje de Amazon México, Walmart y plataformas de fulfillment como PIMSA. Stock disponible en CDMX con entrega en 24 horas.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">XL/XXL</span><span class="sku-detail__strip-label">Medidas</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-EC-09 Caja Gran Formato para Electrodomésticos y Blancos`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-EC-09</a>
              <a href="/catalogo/cajas-para-ecommerce" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-faq" aria-labelledby="faq-cadec09-title">
      <div class="container">
        <h2 id="faq-cadec09-title" class="sku-faq__title">Preguntas Frecuentes — Caja Gran Formato para Electrodomésticos y Blancos</h2>
        <div class="sku-faq__list">
          {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="¿Vendes electrodomésticos o línea blanca? Cotiza la caja exacta para tu producto en menos de 1 hora" />
</PageLayout>
