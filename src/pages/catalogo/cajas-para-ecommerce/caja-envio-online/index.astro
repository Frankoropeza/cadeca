---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja de Envío para Tienda en Línea | CADECA";
const description = "Caja de envío online compatible con DHL, FedEx, Estafeta, J&T y 99Minutos. Doble corrugado ECT-32. 5 medidas estándar, stock CDMX. MOQ 50 piezas.";

const specs = [
 ["Código SKU", "CAD-EC-06"],
 ["Tipo", "Doble corrugado BC"],
 ["Resistencia", "ECT-32"],
 ["Flauta", "BC (7mm)"],
 ["Medidas disponibles", "5 estándar e-commerce"],
 ["Material", "Kraft virgen marrón"],
 ["Cierre", "4 solapas autoblocante"],
 ["Pedido mínimo", "50 piezas/medida"],
 ["Entrega CDMX", "Según pedido"],
];

const faqs = [
 { id:"cad-ec-06-f1", question:"¿Es compatible con todas las paqueterías?", answer:"Sí. La Caja CAD-EC-06 está diseñada con medidas que cumplen los requerimientos de DHL, FedEx, Estafeta, J&T, 99Minutos y Sendex sin necesidad de ajustes. Las 5 medidas disponibles cubren el 90% de los productos que se venden por e-commerce en México, desde artículos pequeños hasta cajas medianas para electrodomésticos compactos." },
 { id:"cad-ec-06-f2", question:"¿Cuál es el tiempo de entrega si necesito urgente?", answer:"El tiempo depende de la disponibilidad, el volumen y la zona. Para pedidos especiales fuera de las 5 medidas estándar, coordinamos la producción con el fabricante. Escríbenos por WhatsApp para revisar opciones de entrega programada." },
 { id:"cad-ec-06-f3", question:"¿Puedo mezclar medidas en un mismo pedido?", answer:"Sí, puedes hacer un pedido mixto con distintas medidas siempre que cada medida cumpla el MOQ de 50 piezas. Así puedes pedir 50 chicas, 50 medianas y 50 grandes en una sola orden y recibir todo en la misma entrega." },
];

const gallery = [
 { src: "/img/catalogo/caja-envio-online-hero-cdmx.avif", alt: "Caja envío online universal multi-paquetería CDMX" },
 { src: "/img/catalogo/caja-envio-online-courier-cdmx.avif", alt: "Caja envío online con courier" },
 { src: "/img/catalogo/caja-envio-online-stack-cdmx.avif", alt: "Cajas envío online apiladas bodega" },
 { src: "/img/catalogo/caja-envio-online-unboxing-cdmx.avif", alt: "Caja envío online unboxing" },
 { src: "/img/catalogo/caja-paqueteria-tallas-cdmx.avif", alt: "Tallas caja envío paquetería" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas para E-commerce",href:"/catalogo/cajas-para-ecommerce/"},{name:"Caja de Envío Online Universal"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja de Envío Online Universal",sku:"CAD-EC-06",description:"Caja universal para envíos online compatible con cualquier paquetería nacional. Doble corrugado ECT-32, 5 medidas estándar con disponibilidad por confirmar, entrega programada según pedido.",image:gallery[0].src,material:"CAD-EC-06",category:"Cajas para E-commerce",moq:"50 piezas/medida"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-ecommerce/">Cajas para E-commerce</a></li>
 <li><span class="current">Caja de Envío Online Universal</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadec06-title"
   eyebrow="E-commerce · SKU CAD-EC-06"
   titleHtml={true}
   title="Cajas de cartón para envíos <span>en línea</span>"
   desc="Cajas de cartón para envíos de tiendas en línea que requieren una solución para distintas paqueterías. Se cotizan en medidas estándar según producto, peso y tipo de traslado."
   desc2="La propuesta incluye cinco medidas estándar en corrugado con ECT-32 para productos de venta en línea. Las <strong>cajas para envío</strong> se seleccionan considerando dimensiones, peso y necesidad de protección, para elegir una alternativa compatible con el flujo de cada negocio.||CADECA coordina el surtido con talleres aliados al confirmar medidas, cantidad, uso y zona de entrega. Comparte el tamaño y peso del producto para asesorarte sobre la medida, resistencia y formato de caja convenientes para tu envío."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadec06-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-EC-06 · Familia: Cajas para E-commerce</p>
 <h2 id="detalle-cadec06-title" class="sku-detail__title">Caja de Envío Online Universal</h2>
 <p class="sku-detail__desc">La caja de envío es compatible con DHL, FedEx, Estafeta, J&T, 99Minutos y Sendex sin modificaciones. Coordinada en doble corrugado ECT-32 con 5 medidas estándar que cubren muchos productos que se venden por internet. Disponibilidad y entrega se confirman según pedido, con mínimo de 50 piezas por medida. Ideal para comercios con múltiples paqueterías o que cambian de carrier según precio y zona.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">5 medidas</span><span class="sku-detail__strip-label">En stock CDMX</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ/medida</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Según pedido</span><span class="sku-detail__strip-label">Entrega</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-EC-06 Caja de Envío Online Universal`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-EC-06</a>
 <a href="/catalogo/cajas-para-ecommerce/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas de cartón para envíos" />
</PageLayout>
