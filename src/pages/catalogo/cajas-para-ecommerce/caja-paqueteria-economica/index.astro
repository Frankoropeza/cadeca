---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja para Paquetería Económica | CADECA";
const description = "Caja optimizada para paqueterías económicas en CDMX: J&T, 99Minutos, Sendex y Estafeta económica. ECT-32, medidas que minimizan el peso volumétrico.";

const specs = [
 ["Código SKU", "CAD-EC-10"],
 ["Tipo", "Doble corrugado BC"],
 ["Resistencia", "ECT-32"],
 ["Paqueterías", "J&T · 99Min · Sendex · Estafeta"],
 ["Material", "Kraft virgen marrón"],
 ["Optimización", "Peso volumétrico mínimo"],
 ["Medidas", "3 estándar económicas"],
 ["Pedido mínimo", "50 piezas/medida"],
 ["Entrega CDMX", "Según pedido"],
];

const faqs = [
 { id:"cad-ec-10-f1", question:"¿Cómo se calcula el peso volumétrico?", answer:"El peso volumétrico se calcula como Largo×Ancho×Alto / 5000 (DHL y FedEx) o /6000 (J&T y Sendex). Si tu caja tiene dimensiones mayores a las necesarias para contener el producto, estarás pagando de más. CAD-EC-10 reduce ese sobrecosto dimensionando la caja para que el peso volumétrico sea igual o muy cercano al peso real del paquete." },
 { id:"cad-ec-10-f2", question:"¿Cuánto puedo ahorrar usando esta caja vs una genérica?", answer:"Depende del producto, pero en promedio nuestros clientes reportan ahorros del 18% al 35% en costo de flete al cambiar a una caja optimizada para peso volumétrico. En un negocio que envía 500 paquetes mensuales, eso puede significar entre $3,000 y $8,000 pesos de ahorro mensual." },
 { id:"cad-ec-10-f3", question:"¿Funciona para envíos locales en CDMX también?", answer:"Sí. Para envíos locales con 99Minutos o Lalamove, el peso volumétrico también aplica en paquetes medianos y grandes. CAD-EC-10 es válida para envíos locales y nacionales. Además, su resistencia ECT-32 es más que suficiente para envíos locales de corta distancia." },
 { id:"cad-ec-10-f4", question:"¿Cómo elegir una caja económica para paquetería?", answer:"Parte de las medidas y peso del producto con su protección interior. Una caja ajustada ayuda a limitar el espacio vacío y permite comparar el peso volumétrico que aplicará cada paquetería." },
 { id:"cad-ec-10-f5", question:"¿Qué debo enviar para cotizar cajas económicas para envío?", answer:"Envía el formulario con dimensiones, cantidad, peso y paquetería prevista. Si necesitas impresión o una medida especial, inclúyelo para revisar las alternativas de corrugado y formato." },
];

const gallery = [
 { src: "/img/catalogo/caja-paqueteria-hero-cdmx.avif", alt: "Caja paquetería económica J&T 99Minutos CDMX" },
 { src: "/img/catalogo/caja-paqueteria-lista-cdmx.avif", alt: "Caja lista para paquetería" },
 { src: "/img/catalogo/caja-paqueteria-sorteo-cdmx.avif", alt: "Cajas paquetería clasificadas" },
 { src: "/img/catalogo/caja-paqueteria-tallas-cdmx.avif", alt: "Tallas caja paquetería económica" },
 { src: "/img/catalogo/cajas-medida-ecommerce-peso-volumetrico-cdmx.avif", alt: "Optimización peso volumétrico" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas para E-commerce",href:"/catalogo/cajas-para-ecommerce/"},{name:"Caja para Paquetería Económica"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para Paquetería Económica",sku:"CAD-EC-10",description:"Caja específicamente dimensionada para minimizar el costo en paqueterías económicas como J&T, 99Minutos y Sendex. ECT-32 doble pared, MOQ 50 piezas, entrega programada según pedido.",image:gallery[0].src,material:"CAD-EC-10",category:"Cajas para E-commerce",moq:"50 piezas/medida"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-ecommerce/">Cajas para E-commerce</a></li>
 <li><span class="current">Caja para Paquetería Económica</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadec10-title"
   eyebrow="E-commerce · SKU CAD-EC-10"
   titleHtml={true}
   title="Cajas para paquetería <span>económica</span>"
   desc="Cajas para paquetería de negocios que envían con J&T, 99Minutos o Sendex. Se definen para productos y medidas que buscan controlar el volumen de cada envío."
   desc2="La propuesta considera corrugado ECT-32, medidas para envíos y pedido desde 50 piezas. Las <strong>cajas para envíos económicos</strong> se seleccionan por dimensiones, peso y protección requerida, para comparar el formato con el esquema de la paquetería elegida.||Para envíos económicos, la medida exterior y el peso del paquete deben ajustarse al esquema de la paquetería. Envía dimensiones del producto protegido, peso total, operador previsto y cantidad; CADECA revisa una caja ECT-32 con el formato correspondiente."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadec10-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-EC-10 · Familia: Cajas para E-commerce</p>
 <h2 id="detalle-cadec10-title" class="sku-detail__title">Caja para Paquetería Económica</h2>
 <p class="sku-detail__desc">Las paqueterías económicas como J&T, 99Minutos y Sendex aplican cobros por peso volumétrico igual que DHL o FedEx. Una caja sobredimensionada sube tu costo de envío entre 20% y 40% innecesariamente. CAD-EC-10 está dimensionada para minimizar el volumen cobrado en estas paqueterías sin comprometer la protección del producto. Doble corrugado ECT-32, 3 medidas optimizadas para los productos más vendidos en Mercado Libre y Amazon, con disponibilidad según pedido en CDMX.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">J&T/99Min</span><span class="sku-detail__strip-label">Optimizada</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-EC-10 Caja para Paquetería Económica`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-EC-10</a>
 <a href="/catalogo/cajas-para-ecommerce/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas para paquetería" />
</PageLayout>
