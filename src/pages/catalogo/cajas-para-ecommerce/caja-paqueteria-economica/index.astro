---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja Paquetería Económica CDMX | J&T 99Minutos Sendex | CAD-EC-10 | CADECA";
const description = "Caja optimizada para paqueterías económicas en CDMX: J&T, 99Minutos, Sendex y Estafeta económica. ECT-32, medidas que minimizan el peso volumétrico. MOQ 50. CADECA.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU", "CAD-EC-10"],
 ["Tipo", "Doble corrugado BC"],
 ["Resistencia", "ECT-32"],
 ["Paqueterías", "J&T · 99Min · Sendex · Estafeta"],
 ["Material", "Kraft virgen marrón"],
 ["Optimización", "Peso volumétrico mínimo"],
 ["Medidas", "3 estándar económicas"],
 ["Pedido mínimo", "50 piezas/medida"],
 ["Entrega CDMX", "24 hrs en stock"],
];

const faqs = [
 { id:"cad-ec-10-f1", question:"¿Cómo se calcula el peso volumétrico?", answer:"El peso volumétrico se calcula como Largo×Ancho×Alto / 5000 (DHL y FedEx) o /6000 (J&T y Sendex). Si tu caja tiene dimensiones mayores a las necesarias para contener el producto, estarás pagando de más. CAD-EC-10 reduce ese sobrecosto dimensionando la caja para que el peso volumétrico sea igual o muy cercano al peso real del paquete." },
 { id:"cad-ec-10-f2", question:"¿Cuánto puedo ahorrar usando esta caja vs una genérica?", answer:"Depende del producto, pero en promedio nuestros clientes reportan ahorros del 18% al 35% en costo de flete al cambiar a una caja optimizada para peso volumétrico. En un negocio que envía 500 paquetes mensuales, eso puede significar entre $3,000 y $8,000 pesos de ahorro mensual." },
 { id:"cad-ec-10-f3", question:"¿Funciona para envíos locales en CDMX también?", answer:"Sí. Para envíos locales con 99Minutos o Lalamove, el peso volumétrico también aplica en paquetes medianos y grandes. CAD-EC-10 es válida para envíos locales y nacionales. Además, su resistencia ECT-32 es más que suficiente para envíos locales de corta distancia." },
];

const gallery = [
 { src: "/img/catalogo/caja-paqueteria-hero-cdmx.avif", alt: "Caja paquetería económica J&T 99Minutos CDMX" },
 { src: "/img/catalogo/caja-paqueteria-lista-cdmx.avif", alt: "Caja lista para paquetería" },
 { src: "/img/catalogo/caja-paqueteria-sorteo-cdmx.avif", alt: "Cajas paquetería clasificadas" },
 { src: "/img/catalogo/caja-paqueteria-tallas-cdmx.avif", alt: "Tallas caja paquetería económica" },
 { src: "/img/catalogo/cajas-medida-ecommerce-peso-volumetrico-cdmx.avif", alt: "Optimización peso volumétrico" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas para E-commerce",href:"/catalogo/cajas-para-ecommerce"},{name:"Caja para Paquetería Económica"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para Paquetería Económica",sku:"CAD-EC-10",description:"Caja específicamente dimensionada para minimizar el costo en paqueterías económicas como J&T, 99Minutos y Sendex. ECT-32 doble pared, MOQ 50 piezas, entrega 24 hrs CDMX.",image:gallery[0].src,material:"CAD-EC-10",category:"Cajas para E-commerce",moq:"50 piezas/medida"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-ecommerce">Cajas para E-commerce</a></li>
 <li><span class="current">Caja para Paquetería Económica</span></li>
 </ol>
 </div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-cadec10-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-EC-10 · Cajas para E-commerce</span>
 <h1 id="sku-cadec10-title" class="cat-page-hero__title">Caja para <span>Paquetería Económica</span> — J&T, 99Min, Sendex</h1>
 <p class="cat-page-hero__desc">Caja específicamente dimensionada para minimizar el costo en paqueterías económicas como J&T, 99Minutos y Sendex. ECT-32 doble pared, MOQ 50 piezas, entrega 24 hrs CDMX.</p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-EC-10</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>50 piezas/medida</strong></div>
 <div class="cat-page-hero__strip-item">Fabricante: <strong>Directo</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadec10-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-EC-10 · Familia: Cajas para E-commerce</p>
 <h2 id="detalle-cadec10-title" class="sku-detail__title">Caja para Paquetería Económica</h2>
 <p class="sku-detail__desc">Las paqueterías económicas como J&T, 99Minutos y Sendex aplican cobros por peso volumétrico igual que DHL o FedEx. Una caja sobredimensionada sube tu costo de envío entre 20% y 40% innecesariamente. CAD-EC-10 está dimensionada para minimizar el volumen cobrado en estas paqueterías sin comprometer la protección del producto. Doble corrugado ECT-32, 3 medidas optimizadas para los productos más vendidos en Mercado Libre y Amazon, con stock permanente en CDMX.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">J&T/99Min</span><span class="sku-detail__strip-label">Optimizada</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-EC-10 Caja para Paquetería Económica`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-EC-10</a>
 <a href="/catalogo/cajas-para-ecommerce" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-cadec10-title">
 <div class="container">
 <h2 id="faq-cadec10-title" class="sku-faq__title">Preguntas Frecuentes — Caja para Paquetería Económica</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="¿Cuánto pagas de flete mensualmente? Te mostramos cómo reducirlo con la caja correcta" />
</PageLayout>
