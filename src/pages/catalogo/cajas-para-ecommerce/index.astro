 {HAS_WA && (
<a href={contactoHref()}  class="btn btn--outline" {...contactoAttrs}>WhatsApp Directo</a>
)}
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- SUBCATEGORÍAS -->

<section class="industries" aria-labelledby="detIndustrias-eco-title">
