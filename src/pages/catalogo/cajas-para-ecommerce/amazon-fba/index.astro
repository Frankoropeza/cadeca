---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem     from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";

const title       = "Cajas Amazon FBA FBM México CDMX | CAD-EC-02 | ECT-44 | CADECA";
const description = "Ficha técnica cajas para Amazon FBA y FBM en México. ECT-44 certificado, sin grapas expuestas, medidas aprobadas Amazon Seller Central MX. Desde 50 pzas. CADECA CDMX.";
const WHATSAPP    = "5255XXXXXXXX";

const medidas = [
  { talla:"Small (S)",    dims:"20×15×10 cm",flauta:"BC",ect:"ECT-44",vacío:"0.22 kg",máx:"5 kg",  tipo:"FBA/FBM",disp:"yellow",label:"3-5 días" },
  { talla:"Medium (M)",   dims:"30×22×18 cm",flauta:"BC",ect:"ECT-44",vacío:"0.48 kg",máx:"10 kg", tipo:"FBA/FBM",disp:"yellow",label:"3-5 días",hl:true },
  { talla:"Large (L)",    dims:"45×35×25 cm",flauta:"BC",ect:"ECT-44",vacío:"0.85 kg",máx:"15 kg", tipo:"FBA/FBM",disp:"yellow",label:"3-5 días",hl:true },
  { talla:"X-Large (XL)", dims:"55×45×30 cm",flauta:"BC",ect:"ECT-44",vacío:"1.30 kg",máx:"20 kg", tipo:"FBA/FBM",disp:"gray",  label:"5-7 días" },
  { talla:"XX-Large (XXL)",dims:"63×50×40 cm",flauta:"BC",ect:"ECT-51",vacío:"1.90 kg",máx:"25 kg",tipo:"FBA heavy",disp:"gray",label:"5-7 días" },
  { talla:"A la Medida",  dims:"Hasta 63.5cm/lado",flauta:"BC/BCB",ect:"ECT-44+",vacío:"—",máx:"—",tipo:"FBM custom",disp:"gray",label:"Consultar" },
];

const specs = [
  ["Código SKU",          "CAD-EC-02"],
  ["Plataforma",          "Amazon México (FBA y FBM)"],
  ["Tipo de pared",       "Doble corrugado (BC)"],
  ["Flauta",              "BC (7mm) — ECT-51 en XXL"],
  ["Resistencia ECT",     "ECT-44 mínimo (política Amazon)"],
  ["Sin grapas",          "Sí — requerido Amazon FBA"],
  ["Sin ventanas acetato","Sí — requerido Amazon FBA"],
  ["Límite por lado",     "Máx. 63.5 cm (política Amazon)"],
  ["Gramaje liner",       "150 – 175 g/m²"],
  ["Material",            "Kraft virgen marrón"],
  ["Certificación",       "ECT verificado — cumple Seller Central MX"],
  ["Personalización",     "No recomendada para FBA (Amazon lo gestiona)"],
  ["Pedido mínimo",       "50 piezas por talla"],
  ["Tiempo de entrega",   "3-5 días (producción bajo pedido)"],
];

const faqs = [
  {
    id:"ec02-f1",
    question:"¿Por qué Amazon rechaza cajas con grapas o ventanas de acetato?",
    answer:"Las bandas transportadoras automatizadas de los centros de distribución de Amazon pueden engancharse con grapas expuestas, causando daños en la maquinaria o en el producto. Las ventanas de acetato reducen la resistencia estructural del corrugado y hacen difícil el escaneo de códigos de barras. Nuestro CAD-EC-02 elimina ambos problemas de fábrica.",
  },
  {
    id:"ec02-f2",
    question:"¿Qué pasa si envío a Amazon FBA una caja con ECT inferior a 44?",
    answer:"Amazon puede rechazar el inventory shipment en el centro de distribución si las cajas no cumplen con la resistencia estructural mínima. Esto implica que el producto regresa al vendedor con costo de flete a cargo del seller, genera una penalización en la cuenta y retrasa la disponibilidad del producto en el catálogo. Nuestro CAD-EC-02 lleva el ECT-44 garantizado de fábrica para evitar este problema.",
  },
];
---

<PageLayout title={title} description={description} whatsapp={WHATSAPP}>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-para-ecommerce">E-commerce</a></li>
        <li><span class="current">Amazon FBA / FBM</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-ec02-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-EC-02 · E-commerce</span>
      <h1 id="sku-ec02-title" class="cat-page-hero__title">Cajas <span>Amazon FBA / FBM</span><br>— México CDMX</h1>
      <p class="cat-page-hero__desc">ECT-44 certificado, sin grapas expuestas, sin ventanas de acetato. Medidas dentro del límite de 63.5 cm por lado. Cumple todas las políticas de empaque de Amazon Seller Central México.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-EC-02</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-44 certificado</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>50 pzas/talla</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>3-5 días</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-ec02-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div>
            <div class="sku-detail__img-wrap">
              <img src="/img/catalogo/cajas-amazon-fba-fbm-seller-central-mexico.avif"
                alt="Cajas Amazon FBA FBM Seller Central México ECT-44 — CADECA CAD-EC-02"
                class="sku-detail__img" width="880" height="560" loading="eager" decoding="async" fetchpriority="high" />
            </div>
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-EC-02 · Familia: E-commerce</p>
            <h2 id="detalle-ec02-title" class="sku-detail__title">Cajas Amazon FBA / FBM México</h2>
            <p class="sku-detail__desc">Fabricadas específicamente para cumplir todas las políticas de empaque de Amazon Seller Central México. ECT-44 mínimo garantizado, sin grapas expuestas, sin ventanas de acetato y medidas dentro del límite de 63.5 cm por lado. Cero rechazos en centros de distribución Amazon MX.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Mín. Amazon</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">0 grapas</span><span class="sku-detail__strip-label">Política FBA</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">63.5 cm</span><span class="sku-detail__strip-label">Límite/lado</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-EC-02 Cajas Amazon FBA`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-EC-02</a>
              <a href="/catalogo/cajas-para-ecommerce" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-ec02-title">
      <div class="container">
        <h2 id="sizes-ec02-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Amazon Seller Central MX — CAD-EC-02</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Talla</th><th>Dimensiones (cm)</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Tipo uso</th><th>Disponib.</th></tr></thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td><strong>{m.talla}</strong></td><td>{m.dims}</td><td>{m.flauta}</td><td>{m.ect}</td>
                  <td>{m.vacío}</td><td><strong>{m.máx}</strong></td><td>{m.tipo}</td>
                  <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"✓":m.disp==="yellow"?"⏱":"○"} {m.label}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas bajo requerimientos Amazon Seller Central MX vigentes. ⏱ Producción 3-5 días · ○ Consultar</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-ec02-title">
      <div class="container">
        <h2 id="faq-ec02-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-EC-02</h2>
        <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
      </div>
    </section>
  </main>
  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-EC-02 — ECT-44 certificado, cero rechazos en Amazon FBA" />
</PageLayout>
