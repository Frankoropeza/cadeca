---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja para PyME con Tienda en Línea | CADECA";
const description = "Caja para PyME con tienda online en CDMX. Sin mínimo alto — MOQ 50 pzas. Entrega programada según pedido.";

const specs = [
 ["Código SKU", "CAD-EC-07"],
 ["Tipo", "Doble corrugado BC"],
 ["Resistencia", "ECT-32"],
 ["Flauta", "BC (7mm)"],
 ["Material", "Kraft virgen / reciclado"],
 ["Medidas", "4 estándar PyME"],
 ["Cierre", "4 solapas autoblocante"],
 ["Pedido mínimo", "50 piezas"],
 ["Entrega CDMX", "Según pedido"],
];

const faqs = [
 { id:"cad-ec-07-f1", question:"¿Puedo pedir solo 50 cajas si soy un negocio pequeño?", answer:"Sí, absolutamente. El CAD-EC-07 tiene el MOQ más bajo de nuestra línea e-commerce: 50 piezas. No necesitas comprometerte a cientos de cajas cuando estás empezando o cuando tu volumen es moderado. Al crecer y pedir más, el precio por pieza baja automáticamente." },
 { id:"cad-ec-07-f2", question:"¿Qué pasa si necesito una medida diferente a las 4 estándar?", answer:"Si ninguna de las 4 medidas estándar se ajusta a tu producto, podemos fabricar a la medida exacta desde 50 piezas con un tiempo de producción de 3 a 5 días hábiles. Compártenos las dimensiones de tu producto y te calculamos el precio sin costo y sin compromiso." },
 { id:"cad-ec-07-f3", question:"¿Incluyen factura electrónica?", answer:"Sí. Emitimos CFDI 4.0 en todas las compras, sin importar el monto. Aceptamos pago con transferencia bancaria, tarjeta de crédito/débito y efectivo en instalaciones. Para clientes recurrentes también manejamos crédito a 30 días previo análisis." },
 { id:"cad-ec-07-f4", question:"¿Cómo elegir la medida de caja para una pyme de e-commerce?", answer:"Mide el producto con su empaque y protección, y compara las medidas estándar con el espacio necesario. Una caja proporcionada reduce el movimiento interior y permite revisar el peso volumétrico del envío." },
 { id:"cad-ec-07-f5", question:"¿Qué datos debo enviar para cotizar cajas para una pyme?", answer:"Envía el formulario con dimensiones, cantidad, peso, tipo de producto y paquetería. Indica si requieres impresión o medida especial para orientar la elección de formato y resistencia." },
];

const gallery = [
 { src: "/img/catalogo/caja-pyme-hero-cdmx.avif", alt: "Caja para PyME con tienda online CDMX" },
 { src: "/img/catalogo/caja-pyme-stack-cdmx.avif", alt: "Cajas PyME apiladas en bodega" },
 { src: "/img/catalogo/caja-pyme-uso-cdmx.avif", alt: "Caja PyME en uso" },
 { src: "/img/catalogo/caja-pyme-despacho-cdmx.avif", alt: "Cajas PyME despacho" },
 { src: "/img/catalogo/caja-envio-online-courier-cdmx.avif", alt: "PyME enviando paquetes" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Cajas para E-commerce",href:"/catalogo/cajas-para-ecommerce/"},{name:"Caja para PyME con Tienda Online"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para PyME con Tienda Online",sku:"CAD-EC-07",description:"Solución de empaque diseñada para PyMEs que venden online y en local. MOQ desde 50 piezas, sin contratos ni compromisos, entrega programada según pedido.",image:gallery[0].src,material:"CAD-EC-07",category:"Cajas para E-commerce",moq:"50 piezas"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-ecommerce/">Cajas para E-commerce</a></li>
 <li><span class="current">Caja para PyME con Tienda Online</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-cadec07-title"
   eyebrow="E-commerce · SKU CAD-EC-07"
   titleHtml={true}
   title="Cajas para tienda en línea <span>de PyME</span>"
   desc="Cajas para tienda en línea dirigidas a PyMEs que venden por internet y en local. Se cotizan desde 50 piezas según el producto, su presentación y la forma de envío."
   desc2="Está pensada para ventas en línea, con pedidos desde 50 piezas, con medidas definidas según el producto. Las <strong>cajas para emprendedores</strong> pueden configurarse para envíos, punto de venta o ambos, considerando peso, contenido y necesidad de impresión.||CADECA coordina el suministro con talleres aliados al recibir medidas, cantidad, uso y zona de entrega. Explica cómo vendes, qué envías y el peso del producto para asesorarte sobre cartón, formato y estructura de cada pedido."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-cadec07-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-EC-07 · Familia: Cajas para E-commerce</p>
 <h2 id="detalle-cadec07-title" class="sku-detail__title">Caja para PyME con Tienda Online</h2>
 <p class="sku-detail__desc">La caja adecuada para el negocio que vende por WhatsApp, Instagram, Shopify o en mostrador físico. Sin contratos, sin mínimos irracionales: empieza desde 50 piezas y escala cuando tu demanda lo requiera. Doble corrugado ECT-32 con 4 medidas que cubren la mayoría de productos de consumo. Precio de mayoreo desde pedido 1 y factura electrónica en todas las compras. Entrega programada según volumen y zona.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ mínimo</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">4 medidas</span><span class="sku-detail__strip-label">En stock</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Según pedido</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-EC-07 Caja para PyME con Tienda Online`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-EC-07</a>
 <a href="/catalogo/cajas-para-ecommerce/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas para tienda en línea" />
</PageLayout>
