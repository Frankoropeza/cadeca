---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem     from "@/components/FaqItem.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Cajas Mercado Envíos Todas las Tallas CDMX | CAD-EC-01 | CADECA";
const description = "Ficha técnica cajas para Mercado Envíos en CDMX. Tallas Chica, Mediana, Grande y Extra Grande. Doble corrugado ECT-44. Stock permanente, entrega 24 hrs. CADECA fabricante.";
const WHATSAPP    = "5255XXXXXXXX";

const medidas = [
  { talla:"Chica",        ml:"21×29×9 cm",  real:"21×29×9",  flauta:"BC",ect:"ECT-44",vacío:"0.35 kg",máx:"5 kg",  disp:"green",  label:"Stock", hl:false },
  { talla:"Mediana",      ml:"27×32×18 cm", real:"27×32×18", flauta:"BC",ect:"ECT-44",vacío:"0.55 kg",máx:"10 kg", disp:"green",  label:"Stock", hl:true  },
  { talla:"Grande",       ml:"32×42×30 cm", real:"32×42×30", flauta:"BC",ect:"ECT-44",vacío:"0.90 kg",máx:"15 kg", disp:"green",  label:"Stock", hl:true  },
  { talla:"Extra Grande", ml:"40×50×40 cm", real:"40×50×40", flauta:"BC",ect:"ECT-44",vacío:"1.45 kg",máx:"20 kg", disp:"green",  label:"Stock", hl:false },
  { talla:"Sobre Medida", ml:"Personalizada",real:"A definir",flauta:"BC",ect:"ECT-44",vacío:"—",     máx:"—",     disp:"yellow", label:"3-5 días",hl:false },
];

const specs = [
  ["Código SKU",          "CAD-EC-01"],
  ["Plataforma",          "Mercado Libre — Mercado Envíos"],
  ["Tipo de pared",       "Doble corrugado (BC)"],
  ["Flauta",              "BC (7mm)"],
  ["Resistencia ECT",     "ECT-44 (requerido ML)"],
  ["Gramaje liner",       "150 – 175 g/m²"],
  ["Material",            "Kraft virgen marrón"],
  ["Sin grapas",          "Sí — cumple política ML"],
  ["Cierre",              "4 solapas autoblocante"],
  ["Peso máx.",           "Según talla (5 a 20 kg)"],
  ["Paqueterías compat.", "Estafeta · J&T · DHL · Sendex"],
  ["Personalización",     "Logo desde 100 pzas adicionales"],
  ["Pedido mínimo",       "50 piezas por talla"],
  ["Entrega CDMX",        "24 hrs stock · 48 hrs pedido especial"],
];

const faqs = [
  {
    id:"ec01-f1",
    question:"¿Las medidas de Mercado Envíos cambian con frecuencia?",
    answer:"Mercado Libre actualiza ocasionalmente las especificaciones de Mercado Envíos. En CADECA monitoreamos estos cambios y actualizamos nuestro stock conforme las nuevas medidas oficiales. Si tienes dudas sobre si las medidas que compraste siguen siendo válidas, escríbenos por WhatsApp con la talla y verificamos la especificación vigente sin costo.",
  },
  {
    id:"ec01-f2",
    question:"¿Puedo usar estas cajas con otras paqueterías además de Mercado Envíos?",
    answer:"Sí. Las medidas de Mercado Envíos también son compatibles con las principales paqueterías del mercado: Estafeta, J&T, DHL y Sendex. El doble corrugado ECT-44 cumple los requerimientos de resistencia de todas estas paqueterías. La única restricción es Amazon FBA, que tiene sus propias medidas específicas — para Amazon te recomendamos el producto CAD-EC-02.",
  },
];

const mainImg = "/img/catalogo/cajas-mercado-envios-chica-mediana-grande-cdmx.avif";
const gallery = [
  { src: "/img/catalogo/cajas-mercado-envios-chica-mediana-grande-cdmx.avif", alt: "Caja Mercado Envíos — principal" },
  { src: "/img/catalogo/caja-mercado-envios-hero-cdmx.avif", alt: "Caja Mercado Envíos — hero" },
  { src: "/img/catalogo/caja-mercado-envios-bodega-cdmx.avif", alt: "Cajas Mercado Envíos — bodega" },
  { src: "/img/catalogo/caja-mercado-envios-stack-cdmx.avif", alt: "Cajas Mercado Envíos — apiladas" },
  { src: "/img/catalogo/caja-mercado-envios-sellada-cdmx.avif", alt: "Caja sellada — lista para envío" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo"}, {name:"E-commerce", href:"/catalogo/cajas-para-ecommerce"}, {name:"Mercado Envíos"}]}
  faqItems={[{question:"¿Las medidas de Mercado Envíos cambian con frecuencia?", answer:"Mercado Libre actualiza ocasionalmente las especificaciones de Mercado Envíos. En CADECA monitoreamos estos cambios y actualizamos nuestro stock conforme las nuevas medidas oficiales. Si tienes dudas sobre si las medidas que compraste siguen siendo válidas, escríbenos por WhatsApp con la talla y verificamos la especificación vigente sin costo."}, {question:"¿Puedo usar estas cajas con otras paqueterías además de Mercado Envíos?", answer:"Sí. Las medidas de Mercado Envíos también son compatibles con Estafeta, J&T, DHL y Sendex. El doble corrugado ECT-44 cumple los requerimientos de resistencia de todas estas paqueterías. La única restricción es Amazon FBA, que tiene medidas específicas — para Amazon recomendamos el producto CAD-EC-02."}]}
  product={{name:"Cajas Mercado Envíos Todas las Tallas", sku:"CAD-EC-01", description:"Cajas Mercado Envíos Todas las Tallas en CDMX — fabricante directo CADECA", image:"/img/catalogo/cajas-mercado-envios-chica-mediana-grande-cdmx.avif", material:"Cartón doble corrugado BC ECT-44 Mercado Envíos", category:"Cajas para E-commerce", moq:"50"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-para-ecommerce">E-commerce</a></li>
        <li><span class="current">Mercado Envíos</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-ec01-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-EC-01 · E-commerce</span>
      <h1 id="sku-ec01-title" class="cat-page-hero__title">Cajas <span>Mercado Envíos</span><br>— Todas las Tallas CDMX</h1>
      <p class="cat-page-hero__desc">Tallas Chica, Mediana, Grande y Extra Grande. Doble corrugado ECT-44, sin grapas expuestas. Compatible con todas las paqueterías de Mercado Libre. Stock permanente en CDMX.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-EC-01</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-44</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>50 pzas/talla</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-ec01-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-EC-01 · Familia: E-commerce</p>
            <h2 id="detalle-ec01-title" class="sku-detail__title">Cajas Mercado Envíos — Todas las Tallas</h2>
            <p class="sku-detail__desc">Cajas en las medidas oficiales de Mercado Envíos (Chica, Mediana, Grande y Extra Grande) fabricadas en doble corrugado ECT-44 sin grapas expuestas — el requerimiento mínimo de Mercado Libre para no recibir penalizaciones. Stock permanente de las 4 tallas en CDMX para entrega inmediata.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Resistencia ML</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">4 tallas</span><span class="sku-detail__strip-label">En stock CDMX</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ/talla</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-EC-01 Cajas Mercado Envíos`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-EC-01</a>
              <a href="/catalogo/cajas-para-ecommerce" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-sizes" aria-labelledby="sizes-ec01-title">
      <div class="container">
        <h2 id="sizes-ec01-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Oficiales Mercado Envíos — CAD-EC-01</h2>
        <div class="catalog-sizes-table-wrap">
          <table class="catalog-sizes-table">
            <thead><tr><th>Talla ML</th><th>Medida oficial (cm)</th><th>Medida real caja</th><th>Flauta</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Disponibilidad</th></tr></thead>
            <tbody>
              {medidas.map(m => (
                <tr class={m.hl ? "highlight" : ""}>
                  <td><strong>{m.talla}</strong></td><td>{m.ml}</td><td>{m.real}</td>
                  <td>{m.flauta}</td><td>{m.ect}</td><td>{m.vacío}</td><td><strong>{m.máx}</strong></td>
                  <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="green"?"✓":"⏱"} {m.label}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">Medidas verificadas conforme especificaciones ML vigentes. ✓ Stock permanente CDMX · ⏱ Producción 3-5 días.</p>
      </div>
    </section>

    <section class="faq" aria-labelledby="faq-ec01-title">
      <div class="container">
        <h2 id="faq-ec01-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">Preguntas Técnicas — CAD-EC-01</h2>
        <div class="faq__list">{faqs.map(f => <FaqItem {...f} />)}</div>
      </div>
    </section>
  </main>
  <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-EC-01 — Stock permanente, entrega 24 hrs en CDMX" />
</PageLayout>
