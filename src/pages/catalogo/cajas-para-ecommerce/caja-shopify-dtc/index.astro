---
import PageLayout    from "@/layouts/PageLayout.astro";
import FaqItem       from "@/components/FaqItem.astro";
import LeadCapture   from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Caja Shopify DTC TikTok Shop CDMX | Branding opcional | CAD-EC-08 | CADECA";
const description = "Caja para marcas DTC, Shopify y TikTok Shop en CDMX. Branding opcional desde 100 pzas. Medidas optimizadas para peso volumétrico mínimo. Entrega 24 hrs. CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const specs = [
  ["Código SKU", "CAD-EC-08"],
  ["Tipo", "Doble corrugado BC"],
  ["Resistencia", "ECT-32"],
  ["Branding", "1-2 colores desde 100 pzas"],
  ["Material", "Kraft virgen marrón"],
  ["Peso volumétrico", "Optimizado DHL/FedEx"],
  ["Diseño", "Gratuito con logo vectorial"],
  ["Pedido mínimo", "50 pzas neutra / 100 pzas con logo"],
  ["Entrega", "5–7 días con logo / 24 hrs neutra"],
];

const faqs = [
  { id:"cad-ec-08-f1", question:"¿Cuánto cuesta agregar mi logo a la caja?", answer:"El diseño de artes es gratuito si nos proporcionas tu logo en formato vectorial (AI, EPS o PDF con tipografías convertidas). El costo de impresión se refleja en el precio por pieza según el número de colores y el tiraje. Desde 100 piezas ya es viable. Solicita cotización por WhatsApp y te enviamos precio en menos de 2 horas." },
  { id:"cad-ec-08-f2", question:"¿La caja realmente reduce el peso volumétrico?", answer:"Sí. Diseñamos las medidas de CAD-EC-08 calculando el volumen efectivo de los 10 productos DTC más comunes en CDMX: ropa, suplementos, cosméticos y accesorios. Una caja bien medida puede reducir tu costo de envío entre 15% y 30% comparado con una caja estándar sobredimensionada." },
  { id:"cad-ec-08-f3", question:"¿Puedo pedir muestras físicas antes de producción?", answer:"Claro. Enviamos 1 muestra física sin logo a CDMX sin costo adicional (aplica tiempo de producción de 1 a 2 días). Para muestras con logo, producimos un plano troquelado sin impresión para validar medidas y estructuras." },
];

const gallery = [
  { src: "/img/catalogo/caja-shopify-hero-cdmx.avif", alt: "Caja para Shopify DTC marca propia CDMX" },
  { src: "/img/catalogo/caja-shopify-moda-cdmx.avif", alt: "Caja Shopify moda y ropa" },
  { src: "/img/catalogo/caja-shopify-home-office-cdmx.avif", alt: "Caja DTC home office" },
  { src: "/img/catalogo/caja-shopify-unboxing-cdmx.avif", alt: "Unboxing caja Shopify" },
  { src: "/img/catalogo/caja-envio-tienda-online-shopify-cdmx.avif", alt: "Tienda online Shopify" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Cajas para E-commerce",href:"/catalogo/cajas-para-ecommerce"},{name:"Caja para Marcas DTC y Shopify"}]}
  faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
  product={{name:"Caja para Marcas DTC y Shopify",sku:"CAD-EC-08",description:"Caja diseñada para marcas direct-to-consumer que venden en Shopify, TikTok Shop o Instagram. Neutra o con tu logo desde 100 piezas, optimizada para peso volumétrico mínimo.",image:gallery[0].src,material:"CAD-EC-08",category:"Cajas para E-commerce",moq:"50 pzas neutra / 100 pzas con logo"}}
>
  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/catalogo">Catálogo</a></li>
        <li><a href="/catalogo/cajas-para-ecommerce">Cajas para E-commerce</a></li>
        <li><span class="current">Caja para Marcas DTC y Shopify</span></li>
      </ol>
    </div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-cadec08-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-EC-08 · Cajas para E-commerce</span>
      <h1 id="sku-cadec08-title" class="cat-page-hero__title">Caja para Marcas <span>DTC / Shopify</span> y TikTok Shop</h1>
      <p class="cat-page-hero__desc">Caja diseñada para marcas direct-to-consumer que venden en Shopify, TikTok Shop o Instagram. Neutra o con tu logo desde 100 piezas, optimizada para peso volumétrico mínimo.</p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-EC-08</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>50 pzas neutra / 100 pzas con logo</strong></div>
        <div class="cat-page-hero__strip-item">Fabricante: <strong>Directo</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-cadec08-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-EC-08 · Familia: Cajas para E-commerce</p>
            <h2 id="detalle-cadec08-title" class="sku-detail__title">Caja para Marcas DTC y Shopify</h2>
            <p class="sku-detail__desc">Las marcas DTC que venden en Shopify, TikTok Shop e Instagram necesitan una caja que cuide el producto, minimice el costo de envío y pueda llevar su logo sin inversión enorme. CAD-EC-08 cumple los tres objetivos: medidas calculadas para reducir el peso volumétrico en DHL y FedEx, opción de impresión de 1 a 2 colores desde 100 piezas y corrugado ECT-32 doble pared que protege en tránsito. Diseño gratuito incluido para clientes con logotipo en vectores.</p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Resistencia</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Logo</span><span class="sku-detail__strip-label">Desde 100 pzas</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Peso vol.</span><span class="sku-detail__strip-label">Optimizado</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Neutra CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-EC-08 Caja para Marcas DTC y Shopify`} target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-EC-08</a>
              <a href="/catalogo/cajas-para-ecommerce" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-faq" aria-labelledby="faq-cadec08-title">
      <div class="container">
        <h2 id="faq-cadec08-title" class="sku-faq__title">Preguntas Frecuentes — Caja para Marcas DTC y Shopify</h2>
        <div class="sku-faq__list">
          {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="¿Tienes marca DTC? Te diseñamos la caja con tu logo y la entregamos en 5–7 días en CDMX" />
</PageLayout>
