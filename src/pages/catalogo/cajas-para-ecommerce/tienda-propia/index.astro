---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Cajas para Tienda Propia: Shopify y TiendaNube | CADECA";
const description = "Ficha técnica cajas para Shopify, TiendaNube e Instagram en CDMX. Neutras o personalizadas con logo. Corrugado simple y doble. Desde 50 pzas.";

const medidas = [
 { talla:"XS Micro",  dims:"20×15×10",pared:"Simple",ect:"ECT-32",vacío:"0.18 kg",máx:"3 kg", logo:"Desde 100 pzas",disp:"yellow",label:"3-5 días" },
 { talla:"S Chica",  dims:"30×22×12",pared:"Simple",ect:"ECT-32",vacío:"0.32 kg",máx:"5 kg", logo:"Desde 100 pzas",disp:"yellow",label:"3-5 días",hl:true },
 { talla:"M Mediana",  dims:"38×28×18",pared:"Simple",ect:"ECT-32",vacío:"0.52 kg",máx:"8 kg", logo:"Desde 100 pzas",disp:"yellow",label:"3-5 días",hl:true },
 { talla:"L Grande",  dims:"48×36×24",pared:"Doble", ect:"ECT-44",vacío:"0.88 kg",máx:"15 kg",logo:"Desde 100 pzas",disp:"yellow",label:"3-5 días" },
 { talla:"XL Extra",  dims:"58×44×30",pared:"Doble", ect:"ECT-44",vacío:"1.30 kg",máx:"20 kg",logo:"Desde 100 pzas",disp:"gray",  label:"5-7 días" },
 { talla:"A la Medida",  dims:"Cualquier",pared:"A elegir",ect:"A elegir",vacío:"—",máx:"—",logo:"Sí",disp:"gray",label:"Consultar" },
];

const specs = [
 ["Código SKU",  "CAD-EC-04"],
 ["Canales de venta",  "Shopify · TiendaNube · Instagram · TikTok Shop"],
 ["Tipo de pared",  "Simple (hasta 8 kg) · Doble (hasta 20 kg)"],
 ["Flauta",  "C (simple) · BC (doble)"],
 ["Resistencia ECT",  "ECT-32 simple · ECT-44 doble"],
 ["Presentación",  "Neutra (kraft marrón) o personalizada"],
 ["Logo impreso",  "Desde 100 pzas adicionales sin costo diseño"],
 ["Alternativa económica","Cinta adhesiva impresa con logo"],
 ["Material",  "Kraft virgen marrón o kraft blanco"],
 ["Cierre",  "4 solapas o automontable (opcional)"],
 ["Pedido mínimo",  "50 piezas (neutra) · 100 pzas (con logo)"],
 ["Tiempo de entrega",  "3-5 días · Con logo: 5-7 días hábiles"],
];

const faqs = [
 {
 id:"ec04-f1",
 question:"¿Es mejor usar caja neutra + cinta con logo o caja impresa con logo?",
 answer:"Depende del volumen: <strong>Cinta adhesiva con logo:</strong> inversión inicial menor (desde 50 pzas de cinta), más flexible para cambiar diseños, opción ideal para comenzar. <strong>Caja impresa con logo:</strong> más profesional y consistente, mejor experiencia unboxing, costo por pieza menor en pedidos de 500+ pzas. Si vendes menos de 200 piezas/mes, empieza con cinta. Si ya vendes más de 200/mes, la caja impresa da mejor ROI.",
 },
 {
 id:"ec04-f2",
 question:"¿Qué tipo de corrugado es mejor para productos de moda (ropa y accesorios)?",
 answer:"Para ropa y accesorios ligeros (hasta 3-5 kg) recomendamos <strong>corrugado simple ECT-32 flauta C</strong>: suficiente resistencia para proteger en tránsito y más económico. Para artículos de moda de mayor valor (bolsos de piel, calzado de lujo), el corrugado simple en kraft blanco coated + impresión full color da un resultado de presentación premium que justifica el costo adicional.",
 },
 { id:"ec04-f3", question:"¿Cómo elegir cajas para una tienda propia en línea?", answer:"Mide el producto con su protección interior y considera el tipo de envío que usarás. Una medida proporcionada ayuda a evitar movimiento excesivo y permite revisar el peso volumétrico del paquete." },
 { id:"ec04-f4", question:"¿Qué corrugado conviene para cajas de tienda propia?", answer:"La elección depende del peso, fragilidad y apilado de los productos. El ECT ayuda a comparar la resistencia a compresión del cartón y orientar si conviene pared simple o doble." },
 { id:"ec04-f5", question:"¿Qué datos debo enviar para cotizar cajas para tienda propia?", answer:"Envía el formulario con medidas, cantidad, peso, tipo de producto y si requieres impresión. Esos datos permiten revisar el formato, la resistencia y la alternativa de personalización adecuada." },
];

const mainImg = "/img/catalogo/cajas-shopify-tiendanube-ecommerce-tienda-propia.avif";
const gallery = [
 { src: "/img/catalogo/cajas-shopify-tiendanube-ecommerce-tienda-propia.avif", alt: "Caja tienda online — principal" },
 { src: "/img/catalogo/caja-shopify-hero-cdmx.avif", alt: "Caja Shopify/TiendaNube — hero" },
 { src: "/img/catalogo/caja-shopify-home-office-cdmx.avif", alt: "Cajas e-commerce — home office" },
 { src: "/img/catalogo/caja-shopify-moda-cdmx.avif", alt: "Cajas e-commerce — tienda moda" },
 { src: "/img/catalogo/caja-shopify-unboxing-cdmx.avif", alt: "Cajas — unboxing experiencia" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio", href:"/"}, {name:"Catálogo", href:"/catalogo/"}, {name:"E-commerce", href:"/catalogo/cajas-para-ecommerce/"}, {name:"Tienda Propia"}]}
 faqItems={faqs.map((f) => ({ question: f.question, answer: f.answer }))}
 product={{name:"Cajas Shopify TiendaNube Tienda Propia", sku:"CAD-EC-04", description:"Cajas Shopify TiendaNube Tienda Propia en CDMX — surtido coordinado por CADECA", image:"/img/catalogo/cajas-shopify-tiendanube-ecommerce-tienda-propia.avif", material:"Cartón corrugado simple o doble para tienda en línea", category:"Cajas para E-commerce", moq:"50"}}
>
 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container">
 <ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-para-ecommerce/">E-commerce</a></li>
 <li><span class="current">Tienda Propia</span></li>
 </ol>
 </div>
 </div>

 <PageHero
   id="sku-ec04-title"
   eyebrow="E-commerce · SKU CAD-EC-04"
   titleHtml={true}
   title="Cajas para Shopify y Tiendanube <span>propias</span>"
   desc="Cajas para Shopify y Tiendanube dirigidas a negocios que gestionan sus propios envíos. Se cotizan neutras o con logo según producto, peso, canal de venta y cantidad."
   desc2="Se surte en corrugado simple ECT-32 o doble ECT-44, en kraft marrón o blanco, para distintos pesos y tamaños. Las <strong>cajas para tienda propia</strong> pueden ser neutras desde 50 piezas o incluir logo desde 100 piezas, según el formato.||CADECA coordina el suministro con talleres aliados al conocer medidas, cantidad, uso y zona de entrega. Indica el canal, peso y presentación de tus productos para asesorarte sobre pared, impresión y formato de caja de tu operación."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-ec04-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-EC-04 · Familia: E-commerce</p>
 <h2 id="detalle-ec04-title" class="sku-detail__title">Cajas para Tienda Propia — Shopify / TiendaNube</h2>
 <p class="sku-detail__desc">Diseñadas para vendedores con tienda propia en Shopify, TiendaNube, Instagram o TikTok Shop que gestionan sus propios envíos con la paquetería de su elección. Disponibles neutras desde 50 piezas o con impresión de logo desde 100 piezas con diseño sin costo incluido.</p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Neutra</span><span class="sku-detail__strip-label">o con logo</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-32</span><span class="sku-detail__strip-label">Simple (ligero)</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Doble (pesado)</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">50 pzas</span><span class="sku-detail__strip-label">MOQ neutra</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-EC-04 cajas para tienda propia`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-EC-04</a>
 <a href="/catalogo/cajas-para-ecommerce/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-ec04-title">
 <div class="container">
 <h2 id="sizes-ec04-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">Medidas Disponibles — CAD-EC-04</h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead><tr><th>Talla</th><th>L×A×H (cm)</th><th>Pared</th><th>ECT</th><th>Peso vacío</th><th>Peso máx.</th><th>Logo impreso</th><th>Disponib.</th></tr></thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td><strong>{m.talla}</strong></td><td>{m.dims}</td><td>{m.pared}</td><td>{m.ect}</td>
 <td>{m.vacío}</td><td><strong>{m.máx}</strong></td><td>{m.logo}</td>
 <td><span class={`stock-chip stock-chip--${m.disp}`}>{m.disp==="yellow"?"":""} {m.label}</span></td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 </div>
 </section>

 </main>
 <FaqCotizacion faqs={faqs} tema="cajas para Shopify y Tiendanube" />
</PageLayout>
