---
import PageLayout    from "@/layouts/PageLayout.astro";
import FaqItem       from "@/components/FaqItem.astro";
import LeadCapture   from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title       = "Caja Wellness y Productos Naturales CDMX | CAD-FC-10 | CADECA";
const description = "Caja kraft FSC reciclado para bienestar, wellness y productos naturales en CDMX. Sin blanqueantes, imagen orgánica, food-grade. MOQ 100 pzas. Fabricante directo CADECA.";
const WHATSAPP    = "5255XXXXXXXX";

const specs = [
  ["Código SKU",    "CAD-FC-10"],
  ["Tipo de pared", "Simple (flauta B)"],
  ["Flauta",        "B (3mm)"],
  ["Resistencia",   "ECT-32"],
  ["Gramaje liner", "127–150 g/m²"],
  ["Material",      "Kraft FSC reciclado / sin blanqueantes"],
  ["Cierre",        "4 solapas autoblocante o tuck-end"],
  ["Pedido mínimo", "100 piezas"],
  ["Entrega CDMX",  "24–48 hrs"],
];

const faqs = [
  {
    id: "fc10-f1",
    question: "¿Qué significa que la caja sea kraft FSC reciclado sin blanqueantes?",
    answer: "El cartón kraft FSC proviene de bosques gestionados responsablemente según el Forest Stewardship Council. Al ser reciclado y sin blanqueantes, conserva su color café natural sin procesos químicos de blanqueo con cloro o peróxidos. Esto reduce la huella ambiental hasta un 40% respecto al corrugado blanco convencional y proyecta una imagen orgánica y sustentable que conecta con consumidores de productos naturales, wellness y bienestar en CDMX.",
  },
  {
    id: "fc10-f2",
    question: "¿La caja es food-grade para suplementos y productos naturales?",
    answer: "Sí. La caja CAD-FC-10 utiliza tintas base agua y adhesivos libres de solventes que cumplen con las regulaciones de la FDA 21 CFR para contacto indirecto con alimentos y suplementos. Como empaque secundario (el producto va en su propio envase interior), es compatible con NOM-051 para suplementos alimenticios y NOM-141 para cosméticos naturales. Disponemos de certificados de inocuidad y ficha técnica de materiales bajo solicitud.",
  },
  {
    id: "fc10-f3",
    question: "¿Pueden personalizar la caja con impresión ecológica para mi marca wellness?",
    answer: "Absolutamente. Ofrecemos impresión flexográfica con tintas base agua y tintas de soya en 1–4 colores sobre kraft natural. El resultado es una impresión con acabado mate natural que refuerza la identidad orgánica de tu marca. Desde 100 piezas puedes incluir logo, información nutricional, ingredientes y código QR. Para tiradas mayores a 500 pzas, habilitamos impresión digital full color con certificación ecológica verificable.",
  },
];

const gallery = [
  { src: "/img/catalogo/caja-suplementos-nutricion-deportiva-cdmx.avif", alt: "Caja wellness productos naturales kraft FSC — CAD-FC-10" },
  { src: "/img/catalogo/caja-suplementos-nutricion-asa-cdmx.avif",      alt: "Caja kraft con asa para productos de bienestar" },
  { src: "/img/catalogo/caja-cosmetica-premium-interior-cdmx.avif",     alt: "Interior kraft natural para cosmética wellness" },
  { src: "/img/catalogo/caja-cosmetica-premium-linea-cdmx.avif",        alt: "Línea de cajas wellness en kraft reciclado CDMX" },
  { src: "/img/catalogo/caja-blister-farmaceutica-detalle-cdmx.avif",   alt: "Detalle de corrugado kraft FSC sin blanqueantes" },
];
---

<PageLayout
  title={title}
  description={description}
  whatsapp={WHATSAPP}
  pageType="product"
  breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Farmacéutica y Cosmética",href:"/catalogo/cajas-farmaceutica-cosmetica"},{name:"Wellness y Naturales"}]}
  faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
  product={{name:"Caja para Bienestar, Wellness y Productos Naturales",sku:"CAD-FC-10",description:"Caja kraft FSC reciclado sin blanqueantes — food-grade, imagen orgánica, MOQ 100 pzas",image:gallery[0].src,material:"Kraft FSC reciclado flauta B ECT-32",category:"Cajas para Industria Farmacéutica y Cosmética",moq:"100"}}
>

  <div class="breadcrumb-bar" aria-label="Ruta de navegación">
    <div class="container"><ol>
      <li><a href="/">Inicio</a></li>
      <li><a href="/catalogo">Catálogo</a></li>
      <li><a href="/catalogo/cajas-farmaceutica-cosmetica">Farmacéutica y Cosmética</a></li>
      <li><span class="current">Wellness y Naturales</span></li>
    </ol></div>
  </div>

  <section class="cat-page-hero" aria-labelledby="sku-fc10-title">
    <div class="container">
      <span class="cat-page-hero__eyebrow">SKU CAD-FC-10 · Farmacéutica y Cosmética</span>
      <h1 id="sku-fc10-title" class="cat-page-hero__title">
        Caja para <span>Bienestar y Productos Naturales</span> — Kraft FSC
      </h1>
      <p class="cat-page-hero__desc">
        Empaque sustentable de kraft FSC reciclado sin blanqueantes para marcas de bienestar, wellness y productos naturales. Imagen orgánica auténtica, food-grade, con tintas base agua. Pedido mínimo 100 piezas con entrega en CDMX en 24–48 horas.
      </p>
      <div class="cat-page-hero__strip">
        <div class="cat-page-hero__strip-item">SKU: <strong>CAD-FC-10</strong></div>
        <div class="cat-page-hero__strip-item">ECT: <strong>ECT-32</strong></div>
        <div class="cat-page-hero__strip-item">MOQ: <strong>100 pzas</strong></div>
        <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
      </div>
    </div>
  </section>

  <main id="contenido-principal" role="main">
    <section class="sku-detail" aria-labelledby="detalle-fc10-title">
      <div class="container">
        <div class="sku-detail__grid">
          <div class="sku-detail__img-col">
            <ProductGallery images={gallery} />
          </div>
          <div class="sku-detail__content">
            <p class="sku-detail__code">CAD-FC-10 · Familia: Farmacéutica y Cosmética</p>
            <h2 id="detalle-fc10-title" class="sku-detail__title">Caja Wellness — Kraft FSC Reciclado</h2>
            <p class="sku-detail__desc">
              La caja CAD-FC-10 está fabricada con cartón kraft FSC 100% reciclado, sin blanqueantes químicos y con tintas base agua certificadas. Diseñada para marcas de bienestar, suplementos naturales, cosmética orgánica y productos de wellness que requieren un empaque coherente con su filosofía sustentable. Certificación food-grade para contacto indirecto con alimentos y suplementos. Personalización gráfica disponible desde 100 piezas en CDMX y zona metropolitana.
            </p>
            <div class="sku-detail__strip">
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">FSC</span><span class="sku-detail__strip-label">Certificación</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Food-grade</span><span class="sku-detail__strip-label">Contacto indirecto</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
              <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
            </div>
            <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
            <table class="sku-detail__specs-table"><tbody>
              {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
            </tbody></table>
            <div class="sku-detail__actions">
              <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-FC-10 Caja Wellness Productos Naturales`}
                 target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-FC-10</a>
              <a href="/catalogo/cajas-farmaceutica-cosmetica" class="btn btn--outline">← Ver categoría</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="sku-faq" aria-labelledby="faq-fc10-title">
      <div class="container">
        <h2 id="faq-fc10-title" class="sku-faq__title">Preguntas Frecuentes — Wellness y Productos Naturales</h2>
        <div class="sku-faq__list">
          {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
        </div>
      </div>
    </section>
  </main>

  <LeadCapture whatsapp={WHATSAPP} title="Tu marca wellness merece un empaque sustentable — Cotiza CAD-FC-10 kraft FSC en CDMX" />

</PageLayout>
