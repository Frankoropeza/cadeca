---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductGallery from "@/components/ProductGallery.astro";
import PageHero from "@/components/PageHero.astro";

const title  = "Caja para Productos Naturales y Bienestar | CADECA";
const description = "Caja kraft reciclado para bienestar, wellness y productos naturales en CDMX. Sin blanqueantes, imagen orgánica, food-grade. MOQ 100 pzas.";

const specs = [
 ["Código SKU",  "CAD-FC-10"],
 ["Tipo de pared", "Simple (flauta B)"],
 ["Flauta",  "B (3mm)"],
 ["Resistencia",  "ECT-32"],
 ["Gramaje liner", "127–150 g/m²"],
 ["Material",  "Kraft reciclado / sin blanqueantes; FSC por confirmar al cotizar"],
 ["Cierre",  "4 solapas autoblocante o tuck-end"],
 ["Pedido mínimo", "100 piezas"],
 ["Entrega CDMX",  "Según pedido"],
];

const faqs = [
 {
 id: "fc10-f1",
 question: "¿Qué significa que la caja sea kraft FSC reciclado sin blanqueantes?",
 answer: "El cartón kraft FSC proviene de bosques gestionados responsablemente según el Forest Stewardship Council. Al ser reciclado y sin blanqueantes, conserva su color café natural sin procesos químicos de blanqueo con cloro o peróxidos. Esto reduce la huella ambiental hasta un 40% respecto al corrugado blanco convencional y proyecta una imagen orgánica y sustentable que conecta con consumidores de productos naturales, wellness y bienestar en CDMX.",
 },
 {
 id: "fc10-f2",
 question: "¿La caja es food-grade para suplementos y productos naturales?",
 answer: "Sí. La caja CAD-FC-10 utiliza tintas base agua y adhesivos libres de solventes que cumplen con las regulaciones de la FDA 21 CFR para contacto indirecto con alimentos y suplementos. Como empaque secundario (el producto va en su propio envase interior), es compatible con NOM-051 para suplementos alimenticios y NOM-141 para cosméticos naturales. Disponemos de certificados de inocuidad y ficha técnica de materiales bajo solicitud.",
 },
 {
 id: "fc10-f3",
 question: "¿Pueden personalizar la caja con impresión ecológica para mi marca wellness?",
 answer: "Absolutamente. Ofrecemos impresión flexográfica con tintas base agua y tintas de soya en 1–4 colores sobre kraft natural. El resultado es una impresión con acabado mate natural que refuerza la identidad orgánica de tu marca. Desde 100 piezas puedes incluir logo, información nutricional, ingredientes y código QR. Para tiradas mayores a 500 pzas, habilitamos impresión digital full color con certificación ecológica verificable.",
 },
 {
 id: "fc10-f4",
 question: "¿Cómo elijo la medida de caja para productos wellness y naturales?",
 answer: "Parte de las dimensiones del producto ya empacado y considera si llevará separador, relleno o presentación en set. El cartón corrugado se puede definir en formato y resistencia conforme al peso y forma de la carga.",
 },
 {
 id: "fc10-f5",
 question: "¿Qué necesito enviar para cotizar cajas para productos wellness?",
 answer: "Envía el formulario con medidas, cantidad, peso aproximado, uso y si necesitas impresión o divisores. Esa información permite orientar la medida, el tipo de corrugado y la configuración interior adecuada.",
 },
];

const gallery = [
 { src: "/img/catalogo/caja-suplementos-nutricion-deportiva-cdmx.avif", alt: "Caja wellness productos naturales kraft FSC — CAD-FC-10" },
 { src: "/img/catalogo/caja-suplementos-nutricion-asa-cdmx.avif",  alt: "Caja kraft con asa para productos de bienestar" },
 { src: "/img/catalogo/caja-cosmetica-premium-interior-cdmx.avif",  alt: "Interior kraft natural para cosmética wellness" },
 { src: "/img/catalogo/caja-cosmetica-premium-linea-cdmx.avif",  alt: "Línea de cajas wellness en kraft reciclado CDMX" },
 { src: "/img/catalogo/caja-blister-farmaceutica-detalle-cdmx.avif",  alt: "Detalle de corrugado kraft FSC sin blanqueantes" },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo/"},{name:"Farmacéutica y Cosmética",href:"/catalogo/cajas-farmaceutica-cosmetica/"},{name:"Wellness y Naturales"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para Bienestar, Wellness y Productos Naturales",sku:"CAD-FC-10",description:"Caja kraft reciclado sin blanqueantes — food-grade, imagen orgánica; FSC por confirmar al cotizar. MOQ 100 pzas",image:gallery[0].src,material:"Kraft reciclado flauta B ECT-32",category:"Cajas para Industria Farmacéutica y Cosmética",moq:"100"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container"><ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo/">Catálogo</a></li>
 <li><a href="/catalogo/cajas-farmaceutica-cosmetica/">Farmacéutica y Cosmética</a></li>
 <li><span class="current">Wellness y Naturales</span></li>
 </ol></div>
 </div>

 <PageHero
   id="sku-fc10-title"
   eyebrow="Cosmética · SKU CAD-FC-10"
   titleHtml={true}
   title="Cajas para productos naturales <span>de bienestar</span>"
   desc="Cajas para productos naturales de bienestar, herbolaria y cuidado personal que buscan una presentación en kraft. Se cotizan para marcas que requieren empaque unitario, sets o venta en anaquel."
   desc2="El empaque contempla kraft reciclado sin blanqueantes, tintas base agua y formato de flauta E para productos de bienestar. Las <strong>cajas kraft para bienestar</strong> pueden definirse con impresión y dimensiones para jabones, tés, suplementos o cuidado personal, según el contenido.||Para productos de bienestar, el tipo de contenido, la presentación unitaria o en set y el acabado kraft guían la elección. Comparte medidas del producto, arte de impresión, tipo de cierre y si llevará etiqueta para cotizar el formato en flauta E."
 />

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-fc10-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-FC-10 · Familia: Farmacéutica y Cosmética</p>
 <h2 id="detalle-fc10-title" class="sku-detail__title">Caja Wellness — Kraft FSC Reciclado</h2>
 <p class="sku-detail__desc">
 La caja CAD-FC-10 se surte en cartón kraft reciclado, sin blanqueantes químicos y con tintas base agua certificadas. Diseñada para marcas de bienestar, suplementos naturales, cosmética orgánica y productos de wellness que requieren un empaque coherente con su filosofía sustentable. Si tu proyecto requiere certificación FSC, la indicamos al cotizar y confirmamos disponibilidad con el fabricante. Certificación food-grade para contacto indirecto con alimentos y suplementos. Personalización gráfica disponible desde 100 piezas en CDMX y zona metropolitana.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Por confirmar</span><span class="sku-detail__strip-label">FSC al cotizar</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Food-grade</span><span class="sku-detail__strip-label">Contacto indirecto</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">Según pedido</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={contactoHref(`Hola, quiero cotizar CAD-FC-10 Caja Wellness Productos Naturales`)} class="btn btn--primary" {...contactoAttrs}>Cotizar CAD-FC-10</a>
 <a href="/catalogo/cajas-farmaceutica-cosmetica/" class="btn btn--outline">Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 </main>

 <FaqCotizacion faqs={faqs} tema="cajas para productos naturales" />

</PageLayout>
