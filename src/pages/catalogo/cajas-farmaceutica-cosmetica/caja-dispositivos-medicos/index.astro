---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja para Dispositivos Médicos y Equipo Hospitalario CDMX | CAD-FC-09 | CADECA";
const description = "Caja corrugado blanco premium para dispositivos médicos y equipo hospitalario en CDMX. Apta COFEPRIS y FDA. Registro sanitario opcional. Fabricante directo CADECA.";
const WHATSAPP  = "5255XXXXXXXX";

const specs = [
 ["Código SKU",  "CAD-FC-09"],
 ["Tipo de pared", "Doble corrugado BC"],
 ["Flauta",  "BC (7mm)"],
 ["Resistencia",  "ECT-44"],
 ["Gramaje liner", "150–175 g/m²"],
 ["Material",  "Corrugado blanco premium blanqueado ECF"],
 ["Cierre",  "4 solapas autoblocante o con precinto de seguridad"],
 ["Pedido mínimo", "100 piezas"],
 ["Entrega CDMX",  "24–48 hrs"],
];

const faqs = [
 {
 id: "fc09-f1",
 question: "¿Qué requisitos debe cumplir el empaque para dispositivos médicos según COFEPRIS?",
 answer: "COFEPRIS regula los dispositivos médicos bajo la NOM-137 y la Ley General de Salud. El empaque secundario debe proteger la integridad del dispositivo, incluir información de trazabilidad (lote, caducidad, número de registro), ser compatible con los procesos de esterilización si aplica, y no aportar contaminantes. La caja CAD-FC-09 usa corrugado blanco premium blanqueado sin cloro elemental, libre de contaminantes que pudieran migrar al dispositivo.",
 },
 {
 id: "fc09-f2",
 question: "¿Pueden fabricar cajas con estructura anticaída para equipos hospitalarios de alto valor?",
 answer: "Sí. Para equipos hospitalarios de alto valor (monitores, desfibriladores, bombas de infusión) diseñamos cajas con inserts de cartón troquelado tipo nido o espuma de polietileno que fijan el dispositivo y absorben impactos hasta 60G (Drop Test ASTM D4169). La caja CAD-FC-09 en doble pared ECT-44 puede combinarse con cualquier insert interior según las dimensiones y fragilidad del equipo a proteger.",
 },
 {
 id: "fc09-f3",
 question: "¿Cómo imprimo la información de registro sanitario en la caja de dispositivo médico?",
 answer: "Imprimimos directamente en la caja en flexografía 1–4 colores cualquier dato de registro sanitario, incluyendo número de COFEPRIS, código de barras UDI (Unique Device Identification) compatible con FDA, símbolos ISO 7000 para manejo (frágil, this side up, temperatura máxima), y cualquier leyenda regulatoria requerida. El proceso de aprobación de arte incluye revisión por nuestro equipo técnico para cumplimiento normativo.",
 },
];

const gallery = [
 { src: "/img/catalogo/corrugado-doble-pared-hero-cdmx.avif",  alt: "Caja dispositivos médicos corrugado doble pared premium — CAD-FC-09" },
 { src: "/img/catalogo/caja-distribuidora-farmacia-hero-cdmx.avif",  alt: "Caja para distribución de equipo hospitalario CDMX" },
 { src: "/img/catalogo/caja-distribuidora-farmacia-mayoreo-cdmx.avif", alt: "Distribución mayoreo de cajas para dispositivos médicos" },
 { src: "/img/catalogo/caja-distribuidora-farmacia-pallet-cdmx.avif",  alt: "Pallet de cajas para equipo médico y hospitalario" },
 { src: "/img/catalogo/caja-distribuidora-farmacia-rack-cdmx.avif",  alt: "Almacén con cajas para dispositivos médicos en rack" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Farmacéutica y Cosmética",href:"/catalogo/cajas-farmaceutica-cosmetica"},{name:"Dispositivos Médicos"}]}
 faqItems={faqs.map(f => ({question:f.question, answer:f.answer}))}
 product={{name:"Caja para Dispositivos Médicos y Equipo Hospitalario",sku:"CAD-FC-09",description:"Caja corrugado blanco premium para dispositivos médicos — apta COFEPRIS y FDA",image:gallery[0].src,material:"Corrugado blanco BC ECT-44 blanqueado premium",category:"Cajas para Industria Farmacéutica y Cosmética",moq:"100"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container"><ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-farmaceutica-cosmetica">Farmacéutica y Cosmética</a></li>
 <li><span class="current">Dispositivos Médicos</span></li>
 </ol></div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-fc09-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-FC-09 · Farmacéutica y Cosmética</span>
 <h1 id="sku-fc09-title" class="cat-page-hero__title">
 Caja para <span>Dispositivos Médicos</span> y Equipo Hospitalario
 </h1>
 <p class="cat-page-hero__desc">
 Corrugado blanco premium doble pared ECT-44 para dispositivos médicos y equipos hospitalarios de alto valor. Apta para COFEPRIS y compatible con UDI FDA. Registro sanitario opcional. Entrega en CDMX en 24–48 horas.
 </p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-FC-09</strong></div>
 <div class="cat-page-hero__strip-item">ECT: <strong>ECT-44</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>100 pzas</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>24 hrs CDMX</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">
 <section class="sku-detail" aria-labelledby="detalle-fc09-title">
 <div class="container">
 <div class="sku-detail__grid">
 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>
 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-FC-09 · Familia: Farmacéutica y Cosmética</p>
 <h2 id="detalle-fc09-title" class="sku-detail__title">Caja Dispositivos Médicos — Corrugado Blanco Premium</h2>
 <p class="sku-detail__desc">
 La caja CAD-FC-09 es la solución de empaque para fabricantes e importadores de dispositivos médicos y equipo hospitalario en CDMX. Corrugado blanco premium doble pared BCF ECT-44 blanqueado sin cloro elemental, cumple con los estándares de COFEPRIS y la norma ISO 15223 para símbolos de empaque médico. Disponible con insert de polietileno expandido o troquelado de cartón para fijación de instrumentos quirúrgicos, monitores, bombas de infusión y cualquier equipo hospitalario.
 </p>
 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">ECT-44</span><span class="sku-detail__strip-label">Resistencia</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">COFEPRIS</span><span class="sku-detail__strip-label">Compatibilidad</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">100 pzas</span><span class="sku-detail__strip-label">Pedido mín.</span></div>
 <div class="sku-detail__strip-item"><span class="sku-detail__strip-value">24 hrs</span><span class="sku-detail__strip-label">Entrega CDMX</span></div>
 </div>
 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table"><tbody>
 {specs.map(([l, v]) => <tr><td>{l}</td><td>{v}</td></tr>)}
 </tbody></table>
 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-FC-09 Caja Dispositivos Médicos`}
 target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-FC-09</a>
 <a href="/catalogo/cajas-farmaceutica-cosmetica" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <section class="sku-faq" aria-labelledby="faq-fc09-title">
 <div class="container">
 <h2 id="faq-fc09-title" class="sku-faq__title">Preguntas Frecuentes — Dispositivos Médicos</h2>
 <div class="sku-faq__list">
 {faqs.map(f => <FaqItem id={f.id} question={f.question} answer={f.answer} />)}
 </div>
 </div>
 </section>
 </main>

 <LeadCapture whatsapp={WHATSAPP} title="Cotiza cajas para dispositivos médicos — Asesoría normativa COFEPRIS · FDA sin costo" />

</PageLayout>
