---
import PageLayout  from "@/layouts/PageLayout.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import ProductGallery from "@/components/ProductGallery.astro";

const title  = "Caja Suplementos y Nutrición Corrugado CDMX | CAD-FC-04 | CADECA";
const description = "Caja corrugado para suplementos alimenticios y nutrición en CDMX. Flauta B ECT-32, impresión datos nutricionales NOM-051. Vitaminas, proteínas, colágeno. CADECA.";
const WHATSAPP = "5255XXXXXXXX";

const medidas = [
 { nombre:"Frasco Individual",lah:"10×10×15",flauta:"B",ect:"ECT-32",vacío:"0.06 kg",máx:"1 kg",  disp:"green",  label:"Stock" },
 { nombre:"Bote Proteína",  lah:"15×15×25", flauta:"B",ect:"ECT-32",vacío:"0.12 kg",máx:"3 kg",  disp:"green",  label:"Stock", hl:true },
 { nombre:"Kit 3 Productos", lah:"30×15×15", flauta:"B",ect:"ECT-32",vacío:"0.16 kg",máx:"5 kg",  disp:"green",  label:"Stock", hl:true },
 { nombre:"Display 6 Frascos",lah:"35×25×20",flauta:"C",ect:"ECT-32",vacío:"0.30 kg",máx:"8 kg",  disp:"yellow", label:"48 hrs" },
 { nombre:"Master 12 pzas",  lah:"40×30×30", flauta:"C",ect:"ECT-32",vacío:"0.50 kg",máx:"10 kg", disp:"yellow", label:"48 hrs" },
 { nombre:"A la Medida",  lah:"Cualquier",flauta:"A elegir",ect:"A elegir",vacío:"—",máx:"—",disp:"gray",label:"3-5 días" },
];

const specs = [
 ["Código SKU",  "CAD-FC-04"],
 ["Tipo de pared",  "Simple (flauta B/C)"],
 ["Flautas disponibles", "B (3mm) · C (4mm)"],
 ["Resistencia ECT",  "ECT-32"],
 ["Gramaje liner",  "127 – 150 g/m²"],
 ["Gramaje médium",  "112 – 127 g/m²"],
 ["Material",  "Kraft virgen · SBS blanqueado"],
 ["Resistencia al estallido", "350 kPa (Mullen)"],
 ["Resistencia a la humedad", "Cobb60: 30 g/m² (estándar)"],
 ["Peso máx. producto",  "Hasta 10 kg (flauta C)"],
 ["Carga de apilado",  "Hasta 100 kg (condiciones ideales)"],
 ["Impresión",  "Flexo 1-4 colores · Tabla nutricional · Código de barras"],
 ["Certificación",  "NOM-051-SCFI compatible · FSC disponible"],
 ["Pedido mínimo",  "200 pzas (producción)"],
 ["Tiempo de entrega",  "48-72 hrs stock · 5-7 días especial"],
];

const faqs = [
 {
 id:"fc04-f1",
 question:"¿Pueden imprimir tabla nutricional en la caja de suplementos?",
 answer:"Sí, imprimimos la <strong>tabla nutricional conforme a NOM-051-SCFI</strong> directamente en la caja mediante flexografía de alta resolución. Incluye información nutricional, ingredientes, advertencias, datos del fabricante y sellos de advertencia. Nuestro equipo de diseño adapta tu tabla al formato de caja sin costo adicional.",
 },
 {
 id:"fc04-f2",
 question:"¿Qué sellos de advertencia NOM-051 deben llevar los suplementos?",
 answer:"Según la <strong>NOM-051-SCFI/SSA1-2010</strong>, los suplementos alimenticios deben llevar sellos de advertencia si exceden los límites de calorías, azúcares, grasas, sodio o cafeína. Los sellos son octágonos negros estandarizados. Nuestras cajas incluyen el área de impresión para estos sellos en la cara frontal según la normativa vigente.",
 },
 {
 id:"fc04-f3",
 question:"¿Es necesario usar flauta B o C para suplementos?",
 answer:"Para <strong>cajas individuales</strong> (frasco, bote) recomendamos <strong>flauta B (3mm)</strong> porque ofrece mejor superficie de impresión y rigidez suficiente para productos ligeros. Para <strong>cajas master</strong> de distribución con varios frascos, recomendamos <strong>flauta C (4mm)</strong> por su mayor capacidad de acolchado y protección contra impacto durante transporte.",
 },
 {
 id:"fc04-f4",
 question:"¿Las cajas son aptas para suplementos que requieren protección contra luz?",
 answer:"El cartón corrugado ofrece <strong>protección natural contra luz</strong>, bloqueando rayos UV que pueden degradar vitaminas y compuestos activos. Para productos especialmente fotosensibles (como omega-3 o probióticos), recomendamos agregar un liner interno de papel kraft oscuro o bolsa metalizada como barrera adicional.",
 },
 {
 id:"fc04-f5",
 question:"¿Fabrican cajas para botes de proteína de 2 lb y 5 lb?",
 answer:"Sí, tenemos <strong>medidas estándar para botes de proteína</strong>: 15×15×25 cm para botes de 2 lb (en stock) y medida especial para 5 lb bajo pedido. El corrugado simple flauta B ECT-32 soporta hasta 3 kg, suficiente para ambas presentaciones. Para envío e-commerce, recomendamos agregar relleno de papel kraft.",
 },
 {
 id:"fc04-f6",
 question:"¿Ofrecen empaques para kits de suplementos o suscripciones mensuales?",
 answer:"Sí, fabricamos <strong>cajas para kits y suscripciones</strong> con divisiones internas para 2-6 productos. Incluyen diseño personalizado exterior e interior para experiencia de unboxing. Son ideales para marcas de suplementos con modelo de suscripción mensual. Pedido mínimo de 200 pzas por diseño.",
 },
];

const mainImg = "/img/catalogo/caja-suplementos-nutricion-deportiva-cdmx.avif";
const gallery = [
 { src: "/img/catalogo/caja-suplementos-nutricion-deportiva-cdmx.avif", alt: "Suplementos nutrición — principal" },
 { src: "/img/catalogo/caja-suplementos-nutricion-hero-cdmx.avif", alt: "Suplementos — hero" },
 { src: "/img/catalogo/caja-suplementos-nutricion-stack-cdmx.avif", alt: "Suplementos — apilados" },
 { src: "/img/catalogo/caja-suplementos-nutricion-tienda-cdmx.avif", alt: "Suplementos — tienda" },
 { src: "/img/catalogo/caja-suplementos-nutricion-asa-cdmx.avif", alt: "Asa reforzada — detalle" },
];
---

<PageLayout
 title={title}
 description={description}
 whatsapp={WHATSAPP}
 pageType="product"
 breadcrumbs={[{name:"Inicio",href:"/"},{name:"Catálogo",href:"/catalogo"},{name:"Farmacéutica y Cosmética",href:"/catalogo/cajas-farmaceutica-cosmetica"},{name:"Suplementos y Nutrición"}]}
 faqItems={faqs.map(f=>({question:f.question,answer:f.answer.replace(/<[^>]+>/g,'')}))}
 product={{name:"Caja Suplementos y Nutrición Corrugado",sku:"CAD-FC-04",description:"Caja corrugado para suplementos alimenticios y nutrición en CDMX — fabricante directo CADECA",image:"/img/catalogo/caja-suplementos-nutricion-deportiva-cdmx.avif",material:"Cartón corrugado simple flauta B ECT-32",category:"Cajas para Industria Farmacéutica y Cosmética",moq:"200"}}
>

 <div class="breadcrumb-bar" aria-label="Ruta de navegación">
 <div class="container"><ol>
 <li><a href="/">Inicio</a></li>
 <li><a href="/catalogo">Catálogo</a></li>
 <li><a href="/catalogo/cajas-farmaceutica-cosmetica">Farmacéutica y Cosmética</a></li>
 <li><span class="current">Suplementos y Nutrición</span></li>
 </ol></div>
 </div>

 <section class="cat-page-hero" aria-labelledby="sku-fc04-title">
 <div class="container">
 <span class="cat-page-hero__eyebrow">SKU CAD-FC-04 · Farmacéutica y Cosmética</span>
 <h1 id="sku-fc04-title" class="cat-page-hero__title">
 Suplementos y Nutrición<br><span>Corrugado Simple — CDMX</span>
 </h1>
 <p class="cat-page-hero__desc">
 Caja corrugado simple para suplementos alimenticios, vitaminas, proteínas y colágeno. Impresión flexográfica con tabla nutricional NOM-051 y sellos de advertencia. Desde frasco individual hasta caja master de distribución.
 </p>
 <div class="cat-page-hero__strip">
 <div class="cat-page-hero__strip-item">SKU: <strong>CAD-FC-04</strong></div>
 <div class="cat-page-hero__strip-item">ECT: <strong>ECT-32</strong></div>
 <div class="cat-page-hero__strip-item">MOQ: <strong>200 pzas</strong></div>
 <div class="cat-page-hero__strip-item">Entrega: <strong>48-72 hrs</strong></div>
 </div>
 </div>
 </section>

 <main id="contenido-principal" role="main">

 <section class="sku-detail" aria-labelledby="detalle-fc04-title">
 <div class="container">
 <div class="sku-detail__grid">

 <div class="sku-detail__img-col">
 <ProductGallery images={gallery} />
 </div>

 <div class="sku-detail__content">
 <p class="sku-detail__code">CAD-FC-04 · Familia: Farmacéutica y Cosmética</p>
 <h2 id="detalle-fc04-title" class="sku-detail__title">Suplementos y Nutrición — Corrugado Simple</h2>
 <p class="sku-detail__desc">
 La caja para suplementos CAD-FC-04 está diseñada para la industria de suplementos alimenticios, vitaminas, proteínas y colágeno en México. Fabricada en cartón corrugado simple flauta B con ECT-32, incluye áreas de impresión optimizadas para tabla nutricional NOM-051, sellos de advertencia y código de barras.
 </p>

 <div class="sku-detail__strip">
 <div class="sku-detail__strip-item">
 <span class="sku-detail__strip-value">ECT-32</span>
 <span class="sku-detail__strip-label">Resistencia estándar</span>
 </div>
 <div class="sku-detail__strip-item">
 <span class="sku-detail__strip-value">10 kg</span>
 <span class="sku-detail__strip-label">Peso máx.</span>
 </div>
 <div class="sku-detail__strip-item">
 <span class="sku-detail__strip-value">200 pzas</span>
 <span class="sku-detail__strip-label">Pedido mín.</span>
 </div>
 <div class="sku-detail__strip-item">
 <span class="sku-detail__strip-value">48 hrs</span>
 <span class="sku-detail__strip-label">Entrega CDMX</span>
 </div>
 </div>

 <p class="sku-detail__specs-title">Especificaciones Técnicas</p>
 <table class="sku-detail__specs-table">
 <tbody>
 {specs.map(([label, val]) => (
 <tr><td>{label}</td><td>{val}</td></tr>
 ))}
 </tbody>
 </table>

 <div class="sku-detail__actions">
 <a href={`https://wa.me/${WHATSAPP}?text=Hola, quiero cotizar CAD-FC-04 Suplementos y Nutrición`}
 target="_blank" rel="noopener" class="btn btn--primary">Cotizar CAD-FC-04</a>
 <a href="/catalogo/cajas-farmaceutica-cosmetica" class="btn btn--outline">← Ver categoría</a>
 </div>
 </div>

 </div>
 </div>
 </section>

 <section class="sku-sizes" aria-labelledby="sizes-fc04-title">
 <div class="container">
 <h2 id="sizes-fc04-title" class="section-header__title" style="margin-bottom:var(--spacing-lg)">
 Medidas Disponibles — CAD-FC-04
 </h2>
 <div class="catalog-sizes-table-wrap">
 <table class="catalog-sizes-table">
 <thead>
 <tr>
 <th>Tamaño</th>
 <th>L × A × H (cm)</th>
 <th>Flauta</th>
 <th>ECT</th>
 <th>Peso vacío</th>
 <th>Peso máx.</th>
 <th>Disponibilidad</th>
 </tr>
 </thead>
 <tbody>
 {medidas.map(m => (
 <tr class={m.hl ? "highlight" : ""}>
 <td>{m.nombre}</td>
 <td><strong>{m.lah}</strong></td>
 <td>{m.flauta}</td>
 <td>{m.ect}</td>
 <td>{m.vacío}</td>
 <td><strong>{m.máx}</strong></td>
 <td>
 <span class={`stock-chip stock-chip--${m.disp}`}>
 {m.disp==="green"?"":m.disp==="yellow"?"":"○"} {m.label}
 </span>
 </td>
 </tr>
 ))}
 </tbody>
 </table>
 </div>
 <p style="font-size:0.72rem;color:var(--color-text-light);margin-top:0.6rem">
 Stock permanente ·  Producción rápida · ○ Pedido especial — 3 a 5 días hábiles. Pesos bajo condiciones estándar: 20°C y 50% HR.
 </p>
 </div>
 </section>

 <section class="faq" aria-labelledby="faq-fc04-title">
 <div class="container">
 <h2 id="faq-fc04-title" class="section-header__title" style="margin-bottom:var(--spacing-xl)">
 Preguntas Técnicas — CAD-FC-04
 </h2>
 <div class="faq__list">
 {faqs.map(f => <FaqItem {...f} />)}
 </div>
 </div>
 </section>

 </main>

 <LeadCapture whatsapp={WHATSAPP} title="Cotiza CAD-FC-04 — Cajas para suplementos con datos nutricionales NOM-051" />

</PageLayout>
