---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Packaging Ecológico y Sustentable — CADECA Fabricante Directo CDMX";
const description = "Ofrecemos cajas de cartón corrugado fabricadas con papel reciclado certificado FSC y materiales de fuentes sostenibles. Para empresas que quieren reducir su hue";
const canonical   = SITE + "/servicios/packaging-ecologico";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Packaging Ecológico y Sustentable",
    "description": description,
    "provider": { "@type": "LocalBusiness", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿El cartón reciclado es igual de resistente?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, el cartón reciclado de calidad tiene la misma resistencia que el virgen para la mayoría de los usos. Para aplicaciones de alta exigencia (exportación pesada) evaluamos caso por caso." } },
    { "@type": "Question", "name": "¿Cuánto más cuesta el packaging ecológico?", "acceptedAnswer": { "@type": "Answer", "text": "En general el precio es similar al cartón convencional. En algunos casos puede ser 5-10% más por las certificaciones, pero la diferencia es mínima comparada con el valor de marca que genera." } },
    { "@type": "Question", "name": "¿Pueden incluir el símbolo de reciclaje o certificación FSC en las cajas?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, podemos imprimir el símbolo de reciclaje, la certificación FSC o cualquier mensaje de sustentabilidad que quieras comunicar a tus clientes." } },
    { "@type": "Question", "name": "¿Tienen opciones biodegradables además del cartón?", "acceptedAnswer": { "@type": "Answer", "text": "El cartón corrugado ya es biodegradable. Para necesidades específicas de empaques compuestos o con barreras especiales, evaluamos alternativas sustentables caso por caso." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios" },
    { name: "Packaging Ecológico y Sustentable" },
  ]}
  whatsapp={WHATSAPP}
>

  <section class="svc-page__hero">
    <div class="svc-page__hero-inner container">
      <div class="svc-page__hero-col1">
      <div class="svc-page__hero-emoji">🌿</div>
      <h1 class="svc-page__hero-title">Packaging Ecológico y Sustentable</h1>
      <p class="svc-page__hero-tagline">Cajas de cartón reciclado FSC — huella de carbono reducida</p>
      <p class="svc-page__hero-desc">Ofrecemos cajas de cartón corrugado fabricadas con papel reciclado certificado FSC y materiales de fuentes sostenibles. Para empresas que quieren reducir su huella de carbono y comunicar un compromiso real con el medio ambiente.</p>
      <div class="svc-page__hero-ctas">
        <a href="/cotizar" class="btn btn--primary btn--lg">Solicitar cotización</a>
        <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+quiero+informaci%C3%B3n+sobre+Packaging+Ecológico+y+Sustentable"}
           class="btn btn--outline btn--lg" target="_blank" rel="noopener">💬 WhatsApp</a>
      </div>
          </div>
      <div class="svc-page__hero-col2">
        <p>CADECA produce <strong>packaging ecológico de cartón corrugado reciclado y reciclable</strong> certificado FSC para empresas comprometidas con la sostenibilidad. Cartón kraft natural, tintas base agua sin solventes, adhesivos no tóxicos y diseños optimizados para minimizar el material usado.</p>
        <p>Nuestros <strong>empaques ecológicos</strong> cumplen con las normas ambientales mexicanas y los requisitos de grandes cadenas de retail que exigen materiales sustentables. Ideal para marcas que comunican responsabilidad ambiental. Cotización de packaging ecológico en menos de 2 horas.</p>
      </div>
    </div>
  </section>

  <section class="svc-page__section">
    <div class="container">
      <SectionHeader title="Beneficios del servicio" subtitle="Por qué elegir CADECA para packaging ecológico y sustentable" />
      <ul class="svc-page__beneficios">
              <li><span>✓</span> Papel reciclado certificado FSC — fuentes responsablemente gestionadas</li>
              <li><span>✓</span> Impresión con tintas a base de agua — sin solventes contaminantes</li>
              <li><span>✓</span> 100% reciclable y biodegradable — no genera residuos plásticos</li>
              <li><span>✓</span> Certificación de sustentabilidad disponible para tus clientes</li>
              <li><span>✓</span> Precio competitivo — el cartón reciclado no cuesta más</li>
      </ul>
    </div>
  </section>

  <section class="svc-page__section svc-page__section--alt">
    <div class="container">
      <SectionHeader title="Cómo funciona" subtitle="Proceso simple, sin burocracia, con respuesta rápida" />
      <div class="svc-page__pasos">
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">1</div>
            <div>
              <strong>Evaluación</strong>
              <p>Analizamos tus necesidades actuales y te proponemos el empaque más sustentable para tu tipo de producto.</p>
            </div>
          </div>
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">2</div>
            <div>
              <strong>Selección de material</strong>
              <p>Elegimos el papel reciclado adecuado según resistencia requerida y certificaciones necesarias.</p>
            </div>
          </div>
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">3</div>
            <div>
              <strong>Producción</strong>
              <p>Fabricamos con materiales certificados. Podemos incluir el logo de reciclaje o certificaciones en el impreso.</p>
            </div>
          </div>
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">4</div>
            <div>
              <strong>Documentación</strong>
              <p>Te proporcionamos certificados de material para que puedas comunicar la sustentabilidad a tus clientes.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <section class="svc-page__section">
    <div class="container">
      <SectionHeader title="Preguntas frecuentes" subtitle={"Todo sobre " + "packaging ecológico y sustentable"} />
      <div class="svc-page__faq">
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿El cartón reciclado es igual de resistente?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>Sí, el cartón reciclado de calidad tiene la misma resistencia que el virgen para la mayoría de los usos. Para aplicaciones de alta exigencia (exportación pesada) evaluamos caso por caso.</p>
            </div>
          </div>
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿Cuánto más cuesta el packaging ecológico?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>En general el precio es similar al cartón convencional. En algunos casos puede ser 5-10% más por las certificaciones, pero la diferencia es mínima comparada con el valor de marca que genera.</p>
            </div>
          </div>
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿Pueden incluir el símbolo de reciclaje o certificación FSC en las cajas?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>Sí, podemos imprimir el símbolo de reciclaje, la certificación FSC o cualquier mensaje de sustentabilidad que quieras comunicar a tus clientes.</p>
            </div>
          </div>
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿Tienen opciones biodegradables además del cartón?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>El cartón corrugado ya es biodegradable. Para necesidades específicas de empaques compuestos o con barreras especiales, evaluamos alternativas sustentables caso por caso.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <section class="svc-page__section svc-page__section--alt">
    <div class="container">
      <SectionHeader title="Productos relacionados" subtitle="Explora el catálogo de CADECA" />
      <div class="svc-page__productos">
        <a href="/catalogo/laminas-carton-corrugado" class="svc-page__prod-card">
          <strong>Láminas Corrugado Ecológico</strong>
          <span>Material FSC</span>
        </a>
        <a href="/catalogo/cajas-corrugado-estandar" class="svc-page__prod-card">
          <strong>Corrugado Estándar Reciclado</strong>
          <span>Stock disponible</span>
        </a>
        <a href="/cotizar" class="svc-page__prod-card">
          <strong>Cotizar packaging verde</strong>
          <span>Precio competitivo</span>
        </a>
      </div>
    </div>
  </section>

  <LeadCapture
    titulo="¿Listo para comenzar con packaging ecológico y sustentable?"
    subtitulo="Cotización sin compromiso en menos de 2 horas. Fabricante directo, los mejores precios de CDMX."
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
.svc-page__hero { background: linear-gradient(135deg, var(--color-secondary) 0%, #0f1d35 100%); padding: var(--space-20) 0 var(--space-16); }
.svc-page__hero-inner { max-width: var(--container-max,1400px); margin: 0 auto; padding: 0 var(--space-5); display:grid; grid-template-columns:1fr; gap:var(--space-10); }
.svc-page__hero-emoji { font-size: 3rem; margin-bottom: var(--space-4); }
.svc-page__hero-title { font-size: clamp(1.8rem,4vw,2.8rem); font-weight: 900; color: #fff; line-height: 1.15; margin-bottom: var(--space-3); }
.svc-page__hero-tagline { font-size: var(--text-lg); color: var(--color-primary); font-weight: 600; margin-bottom: var(--space-4); }
.svc-page__hero-desc { color: rgba(255,255,255,0.75); line-height: var(--line-relaxed); margin-bottom: var(--space-8); }
.svc-page__hero-ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; }
@media(min-width:1024px){ .svc-page__hero-inner{grid-template-columns:1fr 1fr;align-items:start;} }
.svc-page__hero-col2{display:flex;flex-direction:column;gap:var(--space-6);}
.svc-page__hero-col2 p{font-size:var(--text-sm,0.9rem);color:rgba(255,255,255,0.78);line-height:1.75;}
.svc-page__hero-col2 p strong{color:#fff;font-weight:700;}
.svc-page__hero-col2 p+p{padding-top:var(--space-5);border-top:1px solid rgba(255,255,255,0.1);margin-top:var(--space-5);}
.svc-page__section { padding: var(--space-16) 0; }
.svc-page__section--alt { background: var(--color-surface); }
.svc-page__beneficios { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit,minmax(280px,1fr)); gap: var(--space-3); margin-top: var(--space-8); }
.svc-page__beneficios li { display: flex; gap: var(--space-3); align-items: flex-start; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4); font-size: var(--text-sm); line-height: var(--line-relaxed); }
.svc-page__beneficios span { color: var(--color-primary); font-weight: 900; flex-shrink: 0; }
.svc-page__pasos { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-8); max-width: 680px; margin-left: auto; margin-right: auto; }
.svc-page__paso { display: flex; gap: var(--space-5); align-items: flex-start; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-5); }
.svc-page__paso-num { width: 2.5rem; height: 2.5rem; background: var(--color-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: var(--text-lg); flex-shrink: 0; }
.svc-page__paso strong { display: block; color: var(--color-secondary); font-size: var(--text-base); margin-bottom: var(--space-1); }
.svc-page__paso p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--line-relaxed); margin: 0; }
.svc-page__faq { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-8); max-width: 780px; margin-left: auto; margin-right: auto; }
.svc-page__faq-item { border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: #fff; }
.svc-page__faq-q { width: 100%; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-4) var(--space-5); background: none; border: none; cursor: pointer; font-weight: 600; font-size: var(--text-sm); color: var(--color-secondary); }
.svc-page__faq-q:hover { color: var(--color-primary); }
.svc-page__faq-a { padding: 0 var(--space-5) var(--space-4); display: none; }
.svc-page__faq-a p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--line-relaxed); margin: 0; }
.svc-page__faq-item.is-open .svc-page__faq-a { display: block; }
.svc-page__faq-item.is-open .svc-page__faq-q svg { transform: rotate(180deg); }
.svc-page__productos { display: grid; grid-template-columns: repeat(auto-fit,minmax(180px,1fr)); gap: var(--space-4); margin-top: var(--space-8); }
.svc-page__prod-card { display: flex; flex-direction: column; gap: var(--space-1); background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-5); text-decoration: none; color: var(--color-text); }
.svc-page__prod-card:hover { border-color: var(--color-primary); }
.svc-page__prod-card strong { color: var(--color-secondary); font-size: var(--text-sm); }
.svc-page__prod-card span { font-size: var(--text-xs); color: var(--color-text-muted); }
@media (max-width: 640px) {
  .svc-page__hero-ctas { flex-direction: column; }
  .svc-page__beneficios { grid-template-columns: 1fr; }
}
</style>

<script>
document.querySelectorAll('.svc-page__faq-q').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.svc-page__faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
