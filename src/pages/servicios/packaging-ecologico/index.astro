---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Packaging Ecológico Cartón Reciclado FSC CDMX — CADECA Fabricante Directo";
const description = "Packaging ecológico de cartón corrugado reciclado con certificación FSC en CDMX. Tintas base agua, diseño sustentable. Para marcas con compromiso ambiental.";
const canonical   = SITE + "/servicios/packaging-ecologico";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Packaging Ecológico de Cartón Reciclado FSC",
    "description": description,
    "provider": { "@type": "LocalBusiness", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Qué significa la certificación FSC?", "acceptedAnswer": { "@type": "Answer", "text": "FSC (Forest Stewardship Council) certifica que el papel proviene de bosques gestionados de forma responsable o de material reciclado." } },
    { "@type": "Question", "name": "¿El cartón reciclado tiene la misma resistencia?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, el cartón reciclado de calidad tiene resistencias ECT comparables al cartón virgen para la mayoría de usos." } },
    { "@type": "Question", "name": "¿Puedo imprimir con tintas ecológicas?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, usamos tintas base agua para todos nuestros pedidos de packaging ecológico. Sin solventes orgánicos." } },
    { "@type": "Question", "name": "¿Pueden proveer documentación de sustentabilidad?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, podemos emitir carta de proveedor con especificaciones FSC y de material reciclado para tus reportes." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios" },
    { name: "Packaging Ecológico de Cartón Reciclado FSC" },
  ]}
  whatsapp={WHATSAPP}
>

  {/* ════════ HERO ════════ */}
  <section class="hero">
    <div class="container">
      <div class="hero__inner">

        <div class="hero__left">
          <p class="hero__badge">Servicio · Certificación FSC · Sustentable</p>
          <h1 class="hero__title"><span>Packaging Ecológico de Cartón Reciclado FSC</span></h1>
          <p class="hero__intro">Cartón kraft reciclado certificado FSC, tintas base agua sin solventes y diseños que minimizan el material. Para marcas que comunican responsabilidad ambiental.</p>
          <div class="hero__ctas">
            <a href="/cotizar" class="btn btn--primary btn--lg">Solicitar cotización</a>
            <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+quiero+informaci%C3%B3n+sobre+Packaging+Ecol%C3%B3gico+de+CADECA"}
               class="btn btn--outline btn--lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp</a>
          </div>
          <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">FSC</span>
            <span class="hero__metric-label">Certificado</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">100%</span>
            <span class="hero__metric-label">Reciclable</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">Agua</span>
            <span class="hero__metric-label">Tintas sin solventes</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">2 hrs</span>
            <span class="hero__metric-label">Cotización</span>
          </div>
          </div>
        </div>

        <div class="hero__right">
          <p>CADECA produce <strong>packaging ecológico de cartón corrugado reciclado y reciclable</strong> certificado FSC para empresas comprometidas con la sostenibilidad. Cartón kraft natural, tintas base agua sin solventes, adhesivos no tóxicos y diseños optimizados para minimizar el material.</p>
          <p>Nuestros <strong>empaques ecológicos</strong> cumplen con las normas ambientales mexicanas y los requisitos de grandes cadenas de retail que exigen materiales sustentables. Ideal para marcas que comunican responsabilidad ambiental a sus clientes. Cotización en menos de 2 horas.</p>
        </div>

      </div>
    </div>
  </section>

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para packaging ecológico de cartón reciclado fsc"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Cartón kraft reciclado con certificación FSC</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Tintas base agua — sin solventes orgánicos</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Adhesivos no tóxicos compatibles con reciclaje</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Diseño optimizado para minimizar uso de material</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>100% reciclable — sin materiales mixtos no separables</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Cumple requisitos de retail y e-commerce sustentable</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Consulta de materiales</p>
            <p class="process-step__desc">Te informamos sobre las opciones de cartón reciclado y certificaciones disponibles.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Diseño sustentable</p>
            <p class="process-step__desc">Nuestro equipo optimiza las dimensiones y el material para minimizar el impacto ambiental.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Producción certificada</p>
            <p class="process-step__desc">Fabricamos con materiales FSC y tintas base agua. Proveemos documentación si la necesitas.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Entrega y documentación</p>
            <p class="process-step__desc">Entrega en CDMX con carta de material FSC si la necesitas para tus reportes de sustentabilidad.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Preguntas frecuentes"
        subtitle={"Todo sobre packaging ecológico de cartón reciclado fsc"}
      />
      <div class="faq-list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-packaging-ecologico-0">
              <span>¿Qué significa la certificación FSC?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-packaging-ecologico-0">
              <p>FSC (Forest Stewardship Council) certifica que el papel proviene de bosques gestionados de forma responsable o de material reciclado.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-packaging-ecologico-1">
              <span>¿El cartón reciclado tiene la misma resistencia?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-packaging-ecologico-1">
              <p>Sí, el cartón reciclado de calidad tiene resistencias ECT comparables al cartón virgen para la mayoría de usos.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-packaging-ecologico-2">
              <span>¿Puedo imprimir con tintas ecológicas?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-packaging-ecologico-2">
              <p>Sí, usamos tintas base agua para todos nuestros pedidos de packaging ecológico. Sin solventes orgánicos.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-packaging-ecologico-3">
              <span>¿Pueden proveer documentación de sustentabilidad?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-packaging-ecologico-3">
              <p>Sí, podemos emitir carta de proveedor con especificaciones FSC y de material reciclado para tus reportes.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Láminas Ecológicas FSC"
            desc="Cartón reciclado certificado"
            imgSrc="/img/productos/laminas-carton-corrugado-ecologico-reciclado-fsc-cdmx.avif"
            imgAlt="Láminas Ecológicas FSC — CADECA"
            href="/catalogo/laminas-carton-corrugado"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="En material ecológico FSC"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas Personalizadas"
            desc="Con tintas base agua"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas Personalizadas — CADECA"
            href="/catalogo/cajas-personalizadas-con-logo"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <LeadCapture
    titulo="Cotiza tu packaging ecológico FSC"
    subtitulo="Certificado FSC · Tintas base agua · Fabricante directo en CDMX"
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
