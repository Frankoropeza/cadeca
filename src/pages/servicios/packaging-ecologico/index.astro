---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageHero from "@/components/PageHero.astro";
const SITE     = "https://cajas-de-carton.com";

const title       = "Packaging Ecológico de Cartón Reciclado CDMX | CADECA";
const description = "Packaging ecológico con cartón corrugado reciclado y reciclable para empresas en CDMX y Edomex: opciones kraft, tintas base agua y menos plástico.";
const canonical   = SITE + "/servicios/packaging-ecologico/";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Packaging Ecológico de Cartón Reciclado FSC",
    "description": description,
    "provider": { "@type": "Organization", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    get mainEntity() { return faqsModulo.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })); },
  }
];
const faqsModulo = [
 {
  "question": "¿Qué significa la certificación FSC?",
  "answer": "FSC (Forest Stewardship Council) certifica que el papel proviene de bosques gestionados de forma responsable o de material reciclado."
 },
 {
  "question": "¿El cartón reciclado tiene la misma resistencia?",
  "answer": "Sí, el cartón reciclado de calidad tiene resistencias ECT comparables al cartón virgen para la mayoría de usos."
 },
 {
  "question": "¿Puedo imprimir con tintas ecológicas?",
  "answer": "Sí, usamos tintas base agua para todos nuestros pedidos de packaging ecológico. Sin solventes orgánicos."
 },
 {
  "question": "¿Pueden proveer documentación de sustentabilidad?",
  "answer": "Si tu proyecto requiere documentación sobre el material, indícalo en el formulario para revisar qué información puede confirmar el fabricante aliado. La disponibilidad de documentos o certificaciones depende del material y proveedor específicos considerados en la cotización." 
 },
 { "question": "¿Cómo elijo un empaque ecológico de cartón para mi producto?", "answer": "Define el nivel de protección, peso, dimensiones, condiciones de transporte y el material que buscas priorizar. El cartón reciclado y las tintas base agua pueden ser opciones, pero la flauta y resistencia ECT deben corresponder al manejo requerido." }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Packaging Ecológico de Cartón Reciclado FSC" },
  ]}
>

  {/* ════════ HERO ════════ */}
  <PageHero
    eyebrow="Servicio · Empaque ecológico"
    titleHtml={true}
    title="Empaques ecológicos de <span>cartón reciclado</span>"
    desc="Empaques ecológicos con cartón kraft reciclado, tintas base agua y diseños que ayudan a optimizar material. Son una opción para marcas que requieren alternativas de cartón para sus productos."
    desc2="Los <strong>empaques ecológicos</strong> pueden considerar cartón kraft natural, cartón reciclado, tintas base agua sin solventes y adhesivos no tóxicos. El diseño se revisa para usar el material necesario sin perder la estructura que requiere el producto y su manejo.||CADECA surte como proveedor mediante talleres aliados. Indica medidas, cantidad, uso y zona de entrega para cotizar <strong>cajas ecológicas</strong>; te asesoramos para elegir materiales y confirmar opciones disponibles."
  />

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para packaging ecológico de cartón reciclado fsc"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span>Cartón kraft reciclado; FSC disponible según pedido</span>
          </li>
          <li class="feature-item">
            <span>Tintas base agua — sin solventes orgánicos</span>
          </li>
          <li class="feature-item">
            <span>Adhesivos no tóxicos compatibles con reciclaje</span>
          </li>
          <li class="feature-item">
            <span>Diseño optimizado para minimizar uso de material</span>
          </li>
          <li class="feature-item">
            <span>100% reciclable — sin materiales mixtos no separables</span>
          </li>
          <li class="feature-item">
            <span>Cumple requisitos de retail y e-commerce sustentable</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Consulta de materiales</p>
            <p class="process-step__desc">Te informamos sobre las opciones de cartón reciclado y certificaciones disponibles.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Diseño sustentable</p>
            <p class="process-step__desc">Nuestro equipo optimiza las dimensiones y el material para minimizar el impacto ambiental.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Producción certificada</p>
            <p class="process-step__desc">Coordinamos materiales reciclados y tintas base agua. Si necesitas certificación FSC, confirmamos disponibilidad y documentación con el fabricante.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Entrega y documentación</p>
            <p class="process-step__desc">Entrega programada en CDMX; la documentación FSC se confirma con el fabricante si la necesitas para tus reportes.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Láminas Ecológicas FSC"
            desc="Cartón reciclado certificado"
            imgSrc="/img/productos/laminas-carton-corrugado-ecologico-reciclado-fsc-cdmx.avif"
            imgAlt="Láminas Ecológicas FSC — CADECA"
            href="/catalogo/laminas-carton-corrugado/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="En material ecológico FSC"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas Personalizadas"
            desc="Con tintas base agua"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas Personalizadas — CADECA"
            href="/catalogo/cajas-personalizadas-logo/"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <FaqCotizacion faqs={faqsModulo} tema="empaques ecológicos" />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    if (!item) return;
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
