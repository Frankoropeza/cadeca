---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Muestras y Prototipos de Cajas — CADECA Fabricante Directo CDMX";
const description = "Fabricamos prototipos físicos de tu caja personalizada o a la medida antes de iniciar la producción en serie. Valida el tamaño, la resistencia, el acabado y el ";
const canonical   = SITE + "/servicios/muestras-prototipos";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Muestras y Prototipos de Cajas",
    "description": description,
    "provider": { "@type": "LocalBusiness", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿El prototipo tiene costo?", "acceptedAnswer": { "@type": "Answer", "text": "Para pedidos de producción superiores a 1,000 piezas el prototipo es sin costo. Para pedidos menores, podemos hacerlo con un cargo simbólico que se descuenta del pedido final." } },
    { "@type": "Question", "name": "¿Puedo pedir un prototipo sin compromiso de comprar?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, aunque para prototipos sin pedido confirmado aplicamos un cargo de producción que no se descuenta. Consulta condiciones con tu asesor." } },
    { "@type": "Question", "name": "¿Cuántos prototipos puedo pedir?", "acceptedAnswer": { "@type": "Answer", "text": "Incluimos hasta 3 prototipos con ajustes dentro del proceso. Si necesitas más iteraciones, las evaluamos caso por caso." } },
    { "@type": "Question", "name": "¿El prototipo es igual al producto final?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, el prototipo se fabrica con los mismos materiales, dimensiones y acabados que tendrá el pedido de producción. Lo que apruebas es exactamente lo que recibirás." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios" },
    { name: "Muestras y Prototipos de Cajas" },
  ]}
  whatsapp={WHATSAPP}
>

  <section class="svc-page__hero">
    <div class="svc-page__hero-inner container">
      <div class="svc-page__hero-col1">
      <div class="svc-page__hero-emoji">🧪</div>
      <h1 class="svc-page__hero-title">Muestras y Prototipos de Cajas</h1>
      <p class="svc-page__hero-tagline">Valida antes de producir — prototipos físicos sin costo para pedidos grandes</p>
      <p class="svc-page__hero-desc">Fabricamos prototipos físicos de tu caja personalizada o a la medida antes de iniciar la producción en serie. Valida el tamaño, la resistencia, el acabado y el comportamiento con tu producto antes de comprometerte con el pedido completo.</p>
      <div class="svc-page__hero-ctas">
        <a href="/cotizar" class="btn btn--primary btn--lg">Solicitar cotización</a>
        <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+quiero+informaci%C3%B3n+sobre+Muestras+y+Prototipos+de+Cajas"}
           class="btn btn--outline btn--lg" target="_blank" rel="noopener">💬 WhatsApp</a>
      </div>
          </div>
      <div class="svc-page__hero-col2">
        <p>Antes de producir tu corrida completa, CADECA fabrica <strong>muestras y prototipos de cajas de cartón</strong> para que valides dimensiones, resistencia, impresión y acabado. El proceso de muestra incluye diseño CAD, fabricación de 1-5 piezas y prueba de carga si se requiere.</p>
        <p>El costo de la muestra se descuenta del pedido de producción. <strong>Tiempo de entrega de muestras: 24-72 horas</strong> en CDMX. Validamos juntos antes de comprometer el presupuesto de producción. Ideal para cajas nuevas, cambios de diseño y productos con empaques críticos para la experiencia del cliente.</p>
      </div>
    </div>
  </section>

  <section class="svc-page__section">
    <div class="container">
      <SectionHeader title="Beneficios del servicio" subtitle="Por qué elegir CADECA para muestras y prototipos de cajas" />
      <ul class="svc-page__beneficios">
              <li><span>✓</span> Prototipo físico sin costo para pedidos de más de 1,000 piezas</li>
              <li><span>✓</span> Prueba digital (render 3D) para pedidos menores</li>
              <li><span>✓</span> Validación con tu producto real antes de producir</li>
              <li><span>✓</span> Ajustes sin costo hasta quedar perfecto</li>
              <li><span>✓</span> Tiempo de prototipo: 2-3 días hábiles</li>
      </ul>
    </div>
  </section>

  <section class="svc-page__section svc-page__section--alt">
    <div class="container">
      <SectionHeader title="Cómo funciona" subtitle="Proceso simple, sin burocracia, con respuesta rápida" />
      <div class="svc-page__pasos">
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">1</div>
            <div>
              <strong>Solicitud</strong>
              <p>Pides el prototipo junto con la cotización. Para pedidos grandes, lo incluimos automáticamente.</p>
            </div>
          </div>
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">2</div>
            <div>
              <strong>Fabricación</strong>
              <p>En 2-3 días hábiles fabricamos el prototipo con las medidas y materiales finales.</p>
            </div>
          </div>
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">3</div>
            <div>
              <strong>Entrega o envío</strong>
              <p>Te entregamos el prototipo en mano o lo enviamos por paquetería para que lo valides con tu producto.</p>
            </div>
          </div>
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">4</div>
            <div>
              <strong>Ajustes y producción</strong>
              <p>Si necesitas ajustes, los hacemos. Aprobado el prototipo, iniciamos producción en serie.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <section class="svc-page__section">
    <div class="container">
      <SectionHeader title="Preguntas frecuentes" subtitle={"Todo sobre " + "muestras y prototipos de cajas"} />
      <div class="svc-page__faq">
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿El prototipo tiene costo?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>Para pedidos de producción superiores a 1,000 piezas el prototipo es sin costo. Para pedidos menores, podemos hacerlo con un cargo simbólico que se descuenta del pedido final.</p>
            </div>
          </div>
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿Puedo pedir un prototipo sin compromiso de comprar?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>Sí, aunque para prototipos sin pedido confirmado aplicamos un cargo de producción que no se descuenta. Consulta condiciones con tu asesor.</p>
            </div>
          </div>
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿Cuántos prototipos puedo pedir?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>Incluimos hasta 3 prototipos con ajustes dentro del proceso. Si necesitas más iteraciones, las evaluamos caso por caso.</p>
            </div>
          </div>
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿El prototipo es igual al producto final?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>Sí, el prototipo se fabrica con los mismos materiales, dimensiones y acabados que tendrá el pedido de producción. Lo que apruebas es exactamente lo que recibirás.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <section class="svc-page__section svc-page__section--alt">
    <div class="container">
      <SectionHeader title="Productos relacionados" subtitle="Explora el catálogo de CADECA" />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Cajas a la Medida"
            desc="Muestra en 24-72 hrs"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas Personalizadas"
            desc="Prototipo con tu logo"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas Personalizadas — CADECA"
            href="/catalogo/cajas-personalizadas-con-logo"
            btnText="Ver producto"
          />
          <ProductCard
            title="Industrial Triple Pared"
            desc="Muestra con prueba de carga"
            imgSrc="/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif"
            imgAlt="Industrial Triple Pared — CADECA"
            href="/catalogo/cajas-industriales-triple-pared"
            btnText="Ver producto"
          />
        </div>
    </div>
  </section>

  <LeadCapture
    titulo="¿Listo para comenzar con muestras y prototipos de cajas?"
    subtitulo="Cotización sin compromiso en menos de 2 horas. Fabricante directo, los mejores precios de CDMX."
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
.svc-page__hero { background: linear-gradient(135deg, var(--color-secondary) 0%, #0f1d35 100%); padding: var(--space-20) 0 var(--space-16); }
.svc-page__hero-inner { max-width: var(--container-max,1400px); margin: 0 auto; padding: 0 var(--space-5); display:grid; grid-template-columns:1fr; gap:var(--space-10); }
.svc-page__hero-emoji { font-size: 3rem; margin-bottom: var(--space-4); }
.svc-page__hero-title { font-size: clamp(1.8rem,4vw,2.8rem); font-weight: 900; color: #fff; line-height: 1.15; margin-bottom: var(--space-3); }
.svc-page__hero-tagline { font-size: var(--text-lg); color: var(--color-primary); font-weight: 600; margin-bottom: var(--space-4); }
.svc-page__hero-desc { color: rgba(255,255,255,0.75); line-height: var(--line-relaxed); margin-bottom: var(--space-8); }
.svc-page__hero-ctas { display: flex; gap: var(--space-4); flex-wrap: wrap; }
@media(min-width:1024px){ .svc-page__hero-inner{grid-template-columns:1fr 1fr;align-items:start;} }
.svc-page__hero-col2{display:flex;flex-direction:column;gap:var(--space-6);}
.svc-page__hero-col2 p{font-size:var(--text-sm,0.9rem);color:rgba(255,255,255,0.78);line-height:1.75;}
.svc-page__hero-col2 p strong{color:#fff;font-weight:700;}
.svc-page__hero-col2 p+p{padding-top:var(--space-5);border-top:1px solid rgba(255,255,255,0.1);margin-top:var(--space-5);}
.svc-page__section { padding: var(--space-16) 0; }
.svc-page__section--alt { background: var(--color-surface); }
.svc-page__beneficios { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit,minmax(280px,1fr)); gap: var(--space-3); margin-top: var(--space-8); }
.svc-page__beneficios li { display: flex; gap: var(--space-3); align-items: flex-start; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4); font-size: var(--text-sm); line-height: var(--line-relaxed); }
.svc-page__beneficios span { color: var(--color-primary); font-weight: 900; flex-shrink: 0; }
.svc-page__pasos { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-8); max-width: 680px; margin-left: auto; margin-right: auto; }
.svc-page__paso { display: flex; gap: var(--space-5); align-items: flex-start; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-5); }
.svc-page__paso-num { width: 2.5rem; height: 2.5rem; background: var(--color-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: var(--text-lg); flex-shrink: 0; }
.svc-page__paso strong { display: block; color: var(--color-secondary); font-size: var(--text-base); margin-bottom: var(--space-1); }
.svc-page__paso p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--line-relaxed); margin: 0; }
.svc-page__faq { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-8); max-width: 780px; margin-left: auto; margin-right: auto; }
.svc-page__faq-item { border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: #fff; }
.svc-page__faq-q { width: 100%; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-4) var(--space-5); background: none; border: none; cursor: pointer; font-weight: 600; font-size: var(--text-sm); color: var(--color-secondary); }
.svc-page__faq-q:hover { color: var(--color-primary); }
.svc-page__faq-a { padding: 0 var(--space-5) var(--space-4); display: none; }
.svc-page__faq-a p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--line-relaxed); margin: 0; }
.svc-page__faq-item.is-open .svc-page__faq-a { display: block; }
.svc-page__faq-item.is-open .svc-page__faq-q svg { transform: rotate(180deg); }
.svc-page__productos { display: grid; grid-template-columns: repeat(auto-fit,minmax(180px,1fr)); gap: var(--space-4); margin-top: var(--space-8); }
@media (max-width: 640px) {
  .svc-page__hero-ctas { flex-direction: column; }
  .svc-page__beneficios { grid-template-columns: 1fr; }
}
</style>

<script>
document.querySelectorAll('.svc-page__faq-q').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.svc-page__faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
