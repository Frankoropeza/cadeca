---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Muestras y Prototipos de Cajas de Cartón CDMX — CADECA Fabricante Directo";
const description = "Fabricamos muestras y prototipos de cajas de cartón corrugado en CDMX en 24-72 hrs. Costo descontado del pedido de producción. Valida antes de comprometerte.";
const canonical   = SITE + "/servicios/muestras-prototipos";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Muestras y Prototipos de Cajas de Cartón",
    "description": description,
    "provider": { "@type": "LocalBusiness", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Cuánto cuesta una muestra?", "acceptedAnswer": { "@type": "Answer", "text": "El costo varía según las medidas y material. Cotizamos sin compromiso. Ese costo se descuenta si haces el pedido de producción." } },
    { "@type": "Question", "name": "¿Puedo pedir una muestra sin compromiso de pedido posterior?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, la muestra no obliga a ningún pedido posterior. Es para que tomes la mejor decisión." } },
    { "@type": "Question", "name": "¿Incluyen prueba de resistencia en la muestra?", "acceptedAnswer": { "@type": "Answer", "text": "Podemos incluir prueba de compresión y carga bajo solicitud, especialmente para exportación." } },
    { "@type": "Question", "name": "¿Pueden hacer muestra con mi logo impreso?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, fabricamos muestras con impresión de 1-4 colores para validar el resultado visual antes de la corrida." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios" },
    { name: "Muestras y Prototipos de Cajas de Cartón" },
  ]}
  whatsapp={WHATSAPP}
>

  {/* ════════ HERO ════════ */}
  <section class="hero">
    <div class="container">
      <div class="hero__inner">

        <div class="hero__left">
          <p class="hero__badge">Servicio · Validación antes de producción</p>
          <h1 class="hero__title"><span>Muestras y Prototipos de Cajas de Cartón</span></h1>
          <p class="hero__intro">Fabrica 1-5 piezas de muestra antes de comprometer tu presupuesto. Incluye diseño CAD, fabricación de prototipo y prueba de carga opcional. Costo descontado del pedido final.</p>
          <div class="hero__ctas">
            <a href="/cotizar" class="btn btn--primary btn--lg">Solicitar cotización</a>
            <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+quiero+una+muestra+o+prototipo+de+caja+de+cart%C3%B3n"}
               class="btn btn--outline btn--lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp</a>
          </div>
          <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">24-72 hrs</span>
            <span class="hero__metric-label">Tiempo de muestra</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">1-5</span>
            <span class="hero__metric-label">Piezas de prototipo</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">Descontado</span>
            <span class="hero__metric-label">Del pedido final</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">2 hrs</span>
            <span class="hero__metric-label">Cotización</span>
          </div>
          </div>
        </div>

        <div class="hero__right">
          <p>Antes de producir tu corrida completa, CADECA fabrica <strong>muestras y prototipos de cajas de cartón</strong> para que valides dimensiones, resistencia, impresión y acabado. El proceso incluye diseño CAD, fabricación de 1-5 piezas y prueba de carga si se requiere.</p>
          <p>El costo de la muestra se descuenta del pedido de producción. <strong>Tiempo de entrega de muestras: 24-72 horas</strong> en CDMX. Ideal para cajas nuevas, cambios de diseño y productos con empaques críticos para la experiencia del cliente.</p>
        </div>

      </div>
    </div>
  </section>

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para muestras y prototipos de cajas de cartón"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Diseño CAD incluido — plano técnico de la caja antes de fabricar</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>1-5 piezas de prototipo físico para validación</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Prueba de carga y resistencia disponible bajo solicitud</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Entrega de muestra en 24-72 horas en CDMX</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Costo de muestra descontado del pedido de producción</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Validación de impresión antes de correr el lote completo</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Solicitud de muestra</p>
            <p class="process-step__desc">Envíanos medidas, material y, si aplica, arte de impresión. Cotizamos la muestra al instante.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Diseño y fabricación</p>
            <p class="process-step__desc">Nuestro equipo genera el CAD y fabrica las piezas de muestra en 24-72 horas.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Validación</p>
            <p class="process-step__desc">Recibes la muestra física. Revisas dimensiones, resistencia, impresión y acabado.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Pedido de producción</p>
            <p class="process-step__desc">Con tu aprobación, iniciamos la corrida completa. El costo de muestra se descuenta.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Preguntas frecuentes"
        subtitle={"Todo sobre muestras y prototipos de cajas de cartón"}
      />
      <div class="faq-list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-muestras-prototipos-0">
              <span>¿Cuánto cuesta una muestra?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-muestras-prototipos-0">
              <p>El costo varía según las medidas y material. Cotizamos sin compromiso. Ese costo se descuenta si haces el pedido de producción.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-muestras-prototipos-1">
              <span>¿Puedo pedir una muestra sin compromiso de pedido posterior?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-muestras-prototipos-1">
              <p>Sí, la muestra no obliga a ningún pedido posterior. Es para que tomes la mejor decisión.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-muestras-prototipos-2">
              <span>¿Incluyen prueba de resistencia en la muestra?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-muestras-prototipos-2">
              <p>Podemos incluir prueba de compresión y carga bajo solicitud, especialmente para exportación.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-muestras-prototipos-3">
              <span>¿Pueden hacer muestra con mi logo impreso?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-muestras-prototipos-3">
              <p>Sí, fabricamos muestras con impresión de 1-4 colores para validar el resultado visual antes de la corrida.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Cajas a la Medida"
            desc="Muestra en 24-72 hrs"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas Personalizadas"
            desc="Prototipo con tu logo"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas Personalizadas — CADECA"
            href="/catalogo/cajas-personalizadas-con-logo"
            btnText="Ver producto"
          />
          <ProductCard
            title="Industrial Triple Pared"
            desc="Muestra con prueba de carga"
            imgSrc="/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif"
            imgAlt="Industrial Triple Pared — CADECA"
            href="/catalogo/cajas-industriales-triple-pared"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <LeadCapture
    titulo="Solicita tu muestra o prototipo"
    subtitulo="24-72 horas en CDMX · Costo descontado del pedido · Fabricante directo"
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
