---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout  from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import ProcessStep  from "@/components/ProcessStep.astro";
import FaqItem  from "@/components/FaqItem.astro";
import LeadCapture  from "@/components/LeadCapture.astro";
import PageHero from "@/components/PageHero.astro";

// ── SEO ──────────────────────────────────────────────
const title  = "Servicios de Empaque en Cartón Corrugado CDMX | CADECA";
const description = "Suministro de cajas de cartón corrugado estándar, a la medida y personalizadas para CDMX y Estado de México. Entrega programada según pedido.";

// ── Negocio ───────────────────────────────────────────

// ── Breadcrumbs ──────────────────────────────────────
const breadcrumbs = [
 { name: "Inicio", href: "/" },
 { name: "Servicios" },
];

// ── Schema ────────────────────────────────────────────
const schema = {
 "@context": "https://schema.org",
 "@type": "Service",
 "name": "Servicios de Empaque en Cartón Corrugado CADECA",
 "provider": { "@type": "Organization", "name": "CADECA" },
 "areaServed": [
 "Ciudad de México",
 "Estado de México",
 "Zona Metropolitana del Valle de México",
 ],
 "serviceType": [
 "Fabricación de cajas de cartón corrugado a la medida",
 "Impresión y personalización de empaques",
 "Suministro programado para empresas",
 "Asesoría técnica en empaques",
 "Entrega de cajas de cartón en CDMX y Estado de México",
 "Muestras y prototipos de cajas",
 "Venta al mayoreo de cajas corrugadas",
 "Consultoría de packaging",
 ],
};

// ── Servicios principales ─────────────────────────────
const servicios = [
 {
 title: "Fabricación a la Medida",
 short: "Cualquier dimensión exacta según pedido",
 desc: "Coordinamos cualquier medida (largo × ancho × alto en cm) con talleres especializados. Flautas B, C, E y BC. Resistencia ECT seleccionada por producto. Diseño CAD incluido según pedido.",
 href: "/servicios/fabricacion-cajas-medida/",
 tags: ["Simple · Doble · Triple pared", "Diseño CAD incluido", "Desde 50 piezas"],
 badge: "Especialidad",
 },
 {
 title: "Impresión y Personalización",
 short: "Branding profesional desde 100 piezas",
 desc: "Impresión flexográfica y digital en 1 hasta 4 colores o full color. Tintas base agua. Acabados mate, brillante y barniz UV. Prueba de diseño digital sin costo antes de producción.",
 href: "/servicios/impresion-cajas-personalizadas/",
 tags: ["Full color digital", "Tintas base agua", "Prueba de diseño gratis"],
 badge: "Popular",
 },
 {
 title: "Suministro Programado",
 short: "Inventario administrado para empresas",
 desc: "Contrato de suministro mensual o trimestral con inventario reservado. Órdenes de reposición automática. Ideal para plantas manufactureras, distribuidoras y e-commerce de alto volumen.",
 href: "/servicios/suministro-programado/",
 tags: ["Inventario reservado", "Reposición automática", "Precio fijo por contrato"],
 badge: "B2B",
 },
 {
 title: "Asesoría Técnica Gratuita",
 short: "El empaque correcto para cada producto",
 desc: "Te ayudamos a elegir flauta, número de paredes, resistencia ECT, gramaje y tipo de cierre. Analizamos peso del producto, condiciones de almacenamiento, transporte y normativas aplicables.",
 href: "/servicios/asesoria-tecnica/",
 tags: ["Sin costo", "Por WhatsApp o visita", "Asesoría para elegir"],
 badge: "Gratis",
 },
 {
 title: "Entrega a Domicilio",
 short: "CDMX y Estado de México con entrega programada",
 desc: "Coordinamos la entrega en bodega, planta o domicilio según zona y volumen. Seguimiento de pedido y factura electrónica incluidos.",
 href: "/servicios/entrega-domicilio-cdmx/",
 tags: ["CDMX completa", "14 zonas Estado de México", "Seguimiento en tiempo real"],
 badge: "Programado",
 },
 {
 title: "Cotización Exprés",
 short: "Respuesta en horario hábil",
 desc: "Envíanos medidas, cantidad y tipo de caja. Te respondemos en horario hábil con precio, tiempo de entrega y opciones técnicas.",
 href: "/servicios/cotizacion-express/",
 tags: ["WhatsApp · Email", "Propuesta detallada", "Sin compromiso"],
 badge: "Rápido",
 },
 {
 title: "Muestras y Prototipos",
 short: "Toca y aprueba antes de producir",
 desc: "Coordinamos prototipos físicos de tu caja a la medida o personalizada antes del pedido definitivo. Verificación de resistencia, impresión y ensamble. Envío de muestra a tu oficina.",
 href: "/servicios/muestras-prototipos/",
 tags: ["Prototipo físico", "Prueba de resistencia", "Envío incluido"],
 badge: "Nuevo",
 },
 {
 title: "Packaging Ecológico",
 short: "Material reciclado y FSC según pedido",
 desc: "Cajas con cartón reciclado posconsumo y tintas base agua. Si necesitas certificación FSC, confirmamos disponibilidad y documentación con el fabricante.",
 href: "/servicios/packaging-ecologico/",
 tags: ["FSC según pedido", "Reciclado posconsumo", "Documentación disponible"],
 badge: "Sostenible",
 },
];

// ── Capacidades ───────────────────────────────────────
const capacidades = [
 { valor: "50+", label: "Medidas estándar en stock" },
 { valor: "Programada", label: "Entrega en CDMX" },
 { valor: "Horario hábil", label: "Respuesta a cotización" },
 { valor: "Según pedido", label: "Volumen y entrega" },
 { valor: "FSC", label: "Disponible según pedido" },
 { valor: "1 pza", label: "Pedido mínimo en estándar" },
];

// ── Proceso ───────────────────────────────────────────
const pasos = [
 { num: 1, title: "Nos cuentas tu necesidad",  desc: "Escríbenos por WhatsApp o llena el formulario. Nos dices el tipo de caja, medidas, cantidad y si necesitas personalización." },
 { num: 2, title: "Recibimos propuesta técnica", desc: "Te respondemos en horario hábil con cotización, precio, tiempo de entrega, especificaciones técnicas y opciones de material." },
 { num: 3, title: "Apruebas diseño o muestra",  desc: "Para personalizadas: prueba de diseño digital gratis. Para cajas a la medida: prototipo físico si lo requieres." },
 { num: 4, title: "Coordinación y entrega",  desc: "Confirmamos materiales, especificaciones y fecha de entrega según el pedido. Entrega en tu bodega, planta o domicilio." },
];

// ── FAQs ──────────────────────────────────────────────
const faqs = [
 {
 id: "s1",
 question: "¿Qué información necesitan para cotizar cajas a la medida?",
 answer: "Solo necesitamos: medidas interiores (largo × ancho × alto en cm), número de paredes deseado (simple, doble o triple), cantidad aproximada y tipo de producto que vas a empacar. Con eso preparamos la propuesta técnica en horario hábil.",
 },
 {
 id: "s2",
 question: "¿Cuál es el tiempo de producción de cajas personalizadas con logo?",
 answer: "Para cajas personalizadas con logo el tiempo es de 3 a 5 días hábiles tras la aprobación de la prueba de diseño digital. Si tienes una fecha de entrega específica, cuéntanosla y buscamos la solución más rápida.",
 },
 {
 id: "s3",
 question: "¿Hacen muestras o prototipos antes del pedido en firme?",
 answer: "Sí. Para pedidos a la medida o personalizados coordinamos prototipos físicos antes de la producción total. Puedes revisar resistencia, ensamble e impresión. El costo del prototipo se puede abonar al pedido definitivo según cotización.",
 },
 {
 id: "s4",
 question: "¿Qué es el suministro programado y cómo funciona?",
 answer: "Es un contrato donde reservamos capacidad de producción e inventario para tu empresa con entregas periódicas (semanales, quincenales o mensuales). Acordamos el precio y la reposición conforme a las condiciones del contrato, sin necesidad de cotizar cada vez.",
 },
 {
 id: "s5",
 question: "¿Tienen asesoría técnica para elegir el tipo de cartón corrugado?",
 answer: "Sí, completamente gratuita. Nuestro equipo analiza el peso de tu producto, condiciones de transporte, apilamiento en bodega y cualquier norma aplicable (COFEPRIS, normas de exportación) para recomendarte el ECT, flauta y número de paredes correcto.",
 },
 {
 id: "s6",
 question: "¿Entregan fuera de CDMX y Estado de México?",
 answer: "Nuestra cobertura directa es CDMX y Estado de México. Para pedidos en otras ciudades de la república coordinamos el envío con paqueterías (DHL, Estafeta, FedEx). Contáctanos para cotización de flete según destino y volumen.",
 },
 {
 id: "s7",
 question: "¿Emiten factura electrónica?",
 answer: "Sí. Toda orden genera factura electrónica (CFDI) automáticamente. Aceptamos pago en efectivo, transferencia bancaria (SPEI) y tarjeta de crédito/débito empresarial. Para empresas con contrato ofrecemos crédito a 30 días.",
 },
];
---

<PageLayout
 title={title}
 description={description}
 pageType="page"
 breadcrumbs={breadcrumbs}
 schema={schema}
 faqItems={faqs.map(f => ({ question: f.question, answer: f.answer }))}
>

 <!-- ══════════════════════════════════════
 HERO
 ══════════════════════════════════════ -->
 <PageHero
   eyebrow="Servicio · Empaque de cartón"
   titleHtml={true}
   title="Servicios de empaque de <span>cartón corrugado</span>"
   desc="Servicios de empaque de cartón para empresas que requieren cajas estándar, a la medida o personalizadas. Incluyen asesoría para definir el empaque y coordinación de suministro en CDMX y Estado de México."
   desc2="Los servicios cubren <strong>cajas de cartón corrugado</strong> estándar, a la medida e impresas, además de muestras, entrega y suministro programado. Se revisan flauta, resistencia ECT, medidas y tipo de sellado según el producto, su almacenaje y el destino de uso.||CADECA surte como proveedor mediante talleres y fabricantes aliados. Indica medidas, cantidad, uso y zona de entrega al solicitar opciones; te damos asesoría para elegir entre los <strong>empaques de cartón</strong> disponibles."
 />

 <!-- CTA Band -->
 <div class="cta-band">
 <div class="container">
 <div>
 <p class="cta-band__text">¿No sabes qué tipo de caja necesitas?</p>
 <p class="cta-band__sub">Te asesoramos gratis. Cuéntanos tu producto y nosotros te decimos el empaque ideal.</p>
 </div>
 {HAS_WA && (
<a href={contactoHref()} class="btn btn--white" {...contactoAttrs}>
 Asesoría por WhatsApp
 </a>
)}
 </div>
 </div>

 <!-- ══════════════════════════════════════
 MAIN
 ══════════════════════════════════════ -->
 <main id="contenido-principal" role="main">

 <!-- Capacidades numéricas -->
 <section class="svc-metrics" aria-label="Capacidades y métricas de CADECA">
 <div class="container">
 <div class="svc-metrics__grid">
 {capacidades.map(c => (
 <div class="svc-metrics__item">
 <span class="svc-metrics__valor">{c.valor}</span>
 <span class="svc-metrics__label">{c.label}</span>
 </div>
 ))}
 </div>
 </div>
 </section>

 <!-- Servicios: grid principal -->
 <section class="svc-list" id="servicios" aria-labelledby="svc-list-title">
 <div class="container">
 <SectionHeader
 id="svc-list-title"
 twoCol
 title="Todos los Servicios de CADECA: De la Cotización a la Entrega"
 subtitle="Un solo proveedor para todas tus necesidades de empaque en cartón corrugado"
 link={{ text: "Solicitar cotización", href: "/cotizar/" }}
 >
 <p>Construimos relaciones a largo plazo con nuestros clientes porque entendemos que el empaque no es un gasto: es una herramienta estratégica que impacta en la protección del producto, la experiencia del cliente y la imagen de tu marca.</p>
 <p>Desde pedidos pequeños hasta operaciones industriales, cada cliente recibe atención técnica y servicio personalizado según sus necesidades.</p>
 </SectionHeader>

 <div class="svc-list__grid">
 {servicios.map(s => (
 <article class="svc-card" aria-label={`Servicio: ${s.title}`}>
 <div class="svc-card__header">
 <span class="svc-card__badge">{s.badge}</span>
 </div>
 <h3 class="svc-card__title">{s.title}</h3>
 <p class="svc-card__short">{s.short}</p>
 <p class="svc-card__desc">{s.desc}</p>
 <ul class="svc-card__tags">
 {s.tags.map(tag => (
 <li class="svc-card__tag">{tag}</li>
 ))}
 </ul>
 <a href={s.href} class="svc-card__link">
 Más información
 </a>
 </article>
 ))}
 </div>
 </div>
 </section>

 <!-- Feature: Fabricación a la Medida -->
 <section class="svc-feature" aria-labelledby="feature-medida-title">
 <div class="container">
 <div class="svc-feature__inner svc-feature__inner--alt">
 <div class="svc-feature__content">
 <span class="svc-feature__eyebrow">Servicio Estrella</span>
 <h2 id="feature-medida-title" class="svc-feature__title">
 Fabricación a la Medida: Cada Milímetro Importa
 </h2>
 <p class="svc-feature__text">
 No todos los productos caben en una caja estándar. Coordinamos cajas en exactamente las dimensiones que tu producto necesita: sin espacio muerto, sin material de relleno innecesario y con el calibre de corrugado exacto para soportar el peso y el transporte.
 </p>
 <p class="svc-feature__text">
 Nuestro proceso CAD busca una precisión de ±2 mm. Seleccionamos la flauta correcta —B para resistencia, C para equilibrio, E para productos ligeros, BC para triple pared industrial— y calculamos el ECT mínimo requerido según el peso del producto y el apilamiento en bodega.
 </p>
 <div class="svc-feature__bullets">
 <div class="svc-feature__bullet">
 Diseño CAD sin costo adicional
 </div>
 <div class="svc-feature__bullet">
 Flautas B, C, E, BC y doble pared
 </div>
 <div class="svc-feature__bullet">
 Desde 50 piezas · Sin cargo por medidas especiales
 </div>
 <div class="svc-feature__bullet">
 Prototipo físico disponible antes de producir
 </div>
 <div class="svc-feature__bullet">
 Entrega según volumen y zona
 </div>
 </div>
 <a href="/catalogo/cajas-a-la-medida/" class="btn btn--primary">Ver cajas a la medida</a>
 </div>
 <div class="svc-feature__visual">
 <div class="svc-feature__specs-card">
 <h4 class="svc-feature__specs-title">¿Qué información necesitamos?</h4>
 <div class="svc-feature__spec-row">
 <span class="svc-feature__spec-label"> Medidas interiores</span>
 <span class="svc-feature__spec-val">Largo × Ancho × Alto (cm)</span>
 </div>
 <div class="svc-feature__spec-row">
 <span class="svc-feature__spec-label">Peso del contenido</span>
 <span class="svc-feature__spec-val">En kg por unidad</span>
 </div>
 <div class="svc-feature__spec-row">
 <span class="svc-feature__spec-label"> Cantidad inicial</span>
 <span class="svc-feature__spec-val">Mínimo 50 piezas</span>
 </div>
 <div class="svc-feature__spec-row">
 <span class="svc-feature__spec-label"> Condiciones de envío</span>
 <span class="svc-feature__spec-val">Terrestre / aéreo / export</span>
 </div>
 <div class="svc-feature__spec-row">
 <span class="svc-feature__spec-label"> Apilamiento bodega</span>
 <span class="svc-feature__spec-val">Niveles de arrumado</span>
 </div>
 <a href="/cotizar/" class="svc-feature__spec-cta">
 Cotizar ahora
 </a>
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- Feature: Personalización -->
 <section class="svc-feature svc-feature--dark" aria-labelledby="feature-logo-title">
 <div class="container">
 <div class="svc-feature__inner">
 <div class="svc-feature__content">
 <span class="svc-feature__eyebrow" style="color:var(--color-primary-light)">Branding & Marketing</span>
 <h2 id="feature-logo-title" class="svc-feature__title" style="color:white">
 Impresión Profesional: Tu Marca en Cada Caja
 </h2>
 <p class="svc-feature__text" style="color:rgba(255,255,255,0.8)">
 El empaque es el primer contacto físico entre tu cliente y tu producto. Una caja personalizada bien diseñada refuerza la percepción de calidad, genera experiencias de unboxing memorables y construye reconocimiento de marca sin costo adicional de marketing.
 </p>
 <p class="svc-feature__text" style="color:rgba(255,255,255,0.8)">
 Ofrecemos impresión flexográfica de alta definición en 1 a 4 colores Pantone o full color digital para tiradas más cortas. Tintas 100% base agua, seguras para alimentos y respetuosas con el medio ambiente.
 </p>
 <div class="svc-feature__options">
 <div class="svc-feature__option">
 <span class="svc-feature__option-title">1–2 Colores</span>
 <span class="svc-feature__option-desc">Ideal para logotipos simples. Precio más accesible. Desde 100 piezas.</span>
 </div>
 <div class="svc-feature__option">
 <span class="svc-feature__option-title">3–4 Colores Pantone</span>
 <span class="svc-feature__option-desc">Colores precisos con guía Pantone. Para marcas con identidad definida.</span>
 </div>
 <div class="svc-feature__option">
 <span class="svc-feature__option-title">Full Color Digital</span>
 <span class="svc-feature__option-desc">Fotografías, gradientes, diseños complejos. Perfecto para e-commerce y retail.</span>
 </div>
 <div class="svc-feature__option">
 <span class="svc-feature__option-title">Acabados Especiales</span>
 <span class="svc-feature__option-desc">Barniz UV, laminado mate o brillante, relieve. Para packaging premium.</span>
 </div>
 </div>
 <a href="/catalogo/cajas-personalizadas-logo/" class="btn btn--primary">Ver opciones de impresión</a>
 </div>

 <div class="svc-feature__visual">
 <div class="svc-feature__timeline">
 <div class="svc-feature__tl-item">
 <div class="svc-feature__tl-dot"></div>
 <div class="svc-feature__tl-content">
 <span class="svc-feature__tl-title">Día 0 — Envías tu diseño</span>
 <span class="svc-feature__tl-desc">PDF, AI, EPS o PNG en alta resolución. Te confirmamos en 1 hora.</span>
 </div>
 </div>
 <div class="svc-feature__tl-item">
 <div class="svc-feature__tl-dot"></div>
 <div class="svc-feature__tl-content">
 <span class="svc-feature__tl-title">Día 0–1 — Prueba digital gratis</span>
 <span class="svc-feature__tl-desc">Visualización realista de tu caja con el diseño aplicado. Correcciones sin costo.</span>
 </div>
 </div>
 <div class="svc-feature__tl-item">
 <div class="svc-feature__tl-dot"></div>
 <div class="svc-feature__tl-content">
 <span class="svc-feature__tl-title">Día 1–2 — Aprobas y entra a producción</span>
 <span class="svc-feature__tl-desc">Con tu confirmación iniciamos producción inmediatamente.</span>
 </div>
 </div>
 <div class="svc-feature__tl-item">
 <div class="svc-feature__tl-dot svc-feature__tl-dot--last"></div>
 <div class="svc-feature__tl-content">
 <span class="svc-feature__tl-title">Día 3–5 — Entrega en tu puerta</span>
 <span class="svc-feature__tl-desc">Con factura electrónica. Control de calidad por lote antes de despachar.</span>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </section>

 <!-- Proceso -->
 <section class="process" aria-labelledby="proceso-title">
 <div class="container">
 <SectionHeader
 id="proceso-title"
 title="¿Cómo Funciona Trabajar con CADECA?"
 subtitle="Simple, transparente y sin sorpresas — del primer contacto a la entrega"
 />
 <div class="process__grid">
 {pasos.map(p => <ProcessStep {...p} />)}
 </div>
 </div>
 </section>

 <!-- Sectores atendidos -->
 <section class="svc-sectores" aria-labelledby="sectores-title">
 <div class="container">
 <SectionHeader
 id="sectores-title"
 twoCol
 title="Sectores que Atendemos en CDMX y Estado de México"
 subtitle="Experiencia sectorial que marca la diferencia en especificaciones técnicas y tiempos"
 >
 <p>Cada industria tiene requisitos distintos: el e-commerce necesita velocidad y medidas compatibles con paqueterías; la industria alimentaria requiere materiales aptos para contacto con alimentos; y el sector industrial exige documentación técnica completa para auditorías de proveedor.</p>
 <p>En CADECA conocemos estos requerimientos de primera mano y los incorporamos desde la primera cotización.</p>
 </SectionHeader>

 <div class="svc-sectores__grid">
 {[
 { titulo: "E-commerce & Marketplaces", desc: "Mercado Libre, Amazon MX, TikTok Shop, Shopify, WooCommerce. Medidas compatibles con todas las paqueterías. Entrega programada.", href: "/catalogo/cajas-para-ecommerce/" },
 { titulo: "Manufactura & Nearshoring", desc: "Parques industriales de Naucalpan, Tlalnepantla, Lerma, Cuautitlán. Alta resistencia ECT, documentación de proveedor, grandes volúmenes.", href: "/catalogo/cajas-a-la-medida/" },
 { titulo: "Alimentos & Restaurantes", desc: "Dark kitchens, pastelerías, productores orgánicos, exportación. Materiales aptos COFEPRIS, resistentes a humedad y grasa.", href: "/catalogo/cajas-para-alimentos/" },
 { titulo: "Farmacéutica & Cosmética", desc: "Cajas para laboratorios, distribuidoras y marcas de cosméticos. Precisión en medidas, acabados premium y trazabilidad de lote.", href: "/catalogo/cajas-farmaceutica-cosmetica/" },
 { titulo: "Retail, Moda & Textil", desc: "Marcas de ropa, calzado, accesorios y moda rápida. Cajas de presentación con impresión premium y experiencia de unboxing.", href: "/catalogo/cajas-textil-moda-retail/" },
 { titulo: "Archivo & Almacenaje", desc: "Cajas de archivo para corporativos, despachos y almacenes. Alta resistencia al apilamiento, tapa-fondo y medidas oficio y carta.", href: "/catalogo/cajas-archivo-almacenaje/" },
 ].map(s => (
 <a href={s.href} class="svc-sector-card" aria-label={`Sector: ${s.titulo}`}>
 <h3 class="svc-sector-card__title">{s.titulo}</h3>
 <p class="svc-sector-card__desc">{s.desc}</p>
 <span class="svc-sector-card__link">Ver solución</span>
 </a>
 ))}
 </div>
 </div>
 </section>

 <!-- Trust -->
 <section class="trust" aria-labelledby="trust-svc-title">
 <div class="container">
 <SectionHeader
 id="trust-svc-title"
 twoCol
 title="Por Qué CADECA es un Proveedor de Empaques para CDMX"
 subtitle="Suministro coordinado, asesoría y cobertura metropolitana"
 >
 <p>Elegir un fabricante local sobre un distribuidor nacional tiene ventajas reales y medibles: precios sin margen de intermediario, plazos de producción más cortos, capacidad de atender urgencias y un interlocutor técnico que conoce tu operación.</p>
 <p>CADECA atiende desde la Ciudad de México con suministro coordinado, revisión de disponibilidad y entregas programadas para la zona metropolitana.</p>
 </SectionHeader>

 <div class="trust__grid">
 <div class="trust__item">
 <h3 class="trust__item-title">Suministro coordinado</h3>
 <p class="trust__item-desc">Trabajamos con talleres y fabricantes aliados para coordinar materiales, producción y entrega según tu pedido.</p>
 </div>
 <div class="trust__item">
 <h3 class="trust__item-title">Respuesta en horario hábil</h3>
 <p class="trust__item-desc">Recibimos tus medidas y cantidad, y te respondemos con precio, opciones de material, tiempo de entrega y condiciones.</p>
 </div>
 <div class="trust__item">
 <h3 class="trust__item-title">Disponibilidad según pedido</h3>
 <p class="trust__item-desc">Revisamos la disponibilidad de cajas estándar y coordinamos la entrega según el pedido y la zona.</p>
 </div>
 <div class="trust__item">
 <h3 class="trust__item-title">Asesoría Técnica Real</h3>
