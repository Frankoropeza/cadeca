---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Entrega de Cajas de Cartón a Domicilio CDMX — 24 hrs · CADECA Fabricante Directo";
const description = "Entregamos cajas de cartón corrugado a domicilio en CDMX y Estado de México en 24-48 hrs. Flota propia, rutas diarias, sin costo de flete en pedidos mínimos.";
const canonical   = SITE + "/servicios/entrega-domicilio-cdmx";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Entrega de Cajas de Cartón a Domicilio en CDMX",
    "description": description,
    "provider": { "@type": "LocalBusiness", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Cuánto cuesta el flete?", "acceptedAnswer": { "@type": "Answer", "text": "Sin costo en pedidos que cumplan el mínimo de entrega. Contáctanos para conocer el mínimo según tu zona." } },
    { "@type": "Question", "name": "¿Cubren toda la CDMX?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, las 16 alcaldías de CDMX más los principales municipios del Estado de México." } },
    { "@type": "Question", "name": "¿Puedo programar la entrega para un horario específico?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, coordinamos el horario con 24 hrs de anticipación según disponibilidad de rutas." } },
    { "@type": "Question", "name": "¿Entregan en planta con acceso restringido?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, coordinamos con tu equipo de recepción para cumplir con los requisitos de acceso." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios" },
    { name: "Entrega de Cajas de Cartón a Domicilio en CDMX" },
  ]}
  whatsapp={WHATSAPP}
>

  {/* ════════ HERO ════════ */}
  <section class="hero">
    <div class="container">
      <div class="hero__inner">

        <div class="hero__left">
          <p class="hero__badge">Servicio · Entrega 24-48 hrs · Flota Propia</p>
          <h1 class="hero__title"><span>Entrega de Cajas de Cartón a Domicilio en CDMX</span></h1>
          <p class="hero__intro">Flota propia con rutas diarias en toda la CDMX y Zona Metropolitana. Entregamos en tu planta, bodega o domicilio en 24-48 horas sin costo de flete en pedidos calificados.</p>
          <div class="hero__ctas">
            <a href="/cotizar" class="btn btn--primary btn--lg">Solicitar cotización</a>
            <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+quiero+informaci%C3%B3n+sobre+Entrega+a+Domicilio+en+CDMX"}
               class="btn btn--outline btn--lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp</a>
          </div>
          <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">24 hrs</span>
            <span class="hero__metric-label">Entrega exprés</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">Sin costo</span>
            <span class="hero__metric-label">Flete pedidos calif.</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">16</span>
            <span class="hero__metric-label">Alcaldías cubiertas</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">2 hrs</span>
            <span class="hero__metric-label">Cotización</span>
          </div>
          </div>
        </div>

        <div class="hero__right">
          <p>CADECA ofrece <strong>entrega de cajas de cartón a domicilio en CDMX y Estado de México</strong> con flota propia y rutas cubiertas diariamente. Entregamos en 24-48 horas en toda la Zona Metropolitana: Naucalpan, Tlalnepantla, Ecatepec, Toluca, Iztapalapa, Coyoacán y las 16 alcaldías.</p>
          <p>Sin costo de flete en pedidos superiores al mínimo establecido. Seguimiento de tu pedido en tiempo real, confirmación de entrega y horarios flexibles para bodegas y plantas industriales. <strong>Fabricante directo con entrega directa</strong> — sin intermediarios.</p>
        </div>

      </div>
    </div>
  </section>

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para entrega de cajas de cartón a domicilio en cdmx"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Flota propia — sin tercerizar la logística</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>24-48 horas en CDMX y Estado de México</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Sin costo de flete en pedidos calificados</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Horarios flexibles para bodegas y plantas industriales</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Seguimiento en tiempo real de tu pedido</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Confirmación de entrega con evidencia fotográfica</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Pedido</p>
            <p class="process-step__desc">Haces tu pedido por WhatsApp, teléfono o formulario. Confirmas dirección y horario.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Fabricación</p>
            <p class="process-step__desc">Tu pedido entra a producción o se despacha de stock. Recibes confirmación de fecha.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Carga</p>
            <p class="process-step__desc">El día de entrega cargamos tu pedido en nuestra flota y te enviamos ETA.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Entrega</p>
            <p class="process-step__desc">Entregamos en tu domicilio. Firmamos remisión y te enviamos confirmación con foto.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Preguntas frecuentes"
        subtitle={"Todo sobre entrega de cajas de cartón a domicilio en cdmx"}
      />
      <div class="faq-list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-entrega-domicilio-cdmx-0">
              <span>¿Cuánto cuesta el flete?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-entrega-domicilio-cdmx-0">
              <p>Sin costo en pedidos que cumplan el mínimo de entrega. Contáctanos para conocer el mínimo según tu zona.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-entrega-domicilio-cdmx-1">
              <span>¿Cubren toda la CDMX?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-entrega-domicilio-cdmx-1">
              <p>Sí, las 16 alcaldías de CDMX más los principales municipios del Estado de México.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-entrega-domicilio-cdmx-2">
              <span>¿Puedo programar la entrega para un horario específico?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-entrega-domicilio-cdmx-2">
              <p>Sí, coordinamos el horario con 24 hrs de anticipación según disponibilidad de rutas.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-entrega-domicilio-cdmx-3">
              <span>¿Entregan en planta con acceso restringido?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-entrega-domicilio-cdmx-3">
              <p>Sí, coordinamos con tu equipo de recepción para cumplir con los requisitos de acceso.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Corrugado Estándar"
            desc="Entrega 24 hrs en CDMX"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar — CADECA"
            href="/catalogo/cajas-corrugado-estandar"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Entrega directa en tu planta"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas E-commerce"
            desc="Para fulfillment y envíos"
            imgSrc="/img/productos/cajas-de-carton-para-ecommerce-mercado-libre-amazon-cdmx.avif"
            imgAlt="Cajas E-commerce — CADECA"
            href="/catalogo/cajas-ecommerce-mercado-libre"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <LeadCapture
    titulo="Programa tu entrega de cajas a domicilio"
    subtitulo="24-48 hrs en CDMX · Flota propia · Sin costo de flete en pedidos calificados"
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
