---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageHero from "@/components/PageHero.astro";
const SITE     = "https://cajas-de-carton.com";

const title       = "Entrega de Cajas de Cartón a Domicilio CDMX — CADECA";
const description = "Entrega programada de cajas de cartón corrugado a domicilio en CDMX y Estado de México, según volumen, zona y disponibilidad de rutas.";
const canonical   = SITE + "/servicios/entrega-domicilio-cdmx/";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Entrega de Cajas de Cartón a Domicilio en CDMX",
    "description": description,
    "provider": { "@type": "Organization", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    get mainEntity() { return faqsModulo.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })); },
  }
];
const faqsModulo = [
 {
  "question": "¿Cuánto cuesta el flete?",
  "answer": "Sin costo en pedidos que cumplan el mínimo de entrega. Contáctanos para conocer el mínimo según tu zona."
 },
 {
  "question": "¿Cubren toda la CDMX?",
  "answer": "Sí, las 16 alcaldías de CDMX más los principales municipios del Estado de México."
 },
 {
  "question": "¿Puedo programar la entrega para un horario específico?",
  "answer": "Sí, coordinamos el horario de entrega según disponibilidad de rutas y lo confirmamos al cotizar."
 },
 {
  "question": "¿Entregan en planta con acceso restringido?",
  "answer": "Indica en el formulario los requisitos de acceso, horario de recepción y datos de contacto del destino. Esa información permite revisar la coordinación necesaria con la ruta disponible y confirmar las condiciones de entrega antes de programarla."
 },
 { "question": "¿Cómo se calculan las condiciones de entrega de cajas en CDMX?", "answer": "Las condiciones se revisan con base en volumen, medidas de los paquetes, zona de destino y ruta disponible. Incluye la dirección completa y la cantidad de cajas en el formulario para confirmar flete, fecha y requisitos de recepción al cotizar." }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Entrega de Cajas de Cartón a Domicilio en CDMX" },
  ]}
>

  {/* ════════ HERO ════════ */}
  <PageHero
    eyebrow="Servicio · Entrega a domicilio"
    titleHtml={true}
    title="Cajas de cartón a domicilio <span>en CDMX</span>"
    desc="Cajas de cartón a domicilio en CDMX para bodegas, plantas y negocios que requieren entrega coordinada. También revisamos entregas en Estado de México según volumen y zona."
    desc2="La entrega se coordina para <strong>cajas de cartón a domicilio en CDMX</strong> según volumen, zona y ruta disponible. La cobertura incluye las 16 alcaldías y municipios como Naucalpan, Tlalnepantla, Ecatepec y Toluca, con destino a bodegas, plantas o domicilios.||Para coordinar una entrega, el volumen de bultos, la alcaldía o municipio y las condiciones de recepción son determinantes. Indica número de cajas, medidas de los paquetes, dirección completa y horario de recepción; CADECA revisa la <strong>entrega de cajas en Estado de México</strong> o CDMX."
  />

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para entrega de cajas de cartón a domicilio en cdmx"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span>Flota propia — sin tercerizar la logística</span>
          </li>
          <li class="feature-item">
            <span>Fecha de entrega según pedido y zona</span>
          </li>
          <li class="feature-item">
            <span>Sin costo de flete en pedidos calificados</span>
          </li>
          <li class="feature-item">
            <span>Horarios flexibles para bodegas y plantas industriales</span>
          </li>
          <li class="feature-item">
            <span>Seguimiento en tiempo real de tu pedido</span>
          </li>
          <li class="feature-item">
            <span>Confirmación de entrega con evidencia fotográfica</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Pedido</p>
            <p class="process-step__desc">Haces tu pedido por WhatsApp, teléfono o formulario. Confirmas dirección y horario.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Fabricación</p>
            <p class="process-step__desc">Tu pedido entra a producción o se despacha de stock. Recibes confirmación de fecha.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Carga</p>
            <p class="process-step__desc">El día de entrega cargamos tu pedido en nuestra flota y te enviamos ETA.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Entrega</p>
            <p class="process-step__desc">Entregamos en tu domicilio. Firmamos remisión y te enviamos confirmación con foto.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Corrugado Estándar"
            desc="Entrega programada en CDMX"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar — CADECA"
            href="/catalogo/cajas-corrugado-estandar/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Entrega directa en tu planta"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas E-commerce"
            desc="Para fulfillment y envíos"
            imgSrc="/img/productos/cajas-de-carton-para-ecommerce-mercado-libre-amazon-cdmx.avif"
            imgAlt="Cajas E-commerce — CADECA"
            href="/catalogo/cajas-para-ecommerce/mercado-envios/"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <FaqCotizacion faqs={faqsModulo} tema="cajas de cartón a domicilio en CDMX" />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    if (!item) return;
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
