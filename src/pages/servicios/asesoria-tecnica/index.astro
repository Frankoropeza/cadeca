---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageHero from "@/components/PageHero.astro";
const SITE     = "https://cajas-de-carton.com";

const title       = "Asesoría Técnica Gratuita de Empaque CDMX — CADECA";
const description = "Asesoría técnica gratuita para seleccionar la caja de cartón correcta para tu producto en CDMX. Flauta, calibre, resistencia ECT, dimensiones.";
const canonical   = SITE + "/servicios/asesoria-tecnica/";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Asesoría Técnica Gratuita de Empaque",
    "description": description,
    "provider": { "@type": "Organization", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    get mainEntity() { return faqsModulo.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })); },
  }
];
const faqsModulo = [
 {
  "question": "¿De verdad es gratis la asesoría?",
  "answer": "La asesoría se ofrece sin costo para revisar las necesidades de empaque antes de cotizar. Comparte las características del producto, su manejo y el destino para evaluar medidas, flauta, resistencia ECT y sellado con base en el uso previsto."
 },
 {
  "question": "¿Qué información necesito tener lista?",
  "answer": "Ten disponibles las dimensiones y peso del producto, tipo de almacenaje, forma de envío y cantidad requerida. También ayuda indicar si necesita impresión, apilado o protección adicional, porque esos factores influyen en la estructura y resistencia del cartón."
 },
 {
  "question": "¿Cuánto tarda en responder?",
  "answer": "La solicitud se revisa en horario hábil con la información disponible del producto y del pedido. Si requiere varias medidas, impresión o una estructura especial, pueden ser necesarias precisiones técnicas antes de confirmar las alternativas de cotización."
 },
 {
  "question": "¿Puedo pedir asesoría para un solo producto?",
  "answer": "La asesoría puede partir de un producto o de varias referencias. Comparte sus dimensiones, peso, forma de manejo y destino para revisar qué combinación de medidas, flauta, resistencia ECT y sellado corresponde al uso previsto."
 },
 { "question": "¿Cómo se elige la flauta para una caja de cartón?", "answer": "La flauta se define según el peso, fragilidad, apilado y forma de traslado del producto. Las flautas B, C y E ofrecen perfiles distintos de rigidez y amortiguación; la selección debe considerar también las dimensiones y el tipo de sellado." }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Asesoría Técnica Gratuita de Empaque" },
  ]}
>

  {/* ════════ HERO ════════ */}
  <PageHero
    eyebrow="Servicio · Asesoría técnica"
    titleHtml={true}
    title="Asesoría de empaque <span>para tu producto</span>"
    desc="Asesoría de empaque para elegir la caja de cartón según producto, peso y manejo. Revisamos flauta, calibre, medidas, resistencia ECT y tipo de sellado antes de cotizar."
    desc2="La <strong>asesoría de empaque</strong> revisa el producto, su almacenaje y destino para definir dimensiones, flauta, calibre y sellado. Con esos datos es posible <strong>elegir caja de cartón</strong> con la resistencia necesaria y evitar una especificación que no corresponda al uso.||CADECA coordina alternativas con talleres y fabricantes aliados como proveedor. Comparte medidas, cantidad, uso y zona de entrega; te orientamos sobre la <strong>resistencia ECT</strong> y la caja disponible para cotizar."
  />

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para asesoría técnica gratuita de empaque"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span>Selección de flauta óptima según peso y uso del producto</span>
          </li>
          <li class="feature-item">
            <span>Cálculo de resistencia ECT para apilamiento y transporte</span>
          </li>
          <li class="feature-item">
            <span>Recomendación de dimensiones para minimizar material</span>
          </li>
          <li class="feature-item">
            <span>Análisis de tipo de sellado: pegamento, grapa, cinta</span>
          </li>
          <li class="feature-item">
            <span>Reducción de mermas y daños en tránsito como objetivo de asesoría</span>
          </li>
          <li class="feature-item">
            <span>Completamente gratuito — sin compromiso de compra</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Cuéntanos tu caso</p>
            <p class="process-step__desc">Envíanos fotos o descripción de tu producto, cómo lo almacenas y a dónde lo envías.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Análisis</p>
            <p class="process-step__desc">Nuestro equipo de ingeniería analiza las necesidades reales de tu empaque.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Recomendación</p>
            <p class="process-step__desc">Te enviamos una propuesta técnica con materiales, dimensiones y resistencia recomendados.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Cotización</p>
            <p class="process-step__desc">Si te convence la propuesta, cotizamos sin compromiso. Si no, no pasa nada.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Cajas a la Medida"
            desc="Diseño CAD incluido"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Corrugado Estándar"
            desc="Asesoría de flauta y ECT"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar — CADECA"
            href="/catalogo/cajas-corrugado-estandar/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Industrial Triple Pared"
            desc="Para exportación y manufactura"
            imgSrc="/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif"
            imgAlt="Industrial Triple Pared — CADECA"
            href="/catalogo/cajas-corrugado-estandar/triple-corrugado/"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <FaqCotizacion faqs={faqsModulo} tema="asesoría de empaque" />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    if (!item) return;
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
