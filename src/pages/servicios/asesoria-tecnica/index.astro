---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Asesoría Técnica Gratuita de Empaque CDMX — CADECA Fabricante Directo";
const description = "Asesoría técnica gratuita para seleccionar la caja de cartón correcta para tu producto en CDMX. Flauta, calibre, resistencia ECT, dimensiones. Sin compromiso.";
const canonical   = SITE + "/servicios/asesoria-tecnica";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Asesoría Técnica Gratuita de Empaque",
    "description": description,
    "provider": { "@type": "LocalBusiness", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿De verdad es gratis la asesoría?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, completamente gratuita. No hay costo oculto ni compromiso de compra. Nuestro objetivo es que elijas la caja correcta." } },
    { "@type": "Question", "name": "¿Qué información necesito tener lista?", "acceptedAnswer": { "@type": "Answer", "text": "Idealmente: dimensiones del producto, peso, tipo de almacenaje y destino de envío. Con eso es suficiente para empezar." } },
    { "@type": "Question", "name": "¿Cuánto tarda en responder?", "acceptedAnswer": { "@type": "Answer", "text": "Respondemos en menos de 2 horas en horario de lunes a sábado 8:00-20:00." } },
    { "@type": "Question", "name": "¿Puedo pedir asesoría para un solo producto?", "acceptedAnswer": { "@type": "Answer", "text": "Por supuesto. La asesoría aplica para cualquier volumen, desde un producto hasta una línea completa." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios" },
    { name: "Asesoría Técnica Gratuita de Empaque" },
  ]}
  whatsapp={WHATSAPP}
>

  {/* ════════ HERO ════════ */}
  <section class="hero">
    <div class="container">
      <div class="hero__inner">

        <div class="hero__left">
          <p class="hero__badge">Servicio Gratuito · Sin Compromiso de Compra</p>
          <h1 class="hero__title"><span>Asesoría Técnica Gratuita de Empaque</span></h1>
          <p class="hero__intro">Te ayudamos a seleccionar la caja correcta: flauta, calibre, resistencia ECT, dimensiones óptimas y tipo de sellado. Análisis de tu producto y proceso incluido sin costo.</p>
          <div class="hero__ctas">
            <a href="/cotizar" class="btn btn--primary btn--lg">Solicitar cotización</a>
            <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+quiero+la+asesor%C3%ADa+t%C3%A9cnica+gratuita+de+CADECA"}
               class="btn btn--outline btn--lg" target="_blank" rel="noopener">&#x1F4AC; WhatsApp</a>
          </div>
          <div class="hero__metrics">
          <div class="hero__metric">
            <span class="hero__metric-value">Gratis</span>
            <span class="hero__metric-label">Sin costo</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">2 hrs</span>
            <span class="hero__metric-label">Respuesta</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">0</span>
            <span class="hero__metric-label">Compromiso</span>
          </div>
          <div class="hero__metric">
            <span class="hero__metric-value">15+</span>
            <span class="hero__metric-label">Años experiencia</span>
          </div>
          </div>
        </div>

        <div class="hero__right">
          <p>La <strong>asesoría técnica gratuita de empaque</strong> de CADECA te ayuda a seleccionar la caja correcta para tu producto: flauta, calibre, resistencia ECT, dimensiones óptimas y tipo de sellado. Nuestro equipo de ingeniería analiza tu producto, proceso de almacenaje y destino final.</p>
          <p>Miles de empresas en CDMX han optimizado su costo de empaque con nuestra asesoría. <strong>Reducimos mermas, daños en tránsito y sobreempaque</strong> sin incrementar el presupuesto. El servicio es completamente gratuito, sin compromiso de compra. Respuesta en menos de 2 horas.</p>
        </div>

      </div>
    </div>
  </section>

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para asesoría técnica gratuita de empaque"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Selección de flauta óptima según peso y uso del producto</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Cálculo de resistencia ECT para apilamiento y transporte</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Recomendación de dimensiones para minimizar material</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Análisis de tipo de sellado: pegamento, grapa, cinta</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Reducción de mermas y daños en tránsito garantizada</span>
          </li>
          <li class="feature-item">
            <span class="feature-item__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span>Completamente gratuito — sin compromiso de compra</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Cuéntanos tu caso</p>
            <p class="process-step__desc">Envíanos fotos o descripción de tu producto, cómo lo almacenas y a dónde lo envías.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Análisis</p>
            <p class="process-step__desc">Nuestro equipo de ingeniería analiza las necesidades reales de tu empaque.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Recomendación</p>
            <p class="process-step__desc">Te enviamos una propuesta técnica con materiales, dimensiones y resistencia recomendados.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Cotización</p>
            <p class="process-step__desc">Si te convence la propuesta, cotizamos sin compromiso. Si no, no pasa nada.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Preguntas frecuentes"
        subtitle={"Todo sobre asesoría técnica gratuita de empaque"}
      />
      <div class="faq-list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-asesoria-tecnica-0">
              <span>¿De verdad es gratis la asesoría?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-asesoria-tecnica-0">
              <p>Sí, completamente gratuita. No hay costo oculto ni compromiso de compra. Nuestro objetivo es que elijas la caja correcta.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-asesoria-tecnica-1">
              <span>¿Qué información necesito tener lista?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-asesoria-tecnica-1">
              <p>Idealmente: dimensiones del producto, peso, tipo de almacenaje y destino de envío. Con eso es suficiente para empezar.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-asesoria-tecnica-2">
              <span>¿Cuánto tarda en responder?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-asesoria-tecnica-2">
              <p>Respondemos en menos de 2 horas en horario de lunes a sábado 8:00-20:00.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-asesoria-tecnica-3">
              <span>¿Puedo pedir asesoría para un solo producto?</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="faq-item__ans" id="faq-asesoria-tecnica-3">
              <p>Por supuesto. La asesoría aplica para cualquier volumen, desde un producto hasta una línea completa.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Cajas a la Medida"
            desc="Diseño CAD incluido"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida"
            btnText="Ver producto"
          />
          <ProductCard
            title="Corrugado Estándar"
            desc="Asesoría de flauta y ECT"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar — CADECA"
            href="/catalogo/cajas-corrugado-estandar"
            btnText="Ver producto"
          />
          <ProductCard
            title="Industrial Triple Pared"
            desc="Para exportación y manufactura"
            imgSrc="/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif"
            imgAlt="Industrial Triple Pared — CADECA"
            href="/catalogo/cajas-industriales-triple-pared"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <LeadCapture
    titulo="Solicita tu asesoría técnica gratuita"
    subtitulo="Sin compromiso · Respuesta en 2 horas · 15+ años de experiencia técnica"
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
