---
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";

const WHATSAPP = "5255XXXXXXXX";
const SITE     = "https://cajas-de-carton.com";

const title       = "Asesoría Técnica Gratuita de Empaque — CADECA Fabricante Directo CDMX";
const description = "Nuestro equipo técnico analiza tu producto, proceso de empaque, método de transporte y destino final para recomendarte la caja óptima. Sin compromiso de compra.";
const canonical   = SITE + "/servicios/asesoria-tecnica";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Asesoría Técnica Gratuita de Empaque",
    "description": description,
    "provider": { "@type": "LocalBusiness", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿La asesoría técnica tiene algún costo?", "acceptedAnswer": { "@type": "Answer", "text": "No, la asesoría técnica es completamente gratuita y sin compromiso de compra. Es parte de nuestro servicio como fabricante directo." } },
    { "@type": "Question", "name": "¿Pueden ayudarme a reducir el costo de mis empaques actuales?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, con frecuencia identificamos oportunidades para optimizar medidas, cambiar tipo de cartón o ajustar cantidades que reducen el costo sin afectar la protección del producto." } },
    { "@type": "Question", "name": "¿Trabajan con productos frágiles o de alto valor?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, tenemos experiencia en empaque de productos electrónicos, cerámica, vidrio, equipos médicos y arte. Diseñamos cajas con separadores internos y espumas de protección." } },
    { "@type": "Question", "name": "¿Pueden evaluar si mis cajas actuales cumplen normas de exportación?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, podemos revisar si tus cajas actuales cumplen normas ASTM, ISTA o requerimientos de Aduanas y líneas navieras para exportación." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios" },
    { name: "Asesoría Técnica Gratuita de Empaque" },
  ]}
  whatsapp={WHATSAPP}
>

  <section class="svc-page__hero">
    <div class="svc-page__hero-inner container">
      <div class="svc-page__hero-emoji">🔬</div>
      <h1 class="svc-page__hero-title">Asesoría Técnica Gratuita de Empaque</h1>
      <p class="svc-page__hero-tagline">Ingeniería de empaque sin costo — encontramos la caja ideal para tu producto</p>
      <p class="svc-page__hero-desc">Nuestro equipo técnico analiza tu producto, proceso de empaque, método de transporte y destino final para recomendarte la caja óptima. Sin compromiso de compra. El objetivo es que tu empaque proteja, optimice espacio y no cueste más de lo necesario.</p>
      <div class="svc-page__hero-ctas">
        <a href="/cotizar" class="btn btn--primary btn--lg">Solicitar cotización</a>
        <a href={"https://wa.me/" + WHATSAPP + "?text=Hola%2C+quiero+informaci%C3%B3n+sobre+Asesoría+Técnica+Gratuita+de+Empaque"}
           class="btn btn--outline btn--lg" target="_blank" rel="noopener">💬 WhatsApp</a>
      </div>
    </div>
  </section>

  <section class="svc-page__section">
    <div class="container">
      <SectionHeader title="Beneficios del servicio" subtitle="Por qué elegir CADECA para asesoría técnica gratuita de empaque" />
      <ul class="svc-page__beneficios">
              <li><span>✓</span> Análisis de resistencia al apilamiento y al transporte</li>
              <li><span>✓</span> Optimización de medidas para reducir espacio y costo de material</li>
              <li><span>✓</span> Selección del tipo de cartón (flauta, gramaje, resistencia) correcto</li>
              <li><span>✓</span> Evaluación de cumplimiento normativo (COFEPRIS, exportación, farmacéutica)</li>
              <li><span>✓</span> Sin costo, sin compromiso de compra</li>
      </ul>
    </div>
  </section>

  <section class="svc-page__section svc-page__section--alt">
    <div class="container">
      <SectionHeader title="Cómo funciona" subtitle="Proceso simple, sin burocracia, con respuesta rápida" />
      <div class="svc-page__pasos">
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">1</div>
            <div>
              <strong>Contacto inicial</strong>
              <p>Nos describes tu producto, proceso y problema actual. Por WhatsApp, email o teléfono.</p>
            </div>
          </div>
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">2</div>
            <div>
              <strong>Análisis técnico</strong>
              <p>Nuestro equipo evalúa requerimientos y prepara recomendación técnica. En 24-48 hrs.</p>
            </div>
          </div>
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">3</div>
            <div>
              <strong>Presentación de propuesta</strong>
              <p>Te enviamos especificaciones técnicas, opciones de material y costos comparativos.</p>
            </div>
          </div>
          <div class="svc-page__paso">
            <div class="svc-page__paso-num">4</div>
            <div>
              <strong>Prototipo (opcional)</strong>
              <p>Si lo requieres, fabricamos un prototipo físico para validar antes de producción en serie.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <section class="svc-page__section">
    <div class="container">
      <SectionHeader title="Preguntas frecuentes" subtitle={"Todo sobre " + "asesoría técnica gratuita de empaque"} />
      <div class="svc-page__faq">
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿La asesoría técnica tiene algún costo?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>No, la asesoría técnica es completamente gratuita y sin compromiso de compra. Es parte de nuestro servicio como fabricante directo.</p>
            </div>
          </div>
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿Pueden ayudarme a reducir el costo de mis empaques actuales?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>Sí, con frecuencia identificamos oportunidades para optimizar medidas, cambiar tipo de cartón o ajustar cantidades que reducen el costo sin afectar la protección del producto.</p>
            </div>
          </div>
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿Trabajan con productos frágiles o de alto valor?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>Sí, tenemos experiencia en empaque de productos electrónicos, cerámica, vidrio, equipos médicos y arte. Diseñamos cajas con separadores internos y espumas de protección.</p>
            </div>
          </div>
          <div class="svc-page__faq-item">
            <button class="svc-page__faq-q" aria-expanded="false">
              <span>¿Pueden evaluar si mis cajas actuales cumplen normas de exportación?</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
            </button>
            <div class="svc-page__faq-a">
              <p>Sí, podemos revisar si tus cajas actuales cumplen normas ASTM, ISTA o requerimientos de Aduanas y líneas navieras para exportación.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  <section class="svc-page__section svc-page__section--alt">
    <div class="container">
      <SectionHeader title="Productos relacionados" subtitle="Explora el catálogo de CADECA" />
      <div class="svc-page__productos">
        <a href="/catalogo/cajas-a-la-medida" class="svc-page__prod-card">
          <strong>Cajas a la Medida</strong>
          <span>Diseño CAD incluido</span>
        </a>
        <a href="/cotizar" class="svc-page__prod-card">
          <strong>Solicitar asesoría</strong>
          <span>Gratis, sin compromiso</span>
        </a>
        <a href="/contacto" class="svc-page__prod-card">
          <strong>Contactar técnico</strong>
          <span>Respuesta en 24 hrs</span>
        </a>
      </div>
    </div>
  </section>

  <LeadCapture
    titulo="¿Listo para comenzar con asesoría técnica gratuita de empaque?"
    subtitulo="Cotización sin compromiso en menos de 2 horas. Fabricante directo, los mejores precios de CDMX."
    whatsapp={WHATSAPP}
  />

</PageLayout>

<style>
.svc-page__hero { background: linear-gradient(135deg, var(--color-secondary) 0%, #0f1d35 100%); padding: var(--space-20) 0 var(--space-16); text-align: center; }
.svc-page__hero-inner { max-width: 720px; margin: 0 auto; padding: 0 var(--space-5); }
.svc-page__hero-emoji { font-size: 3rem; margin-bottom: var(--space-4); }
.svc-page__hero-title { font-size: clamp(1.8rem,4vw,2.8rem); font-weight: 900; color: #fff; line-height: 1.15; margin-bottom: var(--space-3); }
.svc-page__hero-tagline { font-size: var(--text-lg); color: var(--color-primary); font-weight: 600; margin-bottom: var(--space-4); }
.svc-page__hero-desc { color: rgba(255,255,255,0.75); line-height: var(--line-relaxed); margin-bottom: var(--space-8); }
.svc-page__hero-ctas { display: flex; gap: var(--space-4); justify-content: center; flex-wrap: wrap; }
.svc-page__section { padding: var(--space-16) 0; }
.svc-page__section--alt { background: var(--color-surface); }
.svc-page__beneficios { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit,minmax(280px,1fr)); gap: var(--space-3); margin-top: var(--space-8); }
.svc-page__beneficios li { display: flex; gap: var(--space-3); align-items: flex-start; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4); font-size: var(--text-sm); line-height: var(--line-relaxed); }
.svc-page__beneficios span { color: var(--color-primary); font-weight: 900; flex-shrink: 0; }
.svc-page__pasos { display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-8); max-width: 680px; margin-left: auto; margin-right: auto; }
.svc-page__paso { display: flex; gap: var(--space-5); align-items: flex-start; background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-5); }
.svc-page__paso-num { width: 2.5rem; height: 2.5rem; background: var(--color-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: var(--text-lg); flex-shrink: 0; }
.svc-page__paso strong { display: block; color: var(--color-secondary); font-size: var(--text-base); margin-bottom: var(--space-1); }
.svc-page__paso p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--line-relaxed); margin: 0; }
.svc-page__faq { display: flex; flex-direction: column; gap: var(--space-3); margin-top: var(--space-8); max-width: 780px; margin-left: auto; margin-right: auto; }
.svc-page__faq-item { border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: hidden; background: #fff; }
.svc-page__faq-q { width: 100%; text-align: left; display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-4) var(--space-5); background: none; border: none; cursor: pointer; font-weight: 600; font-size: var(--text-sm); color: var(--color-secondary); }
.svc-page__faq-q:hover { color: var(--color-primary); }
.svc-page__faq-a { padding: 0 var(--space-5) var(--space-4); display: none; }
.svc-page__faq-a p { font-size: var(--text-sm); color: var(--color-text-muted); line-height: var(--line-relaxed); margin: 0; }
.svc-page__faq-item.is-open .svc-page__faq-a { display: block; }
.svc-page__faq-item.is-open .svc-page__faq-q svg { transform: rotate(180deg); }
.svc-page__productos { display: grid; grid-template-columns: repeat(auto-fit,minmax(180px,1fr)); gap: var(--space-4); margin-top: var(--space-8); }
.svc-page__prod-card { display: flex; flex-direction: column; gap: var(--space-1); background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: var(--space-5); text-decoration: none; color: var(--color-text); }
.svc-page__prod-card:hover { border-color: var(--color-primary); }
.svc-page__prod-card strong { color: var(--color-secondary); font-size: var(--text-sm); }
.svc-page__prod-card span { font-size: var(--text-xs); color: var(--color-text-muted); }
@media (max-width: 640px) {
  .svc-page__hero-ctas { flex-direction: column; }
  .svc-page__beneficios { grid-template-columns: 1fr; }
}
</style>

<script>
document.querySelectorAll('.svc-page__faq-q').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.svc-page__faq-item');
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
