---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageHero from "@/components/PageHero.astro";
const SITE     = "https://cajas-de-carton.com";

const title       = "Cotización de Cajas de Cartón en CDMX — CADECA";
const description = "Cotiza cajas de cartón corrugado en CDMX y Estado de México: indica tipo, medidas y cantidad y recibe precio por pieza y tiempo de entrega.";
const canonical   = SITE + "/servicios/cotizacion-express/";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Cotización de Cajas de Cartón",
    "description": description,
    "provider": { "@type": "Organization", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    get mainEntity() { return faqsModulo.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })); },
  }
];
const faqsModulo = [
 {
  "question": "¿Qué necesito para pedir una cotización?",
  "answer": "Indica tipo de caja, largo, ancho, alto, cantidad y zona de entrega para revisar la solicitud. Si necesita impresión o una resistencia particular, añádelo junto con el uso del empaque; esa información permite comparar alternativas de cartón corrugado."
 },
 {
  "question": "¿La cotización tiene algún costo?",
  "answer": "Puedes enviar la información del pedido mediante el formulario para recibir una cotización sin compromiso de compra. El resultado depende de las especificaciones solicitadas, por lo que conviene incluir medidas, cantidad, uso, impresión y destino desde el inicio."
 },
 {
  "question": "¿Cuánto tiempo es válida la cotización?",
  "answer": "La vigencia y las condiciones de precio se indican al emitir la cotización. Como dependen de medida, material, cantidad e impresión, revisa esos datos antes de confirmar el pedido para asegurar que la propuesta corresponda a la especificación requerida."
 },
 {
  "question": "¿Puedo cotizar varias referencias a la vez?",
  "answer": "Puedes incluir varias medidas y cantidades en una misma solicitud. Identifica cada referencia con sus dimensiones, cantidad, uso e impresión si aplica, para revisar la estructura de cartón y presentar las alternativas correspondientes."
 },
 { "question": "¿Cómo cotizo cajas de cartón con la resistencia adecuada?", "answer": "Indica peso del producto, dimensiones, forma de envío, altura de apilado y cantidad requerida. Con esos datos se puede revisar la flauta y el ECT convenientes, pues ambos influyen en la rigidez y resistencia de la caja durante su manejo." }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Cotización de Cajas de Cartón" },
  ]}
>

  {/* ════════ HERO ════════ */}
  <PageHero
    eyebrow="Servicio · Cotización"
    titleHtml={true}
    title="Cotización de cajas de <span>cartón corrugado</span>"
    desc="Cotización de cajas de cartón con precio, especificaciones y condiciones según el pedido. Envía los datos de tu empaque para revisar opciones con CADECA en CDMX y Estado de México."
    desc2="La <strong>cotización de cajas de cartón</strong> considera tipo de corrugado, medidas, cantidad, impresión y uso. Puedes compartir la información por formulario, WhatsApp o teléfono para revisar las opciones técnicas y el <strong>precio de cajas de cartón</strong> correspondiente.||CADECA coordina el suministro con talleres aliados. Para <strong>cotizar cajas</strong>, indica medidas, cantidad, uso y zona de entrega; te orientamos para elegir la caja y confirmamos las condiciones antes de avanzar."
  />

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Cómo solicitar una cotización de cajas de cartón"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span>Respuesta en horario hábil de atención</span>
          </li>
          <li class="feature-item">
            <span>Cotización con precio, specs y tiempo de entrega incluidos</span>
          </li>
          <li class="feature-item">
            <span>Sin compromiso de compra — solo información clara</span>
          </li>
          <li class="feature-item">
            <span>Atención por WhatsApp, teléfono y formulario</span>
          </li>
          <li class="feature-item">
            <span>Seguimiento por WhatsApp y correo</span>
          </li>
          <li class="feature-item">
            <span>Asesor asignado para seguimiento personalizado</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Envía tu solicitud</p>
            <p class="process-step__desc">Por WhatsApp, teléfono o formulario: tipo de caja, medidas aproximadas y cantidad.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Procesamos</p>
            <p class="process-step__desc">Nuestro equipo revisa y calcula precio, material y tiempo de producción.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Recibe tu cotización</p>
            <p class="process-step__desc">Te enviamos propuesta completa con precio unitario, total, specs técnicas y fecha de entrega.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Decides sin presión</p>
            <p class="process-step__desc">Tienes toda la información para decidir. Sin presión, sin seguimiento agresivo.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Corrugado Estándar"
            desc="Cotización en horario hábil"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar — CADECA"
            href="/catalogo/cajas-corrugado-estandar/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Cotización con diseño CAD"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas Personalizadas"
            desc="Cotización con muestra digital"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas Personalizadas — CADECA"
            href="/catalogo/cajas-personalizadas-logo/"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <FaqCotizacion faqs={faqsModulo} tema="cotización de cajas de cartón" />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    if (!item) return;
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
