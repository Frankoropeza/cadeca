---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageHero from "@/components/PageHero.astro";
const SITE     = "https://cajas-de-carton.com";

const title       = "Impresión de Cajas Personalizadas con Logo CDMX | CADECA";
const description = "Cajas de cartón corrugado con tu logo e impresión flexográfica en CDMX. Desde 100 piezas, 1-4 colores, tintas base agua y tiempo de entrega según pedido.";
const canonical   = SITE + "/servicios/impresion-cajas-personalizadas/";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Impresión de Cajas Personalizadas con Logo",
    "description": description,
    "provider": { "@type": "Organization", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Cuántos colores puedo imprimir?", "acceptedAnswer": { "@type": "Answer", "text": "Hasta 4 colores en impresión flexográfica. Para diseños más complejos podemos cotizar combinaciones especiales." } },
    { "@type": "Question", "name": "¿Hacen el diseño o necesito enviar el archivo?", "acceptedAnswer": { "@type": "Answer", "text": "Podemos adaptar tu logo al formato de impresión sin costo. Si tienes el arte listo en vectores, mejor." } },
    { "@type": "Question", "name": "¿Las tintas son seguras para alimentos?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, usamos tintas base agua certificadas para contacto indirecto con alimentos." } },
    { "@type": "Question", "name": "¿Cuánto tiempo tarda?", "acceptedAnswer": { "@type": "Answer", "text": "Entre 5-7 días hábiles desde la aprobación del diseño. Para reórdenes del mismo diseño, 3-5 días." } }
    ]
  }
];
const faqsModulo = [
 {
  "question": "¿Cuántos colores puedo imprimir?",
  "answer": "Hasta 4 colores en impresión flexográfica. Para diseños más complejos podemos cotizar combinaciones especiales."
 },
 {
  "question": "¿Hacen el diseño o necesito enviar el archivo?",
  "answer": "Podemos adaptar tu logo al formato de impresión sin costo. Si tienes el arte listo en vectores, mejor."
 },
 {
  "question": "¿Las tintas son seguras para alimentos?",
  "answer": "Sí, usamos tintas base agua certificadas para contacto indirecto con alimentos."
 },
 {
  "question": "¿Cuánto tiempo tarda?",
  "answer": "Entre 5-7 días hábiles desde la aprobación del diseño. Para reórdenes del mismo diseño, 3-5 días."
 }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Impresión de Cajas Personalizadas con Logo" },
  ]}
>

  {/* ════════ HERO ════════ */}
  <PageHero
    eyebrow="Servicio · Impresión personalizada"
    titleHtml={true}
    title="Impresión de cajas <span>personalizadas</span>"
    desc="Impresión de cajas personalizadas para marcas que requieren logo, colores o mensajes en cartón corrugado. Hay opciones flexográficas de 1 a 4 colores y acabados disponibles."
    desc2="Las <strong>cajas impresas</strong> se coordinan en cartón corrugado con impresión flexográfica de 1 a 4 colores, tintas base agua y acabados mate, brillante o barniz UV. El diseño digital de prueba permite revisar logo, colores y composición antes de confirmar el pedido.||CADECA surte como proveedor desde <strong>100 piezas</strong>. Indica medidas, cantidad, uso y zona de entrega para cotizar <strong>cajas con logo</strong>; te asesoramos para elegir estructura e impresión."
  />

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para impresión de cajas personalizadas con logo"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span>Impresión flexográfica 1-4 colores de alta resolución</span>
          </li>
          <li class="feature-item">
            <span>Tintas base agua certificadas — compatibles con alimentos</span>
          </li>
          <li class="feature-item">
            <span>Diseño digital de prueba incluido sin costo</span>
          </li>
          <li class="feature-item">
            <span>Acabados: mate, brillante y barniz UV disponibles</span>
          </li>
          <li class="feature-item">
            <span>Desde 100 piezas — sin mínimos industriales restrictivos</span>
          </li>
          <li class="feature-item">
            <span>Control de color por lote — consistencia revisada</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Envía tu arte</p>
            <p class="process-step__desc">Mándanos tu logo y colores. Si no tienes archivo, nuestro equipo lo adapta sin costo.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Prueba digital</p>
            <p class="process-step__desc">Generamos una prueba digital para que valides el diseño antes de producir.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Producción</p>
            <p class="process-step__desc">Con tu aprobación, iniciamos impresión. 5-7 días hábiles para la mayoría de pedidos.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Entrega</p>
            <p class="process-step__desc">Cajas con tu logo entregadas en tu dirección en CDMX y Zona Metropolitana.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Cajas Personalizadas con Logo"
            desc="Impresión flexográfica 1-4 colores"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas Personalizadas con Logo — CADECA"
            href="/catalogo/cajas-personalizadas-logo/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Con dimensión e impresión propias"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Corrugado Estándar"
            desc="Base para personalizar"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar — CADECA"
            href="/catalogo/cajas-corrugado-estandar/"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <FaqCotizacion faqs={faqsModulo} tema="impresión de cajas personalizadas" />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    if (!item) return;
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
