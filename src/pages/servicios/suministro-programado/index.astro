---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import FaqCotizacion from "@/components/FaqCotizacion.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageHero from "@/components/PageHero.astro";
const SITE     = "https://cajas-de-carton.com";

const title       = "Suministro Programado de Cajas de Cartón CDMX | CADECA";
const description = "Programa el suministro continuo de cajas de cartón corrugado en CDMX y Estado de México. Coordinamos entregas periódicas según volumen, zona y pedido.";
const canonical   = SITE + "/servicios/suministro-programado/";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Suministro Programado de Cajas de Cartón",
    "description": description,
    "provider": { "@type": "Organization", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    get mainEntity() { return faqsModulo.map((f) => ({ "@type": "Question", "name": f.question, "acceptedAnswer": { "@type": "Answer", "text": f.answer } })); },
  }
];
const faqsModulo = [
 {
  "question": "¿Cuál es el volumen mínimo para suministro programado?",
  "answer": "Trabajamos con empresas que consumen a partir de 500 cajas mensuales. Contáctanos y analizamos tu caso."
 },
 {
  "question": "¿Puedo cambiar las cantidades durante el programa?",
  "answer": "Sí, tenemos flexibilidad para ajustar volúmenes dentro de rangos razonables según disponibilidad."
 },
 {
  "question": "¿El precio es fijo aunque suban los insumos?",
  "answer": "Respetamos el precio acordado durante la vigencia del contrato, generalmente 6 o 12 meses."
 },
 {
  "question": "¿Hacen suministro para múltiples puntos de entrega?",
  "answer": "Incluye los distintos destinos, cantidades y frecuencia requerida en el formulario. Con esa información se revisan las alternativas de ruta y suministro para cada punto, así como las condiciones que deberán confirmarse en la cotización." 
 },
 { "question": "¿Cómo se define la frecuencia de suministro de cajas de cartón?", "answer": "La frecuencia se plantea según consumo estimado, espacio de almacenamiento, tipo de caja y destinos de entrega. Puedes solicitar opciones semanales, quincenales o mensuales; el calendario y las cantidades se revisan y confirman al cotizar." }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Suministro Programado de Cajas de Cartón" },
  ]}
>

  {/* ════════ HERO ════════ */}
  <PageHero
    eyebrow="Servicio · Suministro programado"
    titleHtml={true}
    title="Suministro de cajas de cartón <span>por mayoreo</span>"
    desc="Suministro de cajas de cartón por mayoreo para operaciones con consumo regular. Definimos calendarios semanales, quincenales o mensuales según cantidades y necesidades de entrega."
    desc2="El <strong>suministro de cajas de cartón por mayoreo</strong> permite programar entregas semanales, quincenales o mensuales para manufactura, e-commerce, distribución y logística. El calendario se ajusta al consumo, tipo de caja, volumen y condiciones indicadas en la cotización.||CADECA coordina el pedido con talleres aliados como proveedor. Comparte medidas, cantidad, uso y zona de entrega para revisar <strong>cajas de cartón mayoreo</strong>; te asesoramos para elegir la caja y programar el suministro."
  />

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para suministro programado de cajas de cartón"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span>Precio fijo durante toda la vigencia del contrato</span>
          </li>
          <li class="feature-item">
            <span>Prioridad en la línea de producción para tu empresa</span>
          </li>
          <li class="feature-item">
            <span>Sin riesgo de desabasto — siempre cajas disponibles</span>
          </li>
          <li class="feature-item">
            <span>Sin necesidad de almacenar grandes inventarios</span>
          </li>
          <li class="feature-item">
            <span>Flexibilidad para ajustar cantidades mes a mes</span>
          </li>
          <li class="feature-item">
            <span>Ahorro de hasta 20% vs. compras puntuales</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Diagnóstico</p>
            <p class="process-step__desc">Analizamos tu consumo actual y tu proyección para definir el programa óptimo.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Propuesta</p>
            <p class="process-step__desc">Te presentamos un calendario de entregas con precio fijo y condiciones claras.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Contrato</p>
            <p class="process-step__desc">Firmamos el acuerdo de suministro. Sin letra chica, sin sorpresas.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Operación</p>
            <p class="process-step__desc">Empezamos a entregarte según el calendario acordado. Ajustes disponibles si tu demanda cambia.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Corrugado Estándar"
            desc="Entrega programada semanal"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar — CADECA"
            href="/catalogo/cajas-corrugado-estandar/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas a la Medida"
            desc="Producción continua a tu medida"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Cajas Personalizadas"
            desc="Suministro con tu marca"
            imgSrc="/img/productos/cajas-de-carton-personalizadas-con-logo-impresion-mexico.avif"
            imgAlt="Cajas Personalizadas — CADECA"
            href="/catalogo/cajas-personalizadas-logo/"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <FaqCotizacion faqs={faqsModulo} tema="suministro de cajas de cartón por mayoreo" />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    if (!item) return;
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
