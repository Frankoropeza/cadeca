---
import { contactoHref, contactoAttrs, HAS_WA } from "@/data/contacto";
import PageLayout from "@/layouts/PageLayout.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import LeadCapture from "@/components/LeadCapture.astro";
import ProductCard from "@/components/ProductCard.astro";
import PageHero from "@/components/PageHero.astro";
const SITE     = "https://cajas-de-carton.com";

const title       = "Cajas de Cartón a la Medida CDMX | CADECA";
const description = "Cajas de cartón corrugado a la medida, coordinadas con talleres especializados en CDMX y Estado de México.";
const canonical   = SITE + "/servicios/fabricacion-cajas-medida/";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Fabricación de Cajas a la Medida",
    "description": description,
    "provider": { "@type": "Organization", "name": "CADECA", "url": SITE },
    "areaServed": "Ciudad de México y Zona Metropolitana",
    "url": canonical
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
    { "@type": "Question", "name": "¿Cuánto cuesta hacer cajas a la medida?", "acceptedAnswer": { "@type": "Answer", "text": "El precio depende de las medidas, tipo de cartón y cantidad. A mayor volumen, menor costo unitario. Te cotizamos sin compromiso y te indicamos el tiempo de entrega según el pedido." } },
    { "@type": "Question", "name": "¿Cuál es la cantidad mínima?", "acceptedAnswer": { "@type": "Answer", "text": "Trabajamos desde 100 piezas. Para pedidos menores podemos cotizar aunque el precio unitario es más alto." } },
    { "@type": "Question", "name": "¿Pueden hacer cajas para exportación?", "acceptedAnswer": { "@type": "Answer", "text": "Sí, coordinamos cajas de doble y triple pared con talleres especializados, considerando las normas ASTM D4169 e ISTA para envíos marítimos y aéreos." } },
    { "@type": "Question", "name": "¿Hacen el diseño o yo debo enviarlo?", "acceptedAnswer": { "@type": "Answer", "text": "Lo hacemos nosotros. Solo necesitamos las medidas internas del producto, el peso y el uso final. El diseño técnico es sin costo." } }
    ]
  }
];
---

<PageLayout
  title={title}
  description={description}
  schema={schema}
  canonical={canonical}
  breadcrumbs={[
    { name: "Inicio",    href: "/" },
    { name: "Servicios", href: "/servicios/" },
    { name: "Fabricación de Cajas a la Medida" },
  ]}
>

  {/* ════════ HERO ════════ */}
  <PageHero
    eyebrow="Servicio · CDMX y Estado de México"
    titleHtml={true}
    title="<span>Fabricación de Cajas a la Medida</span>"
    desc="Cualquier dimensión exacta, con diseño CAD técnico y coordinación de producción con talleres especializados. El tiempo de entrega se confirma según el pedido."
    desc2="CADECA coordina <strong>cajas de cartón corrugado a la medida en CDMX y Estado de México</strong> con talleres especializados. Trabajamos cualquier dimensión exacta —largo, ancho y alto— y te proponemos el diseño CAD técnico según el pedido.||Coordinamos la producción con talleres aliados y confirmamos el tiempo de entrega al cotizar. Flautas B, C, E y BC; resistencia ECT seleccionada según el peso del producto. El volumen mínimo se define según la solución requerida."
  />

  {/* ════════ BENEFICIOS ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Beneficios del servicio"
        subtitle={"Por qué elegir CADECA para fabricación de cajas a la medida"}
      />
      <ul class="feature-grid">
          <li class="feature-item">
            <span>Diseño CAD incluido sin costo — plano técnico antes de producir</span>
          </li>
          <li class="feature-item">
            <span>Desde 100 piezas — sin mínimos industriales restrictivos</span>
          </li>
          <li class="feature-item">
            <span>Materiales: flauta B, C, E, BC doble y triple pared</span>
          </li>
          <li class="feature-item">
            <span>Producción: 3-5 días hábiles desde aprobación de diseño</span>
          </li>
          <li class="feature-item">
            <span>Prueba física incluida para pedidos de más de 1,000 piezas</span>
          </li>
          <li class="feature-item">
            <span>Certificado de calidad por lote disponible bajo solicitud</span>
          </li>
      </ul>
    </div>
  </section>

  {/* ════════ PROCESO ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="¿Cómo funciona?"
        subtitle="Proceso simple, sin burocracia, con respuesta rápida"
      />
      <div class="process-grid">
          <div class="process-step">
            <div class="process-step__num">1</div>
            <p class="process-step__title">Cotización</p>
            <p class="process-step__desc">Envíanos las medidas, peso y cantidad. Te respondemos en horario hábil con precio y especificaciones.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">2</div>
            <p class="process-step__title">Diseño técnico</p>
            <p class="process-step__desc">Nuestro equipo genera el plano CAD y lo comparte para tu aprobación. Sin costo, sin compromiso.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">3</div>
            <p class="process-step__title">Producción</p>
            <p class="process-step__desc">Una vez aprobado el diseño, coordinamos la producción con el taller aliado. El tiempo de entrega se confirma según el pedido.</p>
          </div>
          <div class="process-step">
            <div class="process-step__num">4</div>
            <p class="process-step__title">Entrega</p>
            <p class="process-step__desc">Entregamos en tu planta, bodega o domicilio en CDMX y Zona Metropolitana. Factura incluida.</p>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ FAQ ════════ */}
  <section class="page-section">
    <div class="container">
      <SectionHeader
        title="Preguntas frecuentes"
        subtitle={"Todo sobre fabricación de cajas a la medida"}
      />
      <div class="faq-list">
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-fabricacion-cajas-medida-0">
              <span>¿Cuánto cuesta hacer cajas a la medida?</span>
            </button>
            <div class="faq-item__ans" id="faq-fabricacion-cajas-medida-0">
              <p>El precio depende de las medidas, tipo de cartón y cantidad. A mayor volumen, menor costo unitario. Te cotizamos sin compromiso y te indicamos el tiempo de entrega según el pedido.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-fabricacion-cajas-medida-1">
              <span>¿Cuál es la cantidad mínima?</span>
            </button>
            <div class="faq-item__ans" id="faq-fabricacion-cajas-medida-1">
              <p>Trabajamos desde 100 piezas. Para pedidos menores podemos cotizar aunque el precio unitario es más alto.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-fabricacion-cajas-medida-2">
              <span>¿Pueden hacer cajas para exportación?</span>
            </button>
            <div class="faq-item__ans" id="faq-fabricacion-cajas-medida-2">
              <p>Sí, coordinamos cajas de doble y triple pared con talleres especializados, considerando las normas ASTM D4169 e ISTA para envíos marítimos y aéreos.</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-item__btn" aria-expanded="false" aria-controls="faq-fabricacion-cajas-medida-3">
              <span>¿Hacen el diseño o yo debo enviarlo?</span>
            </button>
            <div class="faq-item__ans" id="faq-fabricacion-cajas-medida-3">
              <p>Lo hacemos nosotros. Solo necesitamos las medidas internas del producto, el peso y el uso final. El diseño técnico es sin costo.</p>
            </div>
          </div>
      </div>
    </div>
  </section>

  {/* ════════ PRODUCTOS RELACIONADOS ════════ */}
  <section class="page-section page-section--alt">
    <div class="container">
      <SectionHeader
        title="Productos relacionados"
        subtitle="Explora el catálogo de CADECA"
      />
      <div class="products__grid svc-products-grid">
          <ProductCard
            title="Cajas a la Medida"
            desc="Cualquier dimensión exacta"
            imgSrc="/img/productos/cajas-de-carton-a-la-medida-cdmx-estado-de-mexico.avif"
            imgAlt="Cajas a la Medida — CADECA"
            href="/catalogo/cajas-a-la-medida/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Corrugado Estándar"
            desc="Disponibilidad según pedido"
            imgSrc="/img/productos/cajas-de-carton-corrugado-estandar-cdmx.avif"
            imgAlt="Corrugado Estándar — CADECA"
            href="/catalogo/cajas-corrugado-estandar/"
            btnText="Ver producto"
          />
          <ProductCard
            title="Industrial Triple Pared"
            desc="Alta resistencia ECT"
            imgSrc="/img/productos/cajas-carton-triple-corrugado-industrial-cdmx.avif"
            imgAlt="Industrial Triple Pared — CADECA"
            href="/catalogo/cajas-corrugado-estandar/triple-corrugado/"
            btnText="Ver producto"
          />
      </div>
    </div>
  </section>

  <LeadCapture
    title="Cotiza tus cajas a la medida"
  />

</PageLayout>

<style>
.page-section { padding: var(--spacing-3xl) 0; }
.page-section--alt { background: var(--color-surface, #f8f9fb); }

/* Feature grid */
.feature-grid {
  list-style: none; padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--spacing-md);
  margin-top: var(--spacing-2xl);
}
.feature-item {
  display: flex; align-items: flex-start; gap: var(--spacing-sm);
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  padding: var(--spacing-md) var(--spacing-lg);
  font-size: var(--font-size-sm);
  line-height: var(--line-height-relaxed);
  font-weight: 500;
}
.feature-item__icon {
  flex-shrink: 0;
  width: 32px; height: 32px;
  border-radius: 50%;
  background: rgba(224,88,0,0.1);
  display: flex; align-items: center; justify-content: center;
  color: var(--color-primary);
}

/* Process steps */
.process-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--spacing-lg);
  margin-top: var(--spacing-2xl);
}
.process-step {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius-lg);
  padding: var(--spacing-xl);
  position: relative;
}
.process-step__num {
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--color-primary);
  color: #fff;
  font-size: var(--font-size-lg);
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--spacing-md);
}
.process-step__title {
  font-size: var(--font-size-base);
  font-weight: 700;
  color: var(--color-secondary);
  margin-bottom: var(--spacing-sm);
}
.process-step__desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-light);
  line-height: var(--line-height-relaxed);
  margin: 0;
}

/* FAQ */
.faq-list {
  display: flex; flex-direction: column; gap: var(--spacing-sm);
  margin-top: var(--spacing-2xl);
  max-width: 800px; margin-left: auto; margin-right: auto;
}
.faq-item {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  overflow: hidden;
}
.faq-item__btn {
  width: 100%; text-align: left;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
  padding: var(--spacing-lg) var(--spacing-xl);
  background: none; border: none; cursor: pointer;
  font-weight: 600; font-size: var(--font-size-sm);
  color: var(--color-secondary);
}
.faq-item__btn:hover { color: var(--color-primary); }
.faq-item__btn svg { flex-shrink: 0; }
.faq-item__ans {
  display: none;
  padding: 0 var(--spacing-xl) var(--spacing-lg);
  border-top: 1px solid var(--color-border);
}
.faq-item__ans p { font-size: var(--font-size-sm); color: var(--color-text-light); line-height: var(--line-height-relaxed); margin: var(--spacing-md) 0 0; }
.faq-item.is-open .faq-item__ans { display: block; }
.faq-item.is-open .faq-item__btn svg { transform: rotate(180deg); }

/* Products grid: 3 cols en servicios */
@media(min-width:768px){ .svc-products-grid{ grid-template-columns: repeat(3,1fr); } }
</style>

<script>
document.querySelectorAll('.faq-item__btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    var item = btn.closest('.faq-item');
    if (!item) return;
    item.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', item.classList.contains('is-open') ? 'true' : 'false');
  });
});
</script>
