---
import { SITE, SITE_NAME, siteConfig } from "@/config/site";
import "@fontsource-variable/inter/wght.css";
import "@/styles/global.css";
import { buildPageSchemas, type BreadcrumbItem, type FaqSeoItem, type ProductSeo } from "@/lib/seo";

// ─── Tipos ────────────────────────────────────────────────────────────────────
export interface Props {
 title:  string;
 description:  string;
 canonical?:  string;
 ogImage?:  string;
 pageType?:  "home" | "product" | "category" | "catalog" | "page";
 breadcrumbs?: BreadcrumbItem[];
 faqItems?:  FaqSeoItem[];
 product?:  ProductSeo;
 schema?:  object | object[];  // inyección manual si se necesita
 noindex?:  boolean;
}

const {
 title,
 description,
 canonical  = Astro.url.href,
 ogImage  = siteConfig.ogImage,
 pageType  = "page",
 breadcrumbs,
 faqItems,
 schema,
 noindex = false,
} = Astro.props;

const allSchemas = buildPageSchemas({ breadcrumbs, faqItems, schema });

// ─── og:type dinámico ─────────────────────────────────────────────────────────
const ogType = (pageType === "product") ? "og:product" : "website";
---

<!doctype html>
<html lang={siteConfig.language}>
 <head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
 <style>html,body{overflow-x:hidden;max-width:100%}*,*::before,*::after{box-sizing:border-box}</style>

 <!-- SEO Primario -->
 <title>{title}</title>
 <meta name="description" content={description} />
 <link rel="canonical" href={canonical} />
 <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />

 <!-- Open Graph -->
 <meta property="og:type"  content={ogType} />
 <meta property="og:title"  content={title} />
 <meta property="og:description"  content={description} />
 <meta property="og:url"  content={canonical} />
 <meta property="og:site_name"  content={SITE_NAME} />
 <meta property="og:image"  content={`${SITE}${ogImage}`} />
 <meta property="og:image:width"  content="1200" />
 <meta property="og:image:height" content="630" />
 <meta property="og:image:type"  content="image/jpeg" />
 <meta property="og:image:alt"  content="CADECA — Cajas de Cartón en CDMX y Estado de México" />
 <meta property="og:locale"  content={siteConfig.locale} />

 <!-- Twitter Card -->
 <meta name="twitter:card"  content="summary_large_image" />
 <meta name="twitter:title"  content={title} />
 <meta name="twitter:description" content={description} />
 <meta name="twitter:image"  content={`${SITE}${ogImage}`} />
 <meta name="twitter:image:alt"  content="CADECA — Cajas de Cartón CDMX" />

 <!-- Favicon -->
 <link rel="icon"  href="/favicon.svg" type="image/svg+xml" />
 <link rel="icon"  href="/favicon.svg" sizes="any" />
 <link rel="apple-touch-icon" href="/favicon.svg" />
 <meta name="theme-color"  content={siteConfig.themeColor} />
 <link rel="manifest"  href="/site.webmanifest" />


 <!-- Schema.org JSON-LD (múltiples bloques = mejor parsing por Google) -->
 {allSchemas.map(s => (
 <script type="application/ld+json" set:html={JSON.stringify(s, null, 0)} />
 ))}
 </head>
 <body>
 <slot />
 </body>
</html>

<script>
 import "@/scripts/lead-form.ts"; // formularios de cotización

 // Mobile nav toggle
 const hamburger = document.getElementById('hamburger');
 const mobileNav = document.getElementById('mobile-nav');
 const overlay  = document.getElementById('mobile-overlay');

 function openNav() {
 mobileNav?.classList.add('mobile-nav--open');
 overlay?.classList.add('mobile-overlay--open');
 hamburger?.setAttribute('aria-expanded', 'true');
 const hl = hamburger?.querySelector('.hamburger__label'); if (hl) hl.textContent = 'Cerrar';
 document.body.style.overflow = 'hidden';
 }
 function closeNav() {
 mobileNav?.classList.remove('mobile-nav--open');
 overlay?.classList.remove('mobile-overlay--open');
 hamburger?.setAttribute('aria-expanded', 'false');
 const hl2 = hamburger?.querySelector('.hamburger__label'); if (hl2) hl2.textContent = 'Menú';
 document.body.style.overflow = '';
 }

 hamburger?.addEventListener('click', () => {
 mobileNav?.classList.contains('mobile-nav--open') ? closeNav() : openNav();
 });
 overlay?.addEventListener('click', closeNav);

 // Mobile submenus
 document.querySelectorAll('[data-toggle]').forEach(btn => {
 btn.addEventListener('click', () => {
 const target = document.getElementById(btn.getAttribute('aria-controls') ?? '');
 const isOpen = target?.classList.contains('mobile-nav__submenu--open');
 target?.classList.toggle('mobile-nav__submenu--open', !isOpen);
 btn.setAttribute('aria-expanded', String(!isOpen));
 });
 });

 // FAQ accordion
 document.querySelectorAll('.faq__question').forEach(btn => {
 btn.addEventListener('click', () => {
 const item  = btn.closest('.faq__item');
 const answer = item?.querySelector('.faq__answer');
 const icon  = btn.querySelector('.faq__icon');
 const isOpen = answer?.classList.contains('faq__answer--open');
 document.querySelectorAll('.faq__answer--open').forEach(a  => a.classList.remove('faq__answer--open'));
 document.querySelectorAll('.faq__question').forEach(b  => b.setAttribute('aria-expanded', 'false'));
 document.querySelectorAll('.faq__icon').forEach(i  => { (i as HTMLElement).textContent = '+'; });
 if (!isOpen) {
 answer?.classList.add('faq__answer--open');
 btn.setAttribute('aria-expanded', 'true');
 if (icon) (icon as HTMLElement).textContent = '−';
 }
 });
 });

</script>
