---
import "@/styles/global.css";
import { CONTACTO, HAS_TEL, HAS_EMAIL } from "@/data/contacto";

// ─── Tipos ────────────────────────────────────────────────────────────────────
export interface BreadcrumbItem { name: string; href?: string; }
export interface FaqSeoItem  { question: string; answer: string; }
export interface ProductSeo {
 name:  string;
 sku:  string;
 description: string;
 image:  string;
 brand?:  string;
 material?:  string;
 category?:  string;
 moq?:  string;
}

export interface Props {
 title:  string;
 description:  string;
 canonical?:  string;
 ogImage?:  string;
 pageType?:  "home" | "product" | "category" | "catalog" | "page";
 breadcrumbs?: BreadcrumbItem[];
 faqItems?:  FaqSeoItem[];
 product?:  ProductSeo;
 schema?:  object | object[];  // inyección manual si se necesita
 noindex?:  boolean;
}

const {
 title,
 description,
 canonical  = Astro.url.href,
 ogImage  = "/img/og-cadeca.jpg",
 pageType  = "page",
 breadcrumbs,
 faqItems,
 product,
 schema,
 noindex = false,
} = Astro.props;

const SITE  = "https://cajas-de-carton.com";
const SITE_NAME = "CADECA";

// ─── Schemas base (siempre presentes) ─────────────────────────────────────────
const schemaOrg = {
 "@context": "https://schema.org",
 "@type": "Organization",
 "@id": `${SITE}/#org`,
 "name": SITE_NAME,
 "alternateName": "CADECA Cajas de Cartón",
 "url": SITE,
 "logo": { "@type": "ImageObject", "url": `${SITE}/img/cadeca-logo.png` },
 "description": "Proveedor de cajas de cartón corrugado para empresas y negocios en la Ciudad de México y el Estado de México: cajas estándar, a la medida, personalizadas con logo y láminas de cartón.",
 "areaServed": [
 { "@type": "State", "name": "Ciudad de México" },
 { "@type": "State", "name": "Estado de México" }
 ],
 ...(HAS_TEL ? { "telephone": `+${CONTACTO.telefono}` } : {}),
 ...(HAS_EMAIL ? { "email": CONTACTO.email } : {}),
 ...((HAS_TEL || HAS_EMAIL) ? { "contactPoint": {
 "@type": "ContactPoint",
 "contactType": "sales",
 "areaServed": "MX",
 "availableLanguage": "Spanish",
 ...(HAS_TEL ? { "telephone": `+${CONTACTO.telefono}` } : {}),
 ...(HAS_EMAIL ? { "email": CONTACTO.email } : {})
 } } : {})
};

const schemaWebSite = {
 "@context": "https://schema.org",
 "@type": "WebSite",
 "@id": `${SITE}/#website`,
 "name": SITE_NAME,
 "url": SITE,
 "publisher": { "@id": `${SITE}/#org` }
};

// ─── BreadcrumbList JSON-LD (si se pasan breadcrumbs) ─────────────────────────
const schemaBreadcrumb = breadcrumbs ? {
 "@context": "https://schema.org",
 "@type": "BreadcrumbList",
 "itemListElement": breadcrumbs.map((b, i) => ({
 "@type": "ListItem",
 "position": i + 1,
 "name": b.name,
 ...(b.href ? { "item": `${SITE}${b.href}` } : {})
 }))
} : null;

// ─── FAQPage JSON-LD (si se pasan faqItems) ───────────────────────────────────
const schemaFaq = faqItems?.length ? {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": faqItems.map(f => ({
 "@type": "Question",
 "name": f.question,
 "acceptedAnswer": { "@type": "Answer", "text": f.answer }
 }))
} : null;

// Product JSON-LD: se omite mientras no haya precios publicados (Offer sin price es inválido).

// ─── Ensamblar todos los schemas ──────────────────────────────────────────────
const allSchemas: object[] = [schemaOrg, schemaWebSite];
if (schemaBreadcrumb) allSchemas.push(schemaBreadcrumb);
if (schemaFaq)  allSchemas.push(schemaFaq);
if (schema) {
 const extra = Array.isArray(schema) ? schema : [schema];
 allSchemas.push(...extra);
}

// ─── og:type dinámico ─────────────────────────────────────────────────────────
const ogType = (pageType === "product") ? "og:product" : "website";
---

<!doctype html>
<html lang="es-MX">
 <head>
 <meta charset="UTF-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
 <style>html,body{overflow-x:hidden;max-width:100%}*,*::before,*::after{box-sizing:border-box}</style>

 <!-- SEO Primario -->
 <title>{title}</title>
 <meta name="description" content={description} />
 <link rel="canonical" href={canonical} />
 <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />

 <!-- Open Graph -->
 <meta property="og:type"  content={ogType} />
 <meta property="og:title"  content={title} />
 <meta property="og:description"  content={description} />
 <meta property="og:url"  content={canonical} />
 <meta property="og:site_name"  content={SITE_NAME} />
 <meta property="og:image"  content={`${SITE}${ogImage}`} />
 <meta property="og:image:width"  content="1200" />
 <meta property="og:image:height" content="630" />
 <meta property="og:image:type"  content="image/jpeg" />
 <meta property="og:image:alt"  content="CADECA — Cajas de Cartón en CDMX y Estado de México" />
 <meta property="og:locale"  content="es_MX" />

 <!-- Twitter Card -->
 <meta name="twitter:card"  content="summary_large_image" />
 <meta name="twitter:title"  content={title} />
 <meta name="twitter:description" content={description} />
 <meta name="twitter:image"  content={`${SITE}${ogImage}`} />
 <meta name="twitter:image:alt"  content="CADECA — Cajas de Cartón CDMX" />

 <!-- Favicon -->
 <link rel="icon"  href="/favicon.svg" type="image/svg+xml" />
 <link rel="icon"  href="/favicon.svg" sizes="any" />
 <link rel="apple-touch-icon" href="/favicon.svg" />
 <meta name="theme-color"  content="#E05800" />
 <link rel="manifest"  href="/site.webmanifest" />


 <!-- Schema.org JSON-LD (múltiples bloques = mejor parsing por Google) -->
 {allSchemas.map(s => (
 <script type="application/ld+json" set:html={JSON.stringify(s, null, 0)} />
 ))}
 </head>
 <body>
 <slot />
 </body>
</html>

<script>
 import "@/scripts/lead-form.ts"; // formularios de cotización

 // Mobile nav toggle
 const hamburger = document.getElementById('hamburger');
 const mobileNav = document.getElementById('mobile-nav');
 const overlay  = document.getElementById('mobile-overlay');

 function openNav() {
 mobileNav?.classList.add('mobile-nav--open');
 overlay?.classList.add('mobile-overlay--open');
 hamburger?.setAttribute('aria-expanded', 'true');
 document.body.style.overflow = 'hidden';
 }
 function closeNav() {
 mobileNav?.classList.remove('mobile-nav--open');
 overlay?.classList.remove('mobile-overlay--open');
 hamburger?.setAttribute('aria-expanded', 'false');
 document.body.style.overflow = '';
 }

 hamburger?.addEventListener('click', () => {
 mobileNav?.classList.contains('mobile-nav--open') ? closeNav() : openNav();
 });
 overlay?.addEventListener('click', closeNav);

 // Mobile submenus
 document.querySelectorAll('[data-toggle]').forEach(btn => {
 btn.addEventListener('click', () => {
 const target = document.getElementById(btn.getAttribute('aria-controls') ?? '');
 const isOpen = target?.classList.contains('mobile-nav__submenu--open');
 target?.classList.toggle('mobile-nav__submenu--open', !isOpen);
 btn.setAttribute('aria-expanded', String(!isOpen));
 });
 });

 // FAQ accordion
 document.querySelectorAll('.faq__question').forEach(btn => {
 btn.addEventListener('click', () => {
 const item  = btn.closest('.faq__item');
 const answer = item?.querySelector('.faq__answer');
 const icon  = btn.querySelector('.faq__icon');
 const isOpen = answer?.classList.contains('faq__answer--open');
 document.querySelectorAll('.faq__answer--open').forEach(a  => a.classList.remove('faq__answer--open'));
 document.querySelectorAll('.faq__question').forEach(b  => b.setAttribute('aria-expanded', 'false'));
 document.querySelectorAll('.faq__icon').forEach(i  => { (i as HTMLElement).textContent = '+'; });
 if (!isOpen) {
 answer?.classList.add('faq__answer--open');
 btn.setAttribute('aria-expanded', 'true');
 if (icon) (icon as HTMLElement).textContent = '−';
 }
 });
 });

</script>
