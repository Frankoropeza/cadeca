---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Topbar     from "@/components/Topbar.astro";
import Header     from "@/components/Header.astro";
import Footer     from "@/components/Footer.astro";
import WaBubble   from "@/components/WaBubble.astro";
import "@/styles/blog.css";

export interface Props {
  title:       string;
  description: string;
  pubDate:     Date;
  updatedDate?: Date;
  author:      string;
  category:    string;
  tags:        string[];
  image?:      string;
  imageAlt?:   string;
  readingTime?: number;
  headings:    { depth: number; slug: string; text: string }[];
  slug:        string;
  relatedPosts?: { slug: string; title: string; category: string; pubDate: Date }[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  author,
  category,
  tags,
  image,
  imageAlt,
  readingTime,
  headings,
  slug,
  relatedPosts = [],
} = Astro.props;

const SITE = "https://cajas-de-carton.com";

const categorySlug = category.toLowerCase()
  .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
  .replace(/\s+/g, "-");

const formattedDate = pubDate.toLocaleDateString("es-MX", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const updatedFormatted = updatedDate?.toLocaleDateString("es-MX", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const categoryColors: Record<string, string> = {
  "E-commerce": "#E05800",
  "Guías": "#1C2B4A",
  "Industria": "#0066CC",
  "Sostenibilidad": "#2E7D32",
  "Consejos": "#6A1B9A",
};

const breadcrumbs = [
  { name: "Inicio", href: "/" },
  { name: "Blog", href: "/blog" },
  { name: title },
];

const schemaArticle = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": { "@type": "Organization", "name": author },
  "publisher": {
    "@type": "Organization",
    "name": "CADECA",
    "logo": { "@type": "ImageObject", "url": `${SITE}/img/cadeca-logo.png` },
  },
  "datePublished": pubDate.toISOString(),
  ...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
  "mainEntityOfPage": { "@type": "WebPage", "@id": `${SITE}/blog/${slug}` },
  ...(image ? { "image": `${SITE}${image}` } : {}),
};

const schemaBreadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": b.name,
    ...(b.href ? { "item": `${SITE}${b.href}` } : {}),
  })),
};

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={`${title} | Blog CADECA`}
  description={description}
  ogImage={image || "/img/og-cadeca.jpg"}
  schema={[schemaArticle, schemaBreadcrumb]}
  breadcrumbs={breadcrumbs}
>
  <Topbar />
  <Header currentPath={Astro.url.pathname} />

  <!-- Reading Progress -->
  <div class="reading-progress">
    <div class="reading-progress__bar"></div>
  </div>

  <!-- Post Hero -->
  <section class="post-hero">
    <div class="container">
      <nav class="post-hero__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Inicio</a> <span>/</span>
        <a href="/blog">Blog</a> <span>/</span>
        <span>{title}</span>
      </nav>
      <span class="post-hero__category" style={`background: ${categoryColors[category] || "#E05800"}`}>
        {category}
      </span>
      <h1 class="post-hero__title">{title}</h1>
      <div class="post-hero__meta">
        <span class="post-hero__meta-item">
          ✍ {author}
        </span>
        <span class="post-hero__meta-item">
          📅 {formattedDate}
        </span>
        {updatedFormatted && (
          <span class="post-hero__meta-item">
            (Actualizado: {updatedFormatted})
          </span>
        )}
        {readingTime && (
          <span class="post-hero__meta-item">
            ⏱ {readingTime} min de lectura
          </span>
        )}
      </div>
    </div>
  </section>

  <!-- Post Body -->
  <main class="container" id="contenido-principal">
    <div class="blog-layout">
      <!-- Content -->
      <div>
        <article class="prose">
          <slot />
        </article>

        <!-- Tags -->
        <div class="post-tags">
          {tags.map(tag => (
            <span class="post-tags__tag">#{tag}</span>
          ))}
        </div>

        <!-- Share -->
        <div class="post-share">
          <span class="post-share__label">Compartir:</span>
          <button class="post-share__btn" onclick="navigator.clipboard.writeText(window.location.href).then(()=>this.textContent='¡Copiado!')">
            Copiar enlace
          </button>
        </div>

        <!-- Author -->
        <div class="post-author">
          <div class="post-author__avatar">C</div>
          <div class="post-author__info">
            <h4>{author}</h4>
            <p>Especialistas en empaques de cartón corrugado para empresas en CDMX y Estado de México.</p>
          </div>
        </div>

        <!-- Related Posts -->
        {relatedPosts.length > 0 && (
          <section class="related-posts">
            <h2 class="related-posts__title">Artículos relacionados</h2>
            <div class="related-posts__grid">
              {relatedPosts.map(post => (
                <a href={`/blog/${post.slug}`} style="text-decoration:none;">
                  <div class="blog-card">
                    <div class={`blog-card__placeholder blog-card__placeholder--${post.category.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-")}`}>
                      CADECA
                    </div>
                    <div class="blog-card__body">
                      <span class={`blog-card__category blog-card__category--${post.category.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/\s+/g, "-")}`}>{post.category}</span>
                      <h3 class="blog-card__title" style="margin-top: 0.5rem;">{post.title}</h3>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <!-- Sidebar -->
      <aside class="blog-sidebar">
        <!-- TOC -->
        {tocHeadings.length > 0 && (
          <div class="toc">
            <h3 class="toc__title">Contenido</h3>
            <ul class="toc__list">
              {tocHeadings.map(h => (
                <li class={h.depth === 3 ? "toc__h3" : ""}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- CTA WhatsApp -->
        <div class="blog-sidebar__cta">
          <h3>¿Necesitas cotizar?</h3>
          <p>Respuesta en menos de 2 horas. Sin compromiso.</p>
          <a href="https://wa.me/5255XXXXXXXX?text=Hola%20CADECA%2C%20vi%20su%20blog%20y%20me%20interesa%20cotizar%20cajas." class="btn" target="_blank" rel="noopener">
            WhatsApp directo
          </a>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
  <WaBubble />
</BaseLayout>
