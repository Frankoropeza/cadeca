---
// PageLayout.astro — Layout completo de página (BaseLayout + Topbar + Header + Footer + WaBubble)
import BaseLayout  from "@/layouts/BaseLayout.astro";
import Topbar  from "@/components/Topbar.astro";
import Header  from "@/components/Header.astro";
import Footer  from "@/components/Footer.astro";
import WaBubble  from "@/components/WaBubble.astro";

export interface Props {
 // SEO (heredados a BaseLayout)
 title:  string;
 description:  string;
 canonical?:  string;
 ogImage?:  string;
 schema?:  object | object[];
 pageType?:  "home" | "product" | "category" | "catalog" | "page";
 breadcrumbs?: Array<{ name: string; href?: string }>;
 faqItems?:  Array<{ question: string; answer: string }>;
 noindex?: boolean;
 product?:  { name: string; sku: string; description: string; image: string; brand?: string; material?: string; category?: string; moq?: string; };
}

const {
 title,
 description,
 canonical,
 ogImage,
 schema,
 pageType,
 breadcrumbs,
 faqItems,
 product,
 noindex,
} = Astro.props;
---

<BaseLayout
 title={title}
 description={description}
 canonical={canonical}
 ogImage={ogImage}
 schema={schema}
 pageType={pageType}
 breadcrumbs={breadcrumbs}
 faqItems={faqItems}
 product={product}
 noindex={noindex}
>
 <Topbar />
 <Header currentPath={Astro.url.pathname} />
 <span id="contenido" tabindex="-1"></span>

 <slot />

 <Footer />
 <WaBubble />
</BaseLayout>
